# =========================================================================
# TicketHub Environment Configuration Template (.env)
# =========================================================================

# Database Configuration (PostgreSQL 17)
DB_PASSWORD=ChangeThisPassword123!
DB_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Web Application Configuration
APP_PORT=5000

# Initial Admin Configuration (Secure Seeding)
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=ChangeThisAdminPassword123!
INITIAL_ADMIN_NAME=مدیر کل سیستم
INITIAL_ADMIN_PHONE=09120000000

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=TicketHub System

# Seq Configuration
SEQ_PORT=5341

# Object Storage Configuration (Local / MinIO / S3)
STORAGE_PROVIDER=Local
STORAGE_LOCAL_PATH=uploads
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=tickethub-attachments
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_USE_SSL=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Single Sign-On / OIDC Configuration (Keycloak, Microsoft Entra, Google, Okta)
SSO_ENABLED=false
SSO_PROVIDER_NAME=OIDC
SSO_DISPLAY_NAME=ورود یکپارچه سازمانی (SSO)
SSO_AUTHORITY=https://sso.yourcompany.com/realms/master
SSO_CLIENT_ID=tickethub-client
SSO_CLIENT_SECRET=your_sso_client_secret
SSO_REQUIRE_HTTPS=true
SSO_AUTO_PROVISION=true

