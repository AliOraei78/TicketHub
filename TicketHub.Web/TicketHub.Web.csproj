<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketHub.Application\TicketHub.Application.csproj" />
    <ProjectReference Include="..\TicketHub.Core\TicketHub.Core.csproj" />
    <ProjectReference Include="..\TicketHub.Infrastructure\TicketHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
    <Folder Include="Security\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
	
  <Target Name="BuildTailwind" BeforeTargets="Build">
    <Exec Command="Tailwind\tailwindcss.exe -i wwwroot\app.css -o wwwroot\app.min.css --minify" />
  </Target>
	
</Project>
