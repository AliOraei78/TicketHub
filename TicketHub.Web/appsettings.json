{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=TicketHubDb;Username=postgres;Password=Password123!;",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "RabbitMQ": {
    "Host": ""
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "TicketHub System"
  },
  "InitialAdmin": {
    "Email": "",
    "Password": "",
    "Name": "مدیر کل سیستم",
    "PhoneNumber": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "BucketName": "tickethub-attachments",
    "Endpoint": "http://127.0.0.1:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "UseSsl": false,
    "PresignedUrlExpirationMinutes": 60
  },
  "SSO": {
    "Enabled": false,
    "ProviderName": "OIDC",
    "DisplayName": "ورود یکپارچه سازمانی (SSO)",
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "ResponseType": "code",
    "RequireHttpsMetadata": false,
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "Scopes": [ "openid", "profile", "email" ],
    "DefaultRole": "کاربر",
    "AutoProvisionUsers": true
  }
}
