<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <link rel="stylesheet" href="app.min.css" />
    <link rel="stylesheet" href="TicketHub.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="css/Vazirmatn-font-face.css" />
    <link href="_content/Bit.BlazorUI/styles/bit.blazorui.css" rel="stylesheet" />
    <link href="css/jalalidatepicker.min.css" rel="stylesheet" />

    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script defer src="js/alpine.min.js"></script>

    <script>
        window.loadDntCaptcha = function() {
        var img = document.getElementById('dntCaptchaImg');
        if (!img) return;

        fetch('/api/captcha')
        .then(response => response.json())
        .then(data => {
        img.src = data.dntCaptchaImgUrl;
        document.getElementById('DNTCaptchaText').value = data.dntCaptchaTextValue;
        document.getElementById('DNTCaptchaToken').value = data.dntCaptchaTokenValue;
        var input = document.getElementById('CaptchaInputText');
        if (input) input.value = '';
        })
        .catch(error => console.error('خطا در دریافت کپچا:', error));
        };

        document.addEventListener('DOMContentLoaded', function () {
        if (document.getElementById('dntCaptchaImg')) window.loadDntCaptcha();
        });

        Blazor.addEventListener('enhancedload', function () {
        if (document.getElementById('dntCaptchaImg')) window.loadDntCaptcha();
        });
    </script>
    <script src="_content/Bit.BlazorUI/scripts/bit.blazorui.js"></script>
    <script src="js/jalalidatepicker.min.js"></script>
    <script src="js/gamer-hud.js"></script>
    <script>
        window.initJalaliDatePicker = (id, showTime, dotnetHelper) => {
        jalaliDatepicker.startWatch({
        time: showTime,
        hasSecond: false
        });

        var el = document.getElementById(id);
        if (el) {
        var handler = function(e) {
        dotnetHelper.invokeMethodAsync('UpdateValue', e.target.value);
        };

        el.addEventListener('change', handler);
        el.addEventListener('jdp:change', handler);
        }
        };

        window.initClickOutside = (elementId, dotnetHelper) => {
            var el = document.getElementById(elementId);
            if (el) {
                var rect = el.getBoundingClientRect();
                var spaceBelow = window.innerHeight - rect.bottom;
                var menu = el.querySelector('.dropdown-menu-container');
                if (menu) {
                    if (spaceBelow < 260 && rect.top > 260) {
                        menu.classList.add('drop-up');
                    } else {
                        menu.classList.remove('drop-up');
                    }
                }
            }

            var handler = function(e) {
                if (el && !el.contains(e.target)) {
                    dotnetHelper.invokeMethodAsync('CloseDropdown');
                    document.removeEventListener('pointerdown', handler);
                }
            };
            setTimeout(function() {
                document.addEventListener('pointerdown', handler);
            }, 0);
        };

        window.copyTextToClipboard = async (text) => {
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    return true;
                } else {
                    var textArea = document.createElement("textarea");
                    textArea.value = text;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-999999px";
                    textArea.style.top = "-999999px";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    var successful = document.execCommand('copy');
                    document.body.removeChild(textArea);
                    return successful;
                }
            } catch (e) {
                console.error("Copy failed:", e);
                return false;
            }
        };

        window.downloadFileFromText = (fileName, text, mimeType) => {
            try {
                var blob = new Blob([text], { type: mimeType || 'text/plain;charset=utf-8' });
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            } catch (e) {
                console.error("Download failed:", e);
            }
        };
    </script>

    <style>
        .dropdown-menu-container.drop-up {
            top: auto !important;
            bottom: 100% !important;
            margin-top: 0 !important;
            margin-bottom: 0.5rem !important;
        }
    </style>

</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private Microsoft.AspNetCore.Components.IComponentRenderMode? PageRenderMode =>
            HttpContext != null && (
                HttpContext.Request.Path.StartsWithSegments("/login") ||
                HttpContext.Request.Path.StartsWithSegments("/register") ||
                HttpContext.Request.Path.StartsWithSegments("/confirm-email"))
                ? null
                : new InteractiveServerRenderMode(prerender: false);
}