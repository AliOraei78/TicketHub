@page "/tickets/{TicketId:int}"
@page "/tickets/details/{TicketId:int}"

@using TicketHub.Core.Common
@using TicketHub.Core.Common.Exceptions
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Application.Enums
@using TicketHub.Application.DTOs

<PageTitle>جزئیات تیکت | سامانه تیکتینگ</PageTitle>

<div class="w-full max-w-[1680px] mx-auto px-1 sm:px-4 lg:px-8 space-y-2.5 sm:space-y-4 select-none" dir="rtl">
    <!-- Header Bar -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 sm:gap-4">
        <button @onclick="GoBack" class="btn-cyber-ghost px-3 sm:px-3.5 py-1.5 text-xs font-bold flex items-center gap-2 cursor-pointer shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m7 7l-7-7 7-7" /></svg>
            <span>بازگشت به لیست تیکت‌ها</span>
        </button>

        @if (Ticket != null)
        {
            <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 text-xs font-mono font-bold shadow-inner">
                    <span>تیکت</span>
                    <span>#@Ticket.Id</span>
                </div>
                @if (CanEdit)
                {
                    <span class="px-2.5 sm:px-3 py-1 bg-emerald-950/80 text-emerald-300 text-xs font-bold rounded-xl border border-emerald-500/40 flex items-center gap-1.5 shadow-sm">
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                        <span>مجاز به ویرایش</span>
                    </span>
                }
            </div>
        }
    </div>

    @if (Ticket == null)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-cyan-400"></div>
        </div>
    }
    else
    {
        <!-- Mobile Cyber Tab Switcher (Visible only on < lg screens, e.g. phones like Galaxy A54) -->
        <div class="lg:hidden flex items-center p-1 bg-[#070c1a]/95 backdrop-blur-2xl rounded-2xl border border-cyan-500/30 shadow-[0_4px_20px_rgba(0,0,0,0.6)] gap-1">
            <button type="button" @onclick="() => SetMobileTab(0)"
                    class="flex-1 py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none @(ActiveMobileTab == 0 ? "bg-gradient-to-r from-cyan-600/90 to-blue-600/90 text-white shadow-[0_0_15px_rgba(56,189,248,0.4)] border border-cyan-400/50 font-black" : "text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]")">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                <span class="truncate">مشخصات</span>
            </button>

            <button type="button" @onclick="() => SetMobileTab(1)"
                    class="flex-1 py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none @(ActiveMobileTab == 1 ? "bg-gradient-to-r from-cyan-600/90 to-blue-600/90 text-white shadow-[0_0_15px_rgba(56,189,248,0.4)] border border-cyan-400/50 font-black" : "text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]")">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                <span>نظرات</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold @(ActiveMobileTab == 1 ? "bg-white/25 text-white" : "bg-cyan-950 text-cyan-300 border border-cyan-500/40")">
                    @(Comments?.Count ?? 0)
                </span>
            </button>

            <button type="button" @onclick="() => SetMobileTab(2)"
                    class="flex-1 py-2 px-2 text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5 cursor-pointer select-none @(ActiveMobileTab == 2 ? "bg-gradient-to-r from-cyan-600/90 to-blue-600/90 text-white shadow-[0_0_15px_rgba(56,189,248,0.4)] border border-cyan-400/50 font-black" : "text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]")">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                <span>گردش‌کار</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold @(ActiveMobileTab == 2 ? "bg-white/25 text-white" : "bg-slate-900 text-slate-300 border border-slate-700")">
                    @(Transitions?.Count ?? 0)
                </span>
            </button>
        </div>

        <!-- 3 Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-stretch">
            
            <!-- CARD 1: Ticket Overview & Attachments -->
            <div class="relative bg-[#070c1a]/95 backdrop-blur-2xl p-3.5 sm:p-5 rounded-2xl sm:rounded-3xl shadow-[0_15px_45px_rgba(0,0,0,0.85)] border border-cyan-500/35 flex-col justify-between h-[calc(100dvh-255px)] sm:h-[calc(100dvh-240px)] lg:h-auto lg:max-h-[calc(100vh-195px)] min-h-0 @(ActiveMobileTab == 0 ? "flex" : "hidden") lg:flex">
                <!-- Corner HUD Markers -->
                <div class="absolute top-0 right-0 w-3.5 h-3.5 border-t-2 border-r-2 border-cyan-400 z-10 pointer-events-none rounded-tr-xl"></div>
                <div class="absolute bottom-0 left-0 w-3.5 h-3.5 border-b-2 border-l-2 border-cyan-400 z-10 pointer-events-none rounded-bl-xl"></div>

                <!-- Scrollable Body -->
                <div class="my-1 flex-grow overflow-y-auto overflow-x-hidden space-y-4 custom-scrollbar pl-1.5 min-h-0">
                    <!-- Project & Category Badges -->
                    <div class="flex flex-wrap items-center gap-2 border-b border-white/[0.08] pb-3">
                        <span class="text-xs font-bold text-cyan-300 bg-cyan-950/80 px-2.5 sm:px-3 py-1 rounded-xl border border-cyan-500/40 shadow-inner max-w-full truncate">
                            📁 پروژه: @(Ticket.Project?.Name ?? "عمومی")
                        </span>
                        <span class="text-xs font-bold text-purple-300 bg-purple-950/80 px-2.5 sm:px-3 py-1 rounded-xl border border-purple-500/40 shadow-inner max-w-full truncate">
                            🏷️ دسته: @(Ticket.Category?.Name ?? "بدون دسته‌بندی")
                        </span>
                    </div>

                    <!-- Priority Selector / Badge -->
                    <div class="flex flex-wrap items-center justify-between gap-2 bg-[#050811]/90 p-2.5 sm:p-3 rounded-2xl border border-white/[0.08]">
                        <span class="text-xs font-bold text-slate-300">اولویت تیکت:</span>
                        @if (CanEdit)
                        {
                            <select value="@(Ticket.PriorityId ?? 0)" @onchange="UpdatePriorityAsync" class="text-xs bg-[#090e1d] text-slate-200 px-3 py-1.5 rounded-xl border border-cyan-500/40 font-bold focus:outline-none focus:border-cyan-400 cursor-pointer">
                                <option value="0">انتخاب نشده</option>
                                @foreach (var pri in Priorities)
                                {
                                    <option value="@pri.Id">@pri.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="inline-block px-3 py-1 rounded-xl text-xs font-bold border border-current shadow-sm"
                                  style="background-color: @(Ticket.Priority?.ColorCode ?? "#64748B")20; color: @(Ticket.Priority?.ColorCode ?? "#64748B");">
                                @(Ticket.Priority?.Name ?? "نامشخص")
                            </span>
                        }
                    </div>

                    <!-- Title Section & Inline Edit -->
                    <div>
                        @if (IsEditingTitle)
                        {
                            <div class="flex items-center gap-2 mt-1">
                                <input type="text" @bind="TitleValue" class="flex-grow min-w-0 text-sm font-bold text-white bg-[#050811] px-3 py-2 border-2 border-cyan-400 rounded-xl focus:outline-none shadow-inner" autofocus />
                                <button type="button" @onclick="SaveTitleAsync" class="p-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl transition-all shadow-md cursor-pointer shrink-0" title="ذخیره عنوان">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                </button>
                                <button type="button" @onclick="() => IsEditingTitle = false" class="p-2 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded-xl transition-all cursor-pointer shrink-0" title="انصراف">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="group flex items-start sm:items-center justify-between gap-2">
                                <h1 class="text-sm sm:text-base font-black text-slate-100 tracking-tight leading-snug break-words flex-grow min-w-0">@Ticket.Title</h1>
                                @if (CanEdit)
                                {
                                    <button type="button" @onclick="EnableTitleEdit" class="opacity-80 sm:opacity-0 group-hover:opacity-100 transition-all p-1.5 rounded-lg bg-cyan-950 text-cyan-300 hover:bg-cyan-900 border border-cyan-500/40 text-xs font-bold flex items-center gap-1 shrink-0 cursor-pointer" title="ویرایش عنوان">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                                        <span>ویرایش</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Description Section & Inline Edit -->
                    <div>
                        @if (IsEditingDescription)
                        {
                            <div class="space-y-2">
                                <textarea @bind="DescriptionValue" rows="4" class="w-full p-3 text-xs text-slate-200 bg-[#050811] border-2 border-cyan-400 rounded-xl focus:outline-none leading-relaxed shadow-inner resize-none" placeholder="توضیحات تیکت..."></textarea>
                                <div class="flex justify-end gap-2">
                                    <button type="button" @onclick="SaveDescriptionAsync" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl transition-all flex items-center gap-1 shadow-md cursor-pointer">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                        <span>ذخیره توضیحات</span>
                                    </button>
                                    <button type="button" @onclick="() => IsEditingDescription = false" class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl transition-all cursor-pointer">
                                        انصراف
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="group relative bg-[#050811]/80 p-3.5 sm:p-4 rounded-2xl border border-white/[0.08]">
                                <p class="text-slate-300 leading-relaxed text-xs font-normal whitespace-pre-line break-words">@Ticket.Description</p>
                                @if (CanEdit)
                                {
                                    <button type="button" @onclick="EnableDescriptionEdit" class="absolute top-2 left-2 opacity-80 sm:opacity-0 group-hover:opacity-100 transition-all p-1.5 rounded-lg bg-cyan-950 text-cyan-300 hover:bg-cyan-900 border border-cyan-500/40 text-[11px] font-bold flex items-center gap-1 cursor-pointer" title="ویرایش شرح">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                                        <span>ویرایش شرح</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Attachments List -->
                    <div class="border-t border-white/[0.08] pt-3 space-y-2">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <h4 class="font-bold text-slate-200 text-xs flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                                <span>فایل‌های پیوست</span>
                            </h4>

                            @if (CanEdit)
                            {
                                <label class="cursor-pointer px-2.5 sm:px-3 py-1 bg-cyan-950 hover:bg-cyan-900 text-cyan-300 border border-cyan-500/40 text-[11px] font-bold rounded-xl transition-all flex items-center gap-1 shadow-sm shrink-0">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    <span>بارگذاری فایل جدید</span>
                                    <InputFile OnChange="UploadFilesAsync" multiple class="hidden" />
                                </label>
                            }
                        </div>

                        @if (AllAttachments != null && AllAttachments.Any())
                        {
                            <div class="space-y-2">
                                @foreach (var att in AllAttachments)
                                {
                                    <div class="flex items-center justify-between p-2.5 bg-[#050811] rounded-xl border border-white/[0.08] hover:border-cyan-500/40 transition-all group">
                                        <a href="/api/attachments/@att.Id/download" target="_blank" download class="flex items-center gap-2 min-w-0 flex-grow text-slate-300 hover:text-cyan-300 font-medium text-xs truncate">
                                            <div class="p-1.5 rounded-lg bg-cyan-950 text-cyan-400 border border-cyan-500/30 flex-shrink-0">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                                            </div>
                                            <span class="truncate" title="@att.FileName">@att.FileName</span>
                                        </a>

                                        @if (CanEdit)
                                        {
                                            <button type="button" @onclick="() => DeleteAttachmentAsync(att.Id)" class="p-1.5 text-rose-400 hover:bg-rose-950/80 rounded-lg transition-colors flex-shrink-0 cursor-pointer" title="حذف فایل">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-slate-500 text-center py-2.5 bg-[#050811] rounded-xl border border-dashed border-white/10 font-medium">
                                فایلی پیوست نشده است
                            </p>
                        }
                    </div>
                </div>

                <!-- Footer Metadata -->
                <div class="border-t border-white/[0.08] pt-3 space-y-1 text-[11px] text-slate-400 font-medium shrink-0">
                    <div class="flex justify-between">
                        <span>ثبت کننده:</span>
                        <span class="font-bold text-slate-200">@(Ticket.User?.Name ?? "کاربر ناشناس")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>تاریخ ایجاد (تهران):</span>
                        <span class="font-bold text-slate-200 font-mono dir-ltr">@Ticket.CreatedAt.ToPersianDateTimeString()</span>
                    </div>
                </div>
            </div>

            <!-- CARD 2: Comments Stream -->
            <div class="relative bg-[#070c1a]/95 backdrop-blur-2xl p-3.5 sm:p-5 rounded-2xl sm:rounded-3xl shadow-[0_15px_45px_rgba(0,0,0,0.85)] border border-cyan-500/35 flex-col justify-between h-[calc(100dvh-255px)] sm:h-[calc(100dvh-240px)] lg:h-auto lg:max-h-[calc(100vh-195px)] min-h-0 @(ActiveMobileTab == 1 ? "flex" : "hidden") lg:flex">
                <!-- Corner HUD Markers -->
                <div class="absolute top-0 right-0 w-3.5 h-3.5 border-t-2 border-r-2 border-cyan-400 z-10 pointer-events-none rounded-tr-xl"></div>
                <div class="absolute bottom-0 left-0 w-3.5 h-3.5 border-b-2 border-l-2 border-cyan-400 z-10 pointer-events-none rounded-bl-xl"></div>

                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/[0.08] pb-3 shrink-0">
                    <h3 class="font-bold text-slate-100 text-sm flex items-center gap-2">
                        <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                        <span>نظرات و گفتگو</span>
                    </h3>
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center px-2.5 py-0.5 text-xs font-black font-mono rounded-full bg-cyan-950 text-cyan-300 border border-cyan-500/40">
                            @(Comments?.Count ?? 0)
                        </span>
                        <span class="flex items-center gap-1.5 text-[10px] text-emerald-400 font-bold bg-emerald-950/80 px-2.5 py-0.5 rounded-full border border-emerald-500/40">
                            <span class="flex h-2 w-2 relative">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                            </span>
                            <span>گفتگوی زنده</span>
                        </span>
                    </div>
                </div>

                <!-- Stream List -->
                <div class="my-3 flex-grow overflow-y-auto overflow-x-hidden space-y-3 custom-scrollbar pr-1.5 min-h-0">
                    @if (Comments != null && Comments.Any())
                    {
                        @foreach (var comment in Comments)
                        {
                            <div class="bg-[#050811]/90 p-3.5 rounded-2xl border border-white/[0.08] flex items-start gap-3 group hover:border-cyan-500/30 transition-all">
                                <div class="w-8 h-8 rounded-xl bg-cyan-950 text-cyan-300 border border-cyan-500/40 font-bold text-xs flex items-center justify-center flex-shrink-0 shadow-inner">
                                    @(GetInitials(comment.User?.Name ?? "کاربر"))
                                </div>

                                <div class="flex-grow min-w-0">
                                    <div class="flex items-center justify-between gap-1">
                                        <span class="font-bold text-xs text-slate-100 truncate">@(comment.User?.Name ?? "کاربر ناشناس")</span>
                                        <span class="text-[10px] text-slate-400 font-mono dir-ltr shrink-0 font-normal">
                                            @comment.CreatedAt.ToPersianDateTimeString()
                                        </span>
                                    </div>

                                    <p class="text-xs text-slate-300 leading-relaxed mt-1 font-normal whitespace-pre-line break-words">@comment.Content</p>
                                </div>

                                @if (comment.UserId == CurrentUserId || HasFullAccess)
                                {
                                    <button type="button" @onclick="() => DeleteCommentAsync(comment.Id)" class="p-1 text-slate-500 hover:text-rose-400 opacity-80 sm:opacity-0 group-hover:opacity-100 transition-all flex-shrink-0 rounded-lg cursor-pointer" title="حذف نظر">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-8 text-center text-xs text-slate-500 bg-[#050811] rounded-2xl border border-dashed border-white/10 font-medium">
                            هنوز نظری ثبت نشده است
                        </div>
                    }
                </div>

                <!-- Input Box -->
                <div class="pt-2 border-t border-white/[0.08] shrink-0">
                    <div class="flex items-center gap-2 bg-[#050811] p-1.5 sm:p-2 rounded-2xl border border-white/[0.1] focus-within:border-cyan-400 focus-within:ring-1 focus-within:ring-cyan-400 transition-all">
                        <input type="text" @bind="NewCommentContent" @onkeyup='async (e) => { if (e.Key == "Enter") await AddCommentAsync(); }' placeholder="نظر خود را بنویسید..." class="flex-grow min-w-0 bg-transparent px-2.5 sm:px-3 py-1.5 text-xs text-slate-100 border-none outline-none focus:outline-none placeholder-slate-500 font-normal" />
                        <button type="button" @onclick="AddCommentAsync" disabled="@(IsSubmittingComment || string.IsNullOrWhiteSpace(NewCommentContent))" class="btn-cyber-primary px-3 sm:px-4 py-2 text-xs font-bold rounded-xl disabled:opacity-40 flex items-center gap-1 shrink-0 cursor-pointer">
                            @if (IsSubmittingComment)
                            {
                                <div class="animate-spin rounded-full h-3 w-3 border-b-2 border-white"></div>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                            }
                            <span>ارسال</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- CARD 3: Status & Transitions Timeline -->
            <div class="relative bg-[#070c1a]/95 backdrop-blur-2xl p-3.5 sm:p-5 rounded-2xl sm:rounded-3xl shadow-[0_15px_45px_rgba(0,0,0,0.85)] border border-cyan-500/35 flex-col justify-between h-[calc(100dvh-255px)] sm:h-[calc(100dvh-240px)] lg:h-auto lg:max-h-[calc(100vh-195px)] min-h-0 @(ActiveMobileTab == 2 ? "flex" : "hidden") lg:flex">
                <!-- Corner HUD Markers -->
                <div class="absolute top-0 right-0 w-3.5 h-3.5 border-t-2 border-r-2 border-cyan-400 z-10 pointer-events-none rounded-tr-xl"></div>
                <div class="absolute bottom-0 left-0 w-3.5 h-3.5 border-b-2 border-l-2 border-cyan-400 z-10 pointer-events-none rounded-bl-xl"></div>

                <div class="flex flex-col flex-grow min-h-0">
                    <div class="border-b border-white/[0.08] pb-3 mb-3 shrink-0">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                            <h3 class="font-bold text-slate-100 text-sm flex items-center gap-2">
                                <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                <span>وضعیت و تاریخچه تغییرات</span>
                            </h3>
                            <span class="inline-flex items-center justify-center px-2.5 py-0.5 text-xs font-black font-mono rounded-full bg-slate-900 text-slate-300 border border-slate-700">
                                @(Transitions?.Count ?? 0)
                            </span>
                        </div>

                        <div class="flex flex-wrap items-center justify-between gap-2.5 bg-[#050811] p-2.5 sm:p-3 rounded-2xl border border-white/[0.08]">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="text-xs text-slate-400 font-medium shrink-0">وضعیت فعلی:</span>
                                <span class="text-xs font-bold px-2.5 py-1 rounded-xl border border-current shadow-sm truncate" style="background-color: @(Ticket.Status?.ColorCode ?? "#64748B")20; color: @(Ticket.Status?.ColorCode ?? "#64748B");">
                                    @(Ticket.Status?.Name ?? "نامشخص")
                                </span>
                            </div>

                            @if (Ticket.Project != null && Ticket.Project.WorkflowId.HasValue)
                            {
                                @if (HasAvailableTransitions || HasFullAccess)
                                {
                                    <button type="button" @onclick="OpenTransitionModal" class="btn-cyber-primary px-3 py-1.5 text-xs font-bold rounded-xl flex items-center gap-1.5 cursor-pointer shrink-0">
                                        <svg class="h-3.5 w-3.5 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                        <span>تغییر وضعیت</span>
                                    </button>
                                }
                            }
                            else
                            {
                                <select value="@Ticket.StatusId" @onchange="UpdateStatusAsync" class="px-3 py-1.5 bg-[#090e1d] text-slate-200 rounded-xl border border-cyan-500/40 text-xs font-bold focus:outline-none cursor-pointer">
                                    @if (Statuses != null)
                                    {
                                        @foreach (var status in Statuses)
                                        {
                                            <option value="@status.Id">@status.Name</option>
                                        }
                                    }
                                </select>
                            }
                        </div>
                    </div>

                    <!-- Timeline -->
                    <div class="my-1 flex-grow overflow-y-auto overflow-x-hidden space-y-2 custom-scrollbar pr-1.5 min-h-0">
                        <h4 class="font-bold text-slate-300 text-xs mb-3">تاریخچه تغییر وضعیت:</h4>
                        @if (Transitions != null && Transitions.Any())
                        {
                            <div class="relative border-r-2 border-cyan-500/30 mr-2 pr-4 space-y-3">
                                @foreach (var item in Transitions)
                                {
                                    <div class="relative group text-xs">
                                        <!-- Glowing Node Dot -->
                                        <div class="absolute -right-[21px] top-2 w-3 h-3 rounded-full bg-cyan-400 border-2 border-[#070c1a] shadow-[0_0_10px_rgba(56,189,248,0.8)]"></div>

                                        <div class="bg-[#050811]/90 p-3 rounded-2xl border border-white/[0.08] space-y-1.5 hover:border-cyan-500/30 transition-all">
                                            <div class="flex items-center justify-between gap-1">
                                                <span class="font-bold text-xs text-slate-100 truncate">
                                                    @(string.IsNullOrWhiteSpace(item.TransitionTitle) ? "تغییر وضعیت" : item.TransitionTitle)
                                                </span>
                                                <span class="text-[10px] text-slate-400 font-mono dir-ltr shrink-0 font-normal">
                                                    @item.CreatedAt.ToPersianDateTimeString()
                                                </span>
                                            </div>

                                            <div class="flex flex-wrap items-center gap-1.5 text-[10px]">
                                                <span class="px-2 py-0.5 rounded-lg font-bold border border-current max-w-[130px] sm:max-w-none truncate" style="background-color: @(item.FromStatusColor ?? "#64748B")20; color: @(item.FromStatusColor ?? "#64748B");">
                                                    @(string.IsNullOrWhiteSpace(item.FromStatusName) ? "نامشخص" : item.FromStatusName)
                                                </span>
                                                <svg class="w-3.5 h-3.5 text-slate-400 rotate-180 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                                                <span class="px-2 py-0.5 rounded-lg font-bold border border-current max-w-[130px] sm:max-w-none truncate" style="background-color: @(item.ToStatusColor ?? "#64748B")20; color: @(item.ToStatusColor ?? "#64748B");">
                                                    @(string.IsNullOrWhiteSpace(item.ToStatusName) ? "نامشخص" : item.ToStatusName)
                                                </span>
                                            </div>

                                            <div class="text-[10px] text-slate-400 font-normal">
                                                انجام دهنده: <strong class="text-slate-200 font-bold">@(item.UserName ?? "سیستم")</strong>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.Comment))
                                            {
                                                <div class="bg-[#090e1d] p-2 rounded-xl border border-white/10 text-[10px] text-slate-300 leading-snug mt-1.5 font-normal break-words">
                                                    💬 @item.Comment
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-8 text-center text-xs text-slate-500 bg-[#050811] rounded-2xl border border-dashed border-white/10 font-medium">
                                هنوز انتقالی ثبت نشده است
                            </div>
                        }
                    </div>
                </div>

                <!-- Footer Metadata -->
                <div class="border-t border-white/[0.08] pt-3 space-y-1 text-[11px] text-slate-400 font-medium shrink-0">
                    <div class="flex justify-between">
                        <span>ثبت کننده:</span>
                        <span class="font-bold text-slate-200">@(Ticket.User?.Name ?? "کاربر ناشناس")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>تاریخ ایجاد (تهران):</span>
                        <span class="font-bold text-slate-200 font-mono dir-ltr">@Ticket.CreatedAt.ToPersianDateTimeString()</span>
                    </div>
                </div>
            </div>
        </div>

    }
</div>

<TicketTransitionModal @ref="TransitionModal" OnSaved="HandleTransitionSaved" />