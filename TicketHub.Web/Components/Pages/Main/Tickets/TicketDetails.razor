@page "/tickets/{TicketId:int}"
@page "/tickets/details/{TicketId:int}"
@rendermode InteractiveServer
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using TicketHub.Core.Common
@using TicketHub.Core.Common.Exceptions
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Application.Enums
@using TicketHub.Application.DTOs

@inject ITicketService TicketService
@inject ICommentService CommentService
@inject IStatusService StatusService
@inject ICategoryService CategoryService
@inject IPriorityService PriorityService
@inject IToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject ITicketEventBroker EventBroker


<div class="w-full space-y-4" dir="rtl">
    <!-- Navigation & Header Bar -->
    <div class="flex items-center justify-between">
        <button @onclick="GoBack" class="smooth-transition flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m7 7l-7-7 7-7" /></svg>
            بازگشت به لیست تیکت‌ها
        </button>

        @if (ticket != null)
        {
            <div class="flex items-center gap-3">
                <span class="text-xs text-gray-400">شناسه تیکت: #@ticket.Id</span>
                @if (_canEdit)
                {
                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-lg border border-emerald-200/60 flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                        ویرایش آنلاین (فرستنده / دسترسی کامل)
                    </span>
                }
            </div>
        }
    </div>

    @if (ticket == null)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-600"></div>
        </div>
    }
    else
    {
        <!-- 3 Cards Layout Fitting Viewport Without Main Scroll -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-stretch">
            
            <!-- CARD 1: Ticket Details & Attachments -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between max-h-[calc(100vh-195px)] overflow-y-auto custom-scrollbar">
                <div class="space-y-4">
                    <!-- Project & Category Badges (Read-Only) -->
                    <div class="flex flex-wrap items-center gap-2 border-b border-gray-50 pb-3">
                        <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-lg border border-indigo-100">
                            پروژه: @(ticket.Project?.Name ?? "عمومی")
                        </span>
                        <span class="text-xs font-semibold text-gray-700 bg-gray-100 px-3 py-1 rounded-lg border border-gray-200">
                            دسته‌بندی: @(ticket.Category?.Name ?? "بدون دسته‌بندی")
                        </span>
                    </div>

                    <!-- Priority Badge / Selector -->
                    <div class="flex items-center justify-between bg-gray-50/70 p-2.5 rounded-xl border border-gray-100">
                        <span class="text-xs font-bold text-gray-500">اولویت تیکت:</span>
                        @if (_canEdit)
                        {
                            <select value="@(ticket.PriorityId ?? 0)" @onchange="UpdatePriorityAsync" class="text-xs bg-white px-2.5 py-1 rounded-lg border border-gray-200 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                                <option value="0">انتخاب نشده</option>
                                @foreach (var pri in priorities)
                                {
                                    <option value="@pri.Id">@pri.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold"
                                  style="background-color: @(ticket.Priority?.ColorCode ?? "#6B7280")20; color: @(ticket.Priority?.ColorCode ?? "#6B7280");">
                                @(ticket.Priority?.Name ?? "نامشخص")
                            </span>
                        }
                    </div>

                    <!-- Inline Editable Title -->
                    <div>
                        @if (_isEditingTitle)
                        {
                            <div class="flex items-center gap-2 mt-1">
                                <input type="text" @bind="_titleValue" class="flex-grow text-base font-bold text-gray-800 px-3 py-1.5 border-2 border-blue-500 rounded-xl focus:outline-none" autofocus />
                                <button type="button" @onclick="SaveTitleAsync" class="p-1.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors" title="ذخیره عنوان">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                </button>
                                <button type="button" @onclick="() => _isEditingTitle = false" class="p-1.5 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors" title="انصراف">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="group flex items-center justify-between gap-2">
                                <h1 class="text-lg font-black text-gray-800">@ticket.Title</h1>
                                @if (_canEdit)
                                {
                                    <button type="button" @onclick="EnableTitleEdit" class="opacity-0 group-hover:opacity-100 smooth-transition p-1 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 text-xs font-bold flex items-center gap-1 shrink-0" title="ویرایش عنوان">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                                        ویرایش
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Inline Editable Description -->
                    <div>
                        @if (_isEditingDescription)
                        {
                            <div class="space-y-2">
                                <textarea @bind="_descriptionValue" rows="4" class="w-full p-2.5 text-xs text-gray-700 border-2 border-blue-500 rounded-xl focus:outline-none leading-relaxed" placeholder="توضیحات تیکت..."></textarea>
                                <div class="flex justify-end gap-2">
                                    <button type="button" @onclick="SaveDescriptionAsync" class="px-3 py-1 bg-emerald-600 text-white text-xs font-bold rounded-lg hover:bg-emerald-700 transition-colors flex items-center gap-1">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                        ذخیره
                                    </button>
                                    <button type="button" @onclick="() => _isEditingDescription = false" class="px-3 py-1 bg-gray-200 text-gray-700 text-xs font-bold rounded-lg hover:bg-gray-300 transition-colors">
                                        انصراف
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="group relative bg-gray-50/60 p-3 rounded-xl border border-gray-100">
                                <p class="text-gray-700 leading-relaxed text-xs whitespace-pre-line">@ticket.Description</p>
                                @if (_canEdit)
                                {
                                    <button type="button" @onclick="EnableDescriptionEdit" class="absolute top-2 left-2 opacity-0 group-hover:opacity-100 smooth-transition p-1 rounded-lg bg-blue-100 text-blue-600 hover:bg-blue-200 text-[11px] font-bold flex items-center gap-1" title="ویرایش شرح">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                                        ویرایش شرح
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Attachments Section (Deletable & Re-uploadable) -->
                    <div class="border-t border-gray-100 pt-3 space-y-2">
                        <div class="flex items-center justify-between">
                            <h4 class="font-bold text-gray-800 text-xs flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                                فایل‌های پیوست
                            </h4>

                            @if (_canEdit)
                            {
                                <label class="cursor-pointer px-2.5 py-0.5 bg-blue-50 hover:bg-blue-100 text-blue-600 text-[11px] font-bold rounded-lg transition-colors flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    آپلود جدید
                                    <InputFile OnChange="UploadFilesAsync" multiple class="hidden" />
                                </label>
                            }
                        </div>

                        @if (allAttachments != null && allAttachments.Any())
                        {
                            <div class="space-y-1.5">
                                @foreach (var att in allAttachments)
                                {
                                    <div class="flex items-center justify-between p-2 bg-gray-50 rounded-lg border border-gray-100 hover:border-gray-200 transition-all group">
                                        <a href="@att.FilePath" target="_blank" download class="flex items-center gap-2 min-w-0 flex-grow text-gray-700 hover:text-blue-600 font-medium text-xs truncate">
                                            <div class="p-1 rounded bg-blue-100 text-blue-600 flex-shrink-0">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                                            </div>
                                            <span class="truncate" title="@att.FileName">@att.FileName</span>
                                        </a>

                                        @if (_canEdit)
                                        {
                                            <button type="button" @onclick="() => DeleteAttachmentAsync(att.Id)" class="p-1 text-rose-500 hover:bg-rose-50 rounded transition-colors flex-shrink-0" title="حذف فایل">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-[11px] text-gray-400 text-center py-2 bg-gray-50 rounded-lg border border-dashed border-gray-200">
                                فایلی پیوست نشده است.
                            </p>
                        }
                    </div>
                </div>

                <div class="border-t border-gray-100 pt-3 space-y-1 text-[11px] text-gray-400">
                    <div class="flex justify-between">
                        <span>ثبت کننده:</span>
                        <span class="font-medium text-gray-700">@(ticket.User?.Name ?? "کاربر ناشناس")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>تاریخ ایجاد (تهران):</span>
                        <span class="font-medium text-gray-700 dir-ltr">@ticket.CreatedAt.ToPersianDateTimeString()</span>
                    </div>
                </div>
            </div>


            <!-- CARD 2: Live Comments (Expanded Stream + Ultra Compact Input Bar) -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between max-h-[calc(100vh-195px)]">
                <!-- Header -->
                <div class="flex items-center justify-between border-b border-gray-100 pb-3 shrink-0">
                    <h3 class="font-bold text-gray-800 text-sm flex items-center gap-2">
                        <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                        نظرات و گفتگو
                    </h3>
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-extrabold rounded-full bg-blue-100 text-blue-700">
                            @(comments?.Count ?? 0)
                        </span>
                        <span class="flex items-center gap-1 text-[11px] text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-100">
                            <span class="flex h-1.5 w-1.5 relative">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                            </span>
                            زنده
                        </span>
                    </div>
                </div>

                <!-- Comments Stream (Fills middle height) -->
                <div class="my-3 flex-grow overflow-y-auto space-y-2.5 custom-scrollbar pr-1">
                    @if (comments != null && comments.Any())
                    {
                        @foreach (var comment in comments)
                        {
                            <div class="bg-gray-50/70 p-3 rounded-xl border border-gray-100 shadow-2xs flex items-start gap-2.5 group">
                                <div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-[11px] flex items-center justify-center flex-shrink-0">
                                    @(GetInitials(comment.User?.Name ?? "کاربر"))
                                </div>

                                <div class="flex-grow min-w-0">
                                    <div class="flex items-center justify-between gap-1">
                                        <span class="font-bold text-xs text-gray-800 truncate">@(comment.User?.Name ?? "کاربر ناشناس")</span>
                                        <span class="text-[10px] text-gray-400 dir-ltr shrink-0">
                                            @comment.CreatedAt.ToPersianDateTimeString()
                                        </span>
                                    </div>

                                    <p class="text-xs text-gray-700 leading-relaxed mt-0.5 whitespace-pre-line">@comment.Content</p>
                                </div>

                                @if (comment.UserId == _currentUserId || _hasFullAccess)
                                {
                                    <button type="button" @onclick="() => DeleteCommentAsync(comment.Id)" class="p-1 text-gray-300 hover:text-rose-600 opacity-0 group-hover:opacity-100 transition-all flex-shrink-0" title="حذف نظر">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-6 text-center text-xs text-gray-400 bg-gray-50 rounded-xl border border-dashed border-gray-200">
                            هیچ نظری برای این تیکت ثبت نشده است.
                        </div>
                    }
                </div>

                <!-- Ultra Compact Single-Row Comment Input Bar at Bottom -->
                <div class="pt-2 border-t border-gray-100 shrink-0">
                    <div class="flex items-center gap-2 bg-gray-50 p-1.5 rounded-xl border border-gray-200 focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500 transition-all">
                        <input type="text" @bind="_newCommentContent" @onkeyup='(e) => { if (e.Key == "Enter") AddCommentAsync(); }' placeholder="نظر خود را بنویسید..." class="flex-grow bg-transparent px-3 py-1.5 text-xs text-gray-700 border-none outline-none focus:outline-none placeholder-gray-400" />
                        <button type="button" @onclick="AddCommentAsync" disabled="@(_isSubmittingComment || string.IsNullOrWhiteSpace(_newCommentContent))" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-lg transition-all disabled:opacity-40 flex items-center gap-1 shrink-0">
                            @if (_isSubmittingComment)
                            {
                                <div class="animate-spin rounded-full h-3 w-3 border-b-2 border-white"></div>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                            }
                            ارسال
                        </button>
                    </div>
                </div>
            </div>


            <!-- CARD 3: Status & Compact Transition History -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between max-h-[calc(100vh-195px)]">
                <div class="flex flex-col flex-grow min-h-0">
                    <!-- Status Header & Action -->
                    <div class="border-b border-gray-100 pb-3 mb-3 shrink-0">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="font-bold text-gray-800 text-sm flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                وضعیت و انتقالات
                            </h3>
                            <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-extrabold rounded-full bg-gray-100 text-gray-700">
                                @(transitions?.Count ?? 0)
                            </span>
                        </div>

                        <div class="flex items-center justify-between bg-gray-50 p-2.5 rounded-xl border border-gray-100">
                            <div class="flex items-center gap-1.5">
                                <span class="text-[11px] text-gray-400">وضعیت فعلی:</span>
                                <span class="text-xs font-bold" style="color: @(ticket.Status?.ColorCode ?? "#6B7280");">
                                    @(ticket.Status?.Name ?? "نامشخص")
                                </span>
                            </div>

                            @if (ticket.Project != null && ticket.Project.WorkflowId.HasValue)
                            {
                                <SecuredView ResourceKey="/tickets" MinimumType="PermissionType.SystemSection">
                                    <button type="button" @onclick="OpenTransitionModal" class="px-3 py-1 bg-blue-600 text-white text-[11px] font-bold rounded-lg shadow-2xs hover:bg-blue-700 transition-colors flex items-center gap-1">
                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                        تغییر وضعیت
                                    </button>
                                </SecuredView>
                            }
                            else
                            {
                                <select value="@ticket.StatusId" @onchange="UpdateStatusAsync" class="px-2 py-1 rounded-lg border border-gray-200 text-[11px] focus:outline-none font-bold">
                                    @if (statuses != null)
                                    {
                                        @foreach (var status in statuses)
                                        {
                                            <option value="@status.Id">@status.Name</option>
                                        }
                                    }
                                </select>
                            }
                        </div>
                    </div>

                    <!-- Compact Transition History Timeline (Scrollable inside card) -->
                    <div class="my-1 flex-grow overflow-y-auto space-y-2 custom-scrollbar pr-1">
                        <h4 class="font-bold text-gray-700 text-xs mb-2">تاریخچه انتقالات:</h4>
                        @if (transitions != null && transitions.Any())
                        {
                            <div class="relative border-r-2 border-indigo-100 mr-1.5 pr-3 space-y-2">
                                @foreach (var item in transitions)
                                {
                                    <div class="relative group text-xs">
                                        <div class="absolute -right-[17px] top-1.5 w-2.5 h-2.5 rounded-full bg-indigo-600 border-2 border-white shadow-2xs"></div>

                                        <div class="bg-gray-50/80 p-2.5 rounded-lg border border-gray-100 space-y-1">
                                            <div class="flex items-center justify-between gap-1">
                                                <span class="font-bold text-[11px] text-gray-800 truncate">
                                                    @(string.IsNullOrWhiteSpace(item.TransitionTitle) ? "تغییر وضعیت" : item.TransitionTitle)
                                                </span>
                                                <span class="text-[10px] text-gray-400 dir-ltr shrink-0">
                                                    @item.CreatedAt.ToPersianDateTimeString()
                                                </span>
                                            </div>

                                            <div class="flex items-center gap-1 text-[10px]">
                                                <span class="px-1.5 py-0.5 rounded font-bold" style="background-color: @(item.FromStatusColor ?? "#6B7280")20; color: @(item.FromStatusColor ?? "#6B7280");">
                                                    @(string.IsNullOrWhiteSpace(item.FromStatusName) ? "نامشخص" : item.FromStatusName)
                                                </span>
                                                <svg class="w-3 h-3 text-gray-400 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                                                <span class="px-1.5 py-0.5 rounded font-bold" style="background-color: @(item.ToStatusColor ?? "#6B7280")20; color: @(item.ToStatusColor ?? "#6B7280");">
                                                    @(string.IsNullOrWhiteSpace(item.ToStatusName) ? "نامشخص" : item.ToStatusName)
                                                </span>
                                            </div>

                                            <div class="text-[10px] text-gray-500">
                                                انجام دهنده: <strong class="text-gray-700">@(item.UserName ?? "سیستم")</strong>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.Comment))
                                            {
                                                <div class="bg-white p-1.5 rounded border border-gray-100 text-[10px] text-gray-600 leading-snug mt-1">
                                                    @item.Comment
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-xs text-gray-400 bg-gray-50 rounded-xl border border-dashed border-gray-200">
                                هیچ گام انتقالی ثبت نشده است.
                            </div>
                        }
                    </div>
                </div>

                <!-- Footer Meta Details -->
                <div class="border-t border-gray-100 pt-3 space-y-1 text-[11px] text-gray-400 shrink-0">
                    <div class="flex justify-between">
                        <span>ثبت کننده:</span>
                        <span class="font-medium text-gray-700">@(ticket.User?.Name ?? "کاربر ناشناس")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>تاریخ ایجاد (تهران):</span>
                        <span class="font-medium text-gray-700 dir-ltr">@ticket.CreatedAt.ToPersianDateTimeString()</span>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

<TicketTransitionModal @ref="transitionModal" OnSaved="HandleTransitionSaved" />

@code {
    [Parameter]
    public int TicketId { get; set; }

    private TicketDto? ticket;
    private IEnumerable<StatusDto> statuses = new List<StatusDto>();
    private IEnumerable<CategoryDto> categories = new List<CategoryDto>();
    private IEnumerable<PriorityDto> priorities = new List<PriorityDto>();
    private List<CommentDto> comments = new();
    private List<TicketHistoryDto> transitions = new();
    private List<AttachmentDto> allAttachments = new();

    private TicketTransitionModal transitionModal = default!;

    private bool _canEdit = false;
    private int _currentUserId = 0;
    private bool _hasFullAccess = false;

    private bool _isEditingTitle = false;
    private string _titleValue = string.Empty;

    private bool _isEditingDescription = false;
    private string _descriptionValue = string.Empty;

    private string _newCommentContent = string.Empty;
    private bool _isSubmittingComment = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ticket = await TicketService.GetByIdAsync(TicketId);
        }
        catch (ForbiddenException ex)
        {
            ToastService.ShowWarning(ex.Message, "عدم دسترسی");
            Navigation.NavigateTo("/tickets");
            return;
        }
        catch (NotFoundException ex)
        {
            ToastService.ShowWarning(ex.Message, "یافت نشد");
            Navigation.NavigateTo("/tickets");
            return;
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در بارگذاری تیکت: " + ex.Message);
            Navigation.NavigateTo("/tickets");
            return;
        }

        if (ticket == null)
        {
            Navigation.NavigateTo("/tickets");
            return;
        }

        statuses = await StatusService.GetAllAsync();
        categories = await CategoryService.GetAllAsync();
        priorities = await PriorityService.GetAllAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                           ?? user.FindFirst("sub")?.Value;
        _currentUserId = int.TryParse(userIdString, out var id) ? id : 0;

        _hasFullAccess = await PermissionService.HasAccessAsync(user, "/tickets", PermissionType.Full);
        bool isSender = (_currentUserId > 0 && ticket.UserId == _currentUserId);
        _canEdit = isSender || _hasFullAccess;

        // Load Comments & Transitions
        comments = await CommentService.GetCommentsByTicketIdAsync(TicketId);
        transitions = await TicketService.GetTransitionsByTicketIdAsync(TicketId);

        // Populate attachments
        LoadAttachments();

        // Subscribe to live ticket events across all circuits
        EventBroker.OnCommentAdded += HandleCommentAddedAsync;
        EventBroker.OnCommentDeleted += HandleCommentDeletedAsync;
        EventBroker.OnTicketUpdated += HandleTicketUpdatedAsync;
        EventBroker.OnTransitionOccurred += HandleTransitionOccurredAsync;
    }

    private void LoadAttachments()
    {
        allAttachments.Clear();

        if (ticket != null)
        {
            // 1. Direct ticket attachments
            if (ticket.Attachments != null && ticket.Attachments.Any())
            {
                allAttachments.AddRange(ticket.Attachments);
            }

            // 2. Field Value attachments
            if (ticket.FieldValues != null)
            {
                foreach (var fv in ticket.FieldValues)
                {
                    if (fv.Attachments != null && fv.Attachments.Any())
                    {
                        allAttachments.AddRange(fv.Attachments);
                    }
                }
            }

            allAttachments = allAttachments.DistinctBy(a => a.Id).ToList();
        }
    }

    private async Task HandleCommentAddedAsync(int tId, CommentDto commentDto)
    {
        if (tId == TicketId)
        {
            await InvokeAsync(() =>
            {
                if (!comments.Any(c => c.Id == commentDto.Id))
                {
                    comments.Add(commentDto);
                    StateHasChanged();
                }
            });
        }
    }

    private async Task HandleCommentDeletedAsync(int tId, int commentId)
    {
        if (tId == TicketId)
        {
            await InvokeAsync(() =>
            {
                comments.RemoveAll(c => c.Id == commentId);
                StateHasChanged();
            });
        }
    }

    private async Task HandleTicketUpdatedAsync(int tId)
    {
        if (tId == TicketId)
        {
            await InvokeAsync(async () =>
            {
                ticket = await TicketService.GetByIdAsync(TicketId);
                LoadAttachments();
                StateHasChanged();
            });
        }
    }

    private async Task HandleTransitionOccurredAsync(int tId)
    {
        if (tId == TicketId)
        {
            await InvokeAsync(async () =>
            {
                ticket = await TicketService.GetByIdAsync(TicketId);
                transitions = await TicketService.GetTransitionsByTicketIdAsync(TicketId);
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        EventBroker.OnCommentAdded -= HandleCommentAddedAsync;
        EventBroker.OnCommentDeleted -= HandleCommentDeletedAsync;
        EventBroker.OnTicketUpdated -= HandleTicketUpdatedAsync;
        EventBroker.OnTransitionOccurred -= HandleTransitionOccurredAsync;
    }

    private void EnableTitleEdit()
    {
        if (ticket == null) return;
        _titleValue = ticket.Title;
        _isEditingTitle = true;
    }

    private async Task SaveTitleAsync()
    {
        if (ticket == null || string.IsNullOrWhiteSpace(_titleValue)) return;

        ticket.Title = _titleValue.Trim();
        await TicketService.UpdateAsync(ticket);
        _isEditingTitle = false;
        ToastService.ShowSuccess("عنوان تیکت با موفقیت ویرایش شد.");
    }

    private void EnableDescriptionEdit()
    {
        if (ticket == null) return;
        _descriptionValue = ticket.Description;
        _isEditingDescription = true;
    }

    private async Task SaveDescriptionAsync()
    {
        if (ticket == null || string.IsNullOrWhiteSpace(_descriptionValue)) return;

        ticket.Description = _descriptionValue.Trim();
        await TicketService.UpdateAsync(ticket);
        _isEditingDescription = false;
        ToastService.ShowSuccess("توضیحات تیکت با موفقیت ویرایش شد.");
    }

    private async Task UpdatePriorityAsync(ChangeEventArgs e)
    {
        if (ticket == null || e.Value == null) return;

        if (int.TryParse(e.Value.ToString(), out int priId))
        {
            ticket.PriorityId = priId == 0 ? null : priId;
            await TicketService.UpdateAsync(ticket);
            ticket = await TicketService.GetByIdAsync(TicketId);
            ToastService.ShowSuccess("اولویت تیکت بروزرسانی شد.");
        }
    }

    private async Task UpdateStatusAsync(ChangeEventArgs e)
    {
        if (ticket == null || e.Value == null) return;

        if (int.TryParse(e.Value.ToString(), out int statusId))
        {
            ticket.StatusId = statusId;
            await TicketService.UpdateAsync(ticket);
            ticket = await TicketService.GetByIdAsync(TicketId);
            ToastService.ShowSuccess("وضعیت تیکت بروزرسانی شد.");
        }
    }

    private async Task DeleteAttachmentAsync(int attachmentId)
    {
        try
        {
            await TicketService.DeleteAttachmentAsync(attachmentId, _currentUserId, _hasFullAccess);
            ticket = await TicketService.GetByIdAsync(TicketId);
            LoadAttachments();
            ToastService.ShowSuccess("فایل ضمیمه با موفقیت حذف شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task UploadFilesAsync(InputFileChangeEventArgs e)
    {
        if (ticket == null) return;

        try
        {
            foreach (var file in e.GetMultipleFiles(5))
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
                await TicketService.UploadTicketAttachmentAsync(TicketId, null, stream, file.Name, file.ContentType);
            }

            ticket = await TicketService.GetByIdAsync(TicketId);
            LoadAttachments();
            ToastService.ShowSuccess("فایل(های) جدید با موفقیت آپلود شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در آپلود فایل: " + ex.Message);
        }
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCommentContent)) return;

        try
        {
            _isSubmittingComment = true;
            await CommentService.AddCommentAsync(new CommentDto
            {
                TicketId = TicketId,
                Content = _newCommentContent
            }, _currentUserId);

            _newCommentContent = string.Empty;
            ToastService.ShowSuccess("نظر شما با موفقیت ثبت شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _isSubmittingComment = false;
        }
    }

    private async Task DeleteCommentAsync(int commentId)
    {
        try
        {
            await CommentService.DeleteCommentAsync(commentId, _currentUserId, _hasFullAccess);
            comments.RemoveAll(c => c.Id == commentId);
            ToastService.ShowSuccess("نظر با موفقیت حذف شد.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task OpenTransitionModal()
    {
        if (ticket != null && ticket.Project != null && ticket.Project.WorkflowId.HasValue)
        {
            await transitionModal.OpenAsync(ticket.Id, ticket.Title, ticket.StatusId, ticket.Project.WorkflowId.Value, ticket.WorkflowStatusId);
        }
    }

    private async Task HandleTransitionSaved()
    {
        ticket = await TicketService.GetByIdAsync(TicketId);
        transitions = await TicketService.GetTransitionsByTicketIdAsync(TicketId);
        StateHasChanged();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/tickets");
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "ک";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString();
        return $"{parts[0][0]}{parts[^1][0]}";
    }
}