@page "/tickets/{TicketId:int}"
@page "/tickets/details/{TicketId:int}"
@rendermode InteractiveServer

@using TicketHub.Core.Common
@using TicketHub.Core.Common.Exceptions
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Application.Enums
@using TicketHub.Application.DTOs

<PageTitle>جزئیات تیکت | سامانه تیکتینگ</PageTitle>

<div class="w-full space-y-4 select-none" dir="rtl">
    <!-- Header Bar -->
    <div class="flex items-center justify-between">
        <button @onclick="GoBack" class="transition-all flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-slate-800 focus-ring rounded-lg px-2 py-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m7 7l-7-7 7-7" /></svg>
            بازگشت به لیست تیکت‌ها
        </button>

        @if (Ticket != null)
        {
            <div class="flex items-center gap-3">
                <span class="text-xs text-slate-400 font-medium">شناسه تیکت: #@Ticket.Id</span>
                @if (CanEdit)
                {
                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-xl border border-emerald-200/60 flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                        ویرایش آنلاین (فرستنده / دسترسی کامل)
                    </span>
                }
            </div>
        }
    </div>

    @if (Ticket == null)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
        </div>
    }
    else
    {
        <!-- 3 Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-stretch">
            
            <!-- CARD 1: Ticket Overview & Attachments -->
            <div class="bg-white p-5 rounded-3xl shadow-2xs border border-slate-200/80 flex flex-col justify-between max-h-[calc(100vh-195px)] overflow-y-auto custom-scrollbar">
                <div class="space-y-4">
                    <div class="flex flex-wrap items-center gap-2 border-b border-slate-100 pb-3">
                        <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-xl border border-indigo-100">
                            پروژه: @(Ticket.Project?.Name ?? "عمومی")
                        </span>
                        <span class="text-xs font-semibold text-slate-700 bg-slate-100 px-3 py-1 rounded-xl border border-slate-200">
                            دسته‌بندی: @(Ticket.Category?.Name ?? "بدون دسته‌بندی")
                        </span>
                    </div>

                    <div class="flex items-center justify-between bg-slate-50/80 p-2.5 rounded-2xl border border-slate-100">
                        <span class="text-xs font-bold text-slate-500">اولویت تیکت:</span>
                        @if (CanEdit)
                        {
                            <select value="@(Ticket.PriorityId ?? 0)" @onchange="UpdatePriorityAsync" class="text-xs bg-white px-2.5 py-1 rounded-xl border border-slate-200 font-bold focus:outline-none focus-ring">
                                <option value="0">انتخاب نشده</option>
                                @foreach (var pri in Priorities)
                                {
                                    <option value="@pri.Id">@pri.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold"
                                  style="background-color: @(Ticket.Priority?.ColorCode ?? "#64748B")20; color: @(Ticket.Priority?.ColorCode ?? "#64748B");">
                                @(Ticket.Priority?.Name ?? "نامشخص")
                            </span>
                        }
                    </div>

                    <div>
                        @if (IsEditingTitle)
                        {
                            <div class="flex items-center gap-2 mt-1">
                                <input type="text" @bind="TitleValue" class="flex-grow text-base font-bold text-slate-800 px-3 py-1.5 border-2 border-indigo-500 rounded-xl focus:outline-none" autofocus />
                                <button type="button" @onclick="SaveTitleAsync" class="p-1.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors focus-ring" title="ذخیره عنوان">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                </button>
                                <button type="button" @onclick="() => IsEditingTitle = false" class="p-1.5 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors focus-ring" title="انصراف">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="group flex items-center justify-between gap-2">
                                <h1 class="text-lg font-black text-slate-800 tracking-tight">@Ticket.Title</h1>
                                @if (CanEdit)
                                {
                                    <button type="button" @onclick="EnableTitleEdit" class="opacity-0 group-hover:opacity-100 transition-all p-1 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 text-xs font-bold flex items-center gap-1 shrink-0 focus-ring" title="ویرایش عنوان">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                                        ویرایش
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div>
                        @if (IsEditingDescription)
                        {
                            <div class="space-y-2">
                                <textarea @bind="DescriptionValue" rows="4" class="w-full p-2.5 text-xs text-slate-700 border-2 border-indigo-500 rounded-xl focus:outline-none leading-relaxed" placeholder="توضیحات تیکت..."></textarea>
                                <div class="flex justify-end gap-2">
                                    <button type="button" @onclick="SaveDescriptionAsync" class="px-3 py-1 bg-emerald-600 text-white text-xs font-bold rounded-lg hover:bg-emerald-700 transition-colors flex items-center gap-1 focus-ring">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                        ذخیره
                                    </button>
                                    <button type="button" @onclick="() => IsEditingDescription = false" class="px-3 py-1 bg-slate-200 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-300 transition-colors focus-ring">
                                        انصراف
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="group relative bg-slate-50/70 p-3.5 rounded-2xl border border-slate-100">
                                <p class="text-slate-700 leading-relaxed text-xs font-normal whitespace-pre-line">@Ticket.Description</p>
                                @if (CanEdit)
                                {
                                    <button type="button" @onclick="EnableDescriptionEdit" class="absolute top-2 left-2 opacity-0 group-hover:opacity-100 transition-all p-1 rounded-lg bg-indigo-100 text-indigo-600 hover:bg-indigo-200 text-[11px] font-bold flex items-center gap-1 focus-ring" title="ویرایش شرح">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 210.3H3v-3.572L16.732 3.732z" /></svg>
                                        ویرایش شرح
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="border-t border-slate-100 pt-3 space-y-2">
                        <div class="flex items-center justify-between">
                            <h4 class="font-bold text-slate-800 text-xs flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                                فایل‌های پیوست
                            </h4>

                            @if (CanEdit)
                            {
                                <label class="cursor-pointer px-2.5 py-0.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 text-[11px] font-bold rounded-lg transition-colors flex items-center gap-1 focus-ring">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    آپلود جدید
                                    <InputFile OnChange="UploadFilesAsync" multiple class="hidden" />
                                </label>
                            }
                        </div>

                        @if (AllAttachments != null && AllAttachments.Any())
                        {
                            <div class="space-y-1.5">
                                @foreach (var att in AllAttachments)
                                {
                                    <div class="flex items-center justify-between p-2 bg-slate-50 rounded-xl border border-slate-100 hover:border-slate-200 transition-all group">
                                        <a href="@att.FilePath" target="_blank" download class="flex items-center gap-2 min-w-0 flex-grow text-slate-700 hover:text-indigo-600 font-medium text-xs truncate">
                                            <div class="p-1 rounded-lg bg-indigo-100 text-indigo-600 flex-shrink-0">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                                            </div>
                                            <span class="truncate" title="@att.FileName">@att.FileName</span>
                                        </a>

                                        @if (CanEdit)
                                        {
                                            <button type="button" @onclick="() => DeleteAttachmentAsync(att.Id)" class="p-1 text-rose-500 hover:bg-rose-50 rounded-lg transition-colors flex-shrink-0 focus-ring" title="حذف فایل">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-[11px] text-slate-400 text-center py-2 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                                فایلی پیوست نشده است.
                            </p>
                        }
                    </div>
                </div>

                <div class="border-t border-slate-100 pt-3 space-y-1 text-[11px] text-slate-400 font-medium">
                    <div class="flex justify-between">
                        <span>ثبت کننده:</span>
                        <span class="font-bold text-slate-700">@(Ticket.User?.Name ?? "کاربر ناشناس")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>تاریخ ایجاد (تهران):</span>
                        <span class="font-bold text-slate-700 dir-ltr">@Ticket.CreatedAt.ToPersianDateTimeString()</span>
                    </div>
                </div>
            </div>

            <!-- CARD 2: Comments Stream -->
            <div class="bg-white p-5 rounded-3xl shadow-2xs border border-slate-200/80 flex flex-col justify-between max-h-[calc(100vh-195px)]">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3 shrink-0">
                    <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                        <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                        نظرات و گفتگو
                    </h3>
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-extrabold rounded-full bg-indigo-100 text-indigo-700">
                            @(Comments?.Count ?? 0)
                        </span>
                        <span class="flex items-center gap-1 text-[11px] text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded-xl border border-emerald-100">
                            <span class="flex h-1.5 w-1.5 relative">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                            </span>
                            زنده
                        </span>
                    </div>
                </div>

                <div class="my-3 flex-grow overflow-y-auto space-y-2.5 custom-scrollbar pr-1">
                    @if (Comments != null && Comments.Any())
                    {
                        @foreach (var comment in Comments)
                        {
                            <div class="bg-slate-50/70 p-3 rounded-2xl border border-slate-100 flex items-start gap-2.5 group">
                                <div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-[11px] flex items-center justify-center flex-shrink-0">
                                    @(GetInitials(comment.User?.Name ?? "کاربر"))
                                </div>

                                <div class="flex-grow min-w-0">
                                    <div class="flex items-center justify-between gap-1">
                                        <span class="font-bold text-xs text-slate-800 truncate">@(comment.User?.Name ?? "کاربر ناشناس")</span>
                                        <span class="text-[10px] text-slate-400 dir-ltr shrink-0 font-normal">
                                            @comment.CreatedAt.ToPersianDateTimeString()
                                        </span>
                                    </div>

                                    <p class="text-xs text-slate-700 leading-relaxed mt-0.5 font-normal whitespace-pre-line">@comment.Content</p>
                                </div>

                                @if (comment.UserId == CurrentUserId || HasFullAccess)
                                {
                                    <button type="button" @onclick="() => DeleteCommentAsync(comment.Id)" class="p-1 text-slate-300 hover:text-rose-600 opacity-0 group-hover:opacity-100 transition-all flex-shrink-0 focus-ring rounded-lg" title="حذف نظر">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-6 text-center text-xs text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                            هیچ نظری برای این تیکت ثبت نشده است.
                        </div>
                    }
                </div>

                <div class="pt-2 border-t border-slate-100 shrink-0">
                    <div class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-2xl border border-slate-200 focus-within:border-indigo-500 focus-within:ring-1 focus-within:ring-indigo-500 transition-all">
                        <input type="text" @bind="NewCommentContent" @onkeyup='(e) => { if (e.Key == "Enter") AddCommentAsync(); }' placeholder="نظر خود را بنویسید..." class="flex-grow bg-transparent px-3 py-1.5 text-xs text-slate-700 border-none outline-none focus:outline-none placeholder-slate-400 font-normal" />
                        <button type="button" @onclick="AddCommentAsync" disabled="@(IsSubmittingComment || string.IsNullOrWhiteSpace(NewCommentContent))" class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition-all disabled:opacity-40 flex items-center gap-1 shrink-0 focus-ring">
                            @if (IsSubmittingComment)
                            {
                                <div class="animate-spin rounded-full h-3 w-3 border-b-2 border-white"></div>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                            }
                            ارسال
                        </button>
                    </div>
                </div>
            </div>

            <!-- CARD 3: Status & Transitions Timeline -->
            <div class="bg-white p-5 rounded-3xl shadow-2xs border border-slate-200/80 flex flex-col justify-between max-h-[calc(100vh-195px)]">
                <div class="flex flex-col flex-grow min-h-0">
                    <div class="border-b border-slate-100 pb-3 mb-3 shrink-0">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="font-bold text-slate-800 text-sm flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                وضعیت و انتقالات
                            </h3>
                            <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-extrabold rounded-full bg-slate-100 text-slate-700">
                                @(Transitions?.Count ?? 0)
                            </span>
                        </div>

                        <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-2xl border border-slate-100">
                            <div class="flex items-center gap-1.5">
                                <span class="text-[11px] text-slate-400 font-medium">وضعیت فعلی:</span>
                                <span class="text-xs font-bold" style="color: @(Ticket.Status?.ColorCode ?? "#64748B");">
                                    @(Ticket.Status?.Name ?? "نامشخص")
                                </span>
                            </div>

                            @if (Ticket.Project != null && Ticket.Project.WorkflowId.HasValue)
                            {
                                <SecuredView ResourceKey="/tickets" MinimumType="PermissionType.SystemSection">
                                    <button type="button" @onclick="OpenTransitionModal" class="px-3 py-1 bg-indigo-600 text-white text-[11px] font-bold rounded-xl shadow-2xs hover:bg-indigo-700 transition-colors flex items-center gap-1 focus-ring">
                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                        تغییر وضعیت
                                    </button>
                                </SecuredView>
                            }
                            else
                            {
                                <select value="@Ticket.StatusId" @onchange="UpdateStatusAsync" class="px-2 py-1 rounded-xl border border-slate-200 text-[11px] focus:outline-none font-bold focus-ring">
                                    @if (Statuses != null)
                                    {
                                        @foreach (var status in Statuses)
                                        {
                                            <option value="@status.Id">@status.Name</option>
                                        }
                                    }
                                </select>
                            }
                        </div>
                    </div>

                    <div class="my-1 flex-grow overflow-y-auto space-y-2 custom-scrollbar pr-1">
                        <h4 class="font-bold text-slate-700 text-xs mb-2">تاریخچه انتقالات:</h4>
                        @if (Transitions != null && Transitions.Any())
                        {
                            <div class="relative border-r-2 border-indigo-100 mr-1.5 pr-3 space-y-2">
                                @foreach (var item in Transitions)
                                {
                                    <div class="relative group text-xs">
                                        <div class="absolute -right-[17px] top-1.5 w-2.5 h-2.5 rounded-full bg-indigo-600 border-2 border-white shadow-2xs"></div>

                                        <div class="bg-slate-50/80 p-2.5 rounded-xl border border-slate-100 space-y-1">
                                            <div class="flex items-center justify-between gap-1">
                                                <span class="font-bold text-[11px] text-slate-800 truncate">
                                                    @(string.IsNullOrWhiteSpace(item.TransitionTitle) ? "تغییر وضعیت" : item.TransitionTitle)
                                                </span>
                                                <span class="text-[10px] text-slate-400 dir-ltr shrink-0 font-normal">
                                                    @item.CreatedAt.ToPersianDateTimeString()
                                                </span>
                                            </div>

                                            <div class="flex items-center gap-1 text-[10px]">
                                                <span class="px-1.5 py-0.5 rounded font-bold" style="background-color: @(item.FromStatusColor ?? "#64748B")20; color: @(item.FromStatusColor ?? "#64748B");">
                                                    @(string.IsNullOrWhiteSpace(item.FromStatusName) ? "نامشخص" : item.FromStatusName)
                                                </span>
                                                <svg class="w-3 h-3 text-slate-400 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                                                <span class="px-1.5 py-0.5 rounded font-bold" style="background-color: @(item.ToStatusColor ?? "#64748B")20; color: @(item.ToStatusColor ?? "#64748B");">
                                                    @(string.IsNullOrWhiteSpace(item.ToStatusName) ? "نامشخص" : item.ToStatusName)
                                                </span>
                                            </div>

                                            <div class="text-[10px] text-slate-500 font-normal">
                                                انجام دهنده: <strong class="text-slate-700 font-bold">@(item.UserName ?? "سیستم")</strong>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.Comment))
                                            {
                                                <div class="bg-white p-1.5 rounded-lg border border-slate-100 text-[10px] text-slate-600 leading-snug mt-1 font-normal">
                                                    @item.Comment
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-xs text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                هیچ گام انتقالی ثبت نشده است.
                            </div>
                        }
                    </div>
                </div>

                <div class="border-t border-slate-100 pt-3 space-y-1 text-[11px] text-slate-400 font-medium shrink-0">
                    <div class="flex justify-between">
                        <span>ثبت کننده:</span>
                        <span class="font-bold text-slate-700">@(Ticket.User?.Name ?? "کاربر ناشناس")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>تاریخ ایجاد (تهران):</span>
                        <span class="font-bold text-slate-700 dir-ltr">@Ticket.CreatedAt.ToPersianDateTimeString()</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

