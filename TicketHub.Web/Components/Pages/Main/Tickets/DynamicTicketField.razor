@using Microsoft.AspNetCore.Components.Forms

<div class="@GetGridClass()">
    @switch ((FieldTypeEnum)Field.FieldTypeId)
    {
        case FieldTypeEnum.Text:
            <CustomInput Label="@Field.Name" @bind-Value="FieldValue.Value" Type="text" Placeholder="@Field.Placeholder" />
            break;

        case FieldTypeEnum.Number:
            <CustomInput Label="@Field.Name" @bind-Value="FieldValue.Value" Type="number" Placeholder="@Field.Placeholder" />
            break;

        case FieldTypeEnum.Checkbox:
            <CustomCheckbox Label="@Field.Name" @bind-Value="CheckboxValue" />
            break;

        case FieldTypeEnum.ColorPicker:
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">@Field.Name</label>
                <ColorPicker @bind-Value="FieldValue.Value" Placeholder="@Field.Placeholder" />
            </div>
            break;

        case FieldTypeEnum.TextArea:
            <CustomTextArea Label="@Field.Name" @bind-Value="FieldValue.Value" Placeholder="@Field.Placeholder" />
            break;

        case FieldTypeEnum.Dropdown:
            <SlideSelect TItem="string" TValue="string"
                         Label="@Field.Name"
                         Items="GetOptions()"
                         TextSelector="x => x"
                         ValueSelector="x => x"
                         @bind-Value="FieldValue.Value" />
            break;

        case FieldTypeEnum.MultipleDropdown:
            <MultiSelectDropdown TItem="string" TValue="string"
                                 Label="@Field.Name"
                                 Items="GetOptions()"
                                 DisplaySelector="x => x"
                                 ValueSelector="x => x"
                                 @bind-SelectedValues="SelectedMultipleValues" />
            break;

        case FieldTypeEnum.File:
            <CustomFileUpload Label="@Field.Name"
                              SelectedFiles="InternalBrowserFiles"
                              SelectedFilesChanged="HandleFilesChanged" />
            break;

        case FieldTypeEnum.Date:
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">@Field.Name</label>
                <CustomPersianDatePicker @bind-Value="FieldValue.Value" Placeholder="@Field.Placeholder" />
            </div>
            break;

        default:
            <div class="text-sm text-gray-400">نوع فیلد پشتیبانی نمی‌شود</div>
            break;
    }

    <!-- نمایش خطای ولیدیشن به صورت یکپارچه برای همه فیلدها -->
    <ValidationMessage For="@(() => FieldValue.Value)" class="text-red-500 text-xs mt-1" />
</div>

@code {
    [Parameter, EditorRequired]
    public TicketFieldDto Field { get; set; } = default!;

    [Parameter, EditorRequired]
    public TicketFieldValueDto FieldValue { get; set; } = default!;

    // مدیریت سایز شبکه‌ای (گرید) بر اساس نوع فیلد
    private string GetGridClass()
    {
        var type = (FieldTypeEnum)Field.FieldTypeId;

        // تکست‌اریا و فایل کل عرض فرم (۲ ستون) را پر می‌کنند
        if (type == FieldTypeEnum.TextArea || type == FieldTypeEnum.File)
        {
            return "col-span-1 sm:col-span-2 flex flex-col";
        }

        // بقیه فیلدها فقط ۱ ستون را پر می‌کنند
        return "col-span-1 flex flex-col";
    }

    private List<IBrowserFile> InternalBrowserFiles { get; set; } = new();

    private void HandleFilesChanged(List<IBrowserFile> files)
    {
        InternalBrowserFiles = files;

        if (FieldValue != null)
        {
            FieldValue.PendingUploads = files.Select(f => new FileUploadDto
            {
                FileName = f.Name,
                ContentType = f.ContentType,
                Size = f.Size,
                Content = f.OpenReadStream(10 * 1024 * 1024)
            }).ToList();
        }
    }

    private bool CheckboxValue
    {
        get => bool.TryParse(FieldValue.Value, out var val) && val;
        set => FieldValue.Value = value.ToString().ToLower();
    }

    private List<string> GetOptions()
    {
        return string.IsNullOrWhiteSpace(Field.Options)
            ? new List<string>()
            : Field.Options.Split(',', StringSplitOptions.RemoveEmptyEntries)
                           .Select(o => o.Trim())
                           .ToList();
    }

    private List<string> SelectedMultipleValues
    {
        get => string.IsNullOrWhiteSpace(FieldValue.Value)
            ? new List<string>()
            : FieldValue.Value.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
        set => FieldValue.Value = string.Join(",", value);
    }

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(FieldValue.Value) && !string.IsNullOrWhiteSpace(Field.DefaultValue))
        {
            FieldValue.Value = Field.DefaultValue;
        }
    }
}