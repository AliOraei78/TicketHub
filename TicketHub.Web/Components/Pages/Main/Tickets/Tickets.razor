@page "/tickets"
@rendermode InteractiveServer
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@namespace TicketHub.Web.Components.Pages.Main.Tickets

<PageTitle>مدیریت تیکت‌ها | سامانه تیکتینگ</PageTitle>

<div class="w-full flex flex-col gap-2.5 flex-1 select-none" dir="rtl">
    <!-- Centered Cyber Operations Master Banner -->
    <div class="relative overflow-hidden rounded-xl bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 p-2.5 sm:p-3 shadow-[0_0_25px_rgba(8,13,26,0.85)] flex flex-col gap-2">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-cyan-500/20 via-indigo-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Section: Centered Title, Centered Subtitle & Centered Create CTA -->
        <div class="relative z-10 flex flex-col items-center justify-center text-center gap-1.5">
            <div class="space-y-0.5 flex flex-col items-center">
                <h1 class="text-lg sm:text-xl font-black tracking-tight text-white drop-shadow-[0_2px_10px_rgba(255,255,255,0.25)] leading-tight flex items-center justify-center gap-1.5 flex-wrap text-center">
                    <span class="bg-gradient-to-r from-cyan-300 via-indigo-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_12px_rgba(56,189,248,0.6)]">مدیریت تیکت‌ها</span>
                </h1>
                <p class="text-slate-300/90 text-[10px] sm:text-[11px] font-medium tracking-wide flex items-center justify-center gap-1.5 flex-wrap text-center">
                    <span>⚡ پایش زنده وضعیت‌ها</span>
                    <span class="text-cyan-400/50">•</span>
                    <span>رهگیری هوشمند کوئست‌ها</span>
                    <span class="text-cyan-400/50">•</span>
                    <span>پشتیبانی سریع بازیکنان</span>
                </p>
            </div>

            <div class="flex items-center justify-center">
                <button @onclick="OpenCreateModal"
                        class="btn-cyber-primary text-xs py-1 px-4 focus-ring flex items-center gap-1.5 shadow-[0_0_12px_rgba(56,189,248,0.25)]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 animate-pulse text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>ثبت تیکت جدید</span>
                </button>
            </div>
        </div>

        <!-- Bottom Row: 6 Holographic Telemetry Cards spanning comfortably -->
        <div class="relative z-10 pt-1.5 border-t border-white/[0.08] grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-1.5">
            <!-- 1. All Tickets (Water) -->
            <div class="telemetry-pill-segment py-1 px-2" style="--seg-border: rgba(56, 189, 248, 0.5); --seg-glow: rgba(56, 189, 248, 0.25);">
                <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-6 h-6 rounded-md bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] text-cyan-300/90 font-bold truncate">کل تیکت‌ها</span>
                        <span class="text-[8px] font-mono text-cyan-400/60 uppercase">🌊 ALL</span>
                    </div>
                </div>
                <span class="text-sm font-black font-mono text-white drop-shadow-[0_0_6px_rgba(56,189,248,0.7)] px-1">
                    @TicketState.Value.Telemetry.TotalTickets
                </span>
            </div>

            <!-- 2. New / Initial (Lightning) -->
            <div class="telemetry-pill-segment py-1 px-2" style="--seg-border: rgba(245, 158, 11, 0.5); --seg-glow: rgba(245, 158, 11, 0.25);">
                <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-6 h-6 rounded-md bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-amber-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] text-amber-300/90 font-bold truncate">اقدام نشده</span>
                        <span class="text-[8px] font-mono text-amber-400/60 uppercase">⚡ NEW</span>
                    </div>
                </div>
                <span class="text-sm font-black font-mono text-amber-300 drop-shadow-[0_0_6px_rgba(245,158,11,0.7)] px-1">
                    @TicketState.Value.Telemetry.NewTicketsCount
                </span>
            </div>

            <!-- 3. In Action / Review (Toxic Acid) -->
            <div class="telemetry-pill-segment py-1 px-2" style="--seg-border: rgba(16, 185, 129, 0.5); --seg-glow: rgba(16, 185, 129, 0.25);">
                <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-6 h-6 rounded-md bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] text-emerald-300/90 font-bold truncate">در حال بررسی</span>
                        <span class="text-[8px] font-mono text-emerald-400/60 uppercase">🧪 ACTIVE</span>
                    </div>
                </div>
                <span class="text-sm font-black font-mono text-emerald-300 drop-shadow-[0_0_6px_rgba(16,185,129,0.7)] px-1">
                    @TicketState.Value.Telemetry.InProgressCount
                </span>
            </div>

            <!-- 4. Critical Priority (Purple Epic) -->
            <div class="telemetry-pill-segment py-1 px-2" style="--seg-border: rgba(168, 85, 247, 0.5); --seg-glow: rgba(168, 85, 247, 0.25);">
                <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-6 h-6 rounded-md bg-purple-500/15 border border-purple-400/30 flex items-center justify-center text-purple-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] text-purple-300/90 font-bold truncate">اولویت بحرانی</span>
                        <span class="text-[8px] font-mono text-purple-400/60 uppercase">⚡ EPIC</span>
                    </div>
                </div>
                <span class="text-sm font-black font-mono text-purple-300 drop-shadow-[0_0_6px_rgba(168,85,247,0.7)] px-1">
                    @TicketState.Value.Telemetry.CriticalCount
                </span>
            </div>

            <!-- 5. Overdue (Fire Raid) -->
            <div class="telemetry-pill-segment py-1 px-2" style="--seg-border: rgba(244, 63, 94, 0.5); --seg-glow: rgba(244, 63, 94, 0.25);">
                <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-6 h-6 rounded-md bg-rose-500/15 border border-rose-400/30 flex items-center justify-center text-rose-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] text-rose-300/90 font-bold truncate">سررسید گذشته</span>
                        <span class="text-[8px] font-mono text-rose-400/60 uppercase">🔥 OVERDUE</span>
                    </div>
                </div>
                <span class="text-sm font-black font-mono text-rose-400 drop-shadow-[0_0_6px_rgba(244,63,94,0.7)] px-1">
                    @TicketState.Value.Telemetry.OverdueCount
                </span>
            </div>

            <!-- 6. Resolved / Closed (Quantum Smoke) -->
            <div class="telemetry-pill-segment py-1 px-2" style="--seg-border: rgba(148, 163, 184, 0.5); --seg-glow: rgba(148, 163, 184, 0.25);">
                <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-6 h-6 rounded-md bg-slate-500/15 border border-slate-400/30 flex items-center justify-center text-slate-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-[10px] text-slate-300/90 font-bold truncate">خاتمه یافته</span>
                        <span class="text-[8px] font-mono text-slate-400/60 uppercase">💨 CLOSED</span>
                    </div>
                </div>
                <span class="text-sm font-black font-mono text-slate-200 drop-shadow-[0_0_6px_rgba(203,213,225,0.7)] px-1">
                    @TicketState.Value.Telemetry.ResolvedCount
                </span>
            </div>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <ListFilterToolbar @bind-SearchTerm="SearchQuery"
                       SearchPlaceholder="جستجو در عنوان تیکت‌ها..."
                       ItemName="تیکت"
                       @bind-PageSize="PageSize"
                       PageSizeOptions="@(new List<int> { 9, 18, 27, 36 })">
        <div class="w-full sm:w-40 md:w-44">
            <MultiSelectDropdown TItem="ProjectDto" TValue="int"
                                  Placeholder="پروژه..."
                                  Items="TicketState.Value.AvailableProjects"
                                  @bind-SelectedValues="SelectedProjectIds"
                                  ValueSelector="p => p.Id"
                                  DisplaySelector="p => p.Name" />
        </div>
        <div class="w-full sm:w-40 md:w-44">
            <MultiSelectDropdown TItem="StatusDto" TValue="int"
                                  Placeholder="وضعیت..."
                                  Items="TicketState.Value.AvailableStatuses"
                                  @bind-SelectedValues="SelectedStatusIds"
                                  ValueSelector="s => s.Id"
                                  DisplaySelector="s => s.Name" />
        </div>
        <div class="w-full sm:w-40 md:w-44">
            <MultiSelectDropdown TItem="PriorityDto" TValue="int"
                                  Placeholder="اولویت..."
                                  Items="TicketState.Value.AvailablePriorities"
                                  @bind-SelectedValues="SelectedPriorityIds"
                                  ValueSelector="p => p.Id"
                                  DisplaySelector="p => p.Name" />
        </div>
    </ListFilterToolbar>

    @if (SelectedTicketIds.Any())
    {
        <div class="w-full flex justify-end fade-in-item">
            <BulkActionToolbar SelectedCount="SelectedTicketIds.Count"
                               OnCancel="ClearSelection"
                               OnDelete="OpenBulkDeleteModal" />
        </div>
    }

    <!-- Tickets List (3 Columns x 3 Rows = 9 Tickets) -->
    @if (TicketState.Value.IsLoading)
    {
        <div class="flex justify-center items-center py-16">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-cyan-400"></div>
        </div>
    }
    else
    {
        <StatefulDataView Items="FilteredTickets" EmptyMessage="هیچ تیکتی یافت نشد." ContainerClass="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2.5">
            <ItemTemplate Context="ticket">
                <TicketCard Ticket="ticket"
                            OnClick="NavigateToDetails"
                            OnActionClick="HandleActionClick"
                            OnDeleteClick="HandleSingleDelete"
                            IsSelected="SelectedTicketIds.Contains(ticket.Id)"
                            IsSelectedChanged="@(val => ToggleTicketSelection(ticket.Id, val))" />
            </ItemTemplate>
        </StatefulDataView>

        <Pagination CurrentPage="TicketState.Value.CurrentPage"
                    PageSize="TicketState.Value.PageSize"
                    TotalItems="TicketState.Value.TotalTickets"
                    ItemName="تیکت"
                    OnNext="NextPage"
                    OnPrevious="PreviousPage" />
    }
</div>

<!-- Create Ticket Modal -->
<TicketFormModal IsOpen="IsCreateModalOpen"
                 Model="NewTicket"
                 Projects="TicketState.Value.AvailableProjects"
                 Priorities="TicketState.Value.AvailablePriorities"
                 Categories="TicketState.Value.AvailableCategories"
                 DynamicFields="TicketState.Value.DynamicFields"
                 OnCategoryChanged="HandleCategoryChanged"
                 OnSubmit="HandleCreateTicket"
                 OnCancel="CloseCreateModal" />

<!-- Transition Modal -->
<TicketTransitionModal @ref="TransitionModal" OnSaved="HandleTransitionSaved" />

<!-- Confirm Delete Modal -->
<ConfirmDeleteModal IsOpen="IsDeleteModalOpen"
                    Title="حذف تیکت"
                    Description="@DeleteModalDescription"
                    OnConfirm="ConfirmDeleteAsync"
                    OnCancel="CancelDelete" />