@page "/tickets"
@rendermode InteractiveServer
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@namespace TicketHub.Web.Components.Pages.Main.Tickets

<PageTitle>مدیریت تیکت‌ها | سامانه تیکتینگ</PageTitle>

<div class="w-full flex flex-col gap-5 flex-1 select-none" dir="rtl">
    <PageHeader Title="سامانه مدیریت تیکت‌ها"
                Description="تیکت‌های پشتیبانی خود را مشاهده، فیلتر و مدیریت کنید."
                ButtonText="ثبت تیکت جدید"
                ButtonThemeClass="bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/20"
                OnActionClick="OpenCreateModal">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-600 drop-shadow-xs" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
            </svg>
        </Icon>
    </PageHeader>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <QuickStatsCard Title="کل تیکت‌ها" 
                        Value="@TicketState.Value.TotalTickets.ToString()"
                        ElementType="water"
                        BadgeText="🌊 ALL"
                        BadgeClass="bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(56,189,248,0.6)]"
                        IconThemeClass="bg-cyan-500/20 text-cyan-300 border-cyan-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
            </Icon>
        </QuickStatsCard>

        <QuickStatsCard Title="اقدام نشده"
                        Value="@TicketState.Value.Tickets.Count(t => t.WorkflowStatus?.IsInitial == true).ToString()"
                        ElementType="lightning"
                        BadgeText="⚡ NEW"
                        BadgeClass="bg-amber-500/20 text-amber-300 border border-amber-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(250,204,21,0.6)]"
                        IconThemeClass="bg-cyan-500/20 text-cyan-300 border-cyan-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </Icon>
        </QuickStatsCard>

        <QuickStatsCard Title="در حال بررسی"
                        Value="@TicketState.Value.Tickets.Count(t => t.WorkflowStatus != null && !t.WorkflowStatus.IsInitial).ToString()"
                        ElementType="toxic"
                        BadgeText="🧪 IN ACTION"
                        BadgeClass="bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(34,197,94,0.6)]"
                        IconThemeClass="bg-emerald-500/20 text-emerald-300 border-emerald-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
            </Icon>
        </QuickStatsCard>

        <QuickStatsCard Title="اولویت بحرانی"
                        Value="@TicketState.Value.Tickets.Count(t => t.Priority != null && t.Priority.Level > 4).ToString()"
                        ElementType="fire"
                        BadgeText="🔥 BOSS"
                        BadgeClass="bg-rose-500/20 text-rose-300 border border-rose-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(239,68,68,0.6)]"
                        IconThemeClass="bg-rose-500/20 text-rose-300 border-rose-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </Icon>
        </QuickStatsCard>

        <QuickStatsCard Title="سررسید گذشته"
                        Value="@TicketState.Value.Tickets.Count(t => t.IsOverdue).ToString()"
                        ElementType="fire"
                        BadgeText="⏰ OVERDUE"
                        BadgeClass="bg-rose-500/20 text-rose-300 border border-rose-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(239,68,68,0.6)]"
                        IconThemeClass="bg-rose-500/20 text-rose-300 border-rose-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </Icon>
        </QuickStatsCard>
    </div>

    <!-- Filter Toolbar -->
    <ListFilterToolbar @bind-SearchTerm="SearchQuery"
                       SearchPlaceholder="جستجو در عنوان تیکت‌ها..."
                       ItemName="تیکت"
                       @bind-PageSize="PageSize"
                       PageSizeOptions="@(new List<int> { 6, 12, 18, 24 })">
        <div class="w-full sm:w-56">
            <MultiSelectDropdown TItem="ProjectDto" TValue="int"
                                  Placeholder="پروژه..."
                                  Items="TicketState.Value.AvailableProjects"
                                  @bind-SelectedValues="SelectedProjectIds"
                                  ValueSelector="p => p.Id"
                                  DisplaySelector="p => p.Name" />
        </div>
        <div class="w-full sm:w-56">
            <MultiSelectDropdown TItem="StatusDto" TValue="int"
                                  Placeholder="وضعیت..."
                                  Items="TicketState.Value.AvailableStatuses"
                                  @bind-SelectedValues="SelectedStatusIds"
                                  ValueSelector="s => s.Id"
                                  DisplaySelector="s => s.Name" />
        </div>
        <div class="w-full sm:w-56">
            <MultiSelectDropdown TItem="PriorityDto" TValue="int"
                                  Placeholder="اولویت..."
                                  Items="TicketState.Value.AvailablePriorities"
                                  @bind-SelectedValues="SelectedPriorityIds"
                                  ValueSelector="p => p.Id"
                                  DisplaySelector="p => p.Name" />
        </div>
    </ListFilterToolbar>

    @if (SelectedTicketIds.Any())
    {
        <div class="w-full flex justify-end fade-in-item">
            <BulkActionToolbar SelectedCount="SelectedTicketIds.Count"
                               OnCancel="ClearSelection"
                               OnDelete="OpenBulkDeleteModal" />
        </div>
    }

    <!-- Tickets List -->
    @if (TicketState.Value.IsLoading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
        </div>
    }
    else
    {
        <StatefulDataView Items="FilteredTickets" EmptyMessage="هیچ تیکتی یافت نشد." ContainerClass="grid grid-cols-1 md:grid-cols-2 gap-4">
            <ItemTemplate Context="ticket">
                <TicketCard Ticket="ticket"
                            OnClick="NavigateToDetails"
                            OnActionClick="HandleActionClick"
                            OnDeleteClick="HandleSingleDelete"
                            IsSelected="SelectedTicketIds.Contains(ticket.Id)"
                            IsSelectedChanged="@(val => ToggleTicketSelection(ticket.Id, val))" />
            </ItemTemplate>
        </StatefulDataView>

        <Pagination CurrentPage="TicketState.Value.CurrentPage"
                    PageSize="TicketState.Value.PageSize"
                    TotalItems="TicketState.Value.TotalTickets"
                    ItemName="تیکت"
                    OnNext="NextPage"
                    OnPrevious="PreviousPage" />
    }
</div>

<!-- Create Ticket Modal -->
<TicketFormModal IsOpen="IsCreateModalOpen"
                 Model="NewTicket"
                 Projects="TicketState.Value.AvailableProjects"
                 Priorities="TicketState.Value.AvailablePriorities"
                 Categories="TicketState.Value.AvailableCategories"
                 DynamicFields="TicketState.Value.DynamicFields"
                 OnCategoryChanged="HandleCategoryChanged"
                 OnSubmit="HandleCreateTicket"
                 OnCancel="CloseCreateModal" />

<!-- Transition Modal -->
<TicketTransitionModal @ref="TransitionModal" OnSaved="HandleTransitionSaved" />

<!-- Confirm Delete Modal -->
<ConfirmDeleteModal IsOpen="IsDeleteModalOpen"
                    Title="حذف تیکت"
                    Description="@DeleteModalDescription"
                    OnConfirm="ConfirmDeleteAsync"
                    OnCancel="CancelDelete" />