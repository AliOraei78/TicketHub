

<ModalDialog IsOpen="@IsOpen"
             Title="ایجاد تیکت پشتیبانی جدید"
             OnClose="HandleCancel"
             MaxWidthClass="max-w-3xl w-full">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mb-4 p-3 bg-red-50 text-red-600 text-sm rounded-xl border border-red-100 whitespace-pre-line leading-relaxed font-medium">
            @ErrorMessage
        </div>
    }

    <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit" class="p-6 space-y-4 max-h-[80vh] flex flex-col">
       
        <div class="overflow-y-auto pr-2 pb-2 flex-1">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">عنوان تیکت</label>
                <InputText @bind-Value="Model.Title" class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 text-sm smooth-transition" placeholder="یک عنوان کوتاه بنویسید" required />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <SlideSelect TItem="PriorityDto" TValue="int?"
                                 Label="اولویت"
                                 Placeholder="انتخاب اولویت..."
                                 Items="Priorities"
                                 @bind-Value="Model.PriorityId"
                                 ValueSelector="p => (int?)p.Id"
                                 TextSelector="p => p.Name"
                                 AllowClear="false" />
                </div>

                <div>
                    <SlideSelect TItem="ProjectDto" TValue="int"
                                 Label="پروژه مربوطه"
                                 Placeholder="انتخاب پروژه..."
                                 Items="Projects"
                                 @bind-Value="Model.ProjectId"
                                 ValueSelector="p => p.Id"
                                 TextSelector="p => p.Name"
                                 AllowClear="false" />
                </div>

                <div>
                    <SlideSelect TItem="CategoryDto" TValue="int?"
                                 Label="دسته‌بندی"
                                 Placeholder="انتخاب دسته‌بندی..."
                                 Items="Categories"
                                 Value="@Model.CategoryId"
                                 ValueChanged="HandleCategoryChange"
                                 ValueSelector="c => c.Id"
                                 TextSelector="c => c.Name"
                                 AllowClear="false" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">توضیحات تیکت</label>
                <InputTextArea @bind-Value="Model.Description" rows="4" class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 text-sm smooth-transition" placeholder="جزئیات مشکل یا درخواست خود را بنویسید..." required />
            </div>

            @if (DynamicFields?.Any() == true)
            {
                <div class="mt-6 pt-4 border-t border-gray-100">
                    <h3 class="text-sm font-medium text-gray-700 mb-4">فیلدهای اختصاصی دسته‌بندی</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
                        @foreach (var field in DynamicFields.OrderBy(f => f.SortOrder))
                        {
                            <DynamicTicketField Field="field" FieldValue="GetOrCreateFieldValue(field.Id)" />
                        }
                    </div>
                </div>
            }

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100 mt-auto">
                <button type="button" @onclick="HandleCancel" class="smooth-transition px-5 py-2 rounded-xl text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200">انصراف</button>
                <button type="submit" class="smooth-transition px-5 py-2 rounded-xl text-sm font-medium bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-500/10" disabled="@(Model.ProjectId == 0)">ثبت تیکت</button>
            </div>
        </div>
    </EditForm>

</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public TicketDto Model { get; set; } = default!;
    [Parameter, EditorRequired] public IEnumerable<ProjectDto> Projects { get; set; } = default!;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter, EditorRequired] public IEnumerable<PriorityDto> Priorities { get; set; } = default!;
    [Parameter, EditorRequired] public IEnumerable<CategoryDto> Categories { get; set; } = default!;
    [Parameter] public IEnumerable<TicketFieldDto> DynamicFields { get; set; } = Array.Empty<TicketFieldDto>();
    [Parameter] public EventCallback<int?> OnCategoryChanged { get; set; }

    private async Task HandleValidSubmit()
    {
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync();
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
    }

    private async Task HandleCategoryChange(int? categoryId)
    {
        Model.CategoryId = categoryId;
        if (OnCategoryChanged.HasDelegate)
        {
            await OnCategoryChanged.InvokeAsync(categoryId);
        }
    }

    private TicketFieldValueDto GetOrCreateFieldValue(int fieldId)
    {
        if (Model.TicketFieldValues == null) Model.TicketFieldValues = new List<TicketFieldValueDto>();

        var val = Model.TicketFieldValues.FirstOrDefault(x => x.TicketFieldId == fieldId);
        if (val == null)
        {
            val = new TicketFieldValueDto { TicketFieldId = fieldId };
            Model.TicketFieldValues.Add(val);
        }
        return val;
    }
}