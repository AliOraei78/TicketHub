@namespace TicketHub.Web.Components.Pages.Main.Tickets
@using Microsoft.AspNetCore.Components.Sections
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

@if (IsOpen)
{
    <SectionContent SectionName="RootModal">
        <div class="fixed inset-0 z-[99999] flex justify-center items-start pt-6 sm:pt-10 md:pt-12 p-4 sm:p-6 overflow-hidden bg-slate-950/70 backdrop-blur-md fade-in-item">
            <div class="absolute inset-0" @onclick="HandleCancel"></div>

            <div class="relative z-[99999] w-full max-w-3xl max-h-[85vh] bg-white rounded-3xl shadow-2xl flex flex-col modal-content-animate border border-slate-200/80 my-0 select-none" dir="rtl">

                <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100 flex-shrink-0">
                    <h2 class="text-xl font-bold text-slate-800">ایجاد تیکت پشتیبانی جدید</h2>
                    <button type="button" @onclick="HandleCancel" class="p-2 text-slate-400 hover:text-rose-500 hover:bg-rose-50 rounded-xl transition-colors focus-ring">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                <EditForm Model="@Model" OnSubmit="HandleSubmit" novalidate class="flex flex-col overflow-hidden flex-1">
                    <FluentValidationValidator />

                    <div class="overflow-y-auto p-6 pb-28 space-y-4 custom-scrollbar max-h-[70vh]">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1.5">عنوان تیکت</label>
                            <InputText @bind-Value="Model.Title" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="یک عنوان کوتاه بنویسید" />
                            <ValidationMessage For="@(() => Model.Title)" class="text-red-500 text-rose-500 text-xs mt-1" />
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-4">
                            <div>
                                <SlideSelect TItem="PriorityDto" TValue="int?"
                                             Label="اولویت"
                                             Placeholder="انتخاب اولویت..."
                                             Items="Priorities"
                                             @bind-Value="Model.PriorityId"
                                             ValueSelector="p => (int?)p.Id"
                                             TextSelector="p => p.Name"
                                             AllowClear="false" />
                                <ValidationMessage For="@(() => Model.PriorityId)" class="text-red-500 text-rose-500 text-xs mt-1" />
                            </div>

                            <div>
                                <SlideSelect TItem="ProjectDto" TValue="int"
                                             Label="پروژه مربوطه"
                                             Placeholder="انتخاب پروژه..."
                                             Items="Projects"
                                             Value="@Model.ProjectId"
                                             ValueChanged="HandleProjectChange"
                                             ValueSelector="p => p.Id"
                                             TextSelector="p => p.Name"
                                             AllowClear="false" />
                                <ValidationMessage For="@(() => Model.ProjectId)" class="text-red-500 text-rose-500 text-xs mt-1" />
                            </div>

                            <div>
                                <SlideSelect TItem="CategoryDto" TValue="int?"
                                             Label="دسته‌بندی"
                                             Placeholder="@(Model.ProjectId > 0 ? "انتخاب دسته‌بندی..." : "ابتدا پروژه را انتخاب کنید...")"
                                             Items="FilteredCategories"
                                             Value="@Model.CategoryId"
                                             ValueChanged="HandleCategoryChange"
                                             ValueSelector="c => c.Id"
                                             TextSelector="c => c.Name"
                                             AllowClear="false" />
                                <ValidationMessage For="@(() => Model.CategoryId)" class="text-red-500 text-rose-500 text-xs mt-1" />
                            </div>
                        </div>

                        <div class="mt-4">
                            <label class="block text-xs font-semibold text-slate-700 mb-1.5">توضیحات تیکت</label>
                            <InputTextArea @bind-Value="Model.Description" rows="4" class="w-full px-4 py-3 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="جزئیات مشکل یا درخواست خود را بنویسید..." />
                            <ValidationMessage For="@(() => Model.Description)" class="text-red-500 text-rose-500 text-xs mt-1" />
                        </div>

                        @if (DynamicFieldModels.Any())
                        {
                            <DynamicFields Fields="DynamicFieldModels" ValidationErrors="DynamicValidationErrors" />
                        }
                    </div>

                    <div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 flex-shrink-0 rounded-b-3xl">
                        <button type="button" @onclick="HandleCancel" class="px-6 py-2.5 rounded-xl text-sm font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs focus-ring">انصراف</button>
                        <button type="submit" class="px-6 py-2.5 rounded-xl text-sm font-bold bg-indigo-600 text-white hover:bg-indigo-700 shadow-lg shadow-indigo-500/20 transition-all focus-ring">ثبت تیکت</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </SectionContent>
}