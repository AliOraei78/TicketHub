@if (IsOpen)
{
    <style>
        main {
            overflow: hidden !important;
        }</style>

        <div class="fixed inset-0 z-[9990] flex justify-center items-start pt-4 sm:pt-8 p-4 sm:p-6 overflow-hidden">

            <div class="absolute inset-0 modal-backdrop-animate backdrop-blur-sm bg-slate-900/40" @onclick="HandleCancel"></div>

            <div class="relative z-[9999] w-full max-w-3xl bg-white rounded-3xl shadow-2xl flex flex-col modal-content-animate" dir="rtl">

                <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100 flex-shrink-0">
                    <h2 class="text-xl font-bold text-gray-800">ایجاد تیکت پشتیبانی جدید</h2>
                    <button type="button" @onclick="HandleCancel" class="p-2 text-gray-400 hover:text-rose-500 hover:bg-rose-50 rounded-xl transition-colors">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit" novalidate class="flex flex-col overflow-hidden">
                    <FluentValidationValidator />

                    <div class="overflow-y-auto p-6 space-y-4 custom-scrollbar max-h-[70vh]">

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">عنوان تیکت</label>
                            <InputText @bind-Value="Model.Title" class="w-full h-[46px] px-4 border border-gray-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-sm bg-gray-50 hover:bg-white focus:bg-white text-sm" placeholder="یک عنوان کوتاه بنویسید" required />
                            <ValidationMessage For="@(() => Model.Title)" class="text-red-500 text-xs mt-1" />
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-4">
                            <div>
                                <SlideSelect TItem="PriorityDto" TValue="int?"
                                             Label="اولویت"
                                             Placeholder="انتخاب اولویت..."
                                             Items="Priorities"
                                             @bind-Value="Model.PriorityId"
                                             ValueSelector="p => (int?)p.Id"
                                             TextSelector="p => p.Name"
                                             AllowClear="false" />
                                <ValidationMessage For="@(() => Model.PriorityId)" class="text-red-500 text-xs mt-1" />
                            </div>

                            <div>
                                <SlideSelect TItem="ProjectDto" TValue="int"
                                             Label="پروژه مربوطه"
                                             Placeholder="انتخاب پروژه..."
                                             Items="Projects"
                                             @bind-Value="Model.ProjectId"
                                             ValueSelector="p => p.Id"
                                             TextSelector="p => p.Name"
                                             AllowClear="false" />
                                <ValidationMessage For="@(() => Model.ProjectId)" class="text-red-500 text-xs mt-1" />
                            </div>

                            <div>
                                <SlideSelect TItem="CategoryDto" TValue="int?"
                                             Label="دسته‌بندی"
                                             Placeholder="انتخاب دسته‌بندی..."
                                             Items="Categories"
                                             Value="@Model.CategoryId"
                                             ValueChanged="HandleCategoryChange"
                                             ValueSelector="c => c.Id"
                                             TextSelector="c => c.Name"
                                             AllowClear="false" />
                                <ValidationMessage For="@(() => Model.CategoryId)" class="text-red-500 text-xs mt-1" />
                            </div>
                        </div>

                        <div class="mt-4">
                            <label class="block text-sm font-medium text-gray-700 mb-2">توضیحات تیکت</label>
                            <InputTextArea @bind-Value="Model.Description" rows="4" class="w-full px-4 py-3 border border-gray-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-sm bg-gray-50 hover:bg-white focus:bg-white text-sm" placeholder="جزئیات مشکل یا درخواست خود را بنویسید..." required />
                            <ValidationMessage For="@(() => Model.Description)" class="text-red-500 text-xs mt-1" />
                        </div>

                        @if (DynamicFieldModels.Any())
                        {
                            <DynamicFields Fields="DynamicFieldModels" />
                        }
                    </div>

                    <!-- فوتر دکمه‌ها -->
                    <div class="p-5 border-t border-gray-100 bg-gray-50 flex justify-end gap-3 flex-shrink-0 rounded-b-3xl">
                        <button type="button" @onclick="HandleCancel" class="px-6 py-2.5 rounded-xl text-sm font-bold bg-white border border-gray-200 text-gray-700 hover:bg-gray-100 transition-colors shadow-sm">انصراف</button>
                        <button type="submit" class="px-6 py-2.5 rounded-xl text-sm font-bold bg-indigo-600 text-white hover:bg-indigo-700 shadow-lg shadow-indigo-500/20 transition-all">ثبت تیکت</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public TicketDto Model { get; set; } = default!;
    [Parameter, EditorRequired] public IEnumerable<ProjectDto> Projects { get; set; } = default!;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter, EditorRequired] public IEnumerable<PriorityDto> Priorities { get; set; } = default!;
    [Parameter, EditorRequired] public IEnumerable<CategoryDto> Categories { get; set; } = default!;
    [Parameter] public IEnumerable<TicketFieldDto> DynamicFields { get; set; } = Array.Empty<TicketFieldDto>();
    [Parameter] public EventCallback<int?> OnCategoryChanged { get; set; }

    private List<DynamicFieldModel> DynamicFieldModels { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (DynamicFields != null && DynamicFieldModels.Count != DynamicFields.Count())
        {
            DynamicFieldModels = DynamicFields.Select(f => new DynamicFieldModel
            {
                OriginalFieldId = f.Id,
                Name = f.Name,
                Placeholder = f.Placeholder,
                SortOrder = f.SortOrder,
                DefaultValue = f.DefaultValue,
                IsRequired = f.IsRequired,
                Options = f.Options,
                FieldTypeId = f.FieldTypeId,
                Value = Model.FieldValues?.FirstOrDefault(x => x.TicketFieldId == f.Id)?.Value ?? string.Empty
            }).ToList();
        }
    }

    private void MapDynamicFieldsToModel()
    {
        Model.FieldValues = DynamicFieldModels.Select(df => new TicketFieldValueDto
        {
            TicketFieldId = df.OriginalFieldId,
            IsRequired = df.IsRequired,
            FieldName = df.Name,
            Value = df.Value,
            PendingUploads = df.PendingUploads
        }).ToList();
    }

    private async Task HandleValidSubmit()
    {
        MapDynamicFieldsToModel();
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync();
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
    }

    private async Task HandleCategoryChange(int? categoryId)
    {
        Model.CategoryId = categoryId;
        if (OnCategoryChanged.HasDelegate)
        {
            await OnCategoryChanged.InvokeAsync(categoryId);
        }
    }
}