@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<ModalDialog IsOpen="@IsOpen"
             Title="ایجاد تیکت پشتیبانی جدید"
             OnClose="HandleCancel"
             MaxWidthClass="max-w-lg">

    <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit" class="p-6 space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">عنوان تیکت</label>
            <InputText @bind-Value="Model.Title" class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 text-sm smooth-transition" placeholder="یک عنوان کوتاه بنویسید" required />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">اولویت</label>
                <InputSelect @bind-Value="Model.PriorityId" class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 text-sm smooth-transition">
                    <option value="1">Low (کم)</option>
                    <option value="2">Medium (متوسط)</option>
                    <option value="3">High (زیاد)</option>
                    <option value="4">Critical (بحرانی)</option>
                </InputSelect>
            </div>

            <div>
                <SlideSelect TItem="ProjectDto" TValue="int"
                             Label="پروژه مربوطه"
                             Placeholder="انتخاب پروژه..."
                             Items="Projects"
                             @bind-Value="Model.ProjectId"
                             ValueSelector="p => p.Id"
                             TextSelector="p => p.Name"
                             AllowClear="false" />
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">توضیحات تیکت</label>
            <InputTextArea @bind-Value="Model.Description" rows="4" class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 text-sm smooth-transition" placeholder="جزئیات مشکل یا درخواست خود را بنویسید..." required />
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
            <button type="button" @onclick="HandleCancel" class="smooth-transition px-5 py-2 rounded-xl text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200">انصراف</button>
            <button type="submit" class="smooth-transition px-5 py-2 rounded-xl text-sm font-medium bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-500/10" disabled="@(Model.ProjectId == 0)">ثبت تیکت</button>
        </div>
    </EditForm>

</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public TicketDto Model { get; set; } = default!;
    [Parameter, EditorRequired] public IEnumerable<ProjectDto> Projects { get; set; } = default!;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleValidSubmit()
    {
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync();
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
    }
}