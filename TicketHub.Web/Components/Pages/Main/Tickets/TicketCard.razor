

@using TicketHub.Core.Common
@using TicketHub.Web.Components.Layout.Shared

<div @onclick="HandleClick" class="cursor-pointer smooth-transition bg-white p-5 rounded-2xl shadow-sm border flex flex-col group h-full relative overflow-hidden @(IsSelected ? "border-blue-500 ring-2 ring-blue-100 shadow-md" : "border-gray-100 hover:shadow-lg hover:border-blue-200 hover:-translate-y-1")">
    <div class="flex items-start gap-4 w-full mb-4">
        <div class="p-3 rounded-xl bg-gray-50 text-gray-400 group-hover:bg-blue-50 group-hover:text-blue-600 smooth-transition flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
        </div>
        <div class="flex-grow">
            <h4 class="font-bold text-gray-800 text-lg group-hover:text-blue-600 smooth-transition line-clamp-1">@Ticket.Title</h4>
            <p class="text-sm text-gray-500 mt-1 line-clamp-2">@Ticket.Description</p>
            <div class="flex flex-wrap gap-4 mt-2 text-xs text-gray-400">
                <span class="text-indigo-600 font-medium">پروژه: @(Ticket.Project?.Name ?? "عمومی")</span>
            </div>
        </div>

        <label class="cursor-pointer relative z-20 flex-shrink-0" @onclick:stopPropagation="true">
            <input type="checkbox" class="peer sr-only" checked="@IsSelected" @onchange="ToggleSelection" />
            <div class="w-6 h-6 rounded-lg border-2 border-gray-300 peer-checked:bg-blue-600 peer-checked:border-blue-600 transition-all flex items-center justify-center">
                <svg class="w-4 h-4 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
            </div>
        </label>
    </div>

    <div class="mt-auto flex items-center justify-between text-xs border-t border-gray-100 pt-3 gap-2">
        <div class="flex items-center text-gray-500 whitespace-nowrap flex-shrink-0">
            <span class="flex items-center" title="تاریخ ایجاد">
                <svg class="h-4 w-4 ml-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                @Ticket.CreatedAt.ToPersianDateTimeString()
            </span>
        </div>
        
        <div class="flex items-center justify-end gap-2 min-w-0 flex-grow">
            <span class="px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap truncate max-w-[120px] sm:max-w-[160px] text-center"
                  style="background-color: @(Ticket.Priority?.ColorCode ?? "#6B7280")20; color: @(Ticket.Priority?.ColorCode ?? "#6B7280");"
                  title="@(Ticket.Priority?.Name ?? "نامشخص")">
                @(Ticket.Priority?.Name ?? "نامشخص")
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap truncate max-w-[120px] sm:max-w-[200px] text-center"
                  style="background-color: @(Ticket.Status?.ColorCode ?? "#6B7280")20; color: @(Ticket.Status?.ColorCode ?? "#6B7280");"
                  title="@(Ticket.Status?.Name ?? "نامشخص")">
                @(Ticket.Status?.Name ?? "نامشخص")
            </span>
            
            <SecuredView ResourceKey="/tickets" MinimumType="TicketHub.Application.Enums.PermissionType.SystemSection">
                <button type="button" @onclick:stopPropagation="true" @onclick="HandleActionClick" class="flex-shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-blue-50 text-blue-600 hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" title="عملیات">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </button>
            </SecuredView>

            <SecuredView ResourceKey="/tickets" MinimumType="TicketHub.Application.Enums.PermissionType.Full">
                <button type="button" @onclick:stopPropagation="true" @onclick="HandleDeleteClick" class="flex-shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-rose-50 text-rose-600 hover:bg-rose-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-rose-500 transition-colors" title="حذف تیکت">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </button>
            </SecuredView>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TicketDto Ticket { get; set; } = null!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<bool> IsSelectedChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnClick { get; set; }

    [Parameter]
    public EventCallback<TicketDto> OnActionClick { get; set; }

    [Parameter]
    public EventCallback<TicketDto> OnDeleteClick { get; set; }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(Ticket.Id);
        }
    }

    private async Task HandleActionClick()
    {
        if (OnActionClick.HasDelegate)
        {
            await OnActionClick.InvokeAsync(Ticket);
        }
    }

    private async Task HandleDeleteClick()
    {
        if (OnDeleteClick.HasDelegate)
        {
            await OnDeleteClick.InvokeAsync(Ticket);
        }
    }

    private async Task ToggleSelection(ChangeEventArgs e)
    {
        bool val = (bool)(e.Value ?? false);
        if (IsSelectedChanged.HasDelegate)
        {
            await IsSelectedChanged.InvokeAsync(val);
        }
    }
}