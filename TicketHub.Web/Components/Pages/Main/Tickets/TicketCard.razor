@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using TicketHub.Core.Common
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Application.Interfaces
@using TicketHub.Application.Enums
@using TicketHub.Application.DTOs

@inject AuthenticationStateProvider AuthStateProvider
@inject IPermissionService PermissionService

<div @onclick="HandleClick"
     style="@GetCapsuleLaserStyle()"
     class="cyber-quest-capsule group relative rounded-xl bg-[#090e1c]/90 hover:bg-[#0d1428] backdrop-blur-md p-2.5 sm:p-3 border flex flex-col justify-between gap-2 transition-all duration-300 hover:-translate-y-0.5 hover:scale-[1.005] cursor-pointer text-slate-200 select-none @GetCapsuleBorderGlowClass()">
    
    <!-- Laser Scanline & Micro Hologram Grid on Hover -->
    <div class="cyber-scan-grid"></div>
    <div class="cyber-scanline"></div>

    <!-- Capsule Header: Rarity & ID (Right) + SLA & Checkbox (Left) -->
    <div class="flex items-center justify-between gap-1.5">
        <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-[9px] font-black font-mono px-2 py-0.5 rounded-md border @GetRarityTagClass()">
                @GetRarityTag()
            </span>
            <span class="text-[10px] font-mono font-bold text-slate-500">#@Ticket.Id</span>
        </div>

        <div class="flex items-center gap-1.5">
            <!-- Dynamic SLA Countdown Beacon -->
            <span class="px-2 py-0.5 rounded-md text-[10px] font-mono border flex items-center gap-1 flex-shrink-0 @GetSlaRemainingClass()">
                @GetSlaRemainingTimeText()
            </span>

            @if (_canSelect)
            {
                <label class="cursor-pointer relative z-20 flex-shrink-0 mr-0.5" @onclick:stopPropagation="true">
                    <input type="checkbox" class="peer sr-only" checked="@IsSelected" @onchange="ToggleSelection" />
                    <div class="w-4 h-4 rounded-md border border-slate-600 peer-checked:bg-cyan-500 peer-checked:border-cyan-400 transition-all flex items-center justify-center shadow-xs">
                        <svg class="w-3 h-3 text-black font-black opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                </label>
            }
        </div>
    </div>

    <!-- Capsule Body: Avatar + Title & Meta -->
    <div class="flex items-start gap-2 min-w-0">
        <!-- Cybernetic Sender Avatar Ring -->
        <div class="relative w-7 h-7 rounded-lg flex-shrink-0 flex items-center justify-center bg-gradient-to-br from-[#0b1021] to-[#050811] border border-white/[0.1] shadow-inner group-hover:border-cyan-400/60 transition-all mt-0.5">
            <span class="text-[10px] font-black font-mono text-cyan-300">
                @(string.IsNullOrWhiteSpace(Ticket.User?.Name) ? "OP" : Ticket.User.Name.Substring(0, 1).ToUpper())
            </span>
            <span class="absolute -bottom-0.5 -right-0.5 w-2 h-2 rounded-full border border-[#090e1c] shadow-xs" style="background-color: @(Ticket.Status?.ColorCode ?? "#38bdf8");"></span>
        </div>

        <div class="min-w-0 flex-1 space-y-0.5">
            <h4 class="font-bold text-slate-100 group-hover:text-cyan-300 transition-colors text-xs sm:text-[13px] leading-snug line-clamp-1">
                @Ticket.Title
            </h4>

            @if (!string.IsNullOrWhiteSpace(Ticket.Description))
            {
                <p class="text-[11px] text-slate-400 line-clamp-1 font-normal leading-relaxed">
                    @Ticket.Description
                </p>
            }

            <!-- Sub-metadata pills -->
            <div class="flex flex-wrap items-center gap-1.5 pt-0.5 text-[10px] text-slate-400 font-medium">
                <span class="inline-flex items-center gap-1 text-slate-300">
                    <span class="text-cyan-400 text-[10px]">🏰</span>
                    <span class="truncate max-w-[85px]">@(Ticket.Project?.Name ?? "عمومی")</span>
                </span>
                <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                <span class="inline-flex items-center gap-1 text-slate-300">
                    <span class="text-indigo-400 text-[10px]">👤</span>
                    <span class="truncate max-w-[80px]">@(Ticket.User?.Name ?? "نامشخص")</span>
                </span>
                <span class="w-1 h-1 bg-slate-600 rounded-full"></span>
                <span class="font-mono text-slate-400 text-[9px]">
                    @Ticket.CreatedAt.ToPersianDateTimeString()
                </span>

                @if (Ticket.CommentIds != null && Ticket.CommentIds.Any())
                {
                    <span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded-md bg-indigo-950/60 border border-indigo-500/30 text-indigo-300 font-mono text-[9px] font-bold">
                        💬 @Ticket.CommentIds.Count
                    </span>
                }
                @if (Ticket.AttachmentIds != null && Ticket.AttachmentIds.Any())
                {
                    <span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded-md bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 font-mono text-[9px] font-bold">
                        📎 @Ticket.AttachmentIds.Count
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Capsule Footer: Status & Priority Badges + Actions -->
    <div class="flex items-center justify-between border-t border-white/[0.05] pt-1.5 mt-0.5">
        <div class="flex items-center gap-1.5">
            <!-- Status Badge -->
            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold font-mono shadow-inner"
                  style="background-color: @(Ticket.Status?.ColorCode ?? "#64748B")15; color: @(Ticket.Status?.ColorCode ?? "#64748B"); border: 1px solid @(Ticket.Status?.ColorCode ?? "#64748B")50;">
                @(Ticket.Status?.Name ?? "نامشخص")
            </span>

            <!-- Priority Badge -->
            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold font-mono @GetPriorityClass(Ticket.Priority?.Name ?? "")">
                @(Ticket.Priority?.Name ?? "نامشخص")
            </span>
        </div>

        <div class="flex items-center gap-1">
            <SecuredView ResourceKey="/tickets" MinimumType="PermissionType.SystemSection">
                <button type="button" 
                        @onclick:stopPropagation="true" 
                        @onclick="HandleActionClick" 
                        class="flex items-center gap-1 px-2 py-0.5 rounded-lg bg-cyan-950/70 hover:bg-cyan-900 border border-cyan-500/40 text-cyan-300 text-[10px] font-bold font-mono shadow-[0_0_8px_rgba(56,189,248,0.15)] transition-all hover:scale-105 cursor-pointer focus-ring" 
                        title="عملیات و تغییر وضعیت">
                    <svg class="h-3 w-3 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    <span>عملیات</span>
                </button>
            </SecuredView>

            @if (_canDelete)
            {
                <button type="button" 
                        @onclick:stopPropagation="true" 
                        @onclick="HandleDeleteClick" 
                        class="p-0.5 rounded-lg bg-rose-950/70 hover:bg-rose-900 border border-rose-500/40 text-rose-300 shadow-xs transition-all hover:scale-105 cursor-pointer focus-ring" 
                        title="حذف تیکت">
                    <svg class="h-3 w-3 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TicketDto Ticket { get; set; } = null!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<bool> IsSelectedChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnClick { get; set; }

    [Parameter]
    public EventCallback<TicketDto> OnActionClick { get; set; }

    [Parameter]
    public EventCallback<TicketDto> OnDeleteClick { get; set; }

    [Parameter]
    public bool? CanDelete { get; set; }

    [Parameter]
    public bool? CanSelect { get; set; }

    private bool _canDelete => CanDelete ?? _internalCanDelete;
    private bool _canSelect => CanSelect ?? _internalCanSelect;
    private bool _internalCanDelete = false;
    private bool _internalCanSelect = false;

    protected override async Task OnParametersSetAsync()
    {
        if (CanDelete.HasValue && CanSelect.HasValue)
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                           ?? user.FindFirst("sub")?.Value;
        int currentUserId = int.TryParse(userIdString, out var id) ? id : 0;

        bool isSender = (Ticket != null && currentUserId > 0 && Ticket.UserId == currentUserId);
        bool hasFullAccess = await PermissionService.HasAccessAsync(user, "/tickets", PermissionType.Full);

        _internalCanDelete = isSender || hasFullAccess;
        _internalCanSelect = hasFullAccess;
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(Ticket.Id);
        }
    }

    private async Task HandleActionClick()
    {
        if (OnActionClick.HasDelegate)
        {
            await OnActionClick.InvokeAsync(Ticket);
        }
    }

    private async Task HandleDeleteClick()
    {
        if (OnDeleteClick.HasDelegate)
        {
            await OnDeleteClick.InvokeAsync(Ticket);
        }
    }

    private async Task ToggleSelection(ChangeEventArgs e)
    {
        bool val = (bool)(e.Value ?? false);
        if (IsSelectedChanged.HasDelegate)
        {
            await IsSelectedChanged.InvokeAsync(val);
        }
    }

    private string GetRarityTag()
    {
        if (Ticket.IsOverdue) return "🔥 RAID [OVERDUE]";
        if (Ticket.Priority != null && (Ticket.Priority.Level >= 4 || Ticket.Priority.Name == "بحرانی")) return "⚡ EPIC";
        if (Ticket.Priority != null && (Ticket.Priority.Level == 3 || Ticket.Priority.Name == "زیاد" || Ticket.Priority.Name == "بالا" || Ticket.Priority.Name == "خیلی زیاد")) return "🛡️ RARE";
        if (Ticket.Priority != null && (Ticket.Priority.Level == 2 || Ticket.Priority.Name == "متوسط")) return "✨ UNCOMMON";
        return "⚔️ COMMON";
    }

    private string GetRarityTagClass()
    {
        if (Ticket.IsOverdue) return "bg-rose-950/90 text-rose-300 border-rose-500/70 shadow-[0_0_14px_rgba(244,63,94,0.5)] animate-pulse";
        if (Ticket.Priority != null && (Ticket.Priority.Level >= 4 || Ticket.Priority.Name == "بحرانی")) 
            return "bg-purple-950/80 text-purple-300 border-purple-500/60 shadow-[0_0_10px_rgba(168,85,247,0.3)]";
        if (Ticket.Priority != null && (Ticket.Priority.Level == 3 || Ticket.Priority.Name == "زیاد" || Ticket.Priority.Name == "بالا" || Ticket.Priority.Name == "خیلی زیاد")) 
            return "bg-rose-950/80 text-rose-300 border-rose-500/60 shadow-[0_0_10px_rgba(244,63,94,0.3)]";
        if (Ticket.Priority != null && (Ticket.Priority.Level == 2 || Ticket.Priority.Name == "متوسط")) 
            return "bg-amber-950/80 text-amber-300 border-amber-500/60 shadow-[0_0_10px_rgba(245,158,11,0.3)]";
        return "bg-emerald-950/80 text-emerald-300 border-emerald-500/60 shadow-[0_0_10px_rgba(16,185,129,0.3)]";
    }

    private string GetPriorityClass(string priorityName) => priorityName switch
    {
        "بحرانی" => "bg-purple-950/80 text-purple-300 border border-purple-500/40 shadow-xs",
        "زیاد" or "بالا" or "خیلی زیاد" => "bg-rose-950/80 text-rose-300 border border-rose-500/40 shadow-xs",
        "متوسط" => "bg-amber-950/80 text-amber-300 border border-amber-500/40 shadow-xs",
        "کم" or "پایین" or "عادی" => "bg-emerald-950/80 text-emerald-300 border border-emerald-500/40 shadow-xs",
        _ => "bg-slate-900 text-slate-300 border border-slate-700 shadow-xs"
    };

    private string GetSlaRemainingTimeText()
    {
        if (!Ticket.DueDate.HasValue) return "بدون مهلت";
        if (Ticket.IsOverdue)
        {
            var overdueSpan = DateTime.UtcNow - Ticket.DueDate.Value;
            if (overdueSpan.TotalHours < 1)
                return $"🚨 {(int)Math.Max(1, overdueSpan.TotalMinutes)} د گذشته";
            if (overdueSpan.TotalDays < 1)
                return $"🚨 {(int)overdueSpan.TotalHours} س گذشته";
            return $"🚨 {(int)overdueSpan.TotalDays} روز گذشته";
        }
        else
        {
            var remaining = Ticket.DueDate.Value - DateTime.UtcNow;
            if (remaining.TotalHours < 1)
                return $"⏳ {(int)Math.Max(1, remaining.TotalMinutes)} د مانده";
            if (remaining.TotalDays < 1)
                return $"⏳ {(int)remaining.TotalHours} س مانده";
            return $"⏳ {(int)remaining.TotalDays} روز مانده";
        }
    }

    private string GetSlaRemainingClass()
    {
        if (!Ticket.DueDate.HasValue) return "bg-slate-900/80 text-slate-400 border-white/[0.08]";
        if (Ticket.IsOverdue) return "bg-rose-950/90 text-rose-300 border-rose-500/60 shadow-[0_0_12px_rgba(244,63,94,0.35)] animate-pulse font-bold";
        var remaining = Ticket.DueDate.Value - DateTime.UtcNow;
        if (remaining.TotalHours <= 4) return "bg-amber-950/90 text-amber-300 border-amber-500/60 shadow-[0_0_10px_rgba(245,158,11,0.3)] font-bold";
        return "bg-emerald-950/90 text-emerald-300 border-emerald-500/60 shadow-[0_0_10px_rgba(16,185,129,0.3)] font-bold";
    }

    private string GetCapsuleBorderGlowClass()
    {
        if (IsSelected) return "border-cyan-400 ring-2 ring-cyan-500/40 shadow-[0_0_25px_rgba(56,189,248,0.35)]";
        if (Ticket.IsOverdue) return "border-rose-500/50 hover:border-rose-400 hover:shadow-[0_8px_30px_rgba(244,63,94,0.3)]";
        if (Ticket.Priority != null && (Ticket.Priority.Level >= 4 || Ticket.Priority.Name == "بحرانی")) 
            return "border-purple-500/40 hover:border-purple-400 hover:shadow-[0_8px_30px_rgba(168,85,247,0.25)]";
        if (Ticket.Priority != null && (Ticket.Priority.Level == 3 || Ticket.Priority.Name == "زیاد" || Ticket.Priority.Name == "بالا" || Ticket.Priority.Name == "خیلی زیاد")) 
            return "border-rose-500/40 hover:border-rose-400 hover:shadow-[0_8px_30px_rgba(244,63,94,0.25)]";
        if (Ticket.Priority != null && (Ticket.Priority.Level == 2 || Ticket.Priority.Name == "متوسط")) 
            return "border-amber-500/40 hover:border-amber-400 hover:shadow-[0_8px_30px_rgba(245,158,11,0.25)]";
        return "border-emerald-500/30 hover:border-emerald-400 hover:shadow-[0_8px_30px_rgba(16,185,129,0.25)]";
    }

    private string GetCapsuleLaserStyle()
    {
        if (Ticket.IsOverdue) 
            return "--capsule-laser-color: #f43f5e; --capsule-laser-glow: rgba(244, 63, 94, 0.9); --capsule-glow: rgba(244, 63, 94, 0.16);";
        if (Ticket.Priority != null && (Ticket.Priority.Level >= 4 || Ticket.Priority.Name == "بحرانی")) 
            return "--capsule-laser-color: #a855f7; --capsule-laser-glow: rgba(168, 85, 247, 0.9); --capsule-glow: rgba(168, 85, 247, 0.16);";
        if (Ticket.Priority != null && (Ticket.Priority.Level == 3 || Ticket.Priority.Name == "زیاد" || Ticket.Priority.Name == "بالا" || Ticket.Priority.Name == "خیلی زیاد")) 
            return "--capsule-laser-color: #f43f5e; --capsule-laser-glow: rgba(244, 63, 94, 0.9); --capsule-glow: rgba(244, 63, 94, 0.16);";
        if (Ticket.Priority != null && (Ticket.Priority.Level == 2 || Ticket.Priority.Name == "متوسط")) 
            return "--capsule-laser-color: #f59e0b; --capsule-laser-glow: rgba(245, 158, 11, 0.9); --capsule-glow: rgba(245, 158, 11, 0.16);";
        return "--capsule-laser-color: #10b981; --capsule-laser-glow: rgba(16, 185, 129, 0.9); --capsule-glow: rgba(16, 185, 129, 0.16);";
    }
}