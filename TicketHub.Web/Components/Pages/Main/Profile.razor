@page "/profile"
@namespace TicketHub.Web.Components.Pages.Main
@using TicketHub.Web.Components.Pages.Auth.Shared
@using TicketHub.Web.Components.Shared
@rendermode InteractiveServer

<PageTitle>پروفایل کاربری | سامانه تیکتینگ</PageTitle>

<div class="w-full space-y-6 select-none" dir="rtl">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight">پروفایل کاربری</h1>
        <p class="text-xs text-slate-400 mt-1 font-normal">مدیریت اطلاعات شخصی و رمز عبور حساب شما.</p>
    </div>

    @if (IsLoading)
    {
        <div class="flex justify-center p-8"><span class="text-slate-400 text-xs">در حال بارگذاری...</span></div>
    }
    else
    {
        <div class="bg-white rounded-3xl shadow-2xs border border-slate-200/80 overflow-hidden">
            <EditForm Model="ProfileModel" OnValidSubmit="UpdateProfile" FormName="profileForm">
                <DataAnnotationsValidator />

                <div class="p-6 space-y-6">
                    <AlertMessage Message="@StatusMessage" Type="@(IsSuccess ? AlertMessage.AlertType.Success : AlertMessage.AlertType.Error)" IsDark="false" />
                    
                    @if (context.GetValidationMessages().Any())
                    {
                        <div class="mt-4 p-4 bg-rose-50 rounded-2xl border border-rose-100 w-full overflow-hidden">
                            <ul class="text-rose-600 text-xs list-disc list-inside flex flex-col gap-1.5 w-full">
                                @foreach (var message in context.GetValidationMessages())
                                {
                                    <li class="break-words whitespace-normal leading-relaxed text-justify pe-2">
                                        @message
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="md:col-span-2">
                            <CustomAuthInput @bind-Value="ProfileModel.Email"
                                             Label="آدرس ایمیل (شناسه ورود)"
                                             Disabled="true"
                                             HelperText="ایمیل قابل تغییر نمی‌باشد."
                                             IsDark="false" HideInlineError="true" />
                        </div>

                        <div>
                            <CustomAuthInput @bind-Value="ProfileModel.Name"
                                             Label="نام و نام خانوادگی"
                                             ValidationFor="() => ProfileModel.Name"
                                             IsDark="false" HideInlineError="true" />
                        </div>

                        <div>
                            <CustomAuthInput @bind-Value="ProfileModel.PhoneNumber"
                                             Label="شماره تماس"
                                             Dir="ltr"
                                             IsDark="false" HideInlineError="true" />
                        </div>
                    </div>

                    <hr class="border-slate-100" />

                    <div>
                        <h3 class="text-sm font-bold text-slate-800 mb-4">تغییر رمز عبور (اختیاری)</h3>
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                            <div>
                                <CustomAuthInput @bind-Value="ProfileModel.CurrentPassword"
                                                 Label="رمز عبور فعلی"
                                                 Type="password"
                                                 IsDark="false" />
                            </div>

                            <div>
                                <CustomAuthInput @bind-Value="ProfileModel.NewPassword"
                                                 Label="رمز عبور جدید"
                                                 Type="password"
                                                 ValidationFor="() => ProfileModel.NewPassword"
                                                 IsDark="false" HideInlineError="true" />
                            </div>

                            <div>
                                <CustomAuthInput @bind-Value="ProfileModel.ConfirmNewPassword"
                                                 Label="تکرار رمز عبور جدید"
                                                 Type="password"
                                                 ValidationFor="() => ProfileModel.ConfirmNewPassword"
                                                 IsDark="false" HideInlineError="true" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
                    <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl transition-all shadow-md shadow-indigo-500/20 focus-ring">
                        ذخیره تغییرات
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>