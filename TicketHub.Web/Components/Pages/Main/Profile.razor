@page "/profile"
@namespace TicketHub.Web.Components.Pages.Main
@using TicketHub.Application.DTOs
@using TicketHub.Core.Common
@using TicketHub.Web.Components.Pages.Auth.Shared
@using TicketHub.Web.Components.Shared

<PageTitle>کنسول پروفایل و هویت کاربری | سامانه تیکت‌هاب</PageTitle>

<div class="w-full flex flex-col gap-5 select-none" dir="rtl">
    <!-- Top Section: Master Persona Holographic Banner -->
    <div class="relative overflow-hidden rounded-2xl bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 p-4 sm:p-6 shadow-[0_0_30px_rgba(8,13,26,0.9)] flex flex-col gap-4">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-cyan-500/20 via-indigo-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Laser Top Edge Sweep -->
        <div class="cyber-laser-sweep"></div>

        <!-- User Identity Row -->
        <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start justify-between gap-5 text-center md:text-right">
            <div class="flex flex-col sm:flex-row items-center gap-4.5">
                <!-- Glowing Avatar Frame -->
                <div class="relative group">
                    <div class="w-20 h-20 sm:w-22 sm:h-22 rounded-2xl bg-gradient-to-br from-cyan-500/20 via-[#050811] to-purple-600/20 border-2 border-cyan-400/40 flex items-center justify-center text-cyan-300 shadow-[0_0_20px_rgba(56,189,248,0.3)] relative overflow-hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 sm:h-11 sm:w-11 text-cyan-300 drop-shadow-[0_0_10px_rgba(56,189,248,0.8)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <div class="absolute inset-0 bg-cyan-400/10 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
                    </div>
                    <!-- Status Ring Indicator -->
                    <span class="absolute -bottom-1 -left-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-[#080d1a] shadow-[0_0_10px_rgba(16,185,129,0.9)] flex items-center justify-center">
                        <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                    </span>
                </div>

                <!-- User Meta Information -->
                <div class="space-y-1.5 min-w-0">
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight drop-shadow-[0_0_12px_rgba(255,255,255,0.3)]">
                            @(string.IsNullOrWhiteSpace(CurrentUserDto?.Name) ? "کاربر سیستم" : CurrentUserDto.Name)
                        </h1>
                        <span class="px-2 py-0.5 rounded-md bg-cyan-500/15 border border-cyan-400/30 text-cyan-300 text-[10px] font-mono font-bold tracking-wider">
                            #USR-@CurrentUserId.ToString("D4")
                        </span>
                        <span class="px-2 py-0.5 rounded-md bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-[10px] font-bold flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            حساب فعال و تایید شده
                        </span>
                    </div>

                    <div class="text-xs text-slate-300 font-mono flex flex-wrap items-center justify-center sm:justify-start gap-2">
                        <span class="text-cyan-400/80">@CurrentUserDto?.Email</span>
                        <span class="text-slate-600">•</span>
                        <span class="text-slate-400">عضویت: @(CurrentUserDto != null ? CurrentUserDto.CreatedAt.ToPersianDateString() : "-")</span>
                    </div>

                    <!-- Role Badges -->
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-1.5 pt-1">
                        @if (CurrentUserDto?.RoleNames != null && CurrentUserDto.RoleNames.Any())
                        {
                            @foreach (var role in CurrentUserDto.RoleNames)
                            {
                                <span class="px-2.5 py-0.5 rounded-lg bg-purple-500/15 border border-purple-400/35 text-purple-300 text-xs font-semibold shadow-[0_0_8px_rgba(168,85,247,0.2)] flex items-center gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                    </svg>
                                    @role
                                </span>
                            }
                        }
                        else
                        {
                            <span class="px-2.5 py-0.5 rounded-lg bg-slate-800/80 border border-slate-700 text-slate-400 text-xs font-mono">
                                کاربر عادی (Customer)
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Row: 3 Telemetry Stats Cards -->
        <div class="relative z-10 pt-3 border-t border-white/[0.08] grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <!-- 1. Total Tickets (Cyan) -->
            <div class="telemetry-pill-segment py-2 px-3 sm:px-4" style="--seg-border: rgba(56, 189, 248, 0.5); --seg-glow: rgba(56, 189, 248, 0.25);">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-8 h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-sm text-cyan-300 font-bold truncate">کل تیکت‌های من</span>
                        <span class="text-[10px] font-mono text-cyan-400/60 uppercase">TOTAL_TICKETS</span>
                    </div>
                </div>
                <span class="text-lg sm:text-xl font-black text-white drop-shadow-[0_0_8px_rgba(56,189,248,0.7)] px-1">
                    @((UserTelemetry?.TotalTickets ?? 0).ToPersianNumbers())
                </span>
            </div>

            <!-- 2. In Progress Tickets (Amber) -->
            <div class="telemetry-pill-segment py-2 px-3 sm:px-4" style="--seg-border: rgba(245, 158, 11, 0.5); --seg-glow: rgba(245, 158, 11, 0.25);">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-amber-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-sm text-amber-300 font-bold truncate">در حال رسیدگی</span>
                        <span class="text-[10px] font-mono text-amber-400/60 uppercase">IN_PROGRESS</span>
                    </div>
                </div>
                <span class="text-lg sm:text-xl font-black text-white drop-shadow-[0_0_8px_rgba(245,158,11,0.7)] px-1">
                    @((UserTelemetry?.InProgressCount ?? 0).ToPersianNumbers())
                </span>
            </div>

            <!-- 3. Resolved / Closed Tickets (Emerald) -->
            <div class="telemetry-pill-segment py-2 px-3 sm:px-4" style="--seg-border: rgba(16, 185, 129, 0.5); --seg-glow: rgba(16, 185, 129, 0.25);">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-sm text-emerald-300 font-bold truncate">حل‌شده و بسته‌شده</span>
                        <span class="text-[10px] font-mono text-emerald-400/60 uppercase">RESOLVED</span>
                    </div>
                </div>
                <span class="text-lg sm:text-xl font-black text-white drop-shadow-[0_0_8px_rgba(16,185,129,0.7)] px-1">
                    @((UserTelemetry?.ResolvedCount ?? 0).ToPersianNumbers())
                </span>
            </div>
        </div>
    </div>

    <!-- Navigation Command Dock (Tab Switcher) -->
    <div class="bg-[#080d1a]/95 backdrop-blur-2xl p-1.5 rounded-2xl border border-cyan-500/35 shadow-[0_0_20px_rgba(8,13,26,0.85)] flex flex-wrap sm:flex-nowrap gap-1.5">
        <button type="button" 
                @onclick="() => SetActiveTab(1)"
                class="flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 cursor-pointer @(ActiveTab == 1 ? "bg-cyan-500/20 text-cyan-300 border border-cyan-400/50 shadow-[0_0_15px_rgba(56,189,248,0.3)]" : "text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>شناسنامه و مشخصات فردی</span>
            <span class="text-[9px] font-mono text-cyan-400/60 hidden md:inline">[IDENTITY]</span>
        </button>

        <button type="button" 
                @onclick="() => SetActiveTab(2)"
                class="flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 cursor-pointer @(ActiveTab == 2 ? "bg-indigo-500/20 text-indigo-300 border border-indigo-400/50 shadow-[0_0_15px_rgba(99,102,241,0.3)]" : "text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>امنیت و کلید عبور</span>
            <span class="text-[9px] font-mono text-indigo-400/60 hidden md:inline">[SECURITY]</span>
        </button>

        <button type="button" 
                @onclick="() => SetActiveTab(3)"
                class="flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-2 cursor-pointer @(ActiveTab == 3 ? "bg-purple-500/20 text-purple-300 border border-purple-400/50 shadow-[0_0_15px_rgba(168,85,247,0.3)]" : "text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]")">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            <span>شخصی‌سازی کاک‌پیت و هود</span>
            <span class="text-[9px] font-mono text-purple-400/60 hidden md:inline">[HUD_AURA]</span>
        </button>
    </div>

    @if (IsLoading)
    {
        <div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 rounded-2xl p-12 flex flex-col items-center justify-center gap-3 text-center">
            <div class="w-10 h-10 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin"></div>
            <span class="text-xs font-mono text-cyan-300">[SYS_INIT // RETRIEVING_USER_VAULT...]</span>
        </div>
    }
    else
    {
        <!-- Main Form Container -->
        <EditForm Model="ProfileModel" OnValidSubmit="UpdateProfile" FormName="profileForm">
            <DataAnnotationsValidator />

            <!-- Global Status Notification Banner -->
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="mb-4 p-3.5 rounded-xl border flex items-center justify-between gap-3 backdrop-blur-xl animate-fade-in @(IsSuccess ? "bg-emerald-500/15 border-emerald-500/40 text-emerald-300 shadow-[0_0_15px_rgba(16,185,129,0.3)]" : "bg-rose-500/15 border-rose-500/40 text-rose-300 shadow-[0_0_15px_rgba(244,63,94,0.3)]")">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2 h-2 rounded-full @(IsSuccess ? "bg-emerald-400 animate-pulse" : "bg-rose-400")"></span>
                        <span class="text-xs sm:text-sm font-semibold">@StatusMessage</span>
                    </div>
                    <button type="button" @onclick="() => StatusMessage = null" class="text-xs opacity-70 hover:opacity-100 font-bold px-2 py-0.5 rounded cursor-pointer">
                        ✕
                    </button>
                </div>
            }

            <!-- TAB 1: IDENTITY & PERSONAL INFO -->
            @if (ActiveTab == 1)
            {
                <div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 rounded-2xl p-5 sm:p-7 shadow-[0_0_25px_rgba(8,13,26,0.85)] relative space-y-6">
                    <div class="border-b border-white/[0.08] pb-4 flex items-center justify-between">
                        <div>
                            <h3 class="text-base font-bold text-white flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(56,189,248,0.8)]"></span>
                                اطلاعات فردی و شناسنامه کاربری
                            </h3>
                            <p class="text-xs text-slate-400 mt-0.5">مشخصات قابل نمایش در فرم‌ها و مکاتبات سامانه تیکت‌هاب</p>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-md bg-cyan-500/10 border border-cyan-400/25 text-cyan-300 text-[10px] font-mono">
                            SEC_LEVEL_1
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <!-- Email (Readonly) -->
                        <div class="md:col-span-2 space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300 flex items-center justify-between">
                                <span>آدرس ایمیل (شناسه ورود سراسری)</span>
                                <span class="text-[10px] font-mono text-cyan-400 flex items-center gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                    قفل‌شده (غیرقابل ویرایش)
                                </span>
                            </label>
                            <div class="relative">
                                <input type="text" value="@ProfileModel.Email" disabled
                                       class="w-full h-[46px] px-4 bg-[#050811]/60 border border-slate-700/50 rounded-xl text-slate-400 font-mono text-sm cursor-not-allowed select-none opacity-80" />
                                <div class="absolute inset-y-0 left-4 flex items-center">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-500/15 text-cyan-300 border border-cyan-400/30">
                                        VERIFIED_ID
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Full Name -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300 flex items-center justify-between">
                                <span>نام و نام خانوادگی</span>
                                <span class="text-[10px] font-mono text-cyan-400/70">* اجباری</span>
                            </label>
                            <div class="field-spark-wrap relative rounded-xl">
                                <InputText @bind-Value="ProfileModel.Name"
                                           class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                                           placeholder="مثال: علی اورعی" />
                            </div>
                            <ValidationMessage For="() => ProfileModel.Name" class="text-rose-400 text-[11px] font-semibold" />
                        </div>

                        <!-- Phone Number -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300 flex items-center justify-between">
                                <span>شماره تماس همراه</span>
                                <span class="text-[10px] font-mono text-slate-500">اختیاری</span>
                            </label>
                            <div class="field-spark-wrap relative rounded-xl">
                                <InputText @bind-Value="ProfileModel.PhoneNumber" dir="ltr"
                                           class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-xl text-slate-100 placeholder-slate-500 text-sm transition-all font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                                           placeholder="09123456789" />
                            </div>
                            <ValidationMessage For="() => ProfileModel.PhoneNumber" class="text-rose-400 text-[11px] font-semibold" />
                        </div>
                    </div>

                    <!-- Action Dock -->
                    <div class="pt-4 border-t border-white/[0.08] flex items-center justify-end">
                        <button type="submit" class="btn-cyber-primary h-[44px] px-6 text-sm font-bold flex items-center gap-2 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>ذخیره تغییرات شناسنامه</span>
                            <span class="btn-micro-badge">EXE</span>
                        </button>
                    </div>
                </div>
            }

            <!-- TAB 2: SECURITY & PASSWORD -->
            @if (ActiveTab == 2)
            {
                <div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-indigo-500/35 rounded-2xl p-5 sm:p-7 shadow-[0_0_25px_rgba(8,13,26,0.85)] relative space-y-6">
                    <div class="border-b border-white/[0.08] pb-4 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h3 class="text-base font-bold text-white flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-indigo-400 shadow-[0_0_8px_rgba(99,102,241,0.8)]"></span>
                                مدیریت کلمات عبور و سطح امنیت حساب
                            </h3>
                            <p class="text-xs text-slate-400 mt-0.5">تغییر کلید دسترسی به همراه ارزیاب هوشمند و ابزار تولید رمز تصادفی ایمن</p>
                        </div>

                        <!-- Auto Password Generator Button -->
                        <button type="button" 
                                @onclick="GenerateStrongPassword"
                                class="px-3 py-1.5 rounded-xl bg-indigo-500/15 border border-indigo-400/40 text-indigo-300 text-xs font-bold hover:bg-indigo-500/25 hover:border-indigo-400 transition-all flex items-center gap-1.5 shadow-[0_0_10px_rgba(99,102,241,0.2)] cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                            </svg>
                            <span>تولید رمز عبور فوق‌العاده امن [AUTO_GEN]</span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                        <!-- Current Password -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">رمز عبور فعلی</label>
                            <div class="field-spark-wrap relative rounded-xl">
                                <InputText @bind-Value="ProfileModel.CurrentPassword"
                                           type="@(ShowCurrentPassword ? "text" : "password")"
                                           class="appearance-none w-full h-[46px] px-4 pl-10 bg-[#050811]/90 border border-slate-700/80 hover:border-indigo-500/40 focus:border-indigo-400 rounded-xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:shadow-[0_0_15px_rgba(99,102,241,0.25)] font-mono"
                                           placeholder="••••••••" />
                                <button type="button" @onclick="() => ShowCurrentPassword = !ShowCurrentPassword"
                                        class="absolute inset-y-0 left-3 flex items-center text-slate-400 hover:text-indigo-300 transition-colors cursor-pointer">
                                    @if (ShowCurrentPassword)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    }
                                </button>
                            </div>
                        </div>

                        <!-- New Password -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">رمز عبور جدید</label>
                            <div class="field-spark-wrap relative rounded-xl">
                                <InputText @bind-Value="ProfileModel.NewPassword"
                                           type="@(ShowNewPassword ? "text" : "password")"
                                           class="appearance-none w-full h-[46px] px-4 pl-10 bg-[#050811]/90 border border-slate-700/80 hover:border-indigo-500/40 focus:border-indigo-400 rounded-xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:shadow-[0_0_15px_rgba(99,102,241,0.25)] font-mono"
                                           placeholder="رمز جدید..." />
                                <button type="button" @onclick="() => ShowNewPassword = !ShowNewPassword"
                                        class="absolute inset-y-0 left-3 flex items-center text-slate-400 hover:text-indigo-300 transition-colors cursor-pointer">
                                    @if (ShowNewPassword)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    }
                                </button>
                            </div>
                            <ValidationMessage For="() => ProfileModel.NewPassword" class="text-rose-400 text-[11px] font-semibold" />
                        </div>

                        <!-- Confirm New Password -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">تکرار رمز عبور جدید</label>
                            <div class="field-spark-wrap relative rounded-xl">
                                <InputText @bind-Value="ProfileModel.ConfirmNewPassword"
                                           type="@(ShowConfirmPassword ? "text" : "password")"
                                           class="appearance-none w-full h-[46px] px-4 pl-10 bg-[#050811]/90 border border-slate-700/80 hover:border-indigo-500/40 focus:border-indigo-400 rounded-xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:shadow-[0_0_15px_rgba(99,102,241,0.25)] font-mono"
                                           placeholder="تکرار رمز..." />
                                <button type="button" @onclick="() => ShowConfirmPassword = !ShowConfirmPassword"
                                        class="absolute inset-y-0 left-3 flex items-center text-slate-400 hover:text-indigo-300 transition-colors cursor-pointer">
                                    @if (ShowConfirmPassword)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    }
                                </button>
                            </div>
                            <ValidationMessage For="() => ProfileModel.ConfirmNewPassword" class="text-rose-400 text-[11px] font-semibold" />
                        </div>
                    </div>

                    <!-- Password Strength Holographic Meter -->
                    @if (!string.IsNullOrEmpty(ProfileModel.NewPassword))
                    {
                        <div class="p-4 rounded-xl bg-[#050811]/90 border border-white/[0.1] space-y-3">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-slate-300 font-semibold flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                                    ارزیابی ضریب امنیت پسورد:
                                </span>
                                <span class="font-bold font-mono @PasswordStrengthColor">
                                    @PasswordStrengthLabel
                                </span>
                            </div>

                            <!-- 4-Stage Neon Bar -->
                            <div class="grid grid-cols-4 gap-1.5 h-2">
                                <div class="rounded-full transition-all duration-300 @(PasswordScore >= 1 ? "bg-gradient-to-r from-rose-500 to-rose-400 shadow-[0_0_8px_rgba(244,63,94,0.7)]" : "bg-slate-800")"></div>
                                <div class="rounded-full transition-all duration-300 @(PasswordScore >= 2 ? "bg-gradient-to-r from-amber-500 to-amber-400 shadow-[0_0_8px_rgba(245,158,11,0.7)]" : "bg-slate-800")"></div>
                                <div class="rounded-full transition-all duration-300 @(PasswordScore >= 3 ? "bg-gradient-to-r from-blue-500 to-cyan-400 shadow-[0_0_8px_rgba(56,189,248,0.7)]" : "bg-slate-800")"></div>
                                <div class="rounded-full transition-all duration-300 @(PasswordScore >= 4 ? "bg-gradient-to-r from-emerald-400 to-teal-300 shadow-[0_0_10px_rgba(16,185,129,0.9)]" : "bg-slate-800")"></div>
                            </div>

                            <!-- Criteria Checklist -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1 text-[11px]">
                                <span class="flex items-center gap-1.5 @(HasMinLength ? "text-emerald-400 font-bold" : "text-slate-500")">
                                    @(HasMinLength ? "✓" : "○") حداقل ۸ کاراکتر
                                </span>
                                <span class="flex items-center gap-1.5 @(HasNumber ? "text-emerald-400 font-bold" : "text-slate-500")">
                                    @(HasNumber ? "✓" : "○") شامل اعداد (0-9)
                                </span>
                                <span class="flex items-center gap-1.5 @(HasUpperLower ? "text-emerald-400 font-bold" : "text-slate-500")">
                                    @(HasUpperLower ? "✓" : "○") حروف بزرگ و کوچک
                                </span>
                                <span class="flex items-center gap-1.5 @(HasSpecialChar ? "text-emerald-400 font-bold" : "text-slate-500")">
                                    @(HasSpecialChar ? "✓" : "○") نمادهای خاص (#@@$!)
                                </span>
                            </div>
                        </div>
                    }

                    <!-- Action Dock -->
                    <div class="pt-4 border-t border-white/[0.08] flex items-center justify-end">
                        <button type="submit" class="btn-cyber-primary h-[44px] px-6 text-sm font-bold flex items-center gap-2 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                            <span>بروزرسانی رمز عبور</span>
                            <span class="btn-micro-badge">AUTH</span>
                        </button>
                    </div>
                </div>
            }

            <!-- TAB 3: COCKPIT HUD & AURA CUSTOMIZER -->
            @if (ActiveTab == 3)
            {
                <div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-purple-500/35 rounded-2xl p-5 sm:p-7 shadow-[0_0_25px_rgba(8,13,26,0.85)] relative space-y-6">
                    <div class="border-b border-white/[0.08] pb-4">
                        <h3 class="text-base font-bold text-white flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(168,85,247,0.8)]"></span>
                            مرکز سفارشی‌سازی هود و اتمسفر کاک‌پیت (Aura Themes)
                        </h3>
                        <p class="text-xs text-slate-400 mt-0.5">انتخاب پالت‌های رنگی کوانتومی و کنترل افکت‌های گرافیکی سامانه</p>
                    </div>

                    <!-- 4 Elemental Auras Grid -->
                    <div>
                        <label class="block text-xs font-bold text-slate-300 mb-3 flex items-center justify-between">
                            <span>پالت رنگی هود کاک‌پیت (Elemental Aura)</span>
                            <span class="text-[10px] font-mono text-purple-400">REALTIME_SWITCH</span>
                        </label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
                            <!-- 1. Water Cyan -->
                            <button type="button" 
                                    @onclick='() => SetCockpitAura("water")'
                                    class="p-3.5 rounded-xl border transition-all text-right flex flex-col gap-2 group cursor-pointer @(CurrentAura == "water" ? "bg-cyan-950/60 border-cyan-400 shadow-[0_0_20px_rgba(56,189,248,0.35)]" : "bg-[#050811]/90 border-slate-700/60 hover:border-cyan-500/50")">
                                <div class="flex items-center justify-between">
                                    <span class="w-4 h-4 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(56,189,248,0.8)]"></span>
                                    <span class="text-[10px] font-mono text-cyan-300 font-bold">CYBER_WATER</span>
                                </div>
                                <span class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors">واتر سایبر (Cyan)</span>
                                <span class="text-[11px] text-slate-400">آرامش اقیانوسی و هماهنگی فیروزه‌ای</span>
                            </button>

                            <!-- 2. Fire Orange/Rose -->
                            <button type="button" 
                                    @onclick='() => SetCockpitAura("fire")'
                                    class="p-3.5 rounded-xl border transition-all text-right flex flex-col gap-2 group cursor-pointer @(CurrentAura == "fire" ? "bg-orange-950/60 border-orange-400 shadow-[0_0_20px_rgba(249,115,22,0.35)]" : "bg-[#050811]/90 border-slate-700/60 hover:border-orange-500/50")">
                                <div class="flex items-center justify-between">
                                    <span class="w-4 h-4 rounded-full bg-orange-500 shadow-[0_0_8px_rgba(249,115,22,0.8)]"></span>
                                    <span class="text-[10px] font-mono text-orange-300 font-bold">NEON_FLAME</span>
                                </div>
                                <span class="text-sm font-bold text-white group-hover:text-orange-300 transition-colors">آتش نئونی (Flame)</span>
                                <span class="text-[11px] text-slate-400">حرارت پرانرژی و درخشش آتشین</span>
                            </button>

                            <!-- 3. Lightning Ultra-Violet -->
                            <button type="button" 
                                    @onclick='() => SetCockpitAura("lightning")'
                                    class="p-3.5 rounded-xl border transition-all text-right flex flex-col gap-2 group cursor-pointer @(CurrentAura == "lightning" ? "bg-purple-950/60 border-purple-400 shadow-[0_0_20px_rgba(168,85,247,0.35)]" : "bg-[#050811]/90 border-slate-700/60 hover:border-purple-500/50")">
                                <div class="flex items-center justify-between">
                                    <span class="w-4 h-4 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(168,85,247,0.8)]"></span>
                                    <span class="text-[10px] font-mono text-purple-300 font-bold">PLASMA_ARC</span>
                                </div>
                                <span class="text-sm font-bold text-white group-hover:text-purple-300 transition-colors">صاعقه بنفش (Lightning)</span>
                                <span class="text-[11px] text-slate-400">ولتاژ بالا و امواج الکترومغناطیس</span>
                            </button>

                            <!-- 4. Toxic Bio-Emerald -->
                            <button type="button" 
                                    @onclick='() => SetCockpitAura("toxic")'
                                    class="p-3.5 rounded-xl border transition-all text-right flex flex-col gap-2 group cursor-pointer @(CurrentAura == "toxic" ? "bg-emerald-950/60 border-emerald-400 shadow-[0_0_20px_rgba(16,185,129,0.35)]" : "bg-[#050811]/90 border-slate-700/60 hover:border-emerald-500/50")">
                                <div class="flex items-center justify-between">
                                    <span class="w-4 h-4 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
                                    <span class="text-[10px] font-mono text-emerald-300 font-bold">BIO_ACID</span>
                                </div>
                                <span class="text-sm font-bold text-white group-hover:text-emerald-300 transition-colors">سم بیولوژیک (Toxic)</span>
                                <span class="text-[11px] text-slate-400">سبز اسیدی رادیواکتیو نئونی</span>
                            </button>
                        </div>
                    </div>

                    <!-- Atmospheric & Effect Controls -->
                    <div class="pt-4 border-t border-white/[0.08] grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Matrix Rain Switch -->
                        <div class="p-4 rounded-xl bg-[#050811]/90 border border-white/[0.08] flex items-center justify-between">
                            <div>
                                <span class="text-xs font-bold text-slate-200 block">باران کدهای ماتریکس</span>
                                <span class="text-[10px] text-slate-500">جریان عمودی ارقام سبز هکری</span>
                            </div>
                            <button type="button" 
                                    @onclick="ToggleMatrixRainAsync"
                                    class="w-12 h-6 rounded-full transition-colors relative p-0.5 cursor-pointer @(MatrixRainEnabled ? "bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.6)]" : "bg-slate-800")">
                                <div class="w-5 h-5 rounded-full bg-white transition-transform @(MatrixRainEnabled ? "-translate-x-6" : "translate-x-0")"></div>
                            </button>
                        </div>

                        <!-- Ambient Nebula Parallax -->
                        <div class="p-4 rounded-xl bg-[#050811]/90 border border-white/[0.08] flex items-center justify-between">
                            <div>
                                <span class="text-xs font-bold text-slate-200 block">مه‌نبولای شناور</span>
                                <span class="text-[10px] text-slate-500">انیمیشن اورب‌های اتمسفریک</span>
                            </div>
                            <button type="button" 
                                    @onclick="ToggleNebulaAsync"
                                    class="w-12 h-6 rounded-full transition-colors relative p-0.5 cursor-pointer @(NebulaParallaxEnabled ? "bg-cyan-500 shadow-[0_0_10px_rgba(56,189,248,0.6)]" : "bg-slate-800")">
                                <div class="w-5 h-5 rounded-full bg-white transition-transform @(NebulaParallaxEnabled ? "-translate-x-6" : "translate-x-0")"></div>
                            </button>
                        </div>

                        <!-- Sound FX -->
                        <div class="p-4 rounded-xl bg-[#050811]/90 border border-white/[0.08] flex items-center justify-between">
                            <div>
                                <span class="text-xs font-bold text-slate-200 block">افکت‌های صوتی HUD</span>
                                <span class="text-[10px] text-slate-500">صدای کلیک و هشدارهای تعاملی</span>
                            </div>
                            <button type="button" 
                                    @onclick="ToggleSoundFxAsync"
                                    class="w-12 h-6 rounded-full transition-colors relative p-0.5 cursor-pointer @(SoundFxEnabled ? "bg-purple-500 shadow-[0_0_10px_rgba(168,85,247,0.6)]" : "bg-slate-800")">
                                <div class="w-5 h-5 rounded-full bg-white transition-transform @(SoundFxEnabled ? "-translate-x-6" : "translate-x-0")"></div>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </EditForm>
    }
</div>