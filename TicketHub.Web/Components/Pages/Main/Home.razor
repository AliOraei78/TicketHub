@page "/"
@page "/home"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Fluxor
@using TicketHub.Application.DTOs
@using TicketHub.Application.Interfaces
@using TicketHub.Web.Store
@using TicketHub.Web.Components.Pages.Main.Tickets
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@rendermode InteractiveServer

<PageTitle>داشبورد | سامانه تیکتینگ</PageTitle>

<div class="w-full space-y-8 select-none" dir="rtl">
    <!-- Welcome Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 p-8 md:p-10 text-white shadow-2xl border border-white/10">
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 backdrop-blur-md flex items-center gap-1.5 shadow-xs">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        میز کار اختصاصی
                    </span>
                    <span class="text-xs text-indigo-200/70 font-medium flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        @CurrentPersianDate
                    </span>
                </div>
                <h1 class="text-3xl md:text-4xl font-black tracking-tight leading-tight text-white drop-shadow-xs">
                    خوش آمدید، @UserName
                </h1>
                <p class="text-indigo-100/80 text-sm md:text-base mt-2 max-w-2xl leading-relaxed font-normal">
                    سیستم یکپارچه مدیریت درخواست‌ها و پشتیبانی. در زیر وضعیت تحلیلی تیکت‌ها و کارکرد پروژه قرار دارد.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <button @onclick="OpenCreateModal"
                        class="px-5 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm rounded-2xl shadow-lg shadow-indigo-600/30 hover:scale-[1.02] active:scale-95 transition-all flex items-center gap-2 focus-ring">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    ثبت تیکت جدید
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Metrics Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <QuickStatsCard Title="کل تیکت‌های دسترس" 
                        Value="@TotalTickets.ToString()" 
                        ValueColorClass="text-slate-900 group-hover:text-indigo-600" 
                        IconThemeClass="bg-indigo-50 text-indigo-600">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 02 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <QuickStatsCard Title="اقدام نشده (جدید)" 
                        Value="@NewTicketsCount.ToString()" 
                        ValueColorClass="text-indigo-600" 
                        IconThemeClass="bg-indigo-50 text-indigo-600">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <QuickStatsCard Title="در حال بررسی" 
                        Value="@InProgressCount.ToString()" 
                        ValueColorClass="text-amber-600" 
                        IconThemeClass="bg-amber-50 text-amber-600">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <QuickStatsCard Title="بحرانی / منقضی‌ شده" 
                        Value="@CriticalAndOverdueCount.ToString()" 
                        ValueColorClass="text-rose-600" 
                        IconThemeClass="bg-rose-50 text-rose-600">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </Icon>
        </QuickStatsCard>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Chart Card 1: 7-Day Tickets Trend -->
        <div @onclick='() => OpenChartModal("trend")'
             class="bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 hover:shadow-xl hover:border-indigo-200 cursor-pointer transition-all relative group overflow-hidden">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-indigo-600 transition-colors">
                        روند ورودی تیکت‌ها (۷ روز گذشته)
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">برای مشاهده جزئیات و بزرگ‌نمایی کلیک کنید</p>
                </div>
                <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-2xl group-hover:bg-indigo-600 group-hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                    </svg>
                </div>
            </div>

            <div class="h-44 w-full flex items-end pt-4">
                @if (TrendData != null && TrendData.Any())
                {
                    <svg viewBox="0 0 400 120" class="w-full h-full overflow-visible">
                        <defs>
                            <linearGradient id="miniTrendGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#4F46E5" stop-opacity="0.35" />
                                <stop offset="100%" stop-color="#4F46E5" stop-opacity="0.0" />
                            </linearGradient>
                        </defs>
                        <path d="@BuildSvgAreaPath(TrendData, 400, 120)" fill="url(#miniTrendGrad)" />
                        <path d="@BuildSvgLinePath(TrendData, 400, 120)" fill="none" stroke="#4F46E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                }
            </div>

            <div class="flex justify-between items-center border-t border-slate-100 pt-3 mt-2 text-xs text-slate-400">
                <span>۷ روز قبل</span>
                <span class="font-bold text-indigo-600">امروز (@(TrendData?.LastOrDefault()?.Count ?? 0) تیکت)</span>
            </div>
        </div>

        <!-- Chart Card 2: Priority Distribution -->
        <div @onclick='() => OpenChartModal("priority")'
             class="bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 hover:shadow-xl hover:border-indigo-200 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-indigo-600 transition-colors">
                        توزیع تیکت‌ها بر اساس اولویت
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">بر اساس اولویت‌های فعال در دیتابیس</p>
                </div>
                <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-2xl group-hover:bg-indigo-600 group-hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                    </svg>
                </div>
            </div>

            <div class="space-y-3.5 my-3">
                @if (PriorityStats != null && PriorityStats.Any())
                {
                    @foreach (var pri in PriorityStats.Take(4))
                    {
                        <div>
                            <div class="flex justify-between text-xs font-bold mb-1">
                                <span class="flex items-center gap-1.5" style="color: @pri.ColorCode;">
                                    <span class="w-2.5 h-2.5 rounded-full" style="background-color: @pri.ColorCode;"></span>
                                    @pri.Name
                                </span>
                                <span class="font-bold" style="color: @pri.ColorCode;">@pri.Count تیکت (@pri.Percentage%)</span>
                            </div>
                            <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
                                <div class="h-full rounded-full transition-all" style="width: @pri.Percentage%; background-color: @pri.ColorCode;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 text-center py-4">اولویت فعالی تعریف نشده است.</p>
                }
            </div>
        </div>

        <!-- Chart Card 3: Project Workload -->
        <div @onclick='() => OpenChartModal("project")'
             class="bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 hover:shadow-xl hover:border-purple-200 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-purple-600 transition-colors">
                        سهم پروژه‌ها از کل تیکت‌ها
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">پروژه‌های پرحجم و لود کاری</p>
                </div>
                <div class="p-2.5 bg-purple-50 text-purple-600 rounded-2xl group-hover:bg-purple-600 group-hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
            </div>

            <div class="space-y-3.5 my-2">
                @if (ProjectStats != null && ProjectStats.Any())
                {
                    @foreach (var proj in ProjectStats.Take(3))
                    {
                        <div>
                            <div class="flex justify-between text-xs font-bold mb-1">
                                <span class="text-slate-800">@proj.ProjectName</span>
                                <span class="text-purple-600">@proj.TicketCount تیکت (@proj.Percentage%)</span>
                            </div>
                            <div class="w-full bg-purple-50 h-2.5 rounded-full overflow-hidden">
                                <div class="bg-purple-600 h-full rounded-full transition-all" style="width: @proj.Percentage%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 text-center py-4">اطلاعاتی موجود نیست.</p>
                }
            </div>
        </div>

        <!-- Chart Card 4: SLA Health Gauge -->
        <div @onclick='() => OpenChartModal("sla")'
             class="bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 hover:shadow-xl hover:border-emerald-200 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-2">
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-emerald-600 transition-colors">
                        شاخص پاسخگویی به موقع (SLA)
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">پایش انقضا و زمان‌بندی مهلت‌ها</p>
                </div>
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-2xl group-hover:bg-emerald-600 group-hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>

            <div class="flex items-center justify-around py-3">
                <div class="relative w-28 h-28 flex items-center justify-center">
                    <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                        <path class="text-slate-100" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        <path class="text-emerald-500 transition-all" stroke-dasharray="@(SlaOnTimePercentage), 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                    </svg>
                    <div class="absolute text-center">
                        <span class="text-xl font-black text-slate-800">@SlaOnTimePercentage%</span>
                        <span class="text-[9px] text-slate-400 block font-medium">پاسخ به موقع</span>
                    </div>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                        <span class="text-slate-600">در مهلت تعیین شده: <b class="text-slate-900">@(TotalTickets - OverdueCount)</b></span>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                        <span class="text-slate-600">سررسید گذشته (Overdue): <b class="text-rose-600">@OverdueCount</b></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Tickets Stream Section -->
    <div class="bg-white rounded-3xl shadow-2xs border border-slate-200/80 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-indigo-600 animate-ping"></div>
                <h2 class="text-xl font-bold text-slate-800">آخرین تیکت‌های فعال در سیستم</h2>
            </div>
            <button @onclick='() => Navigation.NavigateTo("/tickets")'
                    class="text-sm font-bold text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1 focus-ring rounded-lg px-2 py-1">
                مشاهده تمام تیکت‌ها
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>

        <div class="p-0">
            @if (IsLoading)
            {
                <div class="flex justify-center items-center py-16">
                    <div class="animate-spin rounded-full h-9 w-9 border-b-2 border-indigo-600"></div>
                </div>
            }
            else if (RecentTickets == null || !RecentTickets.Any())
            {
                <div class="text-center py-16 text-slate-400 text-sm">
                    تیکتی برای نمایش یافت نشد.
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var ticket in RecentTickets)
                    {
                        <div @onclick="() => NavigateToDetails(ticket.Id)"
                             class="p-5 hover:bg-slate-50/80 cursor-pointer transition-colors flex flex-col md:flex-row justify-between md:items-center gap-4 group">
                            
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-2xs border border-black/5"
                                     style="background-color: @(ticket.Status?.ColorCode ?? "#4F46E5")20; color: @(ticket.Status?.ColorCode ?? "#4F46E5");">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                                    </svg>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h4 class="font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">@ticket.Title</h4>
                                        @if (ticket.IsOverdue)
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-700 border border-rose-200">
                                                سررسید گذشته
                                            </span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-3 mt-1 text-xs text-slate-400 font-medium">
                                        <span>پروژه: @(ticket.Project?.Name ?? "عمومی")</span>
                                        <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
                                        <span>کاربر: @(ticket.User?.Name ?? "نامشخص")</span>
                                        <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
                                        <span>@ticket.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2.5 border-t md:border-none pt-3 md:pt-0">
                                <span class="px-3 py-1 rounded-xl text-xs font-bold"
                                      style="background-color: @(ticket.Status?.ColorCode ?? "#64748B")20; color: @(ticket.Status?.ColorCode ?? "#64748B");">
                                    @(ticket.Status?.Name ?? "نامشخص")
                                </span>

                                <span class="px-3 py-1 rounded-xl text-xs font-bold @GetPriorityClass(ticket.Priority?.Name ?? "")">
                                    @(ticket.Priority?.Name ?? "نامشخص")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Chart Zoom Modal -->
@if (IsChartModalOpen)
{
    <SectionContent SectionName="RootModal">
        <div class="fixed inset-0 z-[99999] flex items-start justify-center p-4 pt-8 md:pt-12 bg-slate-950/70 backdrop-blur-md fade-in-item" dir="rtl">
            <div class="relative w-full max-w-3xl max-h-[82vh] bg-white rounded-3xl shadow-2xl border border-slate-200/80 overflow-hidden flex flex-col modal-content-animate my-0">
                
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center flex-shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-2xl">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-900 text-xl">@ActiveModalTitle</h3>
                            <p class="text-xs text-slate-400 mt-0.5 font-normal">تحلیل جامع و آمار تفکیکی جزئیات</p>
                        </div>
                    </div>

                    <button @onclick="CloseChartModal" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-full transition-all focus-ring">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <div class="p-6 flex-1 overflow-y-auto custom-scrollbar">
                    @if (ActiveModalType == "trend")
                    {
                        <div class="space-y-6">
                            <div class="h-64 w-full bg-slate-50 rounded-2xl p-4 border border-slate-100">
                                <svg viewBox="0 0 600 200" class="w-full h-full">
                                    <defs>
                                        <linearGradient id="modalTrendGrad" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="#4F46E5" stop-opacity="0.4" />
                                            <stop offset="100%" stop-color="#4F46E5" stop-opacity="0.0" />
                                        </linearGradient>
                                    </defs>
                                    <path d="@BuildSvgAreaPath(TrendData, 600, 200)" fill="url(#modalTrendGrad)" />
                                    <path d="@BuildSvgLinePath(TrendData, 600, 200)" fill="none" stroke="#4F46E5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                @foreach (var day in TrendData ?? Enumerable.Empty<DailyTrendDto>())
                                {
                                    <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100 text-center">
                                        <span class="text-xs text-slate-400 block font-medium">@day.DayLabel</span>
                                        <b class="text-lg text-indigo-600 block mt-1">@day.Count تیکت</b>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (ActiveModalType == "priority")
                    {
                        <div class="space-y-4">
                            @if (PriorityStats != null && PriorityStats.Any())
                            {
                                @foreach (var pri in PriorityStats)
                                {
                                    <div class="p-4 rounded-2xl border border-slate-100 flex items-center justify-between shadow-2xs" style="background-color: @(pri.ColorCode)10; border-color: @(pri.ColorCode)30;">
                                        <div class="flex items-center gap-3">
                                            <span class="w-4 h-4 rounded-full flex-shrink-0" style="background-color: @pri.ColorCode;"></span>
                                            <div>
                                                <span class="font-bold text-slate-900 block text-base">@pri.Name</span>
                                                <span class="text-xs text-slate-400 font-medium">سطح اولویت: @pri.Level</span>
                                            </div>
                                        </div>
                                        <div class="text-left">
                                            <span class="text-xl font-black block" style="color: @pri.ColorCode;">@pri.Count تیکت</span>
                                            <span class="text-xs text-slate-500 font-bold block">@pri.Percentage% از کل تیکت‌ها</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else if (ActiveModalType == "project")
                    {
                        <div class="space-y-4">
                            @foreach (var proj in ProjectStats ?? Enumerable.Empty<ProjectWorkloadDto>())
                            {
                                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-2">
                                    <div class="flex justify-between items-center font-bold">
                                        <span class="text-slate-800 text-base">@proj.ProjectName</span>
                                        <span class="text-purple-600">@proj.TicketCount تیکت ثبت شده</span>
                                    </div>
                                    <div class="w-full bg-slate-200 h-3 rounded-full overflow-hidden">
                                        <div class="bg-purple-600 h-full rounded-full transition-all" style="width: @proj.Percentage%"></div>
                                    </div>
                                    <span class="text-xs text-slate-400 block font-medium">@proj.Percentage% از کل حجم تیکت‌های سیستم</span>
                                </div>
                            }
                        </div>
                    }
                    else if (ActiveModalType == "sla")
                    {
                        <div class="space-y-6 text-center">
                            <div class="p-6 bg-emerald-50 rounded-3xl border border-emerald-100">
                                <span class="text-xs text-emerald-700 font-bold block mb-1">میزان پایبندی به زمان‌بندی (SLA)</span>
                                <h2 class="text-5xl font-black text-emerald-600">@SlaOnTimePercentage%</h2>
                                <p class="text-xs text-emerald-800 mt-2">تیکت‌های که پیش از اتمام موعد بررسی به سرانجام رسیده‌اند.</p>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                                    <span class="text-xs text-slate-400 block">پاسخ‌داده شده به موقع</span>
                                    <b class="text-2xl text-emerald-600 block mt-1">@(TotalTickets - OverdueCount)</b>
                                </div>
                                <div class="p-4 bg-rose-50 rounded-2xl border border-rose-100">
                                    <span class="text-xs text-rose-700 block">تخلف زمان‌بندی (Overdue)</span>
                                    <b class="text-2xl text-rose-600 block mt-1">@OverdueCount</b>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-4 border-t border-slate-100 bg-slate-50/50 flex justify-end flex-shrink-0">
                    <button @onclick="CloseChartModal" class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm rounded-xl transition-all focus-ring">
                        بستن
                    </button>
                </div>
            </div>
        </div>
    </SectionContent>
}

<!-- Create Ticket Modal -->
<TicketFormModal IsOpen="IsCreateModalOpen"
                 Model="NewTicket"
                 Projects="TicketState.Value.AvailableProjects"
                 Priorities="TicketState.Value.AvailablePriorities"
                 Categories="TicketState.Value.AvailableCategories"
                 DynamicFields="TicketState.Value.DynamicFields"
                 OnCategoryChanged="HandleCategoryChanged"
                 OnSubmit="HandleCreateTicket"
                 OnCancel="CloseCreateModal" />