@page "/"
@page "/home"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Fluxor
@using TicketHub.Application.DTOs
@using TicketHub.Application.Interfaces
@using TicketHub.Web.Store
@using TicketHub.Web.Components.Pages.Main.Tickets
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<PageTitle>داشبورد | مرکز پشتیبانی بازی</PageTitle>

<div class="w-full space-y-6 select-none" dir="rtl">
    <!-- Welcome Banner / Cyber Commander HUD -->
    <div class="relative overflow-hidden rounded-3xl bg-[#070a13] p-5 md:p-7 text-white shadow-2xl border border-cyan-500/25">
        <!-- Animated Ambient Laser Atmosphere -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-start gap-4 md:gap-6">
            <div class="space-y-1.5">
                <h1 class="text-2xl md:text-3xl font-black tracking-tight leading-tight text-white drop-shadow-md">
                    خوش آمدید، @UserName
                </h1>
                <p class="text-indigo-100/80 text-xs md:text-sm max-w-2xl leading-relaxed font-normal">
                    مرکز پایش و حل مشکلات بازیکنان، ماموریت‌های باز، باگ‌ها و گزارش‌های ارسال شده به پشتیبانی.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3 flex-shrink-0">
                <button @onclick="OpenCreateModal"
                        data-shortcut-new-ticket
                        class="btn-cyber-primary focus-ring cursor-pointer"
                        title="ثبت کوئست / تیکت جدید (کلید میانبر: N یا C)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>ثبت کوئست / تیکت جدید</span>
                    <kbd class="hidden sm:inline-flex px-1.5 py-0.2 text-[10px] font-mono text-cyan-300 bg-cyan-950/90 border border-cyan-500/50 rounded mr-1">N</kbd>
                </button>
            </div>
        </div>
    </div>

    <!-- Elemental Quick Metrics 6-Card Matrix Grid (Water, Lightning, Toxic, Fire, Void, Smoke) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3">
        <!-- 1. WATER ELEMENT CARD (کل تیکت‌ها) -->
        <QuickStatsCard Title="کل تیکت‌ها" 
                        Value="@DisplayTotalTickets.ToString()" 
                        ElementType="water"
                        BadgeText="🌊 ALL"
                        BadgeClass="bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(56,189,248,0.6)]" 
                        IconThemeClass="bg-cyan-500/20 text-cyan-300 border-cyan-400/40 shadow-inner"
                        IsLoading="@IsLoading">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <!-- 2. LIGHTNING ELEMENT CARD (اقدام نشده / جدید) -->
        <QuickStatsCard Title="اقدام نشده" 
                        Value="@DisplayNewTicketsCount.ToString()" 
                        ElementType="lightning"
                        BadgeText="⚡ NEW"
                        BadgeClass="bg-amber-500/20 text-amber-300 border border-amber-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(250,204,21,0.6)]" 
                        IconThemeClass="bg-amber-500/20 text-amber-300 border-amber-400/40 shadow-inner"
                        IsLoading="@IsLoading">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <!-- 3. TOXIC ACID ELEMENT CARD (در حال بررسی) -->
        <QuickStatsCard Title="در حال بررسی" 
                        Value="@DisplayInProgressCount.ToString()" 
                        ElementType="toxic"
                        BadgeText="🧪 ACTIVE"
                        BadgeClass="bg-lime-500/20 text-lime-300 border border-lime-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_14px_rgba(132,204,22,0.7)]" 
                        IconThemeClass="bg-lime-500/20 text-lime-300 border-lime-400/40 shadow-inner"
                        IsLoading="@IsLoading">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <!-- 4. INFERNO FIRE ELEMENT CARD (بحرانی / اولویت بالا) -->
        <QuickStatsCard Title="بحرانی" 
                        Value="@DisplayCriticalCount.ToString()" 
                        ElementType="fire"
                        BadgeText="🔥 CRITICAL"
                        BadgeClass="bg-rose-500/20 text-rose-300 border border-rose-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(239,68,68,0.6)]" 
                        IconThemeClass="bg-rose-500/20 text-rose-300 border-rose-400/40 shadow-inner"
                        IsLoading="@IsLoading">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <!-- 5. CHRONO VOID ELEMENT CARD (منقضی شده / SLA Breach) -->
        <QuickStatsCard Title="منقضی شده" 
                        Value="@DisplayOverdueCount.ToString()" 
                        ElementType="void"
                        BadgeText="🌀 OVERDUE"
                        BadgeClass="bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(217,70,239,0.7)]" 
                        IconThemeClass="bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-400/40 shadow-inner"
                        IsLoading="@IsLoading">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <!-- 6. QUANTUM SMOKE ELEMENT CARD (خاتمه یافته / بسته شده) -->
        <QuickStatsCard Title="خاتمه یافته" 
                        Value="@DisplayResolvedCount.ToString()" 
                        ElementType="smoke"
                        BadgeText="💨 RESOLVED"
                        BadgeClass="bg-slate-400/20 text-slate-200 border border-slate-300/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_14px_rgba(241,245,249,0.7)]" 
                        IconThemeClass="bg-slate-400/20 text-slate-200 border-slate-300/40 shadow-inner"
                        IsLoading="@IsLoading">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </Icon>
        </QuickStatsCard>
    </div>

    <!-- Charts & Gaming Analytics Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Chart Card 1: Ticket Trends (Laser Wave) -->
        <div @onclick='() => OpenChartModal("trend")'
             class="element-card gamer-card-3d bg-[#080c18]/95 rounded-3xl p-6 shadow-2xl border border-white/[0.08] hover:border-cyan-500/50 cursor-pointer transition-all relative group overflow-hidden">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                        <h3 class="font-bold text-slate-100 text-lg group-hover:text-cyan-300 transition-colors">
                            روند ورودی تیکت‌ها (۷ روز گذشته)
                        </h3>
                    </div>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">نمودار لیزری نوسانات ترافیک و لاگ هفتگی</p>
                </div>
                <div class="p-2.5 bg-cyan-950/60 border border-cyan-500/30 text-cyan-400 rounded-2xl group-hover:bg-cyan-500 group-hover:text-black transition-all shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                    </svg>
                </div>
            </div>

            <div class="h-44 w-full flex items-end pt-4">
                @if (IsLoading)
                {
                    <div class="w-full h-full cyber-skeleton-box rounded-2xl animate-pulse"></div>
                }
                else if (TrendData != null && TrendData.Any())
                {
                    <svg viewBox="0 0 400 120" class="w-full h-full overflow-visible">
                        <defs>
                            <linearGradient id="miniTrendGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.4" />
                                <stop offset="100%" stop-color="#6366f1" stop-opacity="0.0" />
                            </linearGradient>
                            <filter id="neonLaserGlow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#38bdf8" flood-opacity="0.9" />
                            </filter>
                        </defs>
                        <path d="@CachedTrendAreaPath" fill="url(#miniTrendGrad)" />
                        <path d="@CachedTrendLinePath" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" filter="url(#neonLaserGlow)" />
                    </svg>
                }
                else
                {
                    <div class="w-full h-full flex items-center justify-center text-xs text-slate-500">داده‌ای یافت نشد</div>
                }
            </div>

            <div class="flex justify-between items-center border-t border-white/[0.08] pt-3 mt-2 text-xs text-slate-400 font-medium">
                <span>۷ روز قبل</span>
                <span class="font-black text-cyan-300 bg-cyan-950/80 border border-cyan-500/30 px-2.5 py-0.5 rounded-full font-mono">امروز (@(TrendData?.LastOrDefault()?.Count ?? 0) تیکت)</span>
            </div>
        </div>

        <!-- Chart Card 2: Priority Distribution (Gamer Rank Tiers) -->
        <div @onclick='() => OpenChartModal("priority")'
             class="element-card gamer-card-3d bg-[#080c18]/95 rounded-3xl p-6 shadow-2xl border border-white/[0.08] hover:border-amber-500/50 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="font-bold text-slate-100 text-lg group-hover:text-amber-400 transition-colors">
                        توزیع تیکت‌ها بر اساس اولویت و رنک
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">تفکیک درجه اهمیت و دسته‌بندی مأموریت‌ها</p>
                </div>
                <div class="p-2.5 bg-amber-950/60 border border-amber-500/30 text-amber-400 rounded-2xl group-hover:bg-amber-500 group-hover:text-black transition-all shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                    </svg>
                </div>
            </div>

            <div class="space-y-3.5 my-3">
                @if (IsLoading)
                {
                    <div class="space-y-3.5">
                        <div class="h-4 cyber-skeleton-box rounded w-full animate-pulse"></div>
                        <div class="h-4 cyber-skeleton-box rounded w-4/5 animate-pulse"></div>
                        <div class="h-4 cyber-skeleton-box rounded w-3/4 animate-pulse"></div>
                    </div>
                }
                else if (PriorityStats != null && PriorityStats.Any())
                {
                    @foreach (var pri in PriorityStats.Take(4))
                    {
                        <div @key="pri.PriorityId">
                            <div class="flex justify-between text-xs font-black mb-1">
                                <span class="flex items-center gap-1.5" style="color: @pri.ColorCode;">
                                    <span class="w-2 h-2 rounded-full shadow-[0_0_8px_currentColor]" style="background-color: @pri.ColorCode;"></span>
                                    @pri.Name
                                    <span class="text-[10px] opacity-75 font-mono">[LVL @pri.Level]</span>
                                </span>
                                <span class="font-mono font-bold" style="color: @pri.ColorCode;">@pri.Count تیکت (@pri.Percentage%)</span>
                            </div>
                            <div class="w-full bg-slate-900 h-2 rounded-full overflow-hidden p-0.5 border border-white/[0.08]">
                                <div class="h-full rounded-full transition-all duration-500 shadow-[0_0_8px_currentColor]" style="background-color: @pri.ColorCode; width: @pri.Percentage%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-500 text-center py-4">اولویت فعالی تعریف نشده است.</p>
                }
            </div>
        </div>

        <!-- Chart Card 3: Project Workload (Game Realms) -->
        <div @onclick='() => OpenChartModal("project")'
             class="element-card gamer-card-3d bg-[#080c18]/95 rounded-3xl p-6 shadow-2xl border border-white/[0.08] hover:border-purple-500/50 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="font-bold text-slate-100 text-lg group-hover:text-purple-400 transition-colors">
                        سهم بخش‌ها و قلمروها از کل تیکت‌ها
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">بخش‌های پرمصرف و تمرکز لود کاربران</p>
                </div>
                <div class="p-2.5 bg-purple-950/60 border border-purple-500/30 text-purple-400 rounded-2xl group-hover:bg-purple-500 group-hover:text-white transition-all shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
            </div>

            <div class="space-y-3.5 my-3">
                @if (IsLoading)
                {
                    <div class="space-y-3.5">
                        <div class="h-4 cyber-skeleton-box rounded w-full animate-pulse"></div>
                        <div class="h-4 cyber-skeleton-box rounded w-4/5 animate-pulse"></div>
                        <div class="h-4 cyber-skeleton-box rounded w-3/4 animate-pulse"></div>
                    </div>
                }
                else if (ProjectStats != null && ProjectStats.Any())
                {
                    @foreach (var proj in ProjectStats.Take(3))
                    {
                        <div @key="proj.ProjectName">
                            <div class="flex justify-between text-xs font-black mb-1">
                                <span class="text-slate-200 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_6px_#c084fc]"></span>
                                    @proj.ProjectName
                                </span>
                                <span class="text-purple-400 font-mono font-bold">@proj.TicketCount تیکت (@proj.Percentage%)</span>
                            </div>
                            <div class="w-full bg-slate-900 h-2 rounded-full overflow-hidden p-0.5 border border-white/[0.08]">
                                <div class="bg-gradient-to-r from-purple-500 to-indigo-400 h-full rounded-full transition-all duration-500 shadow-[0_0_8px_rgba(168,85,247,0.6)]" style="width: @proj.Percentage%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-500 text-center py-4">اطلاعاتی موجود نیست.</p>
                }
            </div>
        </div>

        <!-- Chart Card 4: SLA Boss / Player Health Bar & Shield -->
        <div @onclick='() => OpenChartModal("sla")'
             class="element-card gamer-card-3d bg-[#080c18]/95 rounded-3xl p-6 shadow-2xl border border-white/[0.08] hover:border-emerald-500/50 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-3">
                <div>
                    <h3 class="font-bold text-slate-100 text-lg group-hover:text-emerald-400 transition-colors flex items-center gap-2">
                        <span>نوار سلامت و پاسخگویی به موقع (SLA HP)</span>
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">پایش مهلت پاسخ و حفاظت از شیلد SLA</p>
                </div>
                <div class="p-2.5 bg-emerald-950/60 border border-emerald-500/30 text-emerald-400 rounded-2xl group-hover:bg-emerald-500 group-hover:text-black transition-all shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>

            <div class="space-y-4 py-2">
                @if (IsLoading)
                {
                    <div class="space-y-3">
                        <div class="h-4 cyber-skeleton-box rounded w-full animate-pulse"></div>
                        <div class="h-5 cyber-skeleton-box rounded-xl w-full animate-pulse"></div>
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <div class="h-14 cyber-skeleton-box rounded-2xl animate-pulse"></div>
                            <div class="h-14 cyber-skeleton-box rounded-2xl animate-pulse"></div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Boss / SLA Animated Health Bar -->
                    <div>
                        <div class="flex justify-between text-xs font-black mb-1.5">
                            <span class="text-slate-300 flex items-center gap-1.5">
                                <span class="w-2.5 h-2.5 rounded-full @(SlaOnTimePercentage >= 85 ? "bg-emerald-400 shadow-[0_0_8px_#34d399]" : SlaOnTimePercentage >= 60 ? "bg-amber-400" : "bg-rose-500 animate-ping")"></span>
                                وضعیت شیلد SLA: 
                                <span class="@(SlaOnTimePercentage >= 85 ? "text-emerald-400" : SlaOnTimePercentage >= 60 ? "text-amber-400" : "text-rose-400") font-mono">
                                    @(SlaOnTimePercentage >= 85 ? "🛡️ OPTIMAL (ایمن)" : SlaOnTimePercentage >= 60 ? "⚠️ WARNING (هشدار)" : "🚨 CRITICAL (بحرانی)")
                                </span>
                            </span>
                            <span class="text-base font-black @(SlaOnTimePercentage >= 85 ? "text-emerald-400" : SlaOnTimePercentage >= 60 ? "text-amber-400" : "text-rose-400") font-mono">
                                @SlaOnTimePercentage% HP
                            </span>
                        </div>

                        <div class="boss-hp-bar h-4.5 rounded-xl bg-slate-950 border border-white/[0.08]">
                            <div class="boss-hp-fill @GetSlaHpClass() rounded-lg" style="width: @SlaOnTimePercentage%;">
                                <div class="boss-hp-stripes"></div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-1">
                        <div class="p-3 bg-[#050811]/90 border border-emerald-500/30 rounded-2xl flex items-center gap-2.5 shadow-inner">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_6px_#34d399] flex-shrink-0"></span>
                            <div>
                                <span class="text-[10px] text-emerald-300 font-bold block">در موعد معین (On-Time)</span>
                                <b class="text-sm font-black text-white font-mono">@(TotalTickets - OverdueCount) تیکت</b>
                            </div>
                        </div>
                        <div class="p-3 bg-[#050811]/90 border border-rose-500/30 rounded-2xl flex items-center gap-2.5 shadow-inner">
                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shadow-[0_0_6px_#f43f5e] flex-shrink-0 @(OverdueCount > 0 ? "animate-pulse" : "")"></span>
                            <div>
                                <span class="text-[10px] text-rose-300 font-bold block">منقضی شده (Overdue)</span>
                                <b class="text-sm font-black text-rose-400 font-mono">@OverdueCount تیکت</b>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Chart Zoom Modal -->
@if (IsChartModalOpen)
{
    <SectionContent SectionName="RootModal">
        <div class="modal-backdrop-quantum fixed inset-0 z-[99999] flex items-start justify-center p-4 pt-8 md:pt-12 bg-black/80 backdrop-blur-xl" dir="rtl">
            <div class="modal-warp-container @GetChartModalBeamClass() relative w-full max-w-3xl max-h-[82vh] rounded-[1.6rem] my-0 select-none text-slate-200">
                <div class="modal-hud-chassis relative w-full h-full rounded-[1.5rem] overflow-hidden flex flex-col my-0">
                
                <div class="p-6 border-b border-white/[0.08] bg-[#050811]/90 flex justify-between items-center flex-shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 bg-cyan-950/80 border border-cyan-500/40 text-cyan-400 rounded-2xl shadow-[0_0_15px_rgba(56,189,248,0.2)]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-black font-mono px-2 py-0.5 rounded-md bg-cyan-950/80 text-cyan-400 border border-cyan-500/30">
                                    [SYS-TELEMETRY // LIVE_FEED]
                                </span>
                                <h3 class="font-black text-slate-100 text-xl">@ActiveModalTitle</h3>
                            </div>
                            <p class="text-xs text-slate-400 mt-1 font-normal">تحلیل جامع و آمار تفکیکی جزئیات عملیات</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="esc-key-badge hidden sm:inline-flex">ESC</span>
                        <button @onclick="CloseChartModal" class="group p-2 text-slate-400 hover:text-cyan-300 hover:bg-slate-800/80 rounded-full transition-all focus-ring cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:rotate-90 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="p-6 flex-1 overflow-y-auto custom-scrollbar">
                    @if (ActiveModalType == "trend")
                    {
                        <div class="space-y-6 stagger-item-1">
                            <div class="h-64 w-full bg-[#050811]/90 rounded-2xl p-4 border border-white/[0.08] shadow-inner">
                                <svg viewBox="0 0 600 200" class="w-full h-full">
                                    <defs>
                                        <linearGradient id="modalTrendGrad" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.4" />
                                            <stop offset="100%" stop-color="#6366f1" stop-opacity="0.0" />
                                        </linearGradient>
                                    </defs>
                                    <path d="@CachedModalTrendAreaPath" fill="url(#modalTrendGrad)" />
                                    <path d="@CachedModalTrendLinePath" fill="none" stroke="#38bdf8" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 stagger-item-2">
                                @foreach (var day in TrendData ?? Enumerable.Empty<DailyTrendDto>())
                                {
                                    <div @key="day.Date" class="bg-[#050811]/80 p-3 rounded-2xl border border-white/[0.08] text-center hover:border-cyan-500/40 transition-colors">
                                        <span class="text-xs text-slate-400 block font-medium">@day.DayLabel</span>
                                        <b class="text-lg text-cyan-300 block mt-1 font-mono">@day.Count تیکت</b>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (ActiveModalType == "priority")
                    {
                        <div class="space-y-4 stagger-item-1">
                            @if (PriorityStats != null && PriorityStats.Any())
                            {
                                @foreach (var pri in PriorityStats)
                                {
                                    <div @key="pri.PriorityId" class="p-4 rounded-2xl border flex items-center justify-between shadow-2xs transition-all hover:scale-[1.01]" style="background-color: @(pri.ColorCode)10; border-color: @(pri.ColorCode)40;">
                                        <div class="flex items-center gap-3">
                                            <span class="w-4 h-4 rounded-full flex-shrink-0 shadow-[0_0_12px_currentColor]" style="background-color: @pri.ColorCode;"></span>
                                            <div>
                                                <span class="font-bold text-slate-100 block text-base">@pri.Name</span>
                                                <span class="text-xs text-slate-400 font-mono">سطح اولویت: @pri.Level</span>
                                            </div>
                                        </div>
                                        <div class="text-left font-mono">
                                            <span class="text-xl font-black block" style="color: @pri.ColorCode;">@pri.Count تیکت</span>
                                            <span class="text-xs text-slate-400 font-bold block">@pri.Percentage% از کل</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else if (ActiveModalType == "project")
                    {
                        <div class="space-y-4 stagger-item-1">
                            @foreach (var proj in ProjectStats ?? Enumerable.Empty<ProjectWorkloadDto>())
                            {
                                <div @key="proj.ProjectName" class="bg-[#050811]/80 p-4 rounded-2xl border border-white/[0.08] space-y-2 hover:border-purple-500/40 transition-colors">
                                    <div class="flex justify-between items-center font-bold">
                                        <span class="text-slate-100 text-base">@proj.ProjectName</span>
                                        <span class="text-purple-400 font-mono">@proj.TicketCount تیکت</span>
                                    </div>
                                    <div class="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden p-0.5 border border-white/[0.08]">
                                        <div class="bg-gradient-to-r from-purple-500 to-indigo-400 h-full rounded-full transition-all" style="width: @proj.Percentage%"></div>
                                    </div>
                                    <span class="text-xs text-slate-400 block font-medium">@proj.Percentage% از کل حجم تیکت‌های سیستم</span>
                                </div>
                            }
                        </div>
                    }
                    else if (ActiveModalType == "sla")
                    {
                        <div class="space-y-6 text-center stagger-item-1">
                            <div class="p-6 bg-[#050811]/90 rounded-3xl border border-emerald-500/40 shadow-[0_0_30px_rgba(16,185,129,0.15)]">
                                <span class="text-xs text-emerald-300 font-bold block mb-1">میزان پایبندی به زمان‌بندی (SLA)</span>
                                <h2 class="text-5xl font-black text-emerald-400 font-mono">@SlaOnTimePercentage%</h2>
                                <p class="text-xs text-slate-400 mt-2">تیکت‌های که پیش از اتمام موعد بررسی به سرانجام رسیده‌اند.</p>
                            </div>

                            <div class="grid grid-cols-2 gap-4 stagger-item-2">
                                <div class="p-4 bg-[#050811]/80 rounded-2xl border border-emerald-500/30">
                                    <span class="text-xs text-emerald-300 block">پاسخ‌داده شده به موقع</span>
                                    <b class="text-2xl text-emerald-400 block mt-1 font-mono">@(TotalTickets - OverdueCount)</b>
                                </div>
                                <div class="p-4 bg-[#050811]/80 rounded-2xl border border-rose-500/30">
                                    <span class="text-xs text-rose-400 block">تخلف زمان‌بندی (Overdue)</span>
                                    <b class="text-2xl text-rose-400 block mt-1 font-mono">@OverdueCount</b>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-4 border-t border-white/[0.08] bg-[#050811]/90 flex justify-end flex-shrink-0">
                    <button @onclick="CloseChartModal" class="btn-cyber-ghost focus-ring">
                        <span>بستن پنجره</span>
                    </button>
                </div>
                </div>
            </div>
        </div>
    </SectionContent>
}

<!-- Create Ticket Modal -->
<TicketFormModal IsOpen="IsCreateModalOpen"
                 Model="NewTicket"
                 Projects="TicketState.Value.AvailableProjects"
                 Priorities="TicketState.Value.AvailablePriorities"
                 Categories="TicketState.Value.AvailableCategories"
                 DynamicFields="TicketState.Value.DynamicFields"
                 OnCategoryChanged="HandleCategoryChanged"
                 OnSubmit="HandleCreateTicket"
                 OnCancel="CloseCreateModal" />