@page "/"
@page "/home"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using Fluxor
@using TicketHub.Application.DTOs
@using TicketHub.Application.Interfaces
@using TicketHub.Web.Store
@using TicketHub.Web.Components.Pages.Main.Tickets
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@rendermode InteractiveServer

<PageTitle>داشبورد | مرکز پشتیبانی بازی</PageTitle>

<div class="w-full space-y-8 select-none" dir="rtl">
    <!-- Welcome Banner / Cyber Commander HUD with Full Background EKG Heartbeat -->
    <div class="relative overflow-hidden rounded-3xl bg-[#070a13] p-8 md:p-10 text-white shadow-2xl border border-cyan-500/30">
        <!-- Live Full Background EKG Telemetry & Heartbeat Canvas -->
        <canvas class="hero-ekg-canvas absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>
        
        <!-- Animated Scanline & Ambient Laser Atmosphere -->
        <div class="scanline-glow"></div>
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <div class="flex flex-wrap items-center gap-3 mb-3">
                    <span class="hero-ekg-status px-3.5 py-1 rounded-full text-xs font-black bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 backdrop-blur-md flex items-center gap-2 shadow-xs transition-all duration-300">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                        <span class="font-mono">💚 VITALS: STABLE [78 BPM]</span>
                    </span>
                    <span class="px-3.5 py-1 rounded-full text-xs font-black bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 backdrop-blur-md flex items-center gap-2 shadow-xs">
                        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></span>
                        مرکز فرماندهی بازی
                    </span>
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        سرور آنلاین // پچ ۱.۰
                    </span>
                    <span class="text-xs text-indigo-200/70 font-medium flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        @CurrentPersianDate
                    </span>
                </div>
                <h1 class="text-3xl md:text-4xl font-black tracking-tight leading-tight text-white drop-shadow-md flex items-center gap-3">
                    خوش آمدید، @UserName
                    <span class="text-xs px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-400/40 font-mono">
                        LVL 99 GAMEMASTER
                    </span>
                </h1>
                <p class="text-indigo-100/80 text-sm md:text-base mt-2 max-w-2xl leading-relaxed font-normal">
                    مرکز پایش و حل مشکلات بازیکنان، ماموریت‌های باز، باگ‌ها و گزارش‌های ارسال شده به پشتیبانی.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <button @onclick="OpenCreateModal"
                        class="px-6 py-3.5 bg-gradient-to-r from-indigo-600 via-indigo-500 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-black text-sm rounded-2xl shadow-xl shadow-indigo-600/30 hover:scale-[1.03] active:scale-95 transition-all flex items-center gap-2 focus-ring border border-white/20">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    ثبت کوئست / تیکت جدید
                </button>
            </div>
        </div>
    </div>

    <!-- Elemental Quick Metrics Grid (Water, Lightning, Toxic Acid, Fire) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- 1. WATER ELEMENT CARD (کل تیکت‌ها) -->
        <QuickStatsCard Title="کل تیکت‌های دسترس" 
                        Value="@TotalTickets.ToString()" 
                        ElementType="water"
                        BadgeText="🌊 ALL TICKETS"
                        BadgeClass="bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(56,189,248,0.6)]" 
                        IconThemeClass="bg-cyan-500/20 text-cyan-300 border-cyan-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <!-- 2. LIGHTNING ELEMENT CARD (اقدام نشده / جدید) -->
        <QuickStatsCard Title="اقدام نشده (جدید)" 
                        Value="@NewTicketsCount.ToString()" 
                        ElementType="lightning"
                        BadgeText="⚡ NEW QUESTS"
                        BadgeClass="bg-amber-500/20 text-amber-300 border border-amber-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(250,204,21,0.6)]" 
                        IconThemeClass="bg-cyan-500/20 text-cyan-300 border-cyan-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <!-- 3. TOXIC ACID ELEMENT CARD (در حال بررسی) -->
        <QuickStatsCard Title="در حال بررسی" 
                        Value="@InProgressCount.ToString()" 
                        ElementType="toxic"
                        BadgeText="🧪 IN ACTION"
                        BadgeClass="bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(34,197,94,0.6)]" 
                        IconThemeClass="bg-emerald-500/20 text-emerald-300 border-emerald-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
            </Icon>
        </QuickStatsCard>

        <!-- 4. INFERNO FIRE ELEMENT CARD (بحرانی / منقضی‌ شده) -->
        <QuickStatsCard Title="بحرانی / منقضی‌ شده" 
                        Value="@CriticalAndOverdueCount.ToString()" 
                        ElementType="fire"
                        BadgeText="🔥 BOSS FIGHT"
                        BadgeClass="bg-rose-500/20 text-rose-300 border border-rose-400/40 shadow-sm"
                        ValueColorClass="text-white drop-shadow-[0_0_12px_rgba(239,68,68,0.6)]" 
                        IconThemeClass="bg-rose-500/20 text-rose-300 border-rose-400/40 shadow-inner">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z" />
                </svg>
            </Icon>
        </QuickStatsCard>
    </div>

    <!-- Charts & Gaming Analytics Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Chart Card 1: 7-Day Tickets Laser Trend -->
        <div @onclick='() => OpenChartModal("trend")'
             class="element-card gamer-card-3d bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 hover:shadow-xl hover:border-indigo-300 cursor-pointer transition-all relative group overflow-hidden">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-indigo-500 animate-ping"></span>
                        <h3 class="font-bold text-slate-800 text-lg group-hover:text-indigo-600 transition-colors">
                            روند ورودی تیکت‌ها (۷ روز گذشته)
                        </h3>
                    </div>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">نمودار لیزری نوسانات ترافیک و لاگ هفتگی</p>
                </div>
                <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-2xl group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                    </svg>
                </div>
            </div>

            <div class="h-44 w-full flex items-end pt-4">
                @if (TrendData != null && TrendData.Any())
                {
                    <svg viewBox="0 0 400 120" class="w-full h-full overflow-visible">
                        <defs>
                            <linearGradient id="miniTrendGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#4F46E5" stop-opacity="0.4" />
                                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.0" />
                            </linearGradient>
                            <filter id="neonLaserGlow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#6366f1" flood-opacity="0.8" />
                            </filter>
                        </defs>
                        <path d="@BuildSvgAreaPath(TrendData, 400, 120)" fill="url(#miniTrendGrad)" />
                        <path d="@BuildSvgLinePath(TrendData, 400, 120)" fill="none" stroke="#4F46E5" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#neonLaserGlow)" />
                    </svg>
                }
            </div>

            <div class="flex justify-between items-center border-t border-slate-100 pt-3 mt-2 text-xs text-slate-400 font-medium">
                <span>۷ روز قبل</span>
                <span class="font-black text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full">امروز (@(TrendData?.LastOrDefault()?.Count ?? 0) تیکت)</span>
            </div>
        </div>

        <!-- Chart Card 2: Priority Distribution (Gamer Rank Tiers) -->
        <div @onclick='() => OpenChartModal("priority")'
             class="element-card gamer-card-3d bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 hover:shadow-xl hover:border-amber-300 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-amber-600 transition-colors">
                        توزیع تیکت‌ها بر اساس اولویت و رنک
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">تفکیک درجه اهمیت و دسته‌بندی مأموریت‌ها</p>
                </div>
                <div class="p-2.5 bg-amber-50 text-amber-600 rounded-2xl group-hover:bg-amber-600 group-hover:text-white transition-all shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                    </svg>
                </div>
            </div>

            <div class="space-y-3.5 my-3">
                @if (PriorityStats != null && PriorityStats.Any())
                {
                    @foreach (var pri in PriorityStats.Take(4))
                    {
                        <div>
                            <div class="flex justify-between text-xs font-black mb-1">
                                <span class="flex items-center gap-1.5" style="color: @pri.ColorCode;">
                                    <span class="w-2.5 h-2.5 rounded-full shadow-xs" style="background-color: @pri.ColorCode;"></span>
                                    @pri.Name
                                    <span class="text-[10px] opacity-75 font-mono">[LVL @pri.Level]</span>
                                </span>
                                <span class="font-black" style="color: @pri.ColorCode;">@pri.Count تیکت (@pri.Percentage%)</span>
                            </div>
                            <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden p-0.5 border border-slate-200/50">
                                <div class="h-full rounded-full transition-all duration-500" style="width: @pri.Percentage%; background-color: @pri.ColorCode; box-shadow: 0 0 8px @(pri.ColorCode)80;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 text-center py-4">اولویت فعالی تعریف نشده است.</p>
                }
            </div>
        </div>

        <!-- Chart Card 3: Project Workload (Game Realms) -->
        <div @onclick='() => OpenChartModal("project")'
             class="element-card gamer-card-3d bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 hover:shadow-xl hover:border-purple-300 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-purple-600 transition-colors">
                        سهم بخش‌ها و قلمروها از کل تیکت‌ها
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">بخش‌های پرمصرف و تمرکز لود کاربران</p>
                </div>
                <div class="p-2.5 bg-purple-50 text-purple-600 rounded-2xl group-hover:bg-purple-600 group-hover:text-white transition-all shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
            </div>

            <div class="space-y-3.5 my-2">
                @if (ProjectStats != null && ProjectStats.Any())
                {
                    @foreach (var proj in ProjectStats.Take(3))
                    {
                        <div>
                            <div class="flex justify-between text-xs font-black mb-1">
                                <span class="text-slate-800 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                                    @proj.ProjectName
                                </span>
                                <span class="text-purple-600 font-bold">@proj.TicketCount تیکت (@proj.Percentage%)</span>
                            </div>
                            <div class="w-full bg-purple-50 h-2.5 rounded-full overflow-hidden p-0.5 border border-purple-100">
                                <div class="bg-gradient-to-r from-purple-600 to-indigo-500 h-full rounded-full transition-all duration-500 shadow-xs" style="width: @proj.Percentage%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 text-center py-4">اطلاعاتی موجود نیست.</p>
                }
            </div>
        </div>

        <!-- Chart Card 4: SLA Boss / Player Health Bar & Shield -->
        <div @onclick='() => OpenChartModal("sla")'
             class="element-card gamer-card-3d bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 hover:shadow-xl hover:border-emerald-300 cursor-pointer transition-all relative group">
            <div class="flex justify-between items-center mb-3">
                <div>
                    <h3 class="font-bold text-slate-800 text-lg group-hover:text-emerald-600 transition-colors flex items-center gap-2">
                        <span>نوار سلامت و پاسخگویی به موقع (SLA HP)</span>
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5 font-normal">پایش مهلت پاسخ و حفاظت از شیلد SLA</p>
                </div>
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-2xl group-hover:bg-emerald-600 group-hover:text-white transition-all shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>

            <div class="space-y-4 py-2">
                <!-- Boss / SLA Animated Health Bar -->
                <div>
                    <div class="flex justify-between text-xs font-black mb-1.5">
                        <span class="text-slate-700 flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full @(SlaOnTimePercentage >= 85 ? "bg-emerald-500" : SlaOnTimePercentage >= 60 ? "bg-amber-500" : "bg-rose-500 animate-ping")"></span>
                            وضعیت شیلد SLA: 
                            <span class="@(SlaOnTimePercentage >= 85 ? "text-emerald-600" : SlaOnTimePercentage >= 60 ? "text-amber-600" : "text-rose-600") font-mono">
                                @(SlaOnTimePercentage >= 85 ? "🛡️ OPTIMAL (ایمن)" : SlaOnTimePercentage >= 60 ? "⚠️ WARNING (هشدار)" : "🚨 CRITICAL (بحرانی)")
                            </span>
                        </span>
                        <span class="text-base font-black @(SlaOnTimePercentage >= 85 ? "text-emerald-600" : SlaOnTimePercentage >= 60 ? "text-amber-600" : "text-rose-600") font-mono">
                            @SlaOnTimePercentage% HP
                        </span>
                    </div>

                    <div class="boss-hp-bar h-5 rounded-xl">
                        <div class="boss-hp-fill @GetSlaHpClass() rounded-lg" style="width: @SlaOnTimePercentage%;">
                            <div class="boss-hp-stripes"></div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 pt-1">
                    <div class="p-3 bg-emerald-50/70 border border-emerald-100 rounded-2xl flex items-center gap-2.5">
                        <span class="w-3 h-3 rounded-full bg-emerald-500 flex-shrink-0"></span>
                        <div>
                            <span class="text-[10px] text-emerald-800 font-bold block">در موعد معین (On-Time)</span>
                            <b class="text-sm font-black text-emerald-950 font-mono">@(TotalTickets - OverdueCount) تیکت</b>
                        </div>
                    </div>
                    <div class="p-3 bg-rose-50/70 border border-rose-100 rounded-2xl flex items-center gap-2.5">
                        <span class="w-3 h-3 rounded-full bg-rose-500 flex-shrink-0 @(OverdueCount > 0 ? "animate-pulse" : "")"></span>
                        <div>
                            <span class="text-[10px] text-rose-800 font-bold block">منقضی شده (Overdue)</span>
                            <b class="text-sm font-black text-rose-950 font-mono">@OverdueCount تیکت</b>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Tickets Stream Section (Gamer Quest Board / Mission Log) -->
    <div class="bg-white rounded-3xl shadow-2xs border border-slate-200/80 overflow-hidden select-none">
        <div class="p-6 border-b border-slate-100 flex flex-wrap justify-between items-center bg-slate-50/50 gap-4">
            <div class="flex items-center gap-3">
                <div class="w-3.5 h-3.5 rounded-full bg-indigo-600 animate-ping"></div>
                <div>
                    <h2 class="text-xl font-black text-slate-800 flex items-center gap-2">
                        <span>⚔️ لاگ مأموریت‌ها و تیکت‌های زنده</span>
                        <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-indigo-100 text-indigo-700">
                            LIVE QUEST LOG
                        </span>
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5">جریان آخرین درخواست‌های ثبت‌شده بازیکنان و کاربران</p>
                </div>
            </div>
            <button @onclick='() => Navigation.NavigateTo("/tickets")'
                    class="text-xs font-black text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 transition-all flex items-center gap-1.5 focus-ring rounded-xl px-4 py-2 border border-indigo-200/60 shadow-2xs">
                مشاهده تمام مأموریت‌ها
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>

        <div class="p-0">
            @if (IsLoading)
            {
                <div class="flex justify-center items-center py-16">
                    <div class="animate-spin rounded-full h-9 w-9 border-b-2 border-indigo-600"></div>
                </div>
            }
            else if (RecentTickets == null || !RecentTickets.Any())
            {
                <div class="text-center py-16 text-slate-400 text-sm">
                    تیکت یا مأموریتی برای نمایش یافت نشد.
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var ticket in RecentTickets)
                    {
                        <div @onclick="() => NavigateToDetails(ticket.Id)"
                             class="quest-row-item p-5 cursor-pointer flex flex-col md:flex-row justify-between md:items-center gap-4 group">
                            
                            <div class="flex items-start gap-4">
                                <div class="w-11 h-11 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-2xs border border-black/5 transition-transform group-hover:scale-110"
                                     style="background-color: @(ticket.Status?.ColorCode ?? "#4F46E5")20; color: @(ticket.Status?.ColorCode ?? "#4F46E5");">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                                    </svg>
                                </div>
                                <div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="text-[10px] font-black font-mono px-2 py-0.5 rounded-md border @GetRarityTagClass(ticket)">
                                            @GetRarityTag(ticket)
                                        </span>
                                        <h4 class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors text-base">@ticket.Title</h4>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-3 mt-1.5 text-xs text-slate-400 font-medium">
                                        <span>قلمرو/پروژه: <b class="text-slate-600">@(ticket.Project?.Name ?? "عمومی")</b></span>
                                        <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
                                        <span>کاربر: <b class="text-slate-600">@(ticket.User?.Name ?? "نامشخص")</b></span>
                                        <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
                                        <span class="font-mono">@ticket.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2.5 border-t md:border-none pt-3 md:pt-0">
                                <span class="px-3.5 py-1.5 rounded-xl text-xs font-black shadow-2xs"
                                      style="background-color: @(ticket.Status?.ColorCode ?? "#64748B")20; color: @(ticket.Status?.ColorCode ?? "#64748B"); border: 1px solid @(ticket.Status?.ColorCode ?? "#64748B")40;">
                                    @(ticket.Status?.Name ?? "نامشخص")
                                </span>

                                <span class="px-3.5 py-1.5 rounded-xl text-xs font-black @GetPriorityClass(ticket.Priority?.Name ?? "")">
                                    @(ticket.Priority?.Name ?? "نامشخص")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Chart Zoom Modal -->
@if (IsChartModalOpen)
{
    <SectionContent SectionName="RootModal">
        <div class="fixed inset-0 z-[99999] flex items-start justify-center p-4 pt-8 md:pt-12 bg-slate-950/70 backdrop-blur-md fade-in-item" dir="rtl">
            <div class="relative w-full max-w-3xl max-h-[82vh] bg-white rounded-3xl shadow-2xl border border-slate-200/80 overflow-hidden flex flex-col modal-content-animate my-0">
                
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center flex-shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-2xl">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-900 text-xl">@ActiveModalTitle</h3>
                            <p class="text-xs text-slate-400 mt-0.5 font-normal">تحلیل جامع و آمار تفکیکی جزئیات</p>
                        </div>
                    </div>

                    <button @onclick="CloseChartModal" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-full transition-all focus-ring">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <div class="p-6 flex-1 overflow-y-auto custom-scrollbar">
                    @if (ActiveModalType == "trend")
                    {
                        <div class="space-y-6">
                            <div class="h-64 w-full bg-slate-50 rounded-2xl p-4 border border-slate-100">
                                <svg viewBox="0 0 600 200" class="w-full h-full">
                                    <defs>
                                        <linearGradient id="modalTrendGrad" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="#4F46E5" stop-opacity="0.4" />
                                            <stop offset="100%" stop-color="#4F46E5" stop-opacity="0.0" />
                                        </linearGradient>
                                    </defs>
                                    <path d="@BuildSvgAreaPath(TrendData, 600, 200)" fill="url(#modalTrendGrad)" />
                                    <path d="@BuildSvgLinePath(TrendData, 600, 200)" fill="none" stroke="#4F46E5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                @foreach (var day in TrendData ?? Enumerable.Empty<DailyTrendDto>())
                                {
                                    <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100 text-center">
                                        <span class="text-xs text-slate-400 block font-medium">@day.DayLabel</span>
                                        <b class="text-lg text-indigo-600 block mt-1">@day.Count تیکت</b>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (ActiveModalType == "priority")
                    {
                        <div class="space-y-4">
                            @if (PriorityStats != null && PriorityStats.Any())
                            {
                                @foreach (var pri in PriorityStats)
                                {
                                    <div class="p-4 rounded-2xl border border-slate-100 flex items-center justify-between shadow-2xs" style="background-color: @(pri.ColorCode)10; border-color: @(pri.ColorCode)30;">
                                        <div class="flex items-center gap-3">
                                            <span class="w-4 h-4 rounded-full flex-shrink-0" style="background-color: @pri.ColorCode;"></span>
                                            <div>
                                                <span class="font-bold text-slate-900 block text-base">@pri.Name</span>
                                                <span class="text-xs text-slate-400 font-medium">سطح اولویت: @pri.Level</span>
                                            </div>
                                        </div>
                                        <div class="text-left">
                                            <span class="text-xl font-black block" style="color: @pri.ColorCode;">@pri.Count تیکت</span>
                                            <span class="text-xs text-slate-500 font-bold block">@pri.Percentage% از کل تیکت‌ها</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else if (ActiveModalType == "project")
                    {
                        <div class="space-y-4">
                            @foreach (var proj in ProjectStats ?? Enumerable.Empty<ProjectWorkloadDto>())
                            {
                                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-2">
                                    <div class="flex justify-between items-center font-bold">
                                        <span class="text-slate-800 text-base">@proj.ProjectName</span>
                                        <span class="text-purple-600">@proj.TicketCount تیکت ثبت شده</span>
                                    </div>
                                    <div class="w-full bg-slate-200 h-3 rounded-full overflow-hidden">
                                        <div class="bg-purple-600 h-full rounded-full transition-all" style="width: @proj.Percentage%"></div>
                                    </div>
                                    <span class="text-xs text-slate-400 block font-medium">@proj.Percentage% از کل حجم تیکت‌های سیستم</span>
                                </div>
                            }
                        </div>
                    }
                    else if (ActiveModalType == "sla")
                    {
                        <div class="space-y-6 text-center">
                            <div class="p-6 bg-emerald-50 rounded-3xl border border-emerald-100">
                                <span class="text-xs text-emerald-700 font-bold block mb-1">میزان پایبندی به زمان‌بندی (SLA)</span>
                                <h2 class="text-5xl font-black text-emerald-600">@SlaOnTimePercentage%</h2>
                                <p class="text-xs text-emerald-800 mt-2">تیکت‌های که پیش از اتمام موعد بررسی به سرانجام رسیده‌اند.</p>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                                    <span class="text-xs text-slate-400 block">پاسخ‌داده شده به موقع</span>
                                    <b class="text-2xl text-emerald-600 block mt-1">@(TotalTickets - OverdueCount)</b>
                                </div>
                                <div class="p-4 bg-rose-50 rounded-2xl border border-rose-100">
                                    <span class="text-xs text-rose-700 block">تخلف زمان‌بندی (Overdue)</span>
                                    <b class="text-2xl text-rose-600 block mt-1">@OverdueCount</b>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-4 border-t border-slate-100 bg-slate-50/50 flex justify-end flex-shrink-0">
                    <button @onclick="CloseChartModal" class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm rounded-xl transition-all focus-ring">
                        بستن
                    </button>
                </div>
            </div>
        </div>
    </SectionContent>
}

<!-- Create Ticket Modal -->
<TicketFormModal IsOpen="IsCreateModalOpen"
                 Model="NewTicket"
                 Projects="TicketState.Value.AvailableProjects"
                 Priorities="TicketState.Value.AvailablePriorities"
                 Categories="TicketState.Value.AvailableCategories"
                 DynamicFields="TicketState.Value.DynamicFields"
                 OnCategoryChanged="HandleCategoryChanged"
                 OnSubmit="HandleCreateTicket"
                 OnCancel="CloseCreateModal" />