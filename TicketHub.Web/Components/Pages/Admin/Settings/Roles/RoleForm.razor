@namespace TicketHub.Web.Components.Pages.Admin.Settings.Roles
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 rounded-2xl p-6 shadow-[0_0_25px_rgba(8,13,26,0.85)] relative overflow-hidden select-none sticky top-24">
    <!-- Laser Top Edge Sweep -->
    <div class="cyber-laser-sweep"></div>

    <!-- Header -->
    <div class="flex items-center justify-between mb-5 border-b border-white/[0.08] pb-3">
        <div class="space-y-1">
            <h3 class="font-black text-white text-base tracking-tight flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_rgba(56,189,248,0.8)]"></span>
                @(IsEditing ? "ویرایش نقش" : "ایجاد نقش جدید")
            </h3>
            <span class="text-[11px] text-slate-400 block font-medium">پیکربندی اطلاعات و دسترسی‌های نقش سازمانی</span>
        </div>

        <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-400/30 flex items-center justify-center text-cyan-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
        </div>
    </div>

    <!-- Edit/Create Form -->
    <EditForm Model="Model" OnValidSubmit="OnValidSubmit">
        <FluentValidationValidator />
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">عنوان نقش</label>
                <div class="field-spark-wrap relative rounded-2xl">
                    <InputText @bind-Value="Model.Name"
                               class="w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                               placeholder="مثال: کارشناس پشتیبانی" />
                </div>
                <ValidationMessage For="@(() => Model.Name)" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
            </div>

            <div class="pt-1">
                <CustomCheckbox Label="نقش فعال است" @bind-Value="Model.IsActive" />
            </div>

            <div class="flex gap-2.5 pt-2">
                <button type="submit"
                        class="flex-1 flex justify-center items-center gap-2 py-2.5 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-400 hover:via-blue-500 hover:to-indigo-500 transition-all shadow-[0_0_18px_rgba(56,189,248,0.35)] hover:shadow-[0_0_25px_rgba(56,189,248,0.5)] cursor-pointer focus:outline-none">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>@(IsEditing ? "ذخیره تغییرات" : "ثبت نقش")</span>
                </button>

                @if (IsEditing)
                {
                    <button type="button"
                            @onclick="OnCancel"
                            class="py-2.5 px-4 rounded-xl text-sm font-bold text-slate-300 hover:text-white bg-[#050811] hover:bg-slate-900 border border-slate-700/80 hover:border-slate-500 transition-all cursor-pointer focus:outline-none">
                        انصراف
                    </button>
                }
            </div>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="mt-4 p-3.5 @(IsError ? "bg-rose-950/60 text-rose-300 border-rose-500/40 shadow-[0_0_15px_rgba(244,63,94,0.2)]" : "bg-emerald-950/60 text-emerald-300 border-emerald-500/40 shadow-[0_0_15px_rgba(16,185,129,0.2)]") border rounded-xl text-xs font-bold text-center flex items-center justify-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                @if (IsError)
                {
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                }
                else
                {
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                }
            </svg>
            <span>@SuccessMessage</span>
        </div>
    }
</div>