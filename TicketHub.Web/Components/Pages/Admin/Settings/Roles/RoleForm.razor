@namespace TicketHub.Web.Components.Pages.Admin.Settings.Roles
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<div class="bg-white rounded-3xl p-6 shadow-2xs border border-slate-200/80 sticky top-24 select-none">
    <h3 class="font-bold text-slate-800 mb-4 text-lg tracking-tight">@(IsEditing ? "ویرایش نقش" : "ایجاد نقش جدید")</h3>

    <EditForm Model="Model" OnValidSubmit="OnValidSubmit">
        <FluentValidationValidator />
        <div class="space-y-5">
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">عنوان نقش (انگلیسی یا فارسی)</label>
                <InputText @bind-Value="Model.Name" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="مثال: Support" />
                <ValidationMessage For="@(() => Model.Name)" class="text-rose-500 text-red-500 text-xs mt-1" />
            </div>

            <div class="flex items-center mt-3">
                <CustomCheckbox Label="نقش فعال است؟" @bind-Value="Model.IsActive" />
            </div>

            <div class="flex gap-2 pt-2">
                <button type="submit" class="flex-1 flex justify-center py-3 px-4 rounded-2xl shadow-lg shadow-indigo-500/20 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus-ring transition-all">
                    @(IsEditing ? "ذخیره تغییرات" : "ثبت نقش")
                </button>
                @if (IsEditing)
                {
                    <button type="button" @onclick="OnCancel" class="py-3 px-4 rounded-2xl text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors focus-ring">
                        انصراف
                    </button>
                }
            </div>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="mt-4 p-3 @(IsError ? "bg-rose-50 text-rose-600 border border-rose-200/60" : "bg-emerald-50 text-emerald-600 border border-emerald-200/60") rounded-2xl text-xs font-bold text-center transition-all">@SuccessMessage</div>
    }
</div>