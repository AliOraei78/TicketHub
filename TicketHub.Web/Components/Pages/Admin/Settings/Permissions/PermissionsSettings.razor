@page "/settings/permissions"
@using TicketHub.Web.Components.Shared
@using TicketHub.Application.DTOs
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<PageTitle>مدیریت دسترسی‌ها | سامانه تیکت‌هاب</PageTitle>

<div class="w-full flex flex-col gap-3 flex-1 select-none" dir="rtl">
    <!-- Centered Cyber Operations Master Banner -->
    <div class="relative overflow-hidden rounded-xl bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 p-3 sm:p-3.5 shadow-[0_0_25px_rgba(8,13,26,0.85)] flex flex-col gap-2.5">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-cyan-500/20 via-indigo-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Section: Centered Title & Centered Subtitle -->
        <div class="relative z-10 flex flex-col items-center justify-center text-center gap-2">
            <div class="space-y-1.5 flex flex-col items-center">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white drop-shadow-[0_2px_15px_rgba(255,255,255,0.35)] leading-tight flex items-center justify-center gap-2.5 flex-wrap text-center">
                    <span class="bg-gradient-to-r from-cyan-300 via-indigo-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_18px_rgba(56,189,248,0.7)]">مدیریت دسترسی‌های سیستم</span>
                </h1>
                <p class="text-slate-200 text-sm sm:text-base font-semibold tracking-wide flex items-center justify-center gap-2 flex-wrap text-center">
                    <span>🔐 سطوح مجوزهای دسترسی</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>کنترل امنیت مسیرها و بخش‌های سامانه</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>تفکیک وظایف بر اساس نقش</span>
                </p>
            </div>
        </div>

        <!-- Bottom Row: 3 Holographic Telemetry Cards -->
        <div class="relative z-10 pt-2 border-t border-white/[0.08] grid grid-cols-1 sm:grid-cols-3 gap-2">
            <!-- 1. Total Permissions (Cyan) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(56, 189, 248, 0.5); --seg-glow: rgba(56, 189, 248, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-cyan-300/90 font-bold truncate">کل دسترسی‌ها</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-cyan-400/60 uppercase">همه</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(56,189,248,0.7)] px-1">
                    @TotalPermissionsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 2. Active Permissions (Emerald) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(16, 185, 129, 0.5); --seg-glow: rgba(16, 185, 129, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-emerald-300/90 font-bold truncate">دسترسی‌های فعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-400/60 uppercase">فعال</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(16,185,129,0.7)] px-1">
                    @ActivePermissionsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 3. Inactive Permissions (Rose) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(244, 63, 94, 0.5); --seg-glow: rgba(244, 63, 94, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-rose-500/15 border border-rose-400/30 flex items-center justify-center text-rose-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-rose-300/90 font-bold truncate">دسترسی‌های غیرفعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-rose-400/60 uppercase">غیرفعال</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(244,63,94,0.7)] px-1">
                    @InactivePermissionsCount.ToPersianNumbers()
                </span>
            </div>
        </div>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- Right Column: Add/Edit Permission Form (5 Cols on lg, 4 on xl) -->
        <div class="lg:col-span-5 xl:col-span-4">
            <PermissionForm Model="permModel"
                            IsEditing="isEditing"
                            AvailableRoles="PermState.Value.AvailableRoles"
                            OnValidSubmit="HandleSubmit"
                            OnCancel="CancelEdit" />
        </div>

        <!-- Left Column: Permissions DataGrid & Filter Bar (7 Cols on lg, 8 on xl) -->
        <div class="lg:col-span-7 xl:col-span-8 space-y-3">
            <!-- Search & Filter Command Bar -->
            <div class="bg-[#080d1a]/95 backdrop-blur-2xl p-3 px-4 rounded-2xl shadow-[0_0_25px_rgba(8,13,26,0.85)] border border-cyan-500/35 flex flex-wrap sm:flex-nowrap gap-3 items-center justify-between select-none">
                <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full sm:w-auto flex-1">
                    <div class="w-full sm:w-48 md:w-56">
                        <SearchBox Placeholder="جستجوی دسترسی..." SearchTerm="@PermState.Value.SearchTerm" OnSearchChanged="HandleSearch" />
                    </div>

                    <div class="w-full sm:w-40 md:w-48 z-10">
                        <MultiSelectDropdown TItem="RoleDto" TValue="int"
                                             Placeholder="فیلتر نقش..."
                                             Items="PermState.Value.AvailableRoles"
                                             SelectedValues="PermState.Value.SelectedFilterRoleIds"
                                             SelectedValuesChanged="FilterByRoles"
                                             ValueSelector="r => r.Id"
                                             DisplaySelector="r => r.Name" />
                    </div>
                </div>

                <!-- 3-State Cyberpunk Status Filter Switcher -->
                <div class="flex items-center gap-1 p-1 bg-[#050811]/90 rounded-2xl border border-white/[0.12] h-[46px] w-full sm:w-auto shrink-0 select-none">
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(null))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(PermState.Value.SelectedFilterStatus == null ? "bg-cyan-500/20 text-cyan-300 border border-cyan-400/50 shadow-[0_0_10px_rgba(56,189,248,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        همه (@TotalPermissionsCount.ToPersianNumbers())
                    </button>
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(true))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(PermState.Value.SelectedFilterStatus == true ? "bg-emerald-500/20 text-emerald-300 border border-emerald-400/50 shadow-[0_0_10px_rgba(16,185,129,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        فعال (@ActivePermissionsCount.ToPersianNumbers())
                    </button>
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(false))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(PermState.Value.SelectedFilterStatus == false ? "bg-rose-500/20 text-rose-300 border border-rose-400/50 shadow-[0_0_10px_rgba(244,63,94,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        غیرفعال (@InactivePermissionsCount.ToPersianNumbers())
                    </button>
                </div>
            </div>

            <!-- Permissions Table Container -->
            <div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 rounded-2xl shadow-[0_0_25px_rgba(8,13,26,0.85)] overflow-hidden relative">
                <!-- Laser Top Edge Sweep -->
                <div class="cyber-laser-sweep"></div>

                <div class="p-0">
                    <DataGrid TItem="TicketHub.Application.DTOs.PermissionDto" TKey="int"
                              Items="FilteredPermissions"
                              IsLoading="PermState.Value.IsLoading"
                              KeySelector="p => p.Id"
                              SelectedKeys="selectedIds"
                              SelectedKeysChanged="OnSelectionChanged"
                              ShowRowIndex="false"
                              EmptyStateValue="دسترسی"
                              IsCyberpunk="true">

                        <HeaderTemplate>
                            <th class="pr-5 pl-3 sm:pr-6 sm:pl-4 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[30%]">عنوان دسترسی</th>
                            <th class="px-3 sm:px-4 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[24%]">کلید منبع</th>
                            <th class="px-3 sm:px-4 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[20%]">نقش‌های مرتبط</th>
                            <th class="px-3 sm:px-4 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[12%]">وضعیت</th>
                            <th class="px-2 sm:px-3 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-center w-[14%]">عملیات</th>
                        </HeaderTemplate>

                        <RowTemplate Context="perm">
                            <td class="pr-5 pl-3 sm:pr-6 sm:pl-4 py-3 w-[30%]">
                                <div class="flex items-center gap-3 sm:gap-3.5 min-w-0">
                                    <!-- Dynamic Permission Type Icon Box -->
                                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl flex items-center justify-center flex-shrink-0 @GetPermissionTypeAvatarClass(perm.Type)">
                                        @GetPermissionTypeIcon(perm.Type)
                                    </div>
                                    <div class="space-y-0.5 min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                                            <span class="font-bold text-xs sm:text-sm text-slate-200 block truncate group-hover/row:text-cyan-300 transition-colors" title="@perm.Title">@perm.Title</span>
                                            <span class="px-1.5 py-0.2 rounded text-[9px] font-medium border @GetPermissionTypeBadgeClass(perm.Type) shrink-0">
                                                @GetPermissionTypeName(perm.Type)
                                            </span>
                                        </div>
                                        <span class="text-[10px] sm:text-[11px] font-mono text-slate-500 block">شناسه: #@perm.Id</span>
                                    </div>
                                </div>
                            </td>

                            <td class="px-3 sm:px-4 py-3 w-[24%]">
                                <span class="font-mono text-[11px] sm:text-xs text-cyan-300/80 bg-cyan-950/40 px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-lg border border-cyan-500/20 block truncate max-w-[200px]" title="@perm.ResourceKey">
                                    @perm.ResourceKey
                                </span>
                            </td>

                            <td class="px-3 sm:px-4 py-3 w-[20%]">
                                <div class="flex flex-wrap gap-1">
                                    @if (perm.RoleIds != null && perm.RoleIds.Any() && PermState.Value.AvailableRoles != null)
                                    {
                                        @foreach (var roleId in perm.RoleIds)
                                        {
                                            var role = PermState.Value.AvailableRoles.FirstOrDefault(r => r.Id == roleId);
                                            if (role != null)
                                            {
                                                <span class="inline-block px-1.5 sm:px-2 py-0.5 rounded-lg bg-purple-500/10 border border-purple-400/30 text-purple-300 text-[11px] sm:text-xs font-medium truncate max-w-[90px]" title="@role.Name">
                                                    @role.Name
                                                </span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-500 text-[11px] sm:text-xs font-mono">بدون نقش</span>
                                    }
                                </div>
                            </td>

                            <td class="px-3 sm:px-4 py-3 w-[12%]">
                                @if (perm.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-0.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-[11px] sm:text-xs font-bold shadow-[0_0_8px_rgba(16,185,129,0.2)]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
                                        <span class="truncate">فعال</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-0.5 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 text-[11px] sm:text-xs font-medium">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 shrink-0"></span>
                                        <span class="truncate">غیرفعال</span>
                                    </span>
                                }
                            </td>

                            <td class="px-2 sm:px-3 py-3 text-center w-[14%]">
                                <div class="flex items-center justify-center gap-1 sm:gap-2">
                                    <button type="button"
                                            @onclick="() => Edit(perm)"
                                            class="p-1 sm:p-1.5 text-cyan-400 hover:text-cyan-200 hover:bg-cyan-500/20 rounded-lg transition-all cursor-pointer"
                                            title="ویرایش">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button type="button"
                                            @onclick="() => OpenDeleteModal(perm)"
                                            class="p-1 sm:p-1.5 text-rose-400 hover:text-rose-200 hover:bg-rose-500/20 rounded-lg transition-all cursor-pointer"
                                            title="حذف">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </RowTemplate>
                    </DataGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<BulkActionToolbar SelectedCount="selectedIds.Count"
                   OnCancel="ClearSelection"
                   OnDelete="OpenBulkDeleteModal"
                   OnActivate="() => BulkUpdateStatus(true)"
                   OnDeactivate="() => BulkUpdateStatus(false)" />

<ConfirmDeleteModal IsOpen="showDeleteModal"
                    Description="@deleteModalDesc"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CancelDelete" />