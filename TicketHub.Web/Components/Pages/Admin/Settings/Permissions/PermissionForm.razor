

<EditForm Model="Model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-rose-600 text-sm mb-4 list-disc list-inside" />

    <div class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">عنوان دسترسی</label>
            <InputText @bind-Value="Model.Title" class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-all" placeholder="مثال: مدیریت کاربران" />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">کلید منبع (ResourceKey)</label>
            <InputText @bind-Value="Model.ResourceKey" class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-all" placeholder="مثال: Users.Manage" />
        </div>

        <div>
            <SlideSelect TItem="PermissionTypeItem" TValue="PermissionType"
                         Label="نوع دسترسی" Placeholder="انتخاب نوع دسترسی..."
                         Items="PermissionTypes"
                         @bind-Value="Model.Type"
                         ValueSelector="t => t.Value"
                         TextSelector="t => t.DisplayName"
                         AllowClear="false" />
        </div>

        <div>
            <MultiSelectDropdown TItem="RoleDto" TValue="int"
                                 Label="نقش‌های مرتبط" Placeholder="انتخاب نقش‌ها..."
                                 Items="AvailableRoles" @bind-SelectedValues="Model.RoleIds"
                                 ValueSelector="r => r.Id" DisplaySelector="r => r.Name"
                                 BadgeBgClass="bg-purple-100" BadgeTextClass="text-purple-700" BadgeButtonClass="text-purple-500 hover:text-purple-900" />
        </div>

        <div class="flex items-center mt-3">
            <InputCheckbox @bind-Value="Model.IsActive" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 transition-all" id="permIsActive" />
            <label for="permIsActive" class="mr-2 block text-sm font-medium text-gray-700">دسترسی فعال است؟</label>
        </div>

        <div class="flex gap-2 pt-2">
            <button type="submit" class="flex-1 flex justify-center py-2.5 px-4 rounded-xl shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all">
                @(IsEditing ? "ذخیره تغییرات" : "ثبت دسترسی")
            </button>
            @if (IsEditing)
            {
                <button type="button" @onclick="OnCancel" class="py-2.5 px-4 rounded-xl shadow-sm text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 transition-all">انصراف</button>
            }
        </div>
    </div>
</EditForm>

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="mt-4 p-3 @(IsError ? "bg-rose-50 text-rose-600" : "bg-emerald-50 text-emerald-600") rounded-xl text-sm font-medium text-center transition-all">@SuccessMessage</div>
}

@code {
    [Parameter] public PermissionDto Model { get; set; } = new();
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public IEnumerable<RoleDto> AvailableRoles { get; set; } = new List<RoleDto>();

    // کلاس کمکی برای نگهداری مقادیر Enum
    public class PermissionTypeItem
    {
        public PermissionType Value { get; set; }
        public string DisplayName { get; set; } = string.Empty;
    }

    // لیستی از انواع دسترسی برای نمایش در SlideSelect
    private List<PermissionTypeItem> PermissionTypes { get; set; } = new()
    {
        new PermissionTypeItem { Value = PermissionType.Menu, DisplayName = "منو (Menu)" },
        new PermissionTypeItem { Value = PermissionType.SystemSection, DisplayName = "بخش سیستم (System Section)" },
        new PermissionTypeItem { Value = PermissionType.Full, DisplayName = "کامل (Full)" }
    };
}