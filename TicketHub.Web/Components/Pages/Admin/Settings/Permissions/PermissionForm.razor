@namespace TicketHub.Web.Components.Pages.Admin.Settings.Permissions
@using TicketHub.Application.DTOs
@using TicketHub.Application.Enums
@using TicketHub.Web.Components.Shared

<EditForm Model="Model" OnValidSubmit="OnValidSubmit" class="select-none">
    <FluentValidationValidator />

    <div class="space-y-5">
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">عنوان دسترسی</label>
            <InputText @bind-Value="Model.Title" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="مثال: مدیریت کاربران" />
            <ValidationMessage For="@(() => Model.Title)" class="text-rose-500 text-red-500 text-xs mt-1" />
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">کلید منبع (ResourceKey)</label>
            <InputText @bind-Value="Model.ResourceKey" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="مثال: Users.Manage" />
            <ValidationMessage For="@(() => Model.ResourceKey)" class="text-rose-500 text-red-500 text-xs mt-1" />
        </div>

        <div>
            <SlideSelect TItem="PermissionTypeItem" TValue="PermissionType"
                         Label="نوع دسترسی" Placeholder="انتخاب نوع دسترسی..."
                         Items="PermissionTypes"
                         @bind-Value="Model.Type"
                         ValueSelector="t => t.Value"
                         TextSelector="t => t.DisplayName"
                         AllowClear="false" />
            <ValidationMessage For="@(() => Model.Type)" class="text-rose-500 text-red-500 text-xs mt-1" />
        </div>

        <div>
            <MultiSelectDropdown TItem="RoleDto" TValue="int"
                                 Label="نقش‌های مرتبط" Placeholder="انتخاب نقش‌ها..."
                                 Items="AvailableRoles" @bind-SelectedValues="Model.RoleIds"
                                 ValueSelector="r => r.Id" DisplaySelector="r => r.Name"
                                 BadgeBgClass="bg-purple-100" BadgeTextClass="text-purple-700" BadgeButtonClass="text-purple-500 hover:text-purple-900" />
        </div>

        <div class="flex items-center mt-3">
            <CustomCheckbox Label="دسترسی فعال است؟" @bind-Value="Model.IsActive" />
        </div>

        <div class="flex gap-2 pt-2">
            <button type="submit" class="flex-1 flex justify-center py-3 px-4 rounded-2xl shadow-lg shadow-indigo-500/20 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus-ring transition-all">
                @(IsEditing ? "ذخیره تغییرات" : "ثبت دسترسی")
            </button>
            @if (IsEditing)
            {
                <button type="button" @onclick="OnCancel" class="py-3 px-4 rounded-2xl text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors focus-ring">انصراف</button>
            }
        </div>
    </div>
</EditForm>