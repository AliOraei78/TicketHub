@namespace TicketHub.Web.Components.Pages.Admin.Settings.Categories
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<EditForm Model="Model" OnValidSubmit="OnValidSubmit" class="select-none">
    <FluentValidationValidator />

    <div class="space-y-5">
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">عنوان نوع تیکت</label>
            <InputText @bind-Value="Model.Name" class="appearance-none w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="مثال: پشتیبانی فنی" />
            <ValidationMessage For="@(() => Model.Name)" class="text-rose-500 text-red-500 text-xs mt-1" />
        </div>

        <div>
            <MultiSelectDropdown TItem="ProjectDto" TValue="int"
                                 Label="پروژه‌های مرتبط" Placeholder="انتخاب پروژه..."
                                 Items="AvailableProjects" @bind-SelectedValues="Model.ProjectIds"
                                 ValueSelector="p => p.Id" DisplaySelector="p => p.Name"
                                 BadgeBgClass="bg-indigo-100" BadgeTextClass="text-indigo-700" BadgeButtonClass="text-indigo-500 hover:text-indigo-900" />
        </div>

        <div class="flex items-center mt-3">
            <CustomCheckbox Label="نوع تیکت فعال است؟" @bind-Value="Model.IsActive" Id="categoryIsActive" />
        </div>

        <div class="flex gap-2 pt-2">
            <button type="submit" class="flex-1 flex justify-center py-3 px-4 rounded-2xl shadow-lg shadow-indigo-500/20 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus-ring transition-all">
                @(IsEditing ? "ذخیره تغییرات" : "ثبت نوع تیکت")
            </button>
            @if (IsEditing)
            {
                <button type="button" @onclick="OnCancel" class="py-3 px-4 rounded-2xl text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors focus-ring">انصراف</button>
            }
        </div>
    </div>
</EditForm>