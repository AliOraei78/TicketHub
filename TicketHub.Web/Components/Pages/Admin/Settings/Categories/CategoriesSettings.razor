@page "/settings/categories"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@rendermode InteractiveServer

<PageTitle>تنظیمات نوع تیکت | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-8 flex flex-col gap-3 flex-1" dir="rtl">
    <PageHeader Title="مدیریت انواع تیکت" Description="در این بخش می‌توانید دسته‌بندی و انواع تیکت‌های سیستم را مدیریت کنید.">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
        </Icon>
    </PageHeader>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Add/Edit Form -->
        <div class="md:col-span-1">
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 sticky top-24">
                <h3 class="font-bold text-gray-800 mb-4 text-lg">@(isEditing ? "ویرایش نوع تیکت" : "ایجاد نوع جدید")</h3>

                <CategoryForm Model="categoryModel"
                              IsEditing="isEditing"
                              AvailableProjects="ProjState.Value.Projects"
                              AvailableRoles="ProjState.Value.Roles"
                              OnValidSubmit="HandleSubmitCategory"
                              OnCancel="CancelEdit" />
            </div>
        </div>

        <!-- Data Grid -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-6 border-b border-gray-50 bg-gray-50/50 flex flex-col sm:flex-row sm:items-center justify-start gap-4">
                    <h3 class="font-bold text-gray-800 text-lg whitespace-nowrap">لیست انواع تیکت</h3>

                    <div class="flex flex-wrap gap-3 w-full items-center">
                        <div class="w-full sm:w-45">
                            <SearchBox Placeholder="جستجو..." SearchTerm="@CatState.Value.SearchTerm" OnSearchChanged="HandleSearch" />
                        </div>

                        <div class="w-full sm:w-45">
                            <GenericStatusFilter TValue="bool?"
                                                 Options="new bool?[] { null, true, false }"
                                                 SelectedValue="CatState.Value.SelectedFilterStatus"
                                                 OnValueChanged="FilterByStatus"
                                                 BackgroundClassSelector='val => val == null ? "translate-x-0 bg-gray-900" : val == true ? "-translate-x-full bg-emerald-600" : "-translate-x-[200%] bg-gray-400"'
                                                 ItemClassSelector='(item, selected) => item == selected ? "text-white" : item == null ? "text-gray-600 hover:text-gray-900" : item == true ? "text-emerald-600 hover:text-emerald-700" : "text-gray-500 hover:text-gray-700"'>
                                <ItemTemplate Context="status">
                                    @(status == null ? "همه" : status == true ? "فعال" : "غیرفعال")
                                </ItemTemplate>
                            </GenericStatusFilter>
                        </div>

                        <div class="w-full sm:w-45 z-10">
                            <MultiSelectDropdown TItem="TicketHub.Application.DTOs.ProjectDto"
                                                 TValue="int"
                                                 Placeholder="فیلتر پروژه..."
                                                 Items="ProjState.Value.Projects"
                                                 SelectedValues="CatState.Value.SelectedFilterProjectIds"
                                                 SelectedValuesChanged="FilterByProjects"
                                                 ValueSelector="p => p.Id"
                                                 DisplaySelector="p => p.Name"
                                                 BadgeBgClass="bg-emerald-100"
                                                 BadgeTextClass="text-emerald-700"
                                                 BadgeButtonClass="text-emerald-500 hover:text-emerald-900" />
                        </div>

                        <div class="w-full sm:w-45 z-10">
                            <MultiSelectDropdown TItem="TicketHub.Application.DTOs.RoleDto"
                                                 TValue="int"
                                                 Placeholder="فیلتر نقش..."
                                                 Items="ProjState.Value.Roles"
                                                 SelectedValues="CatState.Value.SelectedFilterRoleIds"
                                                 SelectedValuesChanged="FilterByRoles"
                                                 ValueSelector="r => r.Id"
                                                 DisplaySelector="r => r.Name" />
                        </div>
                    </div>
                </div>

                <div class="p-0">
                    <DataGrid TItem="TicketHub.Application.DTOs.CategoryDto" TKey="int" Items="FilteredCategories" IsLoading="CatState.Value.IsLoading" KeySelector="c => c.Id" SelectedKeys="selectedCategoryIds" SelectedKeysChanged="OnSelectionChanged" ShowRowIndex="false" EmptyStateValue="نوع تیکتی">
                        <HeaderTemplate>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-right w-[25%]">عنوان نوع تیکت</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-right w-[20%]">پروژه‌ها</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-right w-[20%]">نقش‌ها</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-right w-[15%]">وضعیت</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-center w-[15%]">عملیات</th>
                        </HeaderTemplate>

                        <RowTemplate Context="category">
                            <td class="px-6 py-4 w-[25%]">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm border border-black/5 bg-gray-100">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-gray-800 block truncate max-w-[250px]" title="@category.Name">@category.Name</span>
                                        </div>
                                        <span class="text-xs text-gray-400">شناسه: @category.Id</span>
                                    </div>
                                </div>
                            </td>

                            <td class="px-6 py-4 w-[20%]">
                                <div class="flex flex-wrap gap-1">
                                    @if (category.ProjectIds != null && category.ProjectIds.Any() && ProjState.Value.Projects != null)
                                    {
                                        @foreach (var projectId in category.ProjectIds)
                                        {
                                            var project = ProjState.Value.Projects.FirstOrDefault(p => p.Id == projectId);
                                            if (project != null)
                                            {
                                                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 truncate max-w-[120px] align-middle" title="@project.Name">
                                                    @project.Name
                                                </span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs">بدون پروژه</span>
                                    }
                                </div>
                            </td>

                            <td class="px-6 py-4 w-[20%]">
                                <div class="flex flex-wrap gap-1">
                                    @if (category.RoleIds != null && category.RoleIds.Any() && ProjState.Value.Roles != null)
                                    {
                                        @foreach (var roleId in category.RoleIds)
                                        {
                                            var role = ProjState.Value.Roles.FirstOrDefault(r => r.Id == roleId);
                                            if (role != null)
                                            {
                                                <Badge>
                                                    <span class="block truncate max-w-[100px]" title="@role.Name">@role.Name</span>
                                                </Badge>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs">بدون نقش</span>
                                    }
                                </div>
                            </td>

                            <td class="px-6 py-4 w-[15%]">
                                @if (category.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-emerald-700 text-xs font-medium">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.9)]"></span>
                                        فعال
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-gray-200 text-gray-600 text-xs font-medium">
                                        غیرفعال
                                    </span>
                                }
                            </td>

                            <td class="px-6 py-4 text-center w-[15%]">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" @onclick="() => EditCategory(category)" class="p-2 text-blue-500 hover:bg-blue-100 rounded-lg smooth-transition" title="ویرایش">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                    </button>
                                    <button type="button" @onclick="() => OpenDeleteModal(category)" class="p-2 text-rose-500 hover:bg-rose-100 rounded-lg smooth-transition" title="حذف">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                </div>
                            </td>
                        </RowTemplate>
                    </DataGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<BulkActionToolbar SelectedCount="selectedCategoryIds.Count"
                   OnCancel="ClearSelection"
                   OnDelete="OpenBulkDeleteModal"
                   OnActivate="BulkActivateCategories"
                   OnDeactivate="BulkDeactivateCategories" />

<ConfirmDeleteModal IsOpen="showDeleteModal"
                    Description="@deleteModalDescription"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CancelDelete" />