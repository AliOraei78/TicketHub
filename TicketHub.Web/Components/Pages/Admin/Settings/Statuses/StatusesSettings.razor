@page "/settings/statuses"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<PageTitle>مدیریت وضعیت‌ها | سامانه تیکت‌هاب</PageTitle>

<div class="w-full max-w-[1680px] mx-auto px-3 sm:px-6 lg:px-8 flex flex-col gap-3 flex-1 select-none" dir="rtl">
    <!-- Centered Cyber Operations Master Banner -->
    <div class="relative overflow-hidden rounded-xl bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 p-3 sm:p-3.5 shadow-[0_0_25px_rgba(8,13,26,0.85)] flex flex-col gap-2.5">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-cyan-500/20 via-indigo-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Section: Centered Title & Centered Subtitle -->
        <div class="relative z-10 flex flex-col items-center justify-center text-center gap-2">
            <div class="space-y-1.5 flex flex-col items-center">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white drop-shadow-[0_2px_15px_rgba(255,255,255,0.35)] leading-tight flex items-center justify-center gap-2.5 flex-wrap text-center">
                    <span class="bg-gradient-to-r from-cyan-300 via-indigo-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_18px_rgba(56,189,248,0.7)]">مدیریت وضعیت‌های تیکت</span>
                </h1>
                <p class="text-slate-200 text-sm sm:text-base font-semibold tracking-wide flex items-center justify-center gap-2 flex-wrap text-center">
                    <span>🔄 چرخه حیات تیکت</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>شروط تأییدیه هوشمند</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>کدگذاری رنگی مراحل پشتیبانی</span>
                </p>
            </div>
        </div>

        <!-- Bottom Row: 3 Holographic Telemetry Cards -->
        <div class="relative z-10 pt-2 border-t border-white/[0.08] grid grid-cols-1 sm:grid-cols-3 gap-2">
            <!-- 1. Total Statuses (Cyan) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(56, 189, 248, 0.5); --seg-glow: rgba(56, 189, 248, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-cyan-300/90 font-bold truncate">کل وضعیت‌ها</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-cyan-400/60 uppercase">همه</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(56,189,248,0.7)] px-1">
                    @TotalStatusesCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 2. Active Statuses (Emerald) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(16, 185, 129, 0.5); --seg-glow: rgba(16, 185, 129, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-emerald-300/90 font-bold truncate">وضعیت‌های فعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-400/60 uppercase">فعال</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(16,185,129,0.7)] px-1">
                    @ActiveStatusesCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 3. Inactive Statuses (Rose) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(244, 63, 94, 0.5); --seg-glow: rgba(244, 63, 94, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-rose-500/15 border border-rose-400/30 flex items-center justify-center text-rose-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-rose-300/90 font-bold truncate">وضعیت‌های غیرفعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-rose-400/60 uppercase">غیرفعال</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(244,63,94,0.7)] px-1">
                    @InactiveStatusesCount.ToPersianNumbers()
                </span>
            </div>
        </div>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- Right Column: Add/Edit Status Form (5 Cols on lg, 4 on xl) -->
        <div class="lg:col-span-5 xl:col-span-4">
            <StatusForm Model="statusModel"
                        IsEditing="isEditing"
                        OnSubmit="HandleSubmitStatus"
                        OnCancel="CancelEdit" />
        </div>

        <!-- Left Column: Statuses DataGrid & Filter Bar (7 Cols on lg, 8 on xl) -->
        <div class="lg:col-span-7 xl:col-span-8 space-y-3">
            <!-- Search & Filter Command Bar -->
            <div class="bg-[#080d1a]/95 backdrop-blur-2xl p-3 px-4 rounded-2xl shadow-[0_0_25px_rgba(8,13,26,0.85)] border border-cyan-500/35 flex flex-wrap sm:flex-nowrap gap-3 items-center justify-between select-none">
                <div class="w-full sm:w-64">
                    <SearchBox Placeholder="جستجوی وضعیت..." SearchTerm="@StatState.Value.SearchTerm" OnSearchChanged="HandleSearch" />
                </div>

                <!-- 3-State Cyberpunk Status Filter Switcher -->
                <div class="flex items-center gap-1 p-1 bg-[#050811]/90 rounded-2xl border border-white/[0.12] h-[46px] w-full sm:w-auto shrink-0 select-none">
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(null))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(StatState.Value.SelectedFilterStatus == null ? "bg-cyan-500/20 text-cyan-300 border border-cyan-400/50 shadow-[0_0_10px_rgba(56,189,248,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        همه (@TotalStatusesCount.ToPersianNumbers())
                    </button>
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(true))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(StatState.Value.SelectedFilterStatus == true ? "bg-emerald-500/20 text-emerald-300 border border-emerald-400/50 shadow-[0_0_10px_rgba(16,185,129,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        فعال (@ActiveStatusesCount.ToPersianNumbers())
                    </button>
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(false))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(StatState.Value.SelectedFilterStatus == false ? "bg-rose-500/20 text-rose-300 border border-rose-400/50 shadow-[0_0_10px_rgba(244,63,94,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        غیرفعال (@InactiveStatusesCount.ToPersianNumbers())
                    </button>
                </div>
            </div>

            <!-- Statuses Table Container -->
            <div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 rounded-2xl shadow-[0_0_25px_rgba(8,13,26,0.85)] overflow-hidden relative">
                <!-- Laser Top Edge Sweep -->
                <div class="cyber-laser-sweep"></div>

                <div class="p-0">
                    <DataGrid TItem="StatusDto" TKey="int"
                              Items="FilteredStatuses"
                              IsLoading="StatState.Value.IsLoading"
                              KeySelector="s => s.Id"
                              SelectedKeys="selectedStatusIds"
                              SelectedKeysChanged="OnSelectionChanged"
                              ShowRowIndex="false"
                              EmptyStateValue="وضعیتی"
                              IsCyberpunk="true">

                        <HeaderTemplate>
                            <th class="pr-5 pl-3 sm:pr-6 sm:pl-4 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[62%]">عنوان وضعیت و رنگ</th>
                            <th class="px-3 sm:px-4 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[19%]">وضعیت</th>
                            <th class="px-2 sm:px-3 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-center w-[19%]">عملیات</th>
                        </HeaderTemplate>

                        <RowTemplate Context="status">
                            <td class="pr-5 pl-3 sm:pr-6 sm:pl-4 py-3 w-[62%]">
                                <div class="flex items-center gap-3 sm:gap-3.5 min-w-0">
                                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl flex items-center justify-center flex-shrink-0 shadow-[0_0_12px_rgba(0,0,0,0.5)] border border-white/20" style="background-color: @(status.ColorCode ?? "#3b82f6");">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.8)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                    <div class="space-y-0.5 min-w-0 flex-1">
                                        <div class="flex items-center gap-1.5 flex-wrap min-w-0">
                                            <span class="font-bold text-xs sm:text-sm text-slate-200 block truncate group-hover/row:text-cyan-300 transition-colors" title="@status.Name">@status.Name</span>

                                            @if (status.NeedApproval)
                                            {
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-amber-500/10 text-amber-300 border border-amber-400/25 shrink-0">
                                                    نیاز به تأییدیه
                                                </span>
                                            }
                                        </div>
                                        <span class="text-[10px] sm:text-[11px] font-mono text-slate-500 block">شناسه: #@status.Id</span>
                                    </div>
                                </div>
                            </td>

                            <td class="px-3 sm:px-4 py-3 w-[19%]">
                                @if (status.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-0.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-[11px] sm:text-xs font-bold shadow-[0_0_8px_rgba(16,185,129,0.2)]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
                                        <span class="truncate">فعال</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-0.5 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 text-[11px] sm:text-xs font-medium">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 shrink-0"></span>
                                        <span class="truncate">غیرفعال</span>
                                    </span>
                                }
                            </td>

                            <td class="px-2 sm:px-3 py-3 text-center w-[19%]">
                                <div class="flex items-center justify-center gap-1 sm:gap-2">
                                    <button type="button"
                                            @onclick="() => EditStatus(status)"
                                            class="p-1 sm:p-1.5 text-cyan-400 hover:text-cyan-200 hover:bg-cyan-500/20 rounded-lg transition-all cursor-pointer"
                                            title="ویرایش">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button type="button"
                                            @onclick="() => OpenDeleteModal(status)"
                                            class="p-1 sm:p-1.5 text-rose-400 hover:text-rose-200 hover:bg-rose-500/20 rounded-lg transition-all cursor-pointer"
                                            title="حذف">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </RowTemplate>
                    </DataGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<BulkActionToolbar SelectedCount="selectedStatusIds.Count"
                   OnCancel="ClearSelection"
                   OnDelete="OpenBulkDeleteModal"
                   OnActivate="BulkActivateStatuses"
                   OnDeactivate="BulkDeactivateStatuses" />

<ConfirmDeleteModal IsOpen="showDeleteModal"
                    Description="@deleteModalDescription"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CancelDelete" />