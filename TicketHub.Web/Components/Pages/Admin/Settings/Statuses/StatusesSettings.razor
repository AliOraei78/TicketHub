@page "/settings/statuses"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@rendermode InteractiveServer

<PageTitle>تنظیمات وضعیت‌ها | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-8 flex flex-col gap-3 flex-1" dir="rtl">
    <PageHeader Title="مدیریت وضعیت‌های تیکت"
                Description="در این بخش می‌توانید وضعیت‌های سیستم را ایجاد، ویرایش و یا حذف کنید و رنگ اختصاصی آن‌ها را تعیین نمایید.">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </Icon>
    </PageHeader>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Add/Edit Status Form -->
        <div class="md:col-span-1">
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 sticky top-24">
                <h3 class="font-bold text-gray-800 mb-4 text-lg">@(isEditing ? "ویرایش وضعیت" : "ایجاد وضعیت جدید")</h3>

                <StatusForm Model="statusModel"
                            IsEditing="isEditing"
                            OnSubmit="HandleSubmitStatus"
                            OnCancel="CancelEdit" />
            </div>
        </div>

        <!-- Statuses List & Search -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">

                <div class="p-6 border-b border-gray-50 bg-gray-50/50 flex flex-col sm:flex-row sm:items-center justify-start gap-4">
                    <h3 class="font-bold text-gray-800 text-lg whitespace-nowrap">لیست وضعیت‌ها</h3>

                    <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto items-center">

                        <div class="w-full sm:w-45">
                            <SearchBox Placeholder="جستجوی وضعیت..." SearchTerm="@StatState.Value.SearchTerm" OnSearchChanged="HandleSearch" />
                        </div>

                        <!-- فیلتر وضعیت با عرض ثابت -->
                        <div class="w-full sm:w-45">
                            <GenericStatusFilter TValue="bool?"
                                                 Options="new bool?[] { null, true, false }"
                                                 SelectedValue="StatState.Value.SelectedFilterStatus"
                                                 OnValueChanged="FilterByStatus"
                                                 BackgroundClassSelector='val => val == null ? "translate-x-0 bg-gray-900" : val == true ? "-translate-x-full bg-emerald-600" : "-translate-x-[200%] bg-gray-400"'
                                                 ItemClassSelector='(item, selected) => item == selected ? "text-white" : item == null ? "text-gray-600 hover:text-gray-900" : item == true ? "text-emerald-600 hover:text-emerald-700" : "text-gray-500 hover:text-gray-700"'>
                                <ItemTemplate Context="status">
                                    @(status == null ? "همه" : status == true ? "فعال" : "غیرفعال")
                                </ItemTemplate>
                            </GenericStatusFilter>
                        </div>
                    </div>
                </div>

                <div class="p-0">
                    <DataGrid TItem="StatusDto" TKey="int"
                              Items="FilteredStatuses"
                              IsLoading="StatState.Value.IsLoading"
                              KeySelector="s => s.Id"
                              SelectedKeys="selectedStatusIds"
                              SelectedKeysChanged="OnSelectionChanged"
                              ShowRowIndex="false"
                              EmptyStateValue="وضعیتی">

                        <HeaderTemplate>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-right w-[65%]">عنوان وضعیت و رنگ</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-right w-[15%]">وضعیت</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-center w-[15%]">عملیات</th>
                        </HeaderTemplate>

                        <RowTemplate Context="status">
                            <td class="px-6 py-4 w-[65%]">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm border border-black/5" style="background-color: @(status.ColorCode ?? "#ccc");">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-gray-800 block truncate max-w-[200px]" title="@status.Name">@status.Name</span>

                                            @if (status.NeedApproval)
                                            {
                                                <span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-amber-50 text-amber-600 border border-amber-200">
                                                    نیاز به تایید
                                                </span>
                                            }
                                        </div>
                                        <span class="text-xs text-gray-400">شناسه: @status.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 w-[15%]">
                                @if (status.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-emerald-700 text-xs font-medium">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.9)]"></span>
                                        فعال
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-gray-200 text-gray-600 text-xs font-medium">
                                        غیرفعال
                                    </span>
                                }
                            </td>

                            <td class="px-6 py-4 text-center w-[15%]">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" @onclick="() => EditStatus(status)" class="p-2 text-blue-500 hover:bg-blue-100 rounded-lg smooth-transition" title="ویرایش">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                    </button>
                                    <button type="button" @onclick="() => OpenDeleteModal(status)" class="p-2 text-rose-500 hover:bg-rose-100 rounded-lg smooth-transition" title="حذف">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                </div>
                            </td>
                        </RowTemplate>
                    </DataGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<BulkActionToolbar SelectedCount="selectedStatusIds.Count"
                   OnCancel="ClearSelection"
                   OnDelete="OpenBulkDeleteModal"
                   OnActivate="BulkActivateStatuses"
                   OnDeactivate="BulkDeactivateStatuses" />

<ConfirmDeleteModal IsOpen="showDeleteModal"
                    Description="@deleteModalDescription"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CancelDelete" />