@page "/settings/ticket-fields"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using TicketHub.Application.Enums
@rendermode InteractiveServer

<PageTitle>مدیریت فیلدهای تیکت | سامانه تیکت‌هاب</PageTitle>

<div class="w-full flex flex-col gap-3 flex-1 select-none" dir="rtl">
    <!-- Centered Cyber Operations Master Banner -->
    <div class="relative overflow-hidden rounded-xl bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 p-3 sm:p-3.5 shadow-[0_0_25px_rgba(8,13,26,0.85)] flex flex-col gap-2.5">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-cyan-500/20 via-indigo-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Section: Centered Title & Centered Subtitle -->
        <div class="relative z-10 flex flex-col items-center justify-center text-center gap-2">
            <div class="space-y-1.5 flex flex-col items-center">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white drop-shadow-[0_2px_15px_rgba(255,255,255,0.35)] leading-tight flex items-center justify-center gap-2.5 flex-wrap text-center">
                    <span class="bg-gradient-to-r from-cyan-300 via-indigo-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_18px_rgba(56,189,248,0.7)]">مدیریت فیلدهای داینامیک تیکت</span>
                </h1>
                <p class="text-slate-200 text-sm sm:text-base font-semibold tracking-wide flex items-center justify-center gap-2 flex-wrap text-center">
                    <span>📑 فرم‌ساز پویا</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>فیلدهای سفارشی بر اساس نوع تیکت</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>تعیین شروط اجباری و اعتبارسنجی</span>
                </p>
            </div>
        </div>

        <!-- Bottom Row: 3 Holographic Telemetry Cards -->
        <div class="relative z-10 pt-2 border-t border-white/[0.08] grid grid-cols-1 sm:grid-cols-3 gap-2">
            <!-- 1. Total Fields (Cyan) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(56, 189, 248, 0.5); --seg-glow: rgba(56, 189, 248, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-cyan-300/90 font-bold truncate">کل فیلدهای تیکت</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-cyan-400/60 uppercase">همه</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(56,189,248,0.7)] px-1">
                    @TotalFieldsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 2. Active Fields (Emerald) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(16, 185, 129, 0.5); --seg-glow: rgba(16, 185, 129, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-emerald-300/90 font-bold truncate">فیلدهای فعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-400/60 uppercase">فعال</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(16,185,129,0.7)] px-1">
                    @ActiveFieldsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 3. Inactive Fields (Rose) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(244, 63, 94, 0.5); --seg-glow: rgba(244, 63, 94, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-rose-500/15 border border-rose-400/30 flex items-center justify-center text-rose-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-rose-300/90 font-bold truncate">فیلدهای غیرفعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-rose-400/60 uppercase">غیرفعال</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(244,63,94,0.7)] px-1">
                    @InactiveFieldsCount.ToPersianNumbers()
                </span>
            </div>
        </div>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- Right Column: Add/Edit Ticket Field Form (4 Cols) -->
        <div class="lg:col-span-4">
            <TicketFieldForm Model="fieldModel"
                             IsEditing="isEditing"
                             AvailableCategories="CatState.Value.Categories"
                             AvailableFieldTypes="TypeState.Value.FieldTypes"
                             OnValidSubmit="HandleSubmitField"
                             OnCancel="CancelEdit" />
        </div>

        <!-- Left Column: Fields DataGrid & Filter Bar (8 Cols) -->
        <div class="lg:col-span-8 space-y-3">
            <!-- Search & Filter Command Bar -->
            <div class="bg-[#080d1a]/95 backdrop-blur-2xl p-3 px-4 rounded-2xl shadow-[0_0_25px_rgba(8,13,26,0.85)] border border-cyan-500/35 flex flex-wrap gap-3 items-center justify-between select-none">
                <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto flex-1">
                    <div class="w-full sm:w-44 md:w-52">
                        <SearchBox Placeholder="جستجوی فیلد..." SearchTerm="@FieldState.Value.SearchTerm" OnSearchChanged="HandleSearch" />
                    </div>

                    <div class="w-full sm:w-36 md:w-40 z-20">
                        <MultiSelectDropdown TItem="TicketHub.Application.DTOs.FieldTypeDto"
                                             TValue="int"
                                             Placeholder="نوع فیلد..."
                                             Items="TypeState.Value.FieldTypes"
                                             SelectedValues="FieldState.Value.SelectedFilterFieldTypeIds"
                                             SelectedValuesChanged="FilterByType"
                                             ValueSelector="t => t.Id"
                                             DisplaySelector="t => t.Type" />
                    </div>

                    <div class="w-full sm:w-36 md:w-40 z-10">
                        <MultiSelectDropdown TItem="TicketHub.Application.DTOs.CategoryDto"
                                             TValue="int"
                                             Placeholder="نوع تیکت..."
                                             Items="CatState.Value.Categories"
                                             SelectedValues="FieldState.Value.SelectedFilterCategoryIds"
                                             SelectedValuesChanged="FilterByCategories"
                                             ValueSelector="c => c.Id"
                                             DisplaySelector="c => c.Name" />
                    </div>
                </div>

                <!-- 3-State Cyberpunk Status Filter Switcher -->
                <div class="flex items-center gap-1 p-1 bg-[#050811]/90 rounded-2xl border border-white/[0.12] h-[46px] w-full sm:w-auto shrink-0 select-none">
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(null))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(FieldState.Value.SelectedFilterStatus == null ? "bg-cyan-500/20 text-cyan-300 border border-cyan-400/50 shadow-[0_0_10px_rgba(56,189,248,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        همه (@TotalFieldsCount.ToPersianNumbers())
                    </button>
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(true))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(FieldState.Value.SelectedFilterStatus == true ? "bg-emerald-500/20 text-emerald-300 border border-emerald-400/50 shadow-[0_0_10px_rgba(16,185,129,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        فعال (@ActiveFieldsCount.ToPersianNumbers())
                    </button>
                    <button type="button" 
                            @onclick="@(() => FilterByStatus(false))"
                            class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(FieldState.Value.SelectedFilterStatus == false ? "bg-rose-500/20 text-rose-300 border border-rose-400/50 shadow-[0_0_10px_rgba(244,63,94,0.25)]" : "text-slate-400 hover:text-slate-200")">
                        غیرفعال (@InactiveFieldsCount.ToPersianNumbers())
                    </button>
                </div>
            </div>

            <!-- Fields Table Container -->
            <div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 rounded-2xl shadow-[0_0_25px_rgba(8,13,26,0.85)] overflow-hidden relative">
                <!-- Laser Top Edge Sweep -->
                <div class="cyber-laser-sweep"></div>

                <div class="p-0">
                    <DataGrid TItem="TicketHub.Application.DTOs.TicketFieldDto" TKey="int"
                              Items="FilteredFields"
                              IsLoading="FieldState.Value.IsLoading"
                              KeySelector="f => f.Id"
                              SelectedKeys="selectedFieldIds"
                              SelectedKeysChanged="OnSelectionChanged"
                              ShowRowIndex="false"
                              EmptyStateValue="فیلدی"
                              IsCyberpunk="true">

                        <HeaderTemplate>
                            <th class="px-6 py-3.5 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[25%]">عنوان فیلد</th>
                            <th class="px-6 py-3.5 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-center w-[10%]">ترتیب</th>
                            <th class="px-6 py-3.5 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[16%]">نوع فیلد</th>
                            <th class="px-6 py-3.5 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[22%]">انواع تیکت</th>
                            <th class="px-6 py-3.5 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-right w-[12%]">وضعیت</th>
                            <th class="px-6 py-3.5 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-center w-[15%]">عملیات</th>
                        </HeaderTemplate>

                        <RowTemplate Context="field">
                            @{
                                var enumType = (FieldTypeEnum)field.FieldTypeId;
                            }
                            <td class="px-6 py-3.5 w-[25%]">
                                <div class="flex items-center gap-3">
                                    <!-- Dynamic Field Type Icon Box -->
                                    <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm @GetFieldTypeAvatarClass(enumType)">
                                        @GetFieldTypeIcon(enumType)
                                    </div>
                                    <div class="space-y-0.5 min-w-0">
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-sm text-slate-200 block truncate group-hover/row:text-cyan-300 transition-colors" title="@field.Name">@field.Name</span>
                                            @if (field.IsRequired)
                                            {
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-rose-500/20 text-rose-300 border border-rose-400/30">اجباری</span>
                                            }
                                        </div>
                                        <span class="text-[11px] font-mono text-slate-500 block truncate" title="@field.Placeholder">
                                            @(string.IsNullOrWhiteSpace(field.Placeholder) ? $"شناسه: #{field.Id}" : field.Placeholder)
                                        </span>
                                    </div>
                                </div>
                            </td>

                            <td class="px-6 py-3.5 text-center w-[10%]">
                                <span class="inline-flex items-center justify-center w-7 h-7 bg-cyan-500/10 text-cyan-300 border border-cyan-400/25 rounded-lg text-xs font-mono font-bold">
                                    @field.SortOrder
                                </span>
                            </td>

                            <td class="px-6 py-3.5 w-[16%]">
                                @{
                                    var fType = TypeState.Value.FieldTypes?.FirstOrDefault(t => t.Id == field.FieldTypeId);
                                    var typeName = fType?.Type ?? enumType.ToString();
                                }
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium truncate max-w-[130px] border shadow-xs @GetFieldTypeBadgeClass(enumType)" title="@typeName">
                                    <span class="shrink-0 scale-90">@GetFieldTypeIcon(enumType)</span>
                                    <span class="truncate">@typeName</span>
                                </span>
                            </td>

                            <td class="px-6 py-3.5 w-[22%]">
                                <div class="flex flex-wrap gap-1">
                                    @if (field.CategoryIds != null && field.CategoryIds.Any() && CatState.Value.Categories != null)
                                    {
                                        @foreach (var catId in field.CategoryIds)
                                        {
                                            var category = CatState.Value.Categories.FirstOrDefault(c => c.Id == catId);
                                            if (category != null)
                                            {
                                                <span class="inline-block px-2 py-0.5 rounded-lg bg-indigo-500/10 border border-indigo-400/30 text-indigo-300 text-xs font-medium truncate max-w-[100px]" title="@category.Name">
                                                    @category.Name
                                                </span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-cyan-400/70 text-xs font-mono">عمومی (همه)</span>
                                    }
                                </div>
                            </td>

                            <td class="px-6 py-3.5 w-[12%]">
                                @if (field.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold shadow-[0_0_8px_rgba(16,185,129,0.2)]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                        فعال
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-medium">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                        غیرفعال
                                    </span>
                                }
                            </td>

                            <td class="px-6 py-3.5 text-center w-[15%]">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button"
                                            @onclick="() => EditField(field)"
                                            class="p-1.5 text-cyan-400 hover:text-cyan-200 hover:bg-cyan-500/20 rounded-lg transition-all cursor-pointer"
                                            title="ویرایش">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button type="button"
                                            @onclick="() => OpenDeleteModal(field)"
                                            class="p-1.5 text-rose-400 hover:text-rose-200 hover:bg-rose-500/20 rounded-lg transition-all cursor-pointer"
                                            title="حذف">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </RowTemplate>
                    </DataGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<BulkActionToolbar SelectedCount="selectedFieldIds.Count"
                   OnCancel="ClearSelection"
                   OnDelete="OpenBulkDeleteModal"
                   OnActivate="BulkActivateFields"
                   OnDeactivate="BulkDeactivateFields" />

<ConfirmDeleteModal IsOpen="showDeleteModal"
                    Description="@deleteModalDescription"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CancelDelete" />