@namespace TicketHub.Web.Components.Pages.Admin.Settings.TicketFields
@using TicketHub.Application.DTOs
@using TicketHub.Application.Enums
@using TicketHub.Web.Components.Shared

<EditForm Model="Model" OnValidSubmit="OnValidSubmit" class="select-none">
    <FluentValidationValidator />

    <div class="space-y-4">
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">عنوان فیلد</label>
            <InputText @bind-Value="Model.Name" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="مثال: شماره موبایل" />
            <ValidationMessage For="() => Model.Name" class="text-xs text-rose-500 text-red-500 mt-1" />
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">شماره ترتیب</label>
            <InputNumber @bind-Value="Model.SortOrder" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" />
            <ValidationMessage For="() => Model.SortOrder" class="text-xs text-rose-500 text-red-500 mt-1" />
        </div>

        <div>
            <SlideSelect TItem="FieldTypeDto" TValue="int"
                         Label="نوع فیلد" Placeholder="انتخاب نوع فیلد..."
                         Items="AvailableFieldTypes"
                         @bind-Value="Model.FieldTypeId"
                         ValueSelector="t => t.Id"
                         TextSelector="t => t.Type"
                         AllowClear="true" ClearText="بدون انتخاب" />
            <ValidationMessage For="() => Model.FieldTypeId" class="text-xs text-rose-500 text-red-500 mt-1" />
        </div>

        @if (Model.FieldTypeId == (int)FieldTypeEnum.Text || Model.FieldTypeId == (int)FieldTypeEnum.TextArea || Model.FieldTypeId == (int)FieldTypeEnum.Number)
        {
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">متن جایگیر</label>
                <InputText @bind-Value="Model.Placeholder" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="متن جایگیر..." />
                <ValidationMessage For="() => Model.Placeholder" class="text-xs text-rose-500 text-red-500 mt-1" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">مقدار پیش‌فرض</label>
                @if (Model.FieldTypeId == (int)FieldTypeEnum.Number)
                {
                    <input type="number" @bind="Model.DefaultValue" @bind:event="oninput" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="مقدار پیش‌فرض (اختیاری)" />
                }
                else
                {
                    <InputText @bind-Value="Model.DefaultValue" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="مقدار پیش‌فرض (اختیاری)" />
                }
                <ValidationMessage For="() => Model.DefaultValue" class="text-xs text-rose-500 text-red-500 mt-1" />
            </div>
        }

        @if (Model.FieldTypeId == (int)FieldTypeEnum.Dropdown || Model.FieldTypeId == (int)FieldTypeEnum.MultipleDropdown)
        {
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">گزینه‌ها (با کاما از هم جدا کنید)</label>
                <InputText @bind-Value="Model.Options" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" placeholder="گزینه ۱، گزینه ۲، گزینه ۳" />
                <ValidationMessage For="() => Model.Options" class="text-xs text-rose-500 text-red-500 mt-1" />
            </div>
        }

        <div>
            <MultiSelectDropdown TItem="CategoryDto" TValue="int"
                                 Label="انواع تیکت مرتبط (دسته‌بندی‌ها)" Placeholder="انتخاب نوع تیکت..."
                                 Items="AvailableCategories" @bind-SelectedValues="Model.CategoryIds"
                                 ValueSelector="c => c.Id" DisplaySelector="c => c.Name"
                                 BadgeBgClass="bg-indigo-100" BadgeTextClass="text-indigo-700" BadgeButtonClass="text-indigo-500 hover:text-indigo-900" />
        </div>

        <div class="space-y-3 pt-1">
            <CustomCheckbox Label="فیلد اجباری است؟" @bind-Value="Model.IsRequired" />
            <CustomCheckbox Label="فیلد فعال است؟" @bind-Value="Model.IsActive" />
        </div>

        <div class="flex gap-2 pt-2">
            <button type="submit" class="flex-1 flex justify-center py-3 px-4 rounded-2xl shadow-lg shadow-indigo-500/20 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus-ring transition-all">
                @(IsEditing ? "ذخیره تغییرات" : "ثبت فیلد")
            </button>
            @if (IsEditing)
            {
                <button type="button" @onclick="OnCancel" class="py-3 px-4 rounded-2xl text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors focus-ring">انصراف</button>
            }
        </div>
    </div>
</EditForm>