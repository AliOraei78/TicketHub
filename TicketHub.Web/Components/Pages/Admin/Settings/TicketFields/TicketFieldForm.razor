@namespace TicketHub.Web.Components.Pages.Admin.Settings.TicketFields
@using TicketHub.Application.DTOs
@using TicketHub.Application.Enums
@using TicketHub.Web.Components.Shared

<div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 rounded-2xl p-4 sm:p-5 lg:p-6 shadow-[0_0_25px_rgba(8,13,26,0.85)] relative select-none sticky top-24">
    <!-- Laser Top Edge Sweep -->
    <div class="cyber-laser-sweep"></div>

    <!-- Header -->
    <div class="flex items-center justify-between mb-5 border-b border-white/[0.08] pb-3.5">
        <div class="space-y-1 min-w-0">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_rgba(56,189,248,0.8)] shrink-0"></span>
                <h3 class="font-black text-white text-base tracking-tight truncate">
                    @(IsEditing ? "ویرایش فیلد پویا" : "ایجاد فیلد جدید")
                </h3>
            </div>
            <span class="text-[11px] text-slate-400 block font-medium truncate">پیکربندی فیلدهای سفارشی تیکت و شروط ورودی</span>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <span class="px-2 py-0.5 rounded-md bg-cyan-500/10 border border-cyan-400/25 text-[10px] font-mono font-bold text-cyan-300">
                @(IsEditing ? "EDIT_MODE" : "NEW_NODE")
            </span>
            <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-400/30 flex items-center justify-center text-cyan-300 shadow-[0_0_10px_rgba(56,189,248,0.2)]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Edit/Create Form -->
    <EditForm Model="Model" OnValidSubmit="OnValidSubmit">
        <FluentValidationValidator />
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5 flex items-center justify-between">
                    <span>عنوان فیلد</span>
                    <span class="text-[10px] font-mono text-cyan-400/70">* اجباری</span>
                </label>
                <div class="field-spark-wrap relative rounded-2xl">
                    <InputText @bind-Value="Model.Name"
                               class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                               placeholder="مثال: شماره موبایل" />
                </div>
                <ValidationMessage For="() => Model.Name" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5 flex items-center justify-between">
                    <span>ترتیب نمایش</span>
                    <span class="text-[10px] font-mono text-slate-400">عدد کمتر = اولویت بالاتر</span>
                </label>
                <div class="field-spark-wrap relative rounded-2xl">
                    <InputNumber @bind-Value="Model.SortOrder"
                                 class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]" />
                </div>
                <ValidationMessage For="() => Model.SortOrder" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">نوع فیلد</label>
                <SlideSelect TItem="FieldTypeDto" TValue="int"
                             Placeholder="انتخاب نوع فیلد..."
                             Items="AvailableFieldTypes"
                             @bind-Value="Model.FieldTypeId"
                             ValueSelector="t => t.Id"
                             TextSelector="t => t.Type"
                             AllowClear="true" ClearText="بدون انتخاب" />
                <ValidationMessage For="() => Model.FieldTypeId" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
            </div>

            @if (Model.FieldTypeId == (int)FieldTypeEnum.Text || Model.FieldTypeId == (int)FieldTypeEnum.TextArea || Model.FieldTypeId == (int)FieldTypeEnum.Number)
            {
                <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1.5">متن جایگیر (Placeholder)</label>
                    <div class="field-spark-wrap relative rounded-2xl">
                        <InputText @bind-Value="Model.Placeholder"
                                   class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                                   placeholder="متن جایگیر..." />
                    </div>
                    <ValidationMessage For="() => Model.Placeholder" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1.5">مقدار پیش‌فرض</label>
                    <div class="field-spark-wrap relative rounded-2xl">
                        @if (Model.FieldTypeId == (int)FieldTypeEnum.Number)
                        {
                            <input type="number" @bind="Model.DefaultValue" @bind:event="oninput"
                                   class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                                   placeholder="مقدار پیش‌فرض (اختیاری)" />
                        }
                        else
                        {
                            <InputText @bind-Value="Model.DefaultValue"
                                       class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                                       placeholder="مقدار پیش‌فرض (اختیاری)" />
                        }
                    </div>
                    <ValidationMessage For="() => Model.DefaultValue" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
                </div>
            }

            @if (Model.FieldTypeId == (int)FieldTypeEnum.Dropdown || Model.FieldTypeId == (int)FieldTypeEnum.MultipleDropdown)
            {
                <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1.5">گزینه‌ها (با کاما از هم جدا کنید)</label>
                    <div class="field-spark-wrap relative rounded-2xl">
                        <InputText @bind-Value="Model.Options"
                                   class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                                   placeholder="گزینه ۱، گزینه ۲، گزینه ۳" />
                    </div>
                    <ValidationMessage For="() => Model.Options" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
                </div>
            }

            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">انواع تیکت مرتبط (دسته‌بندی‌ها)</label>
                <MultiSelectDropdown TItem="CategoryDto" TValue="int"
                                     Placeholder="انتخاب نوع تیکت..."
                                     Items="AvailableCategories.ToList()"
                                     @bind-SelectedValues="Model.CategoryIds"
                                     ValueSelector="c => c.Id"
                                     DisplaySelector="c => c.Name" />
            </div>

            <div class="space-y-2 pt-1 bg-[#050811]/50 border border-white/[0.05] rounded-xl p-2.5">
                <CustomCheckbox Label="فیلد اجباری است (Required)" @bind-Value="Model.IsRequired" />
                <CustomCheckbox Label="فیلد فعال است (مجاز به نمایش در فرم تیکت)" @bind-Value="Model.IsActive" />
            </div>

            <!-- Tactical Command Action Bar -->
            <div class="pt-4 border-t border-white/[0.08] flex flex-col gap-3">
                <div class="flex items-center justify-between text-xs text-slate-400 select-none">
                    <div class="flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full @(IsEditing ? "bg-amber-400" : "bg-cyan-400") animate-pulse"></span>
                        <span>@(IsEditing ? "در حال ویرایش" : "آماده ثبت")</span>
                    </div>
                </div>

                <div class="flex items-center gap-2 w-full">
                    @if (IsEditing)
                    {
                        <button type="button"
                                @onclick="OnCancel"
                                class="btn-cyber-ghost flex-1 py-2.5 px-3 text-xs font-bold justify-center">
                            انصراف
                        </button>
                    }

                    <button type="submit"
                            class="btn-cyber-primary @(IsEditing ? "flex-[2]" : "w-full") py-2.5 px-4 text-xs sm:text-sm font-bold flex items-center justify-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            @if (IsEditing)
                            {
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                            }
                            else
                            {
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                            }
                        </svg>
                        <span class="truncate">@(IsEditing ? "ذخیره تغییرات" : "ثبت فیلد")</span>
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
</div>