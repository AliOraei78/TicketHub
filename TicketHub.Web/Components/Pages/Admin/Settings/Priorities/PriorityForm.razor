@namespace TicketHub.Web.Components.Pages.Admin.Settings.Priorities
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<div class="bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 rounded-2xl p-4 sm:p-5 lg:p-6 shadow-[0_0_25px_rgba(8,13,26,0.85)] relative select-none sticky top-24">
    <!-- Laser Top Edge Sweep -->
    <div class="cyber-laser-sweep"></div>

    <!-- Header -->
    <div class="flex items-center justify-between mb-5 border-b border-white/[0.08] pb-3.5">
        <div class="space-y-1 min-w-0">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_8px_rgba(56,189,248,0.8)] shrink-0"></span>
                <h3 class="font-black text-white text-base tracking-tight truncate">
                    @(IsEditing ? "ویرایش اولویت" : "ایجاد اولویت جدید")
                </h3>
            </div>
            <span class="text-[11px] text-slate-400 block font-medium truncate">تعیین سطح فوریت و کد رنگی نمایشی</span>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-400/30 flex items-center justify-center text-cyan-300 shadow-[0_0_10px_rgba(56,189,248,0.2)]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Edit/Create Form -->
    <EditForm Model="Model" OnValidSubmit="OnValidSubmit">
        <FluentValidationValidator />
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5 flex items-center justify-between">
                    <span>عنوان اولویت</span>
                    <span class="text-[10px] font-mono text-cyan-400/70">* اجباری</span>
                </label>
                <div class="field-spark-wrap relative rounded-2xl">
                    <InputText @bind-Value="Model.Name"
                               class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
                               placeholder="مثال: بحرانی / فوری" />
                </div>
                <ValidationMessage For="@(() => Model.Name)" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">رنگ نمایشی</label>
                <div class="p-2.5 bg-[#050811]/60 border border-slate-700/60 rounded-2xl">
                    <ColorPicker @bind-Value="Model.ColorCode" />
                </div>
                <ValidationMessage For="@(() => Model.ColorCode)" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5 flex items-center justify-between">
                    <span>سطح فوریت (عددی)</span>
                    <span class="text-[10px] font-mono text-slate-400">اولویت بالاتر = عدد بیشتر</span>
                </label>
                <div class="field-spark-wrap relative rounded-2xl">
                    <InputNumber @bind-Value="Model.Level"
                                 class="appearance-none w-full h-[46px] px-4 bg-[#050811]/90 border border-slate-700/80 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)]" />
                </div>
                <ValidationMessage For="@(() => Model.Level)" class="validation-message text-red-500 text-rose-400 text-xs mt-1 font-medium" />
            </div>

            <div class="pt-1 bg-[#050811]/50 border border-white/[0.05] rounded-xl p-2.5">
                <CustomCheckbox Label="اولویت فعال است (مجاز به انتخاب در تیکت)" @bind-Value="Model.IsActive" Id="priorityIsActive" />
            </div>

            <!-- Tactical Command Action Bar -->
            <div class="pt-4 border-t border-white/[0.08] flex flex-col gap-3">
                <div class="flex items-center justify-between text-xs text-slate-400 select-none">
                    <div class="flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full @(IsEditing ? "bg-amber-400" : "bg-cyan-400") animate-pulse"></span>
                        <span>@(IsEditing ? "در حال ویرایش" : "آماده ثبت")</span>
                    </div>
                </div>

                <div class="flex items-center gap-2 w-full">
                    @if (IsEditing)
                    {
                        <button type="button"
                                @onclick="OnCancel"
                                class="btn-cyber-ghost flex-1 py-2.5 px-3 text-xs font-bold justify-center">
                            انصراف
                        </button>
                    }

                    <button type="submit"
                            class="btn-cyber-primary @(IsEditing ? "flex-[2]" : "w-full") py-2.5 px-4 text-xs sm:text-sm font-bold flex items-center justify-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            @if (IsEditing)
                            {
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                            }
                            else
                            {
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                            }
                        </svg>
                        <span class="truncate">@(IsEditing ? "ذخیره تغییرات" : "ثبت اولویت")</span>
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
</div>