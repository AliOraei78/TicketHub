@namespace TicketHub.Web.Components.Pages.Admin.Settings.Priorities
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<EditForm Model="Model" OnValidSubmit="OnValidSubmit" class="select-none">
    <FluentValidationValidator />

    <div class="space-y-5">
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">عنوان اولویت</label>
            <InputText @bind-Value="Model.Name" class="appearance-none w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" />
            <ValidationMessage For="@(() => Model.Name)" class="text-rose-500 text-red-500 text-xs mt-1" />
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-2">رنگ نمایشی</label>
            <ColorPicker @bind-Value="Model.ColorCode" />
            <ValidationMessage For="@(() => Model.ColorCode)" class="text-rose-500 text-red-500 text-xs mt-1" />
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1.5">سطح (عدد)</label>
            <InputNumber @bind-Value="Model.Level" class="appearance-none w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs bg-slate-50 hover:bg-white focus:bg-white text-sm" />
            <ValidationMessage For="@(() => Model.Level)" class="text-rose-500 text-red-500 text-xs mt-1" />
        </div>
        <div class="flex items-center mt-3">
            <CustomCheckbox Label="اولویت فعال است؟" @bind-Value="Model.IsActive" Id="priorityIsActive" />
        </div>

        <div class="flex gap-2 pt-2">
            <button type="submit" class="flex-1 flex justify-center py-3 px-4 rounded-2xl shadow-lg shadow-indigo-500/20 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus-ring transition-all">
                @(IsEditing ? "ذخیره تغییرات" : "ثبت اولویت")
            </button>
            @if (IsEditing)
            {
                <button type="button" @onclick="OnCancel" class="py-3 px-4 rounded-2xl text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors focus-ring">انصراف</button>
            }
        </div>
    </div>
</EditForm>