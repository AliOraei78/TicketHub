@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="Model" OnValidSubmit="OnValidSubmit">
    <FluentValidationValidator />

    <div class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">عنوان اولویت</label>
            <InputText @bind-Value="Model.Name" class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-all" />
            <ValidationMessage For="@(() => Model.Name)" class="text-red-500 text-xs mt-1" />
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">رنگ نمایشی</label>
            <ColorPicker @bind-Value="Model.ColorCode" />
            <ValidationMessage For="@(() => Model.ColorCode)" class="text-red-500 text-xs mt-1" />
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">سطح (عدد)</label>
            <InputNumber @bind-Value="Model.Level" class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-all" />
             <ValidationMessage For="@(() => Model.Level)" class="text-red-500 text-xs mt-1" />
        </div>
        <div class="flex items-center mt-3">
            <InputCheckbox @bind-Value="Model.IsActive" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" id="priorityIsActive" />
            <label for="priorityIsActive" class="mr-2 block text-sm font-medium text-gray-700">اولویت فعال است؟</label>
        </div>

        <div class="flex gap-2 pt-2">
            <button type="submit" class="flex-1 flex justify-center py-2.5 px-4 rounded-xl shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all">
                @(IsEditing ? "ذخیره تغییرات" : "ثبت اولویت")
            </button>
            @if (IsEditing)
            {
                <button type="button" @onclick="OnCancel" class="py-2.5 px-4 rounded-xl shadow-sm text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 transition-all">انصراف</button>
            }
        </div>
    </div>
</EditForm>


@code{
    [Parameter, EditorRequired] public PriorityDto Model { get; set; } = default!;
    [Parameter] public bool IsEditing { get; set; }
    [Parameter, EditorRequired] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}