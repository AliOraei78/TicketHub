@page "/settings/roles"
@rendermode InteractiveServer
@using TicketHub.Core.Entities
@using TicketHub.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using TicketHub.Web.Components.Shared
@inject AppDbContext DbContext

<PageTitle>تنظیمات نقش‌ها | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-8" dir="rtl">

    <PageHeader Title="مدیریت نقش‌های سیستم"
                Description="در این بخش می‌توانید نقش‌های سیستم را ایجاد، ویرایش و یا حذف کنید.">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
            </svg>
        </Icon>
    </PageHeader>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Add/Edit Role Form -->
        <div class="md:col-span-1">
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 sticky top-24">
                <h3 class="font-bold text-gray-800 mb-4 text-lg">@(isEditing ? "ویرایش نقش" : "ایجاد نقش جدید")</h3>

                <EditForm Model="roleModel" OnValidSubmit="HandleSubmitRole">
                    <DataAnnotationsValidator />
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">عنوان نقش (انگلیسی یا فارسی)</label>
                            <InputText @bind-Value="roleModel.Name" class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition-all" placeholder="مثال: Support" />
                        </div>

                        <div class="flex items-center mt-3">
                            <InputCheckbox @bind-Value="roleModel.IsActive" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" id="roleIsActive" />
                            <label for="roleIsActive" class="mr-2 block text-sm font-medium text-gray-700">نقش فعال است؟</label>
                        </div>

                        <div class="flex gap-2">
                            <button type="submit" class="flex-1 flex justify-center py-2.5 px-4 rounded-xl shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 smooth-transition">
                                @(isEditing ? "ذخیره تغییرات" : "ثبت نقش")
                            </button>
                            @if (isEditing)
                            {
                                <button type="button" @onclick="CancelEdit" class="py-2.5 px-4 rounded-xl shadow-sm text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 smooth-transition">
                                    انصراف
                                </button>
                            }
                        </div>
                    </div>
                </EditForm>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="mt-4 p-3 @(isError ? "bg-rose-50 text-rose-600" : "bg-emerald-50 text-emerald-600") rounded-xl text-sm font-medium text-center transition-all">@successMessage</div>
                }
            </div>
        </div>

        <!-- Roles List & Search -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-6 border-b border-gray-50 bg-gray-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <h3 class="font-bold text-gray-800 text-lg">لیست نقش‌های موجود</h3>

                    <!-- Search Field Component -->
                    <div class="w-full sm:w-72">
                        <SearchBox Placeholder="جستجوی نقش..." SearchTerm="@searchTerm" OnSearchChanged="HandleSearch" />
                    </div>
                </div>
                <div class="p-0">
                    <DataGrid TItem="Role" TKey="int"
                              Items="FilteredRoles"
                              IsLoading="roles == null"
                              KeySelector="r => r.Id"
                              SelectedKeys="selectedRoleIds"
                              SelectedKeysChanged="OnSelectionChanged"
                              ShowRowIndex="false"
                              EmptyStateValue="نقشی">

                        <HeaderTemplate>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-right w-[65%]">عنوان نقش</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-right w-[15%]">وضعیت</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-700 text-center w-[15%]">عملیات</th>
                        </HeaderTemplate>

                        <RowTemplate Context="role">
                            <td class="px-6 py-4 w-[65%]">
                                <div class="flex items-center gap-3 w-[80%]">
                                    <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center flex-shrink-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.95 11.95 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                                    </div>
                                    <div>
                                        <span class="font-bold text-gray-800 block">@role.Name</span>
                                        <span class="text-xs text-gray-400">شناسه: @role.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 w-[15%]">
                                @if (role.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-emerald-700 text-xs font-medium">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.9)]"></span>
                                        فعال
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-gray-200 text-gray-600 text-xs font-medium">
                                        غیرفعال
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-center w-[15%]">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" @onclick="() => EditRole(role)" class="p-2 text-blue-500 hover:bg-blue-100 rounded-lg smooth-transition" title="ویرایش">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                    </button>
                                    <button type="button" @onclick="() => OpenDeleteModal(role)" class="p-2 text-rose-500 hover:bg-rose-100 rounded-lg smooth-transition" title="حذف">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                </div>
                            </td>
                        </RowTemplate>
                    </DataGrid>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toolbar for Bulk Actions -->
<BulkActionToolbar SelectedCount="selectedRoleIds.Count"
                   OnCancel="ClearSelection"
                   OnDelete="OpenBulkDeleteModal" 
                   OnDeactivate="BulkDeactivateRoles" 
                   OnActivate="BulkActivateRoles" />

<!-- Animated Delete Modal -->
<ConfirmDeleteModal IsOpen="showDeleteModal"
                         Description="@($"آیا از حذف نقش «{roleToDelete?.Name}» مطمئن هستید؟ این عملیات غیرقابل بازگشت است.")"
                         ErrorMessage="@(isError ? successMessage : null)"
                         OnConfirm="ConfirmDelete"
                         OnCancel="CancelDelete" />


@code {

    // متغیرهای Bulk Action
    private HashSet<int> selectedRoleIds = new();
    private bool isBulkDelete = false;
    private string deleteModalDescription = string.Empty;

    private Role roleModel = new();
    private List<Role>? roles;
    private string? successMessage;
    private bool isError = false;

    // متغیرهای جستجو
    private string searchTerm = string.Empty;

    // متغیرهای حالت ویرایش
    private bool isEditing = false;
    private int? editingRoleId = null;

    // متغیرهای مودال حذف
    private bool showDeleteModal = false;
    private Role? roleToDelete;

    // فیلتر کردن نقش‌ها بر اساس کلمه جستجو شده
    private IEnumerable<Role> FilteredRoles =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? (roles ?? Enumerable.Empty<Role>())
            : (roles ?? Enumerable.Empty<Role>()).Where(r => r.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        roles = await DbContext.Roles.ToListAsync();
    }

    private async Task HandleSubmitRole()
    {
        if (string.IsNullOrWhiteSpace(roleModel.Name)) return;

        isError = false;

        if (isEditing && editingRoleId.HasValue)
        {
            var roleToUpdate = await DbContext.Roles.FindAsync(editingRoleId.Value);
            if (roleToUpdate != null)
            {
                roleToUpdate.Name = roleModel.Name;
                roleToUpdate.IsActive = roleModel.IsActive;
                successMessage = "نقش با موفقیت ویرایش شد.";
            }
        }
        else
        {
            DbContext.Roles.Add(roleModel);
            successMessage = "نقش با موفقیت ایجاد شد.";
        }

        await DbContext.SaveChangesAsync();
        CancelEdit();
        await LoadRoles();

        _ = Task.Delay(3000).ContinueWith(_ => { successMessage = null; InvokeAsync(StateHasChanged); });
    }

    private void EditRole(Role role)
    {
        isEditing = true;
        editingRoleId = role.Id;
        roleModel.Name = role.Name;
        roleModel.IsActive = role.IsActive;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingRoleId = null;
        roleModel = new Role();
        successMessage = null;
    }

    private void HandleSearch(string term)
    {
        searchTerm = term;
    }

    private void OnSelectionChanged(HashSet<int> newKeys)
    {
        selectedRoleIds = newKeys;
    }

    private void ClearSelection()
    {
        selectedRoleIds.Clear();
    }

    private void OpenBulkDeleteModal()
    {
        isBulkDelete = true;
        deleteModalDescription = $"آیا از حذف {selectedRoleIds.Count} نقش انتخاب شده مطمئن هستید؟ این عملیات غیرقابل بازگشت است.";
        showDeleteModal = true;
    }

    // باز کردن مودال حذف برای یک آیتم
    private void OpenDeleteModal(Role role)
    {
        roleToDelete = role;
        isBulkDelete = false;
        deleteModalDescription = $"آیا از حذف نقش «{role.Name}» مطمئن هستید؟ این عملیات غیرقابل بازگشت است.";
        showDeleteModal = true;
    }

    // بستن مودال حذف
    private void CancelDelete()
    {
        showDeleteModal = false;
        roleToDelete = null;
        isBulkDelete = false;
    }

    // تایید و اجرای حذف (هم تکی و هم گروهی)
    private async Task ConfirmDelete()
    {
        try
        {
            if (isBulkDelete)
            {
                var rolesToRemove = await DbContext.Roles.Where(r => selectedRoleIds.Contains(r.Id)).ToListAsync();
                DbContext.Roles.RemoveRange(rolesToRemove);
                await DbContext.SaveChangesAsync();

                // Set dynamic verb based on count
                var verb = rolesToRemove.Count == 1 ? "شد" : "شدند";
                successMessage = $"{rolesToRemove.Count} نقش با موفقیت حذف {verb}.";

                ClearSelection();
            }
            else if (roleToDelete != null)
            {
                DbContext.Roles.Remove(roleToDelete);
                await DbContext.SaveChangesAsync();

                successMessage = "نقش با موفقیت حذف شد.";
                if (isEditing && editingRoleId == roleToDelete.Id) CancelEdit();
            }

            isError = false;
            await LoadRoles();
        }
        catch (Exception)
        {
            isError = true;
            successMessage = "امکان حذف وجود ندارد! ابتدا باید کاربرانی که این نقش‌ها را دارند، ویرایش کنید.";
        }
        finally
        {
            CancelDelete(); // بستن مودال در هر صورت
            _ = Task.Delay(4000).ContinueWith(_ => { successMessage = null; isError = false; InvokeAsync(StateHasChanged); });
        }
    }

    private async Task BulkDeactivateRoles()
    {
        var rolesToDeactivate = await DbContext.Roles
            .Where(r => selectedRoleIds.Contains(r.Id))
            .ToListAsync();

        foreach (var role in rolesToDeactivate)
        {
            role.IsActive = false;
        }

        await DbContext.SaveChangesAsync();

        var verb = rolesToDeactivate.Count == 1 ? "شد" : "شدند";
        successMessage = $"{rolesToDeactivate.Count} نقش با موفقیت غیرفعال {verb}.";

        ClearSelection();
        await LoadRoles();

        _ = Task.Delay(4000).ContinueWith(_ => { successMessage = null; InvokeAsync(StateHasChanged); });
    }

    private async Task BulkActivateRoles()
    {
        var rolesToActivate = await DbContext.Roles
            .Where(r => selectedRoleIds.Contains(r.Id))
            .ToListAsync();

        foreach (var role in rolesToActivate)
        {
            role.IsActive = true;
        }

        await DbContext.SaveChangesAsync();

        var verb = rolesToActivate.Count == 1 ? "شد" : "شدند";
        successMessage = $"{rolesToActivate.Count} نقش با موفقیت فعال {verb}.";

        ClearSelection();
        await LoadRoles();

        _ = Task.Delay(4000).ContinueWith(_ => { successMessage = null; InvokeAsync(StateHasChanged); });
    }
}