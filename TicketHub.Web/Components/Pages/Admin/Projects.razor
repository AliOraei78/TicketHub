@page "/projects"
@using TicketHub.Core.Entities
@using TicketSystem.Application.Interfaces
@rendermode InteractiveServer
@inject IProjectService ProjectService

<div class="container mx-auto p-4 md:p-8" dir="rtl">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">مدیریت پروژه‌ها</h1>
            <p class="text-sm text-gray-500 mt-1">پروژه‌های سیستم را برای تخصیص تیکت‌ها مدیریت کنید.</p>
        </div>
        <button @onclick="OpenCreateModal" class="smooth-transition bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2.5 rounded-xl shadow-lg shadow-indigo-500/20 flex items-center gap-2 hover:scale-105 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            ایجاد پروژه جدید
        </button>
    </div>

    <!-- Projects Grid -->
    @if (projects == null)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (!projects.Any())
    {
        <div class="bg-white rounded-2xl border border-dashed border-gray-200 p-12 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            <p class="text-gray-500 font-medium">هیچ پروژه‌ای یافت نشد.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var project in projects)
            {
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md smooth-transition group">
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center mb-4 group-hover:bg-indigo-600 group-hover:text-white smooth-transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">@project.Name</h3>
                    <p class="text-gray-500 text-sm mb-4 line-clamp-2">@project.Description</p>
                    <div class="text-xs text-gray-400 border-t border-gray-50 pt-4">
                        ایجاد شده در: @project.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create Project Modal -->
@if (isModalOpen)
{
    <div class="fixed inset-0 bg-gray-900/40 backdrop-blur-sm flex justify-center items-center z-50 p-4 animate-[fadeIn_0.2s_ease-out]">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl border border-gray-100 overflow-hidden transform transition-all scale-100" dir="rtl">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h3 class="font-bold text-gray-800 text-lg">ایجاد پروژه جدید</h3>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600 smooth-transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <EditForm Model="@newProject" OnValidSubmit="HandleCreateProject" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">نام پروژه</label>
                    <InputText @bind-Value="newProject.Name" class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm smooth-transition" placeholder="نام پروژه را وارد کنید" required />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">توضیحات</label>
                    <InputTextArea @bind-Value="newProject.Description" rows="3" class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm smooth-transition" placeholder="درباره این پروژه بنویسید..." />
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <button type="button" @onclick="CloseModal" class="smooth-transition px-5 py-2 rounded-xl text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200">انصراف</button>
                    <button type="submit" class="smooth-transition px-5 py-2 rounded-xl text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700 shadow-lg shadow-indigo-500/10">ثبت پروژه</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private IEnumerable<Project> projects = new List<Project>();
    private bool isModalOpen = false;
    private Project newProject = new Project();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        projects = await ProjectService.GetAllProjectsAsync();
    }

    private void OpenCreateModal()
    {
        newProject = new Project(); // Reset form
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task HandleCreateProject()
    {
        newProject.CreatedAt = DateTime.UtcNow;
        await ProjectService.CreateProjectAsync(newProject);
        await LoadProjects(); // Refresh the list
        isModalOpen = false;
    }
}