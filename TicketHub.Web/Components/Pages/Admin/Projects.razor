@page "/projects"
@using TicketHub.Core.Entities
@using TicketSystem.Application.Interfaces
@using TicketHub.Web.Components.Shared
@rendermode InteractiveServer
@inject IProjectService ProjectService

<div class="container mx-auto p-4 md:p-8" dir="rtl">

    <PageHeader Title="مدیریت پروژه‌ها"
                Description="پروژه‌های سیستم را برای تخصیص تیکت‌ها مدیریت کنید."
                ButtonText="ایجاد پروژه جدید"
                ButtonThemeClass="bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/20"
                OnActionClick="OpenCreateModal">
        <Icon>
            <!-- Project icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
        </Icon>
    </PageHeader>

    <!-- Projects Grid -->
    @if (projects == null)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
        </div>
    }
    else if (!projects.Any())
    {
        <div class="bg-white rounded-2xl border border-dashed border-gray-200 p-12 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            <p class="text-gray-500 font-medium">هیچ پروژه‌ای یافت نشد.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var project in projects)
            {
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md smooth-transition group relative">

                    <!-- Action Buttons (Edit / Delete) -->
                    <div class="absolute top-4 left-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                        <button type="button" @onclick="() => OpenEditModal(project)" class="p-1.5 text-indigo-500 hover:bg-indigo-50 rounded-lg smooth-transition" title="ویرایش">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 5.232z" /></svg>
                        </button>
                        <button type="button" @onclick="() => OpenDeleteModal(project)" class="p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg smooth-transition" title="حذف">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                    </div>

                    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center mb-4 group-hover:bg-indigo-600 group-hover:text-white smooth-transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-2 pl-16">@project.Name</h3>
                    <p class="text-gray-500 text-sm mb-4 line-clamp-2">@project.Description</p>
                    <div class="text-xs text-gray-400 border-t border-gray-50 pt-4">
                        ایجاد شده در: @project.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Unified Create/Edit Modal (با استایل‌های مشابه یوزر) -->
<ModalDialog IsOpen="isFormModalOpen"
             Title="@(projectModel.Id == 0 ? "ایجاد پروژه جدید" : "ویرایش پروژه")"
             OnClose="CloseFormModal"
             MaxWidthClass="max-w-md">

    <EditForm Model="@projectModel" OnValidSubmit="HandleSaveProject" class="flex flex-col max-h-[85vh]">
        <div class="p-8 space-y-6 overflow-y-auto flex-1">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">نام پروژه</label>
                <InputText @bind-Value="projectModel.Name" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500 text-sm smooth-transition" placeholder="نام پروژه را وارد کنید" required />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">توضیحات</label>
                <InputTextArea @bind-Value="projectModel.Description" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500 text-sm smooth-transition" placeholder="درباره این پروژه بنویسید..." />
            </div>
        </div>

        <div class="px-8 py-6 border-t bg-gray-50 flex gap-3">
            <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3.5 rounded-2xl smooth-transition shadow-lg shadow-indigo-500/10">
                @(projectModel.Id == 0 ? "ثبت پروژه" : "ذخیره تغییرات")
            </button>
            <button type="button" @onclick="CloseFormModal" class="flex-1 border border-gray-300 hover:bg-gray-100 font-medium py-3.5 rounded-2xl smooth-transition text-gray-700">انصراف</button>
        </div>
    </EditForm>
</ModalDialog>

<!-- Use the shared delete modal component -->
<ConfirmDeleteModal IsOpen="isDeleteModalOpen"
                    Description="@($"آیا از حذف پروژه {projectToDelete?.Name} مطمئن هستید؟")"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CloseDeleteModal" />

@code {
    private IEnumerable<Project> projects = new List<Project>();

    // Model for Create/Edit
    private Project projectModel = new Project();
    private bool isFormModalOpen = false;

    // Model for Delete
    private Project? projectToDelete;
    private bool isDeleteModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        projects = await ProjectService.GetAllProjectsAsync();
    }

    // --- Create / Edit Methods ---
    private void OpenCreateModal()
    {
        projectModel = new Project(); // Id = 0
        isFormModalOpen = true;
    }

    private void OpenEditModal(Project project)
    {
        projectModel = new Project
        {
            Id = project.Id,
            Name = project.Name,
            Description = project.Description,
            CreatedAt = project.CreatedAt
        };
        isFormModalOpen = true;
    }

    private void CloseFormModal()
    {
        isFormModalOpen = false;
    }

    private async Task HandleSaveProject()
    {
        if (projectModel.Id == 0)
        {
            projectModel.CreatedAt = DateTime.UtcNow;
            await ProjectService.CreateProjectAsync(projectModel);
        }
        else
        {
            // پیدا کردن شیء اصلی که توسط EF Core ردیابی (Track) می‌شود
            var trackedProject = projects.FirstOrDefault(p => p.Id == projectModel.Id);

            if (trackedProject != null)
            {
                // انتقال مقادیر فرم به شیء اصلی
                trackedProject.Name = projectModel.Name;
                trackedProject.Description = projectModel.Description;

                await ProjectService.UpdateProjectAsync(trackedProject);
            }
        }

        await LoadProjects();
        isFormModalOpen = false;
    }

    // --- Delete Methods ---
    private void OpenDeleteModal(Project project)
    {
        projectToDelete = project;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        projectToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (projectToDelete != null)
        {
            await ProjectService.DeleteProjectAsync(projectToDelete.Id);
            await LoadProjects();
        }
        CloseDeleteModal();
    }
}