@using TicketHub.Core.Entities

<div class="w-72 bg-white border-l border-slate-200 flex flex-col z-30 shadow-[-10px_0_30px_-15px_rgba(0,0,0,0.1)] flex-shrink-0">
    <div class="p-5 border-b border-slate-100">
        <h2 class="font-bold text-lg text-slate-800">وضعیت‌ها</h2>
        <p class="text-xs text-slate-500 mt-1">وضعیت مورد نظر را انتخاب و به صفحه اضافه کنید</p>
    </div>
    <div class="p-4">
        <div class="relative">
            <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="جستجوی وضعیت..." class="w-full pl-4 pr-10 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" />
        </div>
    </div>
    <div class="flex-1 overflow-y-auto p-4 pt-0 flex flex-col gap-2 custom-scrollbar">
        @foreach (var status in FilteredStatuses)
        {
            <div @key="status.Id" draggable="true" @ondragstart="() => OnDragStart.InvokeAsync(status)" class="p-3 bg-white border border-slate-200 rounded-xl hover:border-blue-400 hover:shadow-md transition-all cursor-grab flex items-center justify-between group select-none" @onclick="() => OnStatusAdd.InvokeAsync(status)">
                <div class="flex items-center gap-3">
                    <span class="w-3 h-3 rounded-full shadow-sm" style="background-color: @status.ColorCode"></span>
                    <span class="font-medium text-slate-700 text-sm">@status.Name</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IEnumerable<Status> Statuses { get; set; } = new List<Status>();
    [Parameter] public EventCallback<Status> OnDragStart { get; set; }
    [Parameter] public EventCallback<Status> OnStatusAdd { get; set; }

    private string SearchTerm { get; set; } = "";
    private IEnumerable<Status> FilteredStatuses => string.IsNullOrEmpty(SearchTerm) ? Statuses : Statuses.Where(s => s.Name.Contains(SearchTerm));
}