@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows.WorkflowEditor
@using TicketHub.Application.DTOs

<div class="w-72 cyber-sidebar-glass border-l border-slate-800/80 flex flex-col z-30 shadow-[0_10px_35px_rgba(0,0,0,0.8)] flex-shrink-0 select-none" dir="rtl">
    <div class="p-4 border-b border-slate-800/80">
        <h2 class="font-black text-xs text-slate-100 uppercase tracking-wider">وضعیت‌ها</h2>
        <p class="text-[11px] text-slate-400 mt-1 font-normal">وضعیت مورد نظر را انتخاب و به صفحه اضافه کنید</p>
    </div>
    <div class="p-3">
        <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="جستجوی وضعیت..." class="w-full h-[38px] px-3 bg-slate-900/80 border border-slate-700/80 rounded-xl text-xs text-slate-100 placeholder:text-slate-500 focus:border-sky-400 focus:shadow-[0_0_10px_rgba(56,189,248,0.3)] outline-none transition-all" />
    </div>
    <div class="flex-1 overflow-y-auto p-3 pt-0 flex flex-col gap-2 custom-scrollbar">
        @foreach (var status in FilteredStatuses)
        {
            <div @key="status.Id" draggable="true" @ondragstart="() => OnDragStart.InvokeAsync(status)" class="p-2.5 bg-[#090e1d]/90 border border-slate-800/80 rounded-2xl hover:border-sky-400 hover:shadow-[0_0_15px_rgba(56,189,248,0.25)] hover:bg-slate-900/90 transition-all cursor-grab flex items-center justify-between group select-none" @onclick="() => OnStatusAdd.InvokeAsync(status)">
                <div class="flex items-center gap-2.5">
                    <span class="w-3.5 h-3.5 rounded-full shadow-[0_0_8px_currentColor] flex-shrink-0" style="background-color: @status.ColorCode; color: @status.ColorCode;"></span>
                    <span class="font-bold text-slate-200 text-xs truncate">@status.Name</span>
                </div>
            </div>
        }
    </div>
</div>