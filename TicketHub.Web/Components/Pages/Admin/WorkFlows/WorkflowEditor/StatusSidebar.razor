@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows.WorkflowEditor
@using TicketHub.Application.DTOs

<div class="w-72 bg-white border-l border-slate-200 flex flex-col z-30 shadow-[-10px_0_30px_-15px_rgba(0,0,0,0.08)] flex-shrink-0 select-none">
    <div class="p-5 border-b border-slate-100">
        <h2 class="font-bold text-lg text-slate-800 tracking-tight">وضعیت‌ها</h2>
        <p class="text-xs text-slate-500 mt-1 font-normal">وضعیت مورد نظر را انتخاب و به صفحه اضافه کنید</p>
    </div>
    <div class="p-4">
        <div class="relative">
            <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="جستجوی وضعیت..." class="w-full h-[44px] pl-4 pr-10 bg-slate-50 border border-slate-200 rounded-2xl text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none transition-all shadow-2xs" />
        </div>
    </div>
    <div class="flex-1 overflow-y-auto p-4 pt-0 flex flex-col gap-2 custom-scrollbar">
        @foreach (var status in FilteredStatuses)
        {
            <div @key="status.Id" draggable="true" @ondragstart="() => OnDragStart.InvokeAsync(status)" class="p-3 bg-white border border-slate-200 rounded-2xl hover:border-indigo-400 hover:shadow-md transition-all cursor-grab flex items-center justify-between group select-none" @onclick="() => OnStatusAdd.InvokeAsync(status)">
                <div class="flex items-center gap-3">
                    <span class="w-3 h-3 rounded-full shadow-2xs" style="background-color: @status.ColorCode"></span>
                    <span class="font-bold text-slate-700 text-xs">@status.Name</span>
                </div>
            </div>
        }
    </div>
</div>