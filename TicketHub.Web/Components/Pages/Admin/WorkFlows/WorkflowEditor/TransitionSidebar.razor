@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows.WorkflowEditor
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<div class="absolute left-4 top-24 h-[calc(100vh-7.5rem)] w-88 cyber-sidebar-glass border border-slate-800/90 rounded-3xl z-40 shadow-[0_20px_50px_rgba(0,0,0,0.95),0_0_35px_rgba(56,189,248,0.15)] transition-all duration-300 flex flex-col overflow-hidden select-none @(Connection != null ? "translate-x-0 opacity-100" : "-translate-x-full opacity-0 pointer-events-none")" dir="rtl">

    @if (Connection != null)
    {
        <div class="p-4 border-b border-slate-800/80 flex justify-between items-center bg-slate-950/90 flex-shrink-0">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-sky-400 shadow-[0_0_6px_rgba(56,189,248,0.8)]"></span>
                <h2 class="font-black text-xs text-slate-100 uppercase tracking-wider">مدیریت مسیر انتقال</h2>
            </div>
            <button @onclick="OnClose" class="w-8 h-8 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-rose-400 hover:border-rose-500/50 hover:bg-rose-950/40 flex items-center justify-center transition-colors focus-ring" title="بستن">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <EditForm Model="Connection" class="flex-1 overflow-y-auto p-5 space-y-5 custom-scrollbar">
            <FluentValidationValidator />

            <!-- Flow summary chip -->
            <div class="flex items-center justify-between bg-slate-900/80 p-3 rounded-2xl border border-slate-800 shadow-inner">
                <span class="text-xs font-bold text-sky-300 bg-sky-950/90 px-3 py-1 rounded-xl border border-sky-500/40 shadow-[0_0_8px_rgba(56,189,248,0.2)]">@GetNodeName?.Invoke(Connection.FromNodeId)</span>
                <span class="text-indigo-400 font-bold animate-pulse text-base">⟵</span>
                <span class="text-xs font-bold text-sky-300 bg-sky-950/90 px-3 py-1 rounded-xl border border-sky-500/40 shadow-[0_0_8px_rgba(56,189,248,0.2)]">@GetNodeName?.Invoke(Connection.ToNodeId)</span>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">عنوان انتقال</label>
                <div class="field-spark-wrap w-full">
                    <input type="text" @bind="Connection.Name" @bind:event="oninput" placeholder="عنوان مسیر انتقال..." class="w-full h-[42px] px-3.5 bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] rounded-xl text-slate-100 placeholder:text-slate-500 text-xs outline-none transition-all focus-ring" />
                </div>
                <ValidationMessage For="@(() => Connection.Name)" class="validation-message text-rose-400 text-red-500 text-xs mt-1" />
            </div>

            <div class="space-y-3 pt-1">
                <CustomCheckbox Label="انتقال فعال است؟" @bind-Value="Connection.IsActive" />
                <div>
                    <CustomCheckbox Label="انتقال خودکار" 
                                    Value="Connection.IsAutomatic" 
                                    ValueChanged="OnIsAutomaticChanged" 
                                    Disabled="HasCompetingAutomatedTransition && !Connection.IsAutomatic" />
                    @if (HasCompetingAutomatedTransition && !Connection.IsAutomatic)
                    {
                        <div class="mt-1.5 p-2 rounded-xl bg-amber-950/60 border border-amber-500/50 text-amber-300 text-[11px] font-medium leading-relaxed flex items-start gap-1.5">
                            <span class="text-amber-400 font-bold">⚠️</span>
                            <span>این وضعیت مبدا قبلاً یک انتقال خودکار خروجی دارد (حداکثر ۱ انتقال خودکار مجاز است).</span>
                        </div>
                    }
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">تاریخ فعال‌سازی (انتقال زمان‌بندی‌شده)</label>
                <CustomPersianDatePicker @bind-Value="ActivateAtString" Placeholder="1403/05/12 14:30" ShowTimePicker="true" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">مهلت انجام / SLA (دقیقه)</label>
                <div class="field-spark-wrap w-full">
                    <input type="number" min="0" @bind="Connection.DeadlineMinutes" placeholder="مثال: ۶۰ (اختیاری)" class="w-full h-[42px] px-3.5 bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] rounded-xl text-slate-100 placeholder:text-slate-500 text-xs outline-none transition-all focus-ring" />
                </div>
            </div>

            <div class="pt-2">
                <label class="block text-xs font-bold text-slate-300 mb-2">نقش‌های مجاز</label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var role in AvailableRoles)
                    {
                        bool hasRole = Connection.AllowedRoleIds.Contains(role.Id);
                        <button @key="role.Id" 
                                type="button" 
                                @onclick="() => OnRoleToggle.InvokeAsync(role.Id)" 
                                class="px-3 py-1.5 rounded-xl text-xs font-bold border transition-all focus-ring @(hasRole ? "bg-sky-950/90 border-sky-400 text-sky-300 shadow-[0_0_10px_rgba(56,189,248,0.3)]" : "bg-slate-900/60 border-slate-800 text-slate-400 hover:border-slate-700 hover:text-slate-200")">
                            @role.Name
                        </button>
                    }
                </div>
            </div>

            <div class="pt-4 border-t border-slate-800">
                <div class="flex items-center justify-between mb-3">
                    <label class="block text-xs font-bold text-slate-300">فیلدهای سفارشی</label>
                    <button type="button" @onclick="AddCustomField" class="px-3 py-1.5 rounded-xl text-xs font-black text-sky-300 bg-sky-950/80 border border-sky-500/50 hover:bg-sky-900 transition-all focus-ring shadow-[0_0_10px_rgba(56,189,248,0.2)]">
                        + افزودن فیلد
                    </button>
                </div>

                <div class="space-y-3">
                    @if (Connection.CustomFields.Any())
                    {
                        @foreach (var field in Connection.CustomFields.OrderBy(f => f.SortOrder))
                        {
                            <div @key="field" class="p-3 bg-slate-900/90 border rounded-2xl shadow-md cursor-move transition-all duration-200 @(field == DraggedField ? "opacity-30 border-dashed border-sky-400 scale-95 bg-slate-950" : "border-slate-800 hover:border-slate-700")"
                                 draggable="true"
                                 @ondragstart="() => HandleDragStart(field)"
                                 @ondragenter="() => HandleDragEnter(field)"
                                 @ondragend="HandleDragEnd"
                                 @ondragover:preventDefault="true">

                                <div class="flex items-start gap-2">

                                    <div class="flex-1 min-w-0 flex flex-col gap-2">
                                        <div>
                                            <div class="field-spark-wrap w-full">
                                                <input type="text" @bind="field.FieldName" @bind:event="oninput" placeholder="عنوان فیلد" class="w-full h-[38px] px-3 text-xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] rounded-xl text-slate-100 placeholder:text-slate-500 outline-none transition-all pointer-events-auto focus-ring" />
                                            </div>
                                            <ValidationMessage For="@(() => field.FieldName)" class="text-rose-400 text-[10px] mt-0.5" />
                                        </div>

                                        <div class="pointer-events-auto">
                                            <SlideSelect 
                                                TItem="FieldTypeDto" 
                                                TValue="int" 
                                                Items="AvailableFieldTypes" 
                                                TextSelector="@(t => t.Type)" 
                                                ValueSelector="@(t => t.Id)" 
                                                @bind-Value="field.FieldTypeId" 
                                                Placeholder="انتخاب نوع..." 
                                                AllowClear="true" 
                                                ClearText="انتخاب نوع..." />
                                            <ValidationMessage For="@(() => field.FieldTypeId)" class="text-rose-400 text-[10px] mt-0.5" />
                                        </div>

                                        @{
                                            var typeName = AvailableFieldTypes.FirstOrDefault(t => t.Id == field.FieldTypeId)?.Type ?? "";
                                            var showOptions = typeName.Contains("Dropdown", StringComparison.OrdinalIgnoreCase);
                                            var showTextProps = typeName.Contains("Text", StringComparison.OrdinalIgnoreCase) || 
                                                                typeName.Contains("Number", StringComparison.OrdinalIgnoreCase) || 
                                                                typeName.Contains("TextArea", StringComparison.OrdinalIgnoreCase);
                                        }

                                        <div class="grid transition-all duration-300 ease-in-out @(showOptions ? "grid-rows-[1fr] opacity-100 mt-2" : "grid-rows-[0fr] opacity-0 mt-0")">
                                            <div class="overflow-hidden">
                                                <div class="field-spark-wrap w-full">
                                                    <input type="text" @bind="field.Options" @bind:event="oninput" placeholder="گزینه‌ها را با کاما (,) جدا کنید" class="w-full h-[38px] px-3 text-xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] rounded-xl text-slate-100 placeholder:text-slate-500 outline-none transition-all pointer-events-auto focus-ring" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="grid transition-all duration-300 ease-in-out @(showTextProps ? "grid-rows-[1fr] opacity-100 mt-2" : "grid-rows-[0fr] opacity-0 mt-0")">
                                            <div class="overflow-hidden flex flex-col gap-2">
                                                <div class="field-spark-wrap w-full">
                                                    <input type="text" @bind="field.Placeholder" @bind:event="oninput" placeholder="متن جایگیر (Placeholder)" class="w-full h-[38px] px-3 text-xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] rounded-xl text-slate-100 placeholder:text-slate-500 outline-none transition-all pointer-events-auto focus-ring" />
                                                </div>
                                                @if (typeName.Contains("Number", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="field-spark-wrap w-full">
                                                        <input type="number" @bind="field.DefaultValue" @bind:event="oninput" placeholder="مقدار پیش‌فرض" class="w-full h-[38px] px-3 text-xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] rounded-xl text-slate-100 placeholder:text-slate-500 outline-none transition-all pointer-events-auto focus-ring" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="field-spark-wrap w-full">
                                                        <input type="text" @bind="field.DefaultValue" @bind:event="oninput" placeholder="مقدار پیش‌فرض" class="w-full h-[38px] px-3 text-xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] rounded-xl text-slate-100 placeholder:text-slate-500 outline-none transition-all pointer-events-auto focus-ring" />
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-4 mt-1">
                                            <CustomCheckbox Label="اجباری" @bind-Value="field.IsRequired" />
                                            <CustomCheckbox Label="فعال" @bind-Value="field.IsActive" />
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-2 shrink-0 mt-0.5 border-r border-slate-800 pr-2">
                                        <button type="button" @onclick="() => RemoveCustomField(field)" class="w-6 h-6 flex items-center justify-center text-rose-400 hover:text-rose-300 hover:bg-rose-950/50 rounded-lg transition-colors pointer-events-auto focus-ring" title="حذف">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                        </button>
                                        <div class="w-6 h-6 flex items-center justify-center text-slate-500 cursor-grab" title="جابجایی">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-800">
                <button type="button" 
                        @onclick="() => OnDelete.InvokeAsync(Connection)" 
                        class="w-full py-2.5 rounded-xl text-xs font-bold text-rose-400 bg-rose-950/50 hover:bg-rose-900/60 border border-rose-500/50 transition-all shadow-[0_0_15px_rgba(244,63,94,0.2)] focus-ring">
                    حذف این مسیر انتقال
                </button>
            </div>
        </EditForm>
    }
</div>