@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows.WorkflowEditor
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<div class="absolute left-4 top-20 h-[calc(100vh-6rem)] w-80 bg-white border border-slate-200/80 rounded-3xl z-40 shadow-2xl transition-all duration-300 flex flex-col overflow-hidden select-none @(Connection != null ? "translate-x-0 opacity-100" : "-translate-x-full opacity-0 pointer-events-none")">

    @if (Connection != null)
    {
        <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/80 flex-shrink-0">
            <h2 class="font-bold text-sm text-slate-800 tracking-tight">مدیریت انتقال وضعیت</h2>
            <button @onclick="OnClose" class="w-8 h-8 rounded-full bg-slate-200/50 hover:bg-rose-50 hover:text-rose-600 text-slate-500 flex items-center justify-center transition-colors focus-ring" title="بستن">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <EditForm Model="Connection" class="flex-1 overflow-y-auto p-5 space-y-5 custom-scrollbar">
            <FluentValidationValidator />

            <div class="flex items-center justify-between bg-slate-50 p-3 rounded-2xl border border-slate-200/80">
                <span class="text-xs font-bold text-slate-700 bg-white px-2.5 py-1 rounded-xl border border-slate-100 shadow-2xs">@GetNodeName?.Invoke(Connection.FromNodeId)</span>
                <span class="text-slate-400 font-bold">→</span>
                <span class="text-xs font-bold text-slate-700 bg-white px-2.5 py-1 rounded-xl border border-slate-100 shadow-2xs">@GetNodeName?.Invoke(Connection.ToNodeId)</span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">عنوان انتقال</label>
                <input type="text" @bind="Connection.Name" @bind:event="oninput" class="w-full h-[44px] px-4 bg-slate-50 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all text-sm outline-none" />
                <ValidationMessage For="@(() => Connection.Name)" class="text-rose-500 text-red-500 text-xs mt-1" />
            </div>

            <div class="space-y-3 pt-1">
                <CustomCheckbox Label="انتقال فعال است؟" @bind-Value="Connection.IsActive" />
                <div>
                    <CustomCheckbox Label="انتقال خودکار" 
                                    Value="Connection.IsAutomatic" 
                                    ValueChanged="OnIsAutomaticChanged" 
                                    Disabled="HasCompetingAutomatedTransition && !Connection.IsAutomatic" />
                    @if (HasCompetingAutomatedTransition && !Connection.IsAutomatic)
                    {
                        <div class="mt-1 p-2 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-800 text-[11px] font-medium leading-relaxed flex items-start gap-1.5">
                            <span class="text-amber-500 font-bold">⚠️</span>
                            <span>این وضعیت مبدا قبلاً یک انتقال خودکار خروجی دارد (حداکثر ۱ انتقال خودکار مجاز است).</span>
                        </div>
                    }
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">تاریخ فعال‌سازی (انتقال زمان‌بندی‌شده)</label>
                <CustomPersianDatePicker @bind-Value="ActivateAtString" Placeholder="1403/05/12 14:30" ShowTimePicker="true" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">مهلت انجام / SLA (دقیقه)</label>
                <input type="number" min="0" @bind="Connection.DeadlineMinutes" placeholder="مثال: ۶۰ (اختیاری)" class="w-full h-[44px] px-4 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-2xs" />
            </div>

            <div class="pt-2">
                <label class="block text-xs font-semibold text-slate-700 mb-2">نقش‌های مجاز</label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var role in AvailableRoles)
                    {
                        bool hasRole = Connection.AllowedRoleIds.Contains(role.Id);
                        <button @key="role.Id" type="button" @onclick="() => OnRoleToggle.InvokeAsync(role.Id)" class="px-3 py-1.5 rounded-xl text-xs font-bold border transition-colors focus-ring @(hasRole ? "bg-indigo-50 border-indigo-200 text-indigo-700" : "bg-white border-slate-200 text-slate-600 hover:bg-slate-50")">
                            @role.Name
                        </button>
                    }
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <div class="flex items-center justify-between mb-3">
                    <label class="block text-xs font-semibold text-slate-700">فیلدهای سفارشی</label>
                    <button type="button" @onclick="AddCustomField" class="text-xs bg-indigo-50 text-indigo-600 px-3 py-1.5 rounded-xl hover:bg-indigo-100 transition-colors font-bold focus-ring">
                        + افزودن فیلد
                    </button>
                </div>

                <div class="space-y-3">
                    @if (Connection.CustomFields.Any())
                    {
                        @foreach (var field in Connection.CustomFields.OrderBy(f => f.SortOrder))
                        {
                            <div @key="field" class="p-3 bg-white border rounded-2xl shadow-2xs cursor-move transition-all duration-200 @(field == DraggedField ? "opacity-30 border-dashed border-slate-400 scale-95 bg-slate-50" : "border-slate-200/80")"
                                 draggable="true"
                                 @ondragstart="() => HandleDragStart(field)"
                                 @ondragenter="() => HandleDragEnter(field)"
                                 @ondragend="HandleDragEnd"
                                 @ondragover:preventDefault="true">

                                <div class="flex items-start gap-2">

                                    <div class="flex-1 min-w-0 flex flex-col gap-2">
                                        <div>
                                            <input type="text" @bind="field.FieldName" @bind:event="oninput" placeholder="عنوان فیلد" class="w-full h-[40px] px-3 text-xs bg-slate-50 border border-slate-200 focus:bg-white rounded-xl outline-none focus:border-indigo-500 transition-all pointer-events-auto" />
                                            <ValidationMessage For="@(() => field.FieldName)" class="text-rose-500 text-red-500 text-[10px] mt-0.5" />
                                        </div>

                                        <div class="pointer-events-auto">
                                            <SlideSelect 
                                                TItem="FieldTypeDto" 
                                                TValue="int" 
                                                Items="AvailableFieldTypes" 
                                                TextSelector="@(t => t.Type)" 
                                                ValueSelector="@(t => t.Id)" 
                                                @bind-Value="field.FieldTypeId" 
                                                Placeholder="انتخاب نوع..." 
                                                AllowClear="true" 
                                                ClearText="انتخاب نوع..." />
                                            <ValidationMessage For="@(() => field.FieldTypeId)" class="text-rose-500 text-red-500 text-[10px] mt-0.5" />
                                        </div>

                                        @{
                                            var typeName = AvailableFieldTypes.FirstOrDefault(t => t.Id == field.FieldTypeId)?.Type ?? "";
                                            var showOptions = typeName.Contains("Dropdown", StringComparison.OrdinalIgnoreCase);
                                            var showTextProps = typeName.Contains("Text", StringComparison.OrdinalIgnoreCase) || 
                                                                typeName.Contains("Number", StringComparison.OrdinalIgnoreCase) || 
                                                                typeName.Contains("TextArea", StringComparison.OrdinalIgnoreCase);
                                        }

                                        <div class="grid transition-all duration-300 ease-in-out @(showOptions ? "grid-rows-[1fr] opacity-100 mt-2" : "grid-rows-[0fr] opacity-0 mt-0")">
                                            <div class="overflow-hidden">
                                                <input type="text" @bind="field.Options" @bind:event="oninput" placeholder="گزینه‌ها را با کاما (,) جدا کنید" class="w-full h-[40px] px-3 text-xs bg-slate-50 border border-slate-200 focus:bg-white rounded-xl outline-none focus:border-indigo-500 transition-all pointer-events-auto" />
                                            </div>
                                        </div>

                                        <div class="grid transition-all duration-300 ease-in-out @(showTextProps ? "grid-rows-[1fr] opacity-100 mt-2" : "grid-rows-[0fr] opacity-0 mt-0")">
                                            <div class="overflow-hidden flex flex-col gap-2">
                                                <input type="text" @bind="field.Placeholder" @bind:event="oninput" placeholder="متن جایگیر (Placeholder)" class="w-full h-[40px] px-3 text-xs bg-slate-50 border border-slate-200 focus:bg-white rounded-xl outline-none focus:border-indigo-500 transition-all pointer-events-auto" />
                                                @if (typeName.Contains("Number", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <input type="number" @bind="field.DefaultValue" @bind:event="oninput" placeholder="مقدار پیش‌فرض" class="w-full h-[40px] px-3 text-xs bg-slate-50 border border-slate-200 focus:bg-white rounded-xl outline-none focus:border-indigo-500 transition-all pointer-events-auto" />
                                                }
                                                else
                                                {
                                                    <input type="text" @bind="field.DefaultValue" @bind:event="oninput" placeholder="مقدار پیش‌فرض" class="w-full h-[40px] px-3 text-xs bg-slate-50 border border-slate-200 focus:bg-white rounded-xl outline-none focus:border-indigo-500 transition-all pointer-events-auto" />
                                                }
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-4 mt-1">
                                            <CustomCheckbox Label="اجباری" @bind-Value="field.IsRequired" />
                                            <CustomCheckbox Label="فعال" @bind-Value="field.IsActive" />
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-2 shrink-0 mt-0.5 border-r border-slate-100 pr-2">
                                        <button type="button" @onclick="() => RemoveCustomField(field)" class="w-6 h-6 flex items-center justify-center text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors pointer-events-auto focus-ring" title="حذف">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                        </button>
                                        <div class="w-6 h-6 flex items-center justify-center text-slate-300 cursor-grab" title="جابجایی">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-100">
                <button type="button" @onclick="() => OnDelete.InvokeAsync(Connection)" class="w-full py-3 rounded-2xl text-xs font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 transition-colors focus-ring">حذف این مسیر</button>
            </div>
        </EditForm>
    }
</div>