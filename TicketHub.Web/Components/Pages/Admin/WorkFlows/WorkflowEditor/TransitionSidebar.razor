<div class="absolute left-4 top-20 h-[calc(100vh-6rem)] w-80 bg-white border border-slate-200 rounded-2xl z-40 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.15)] transition-all duration-300 flex flex-col overflow-hidden @(Connection != null ? "translate-x-0 opacity-100" : "-translate-x-full opacity-0 pointer-events-none")">

    @if (Connection != null)
    {
        <!-- هدر با دکمه بستن جدید -->
        <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/80 flex-shrink-0">
            <h2 class="font-bold text-sm text-slate-800">مدیریت انتقال وضعیت</h2>
            <button @onclick="OnClose" class="w-8 h-8 rounded-full bg-slate-200/50 hover:bg-rose-100 hover:text-rose-600 text-slate-500 flex items-center justify-center transition-colors shadow-sm" title="بستن">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <EditForm Model="Connection" class="flex-1 overflow-y-auto p-5 space-y-5 custom-scrollbar">
            <FluentValidationValidator />

            <div class="flex items-center justify-between bg-slate-50 p-3 rounded-xl border border-slate-200">
                <span class="text-xs font-bold text-slate-600 bg-white px-2 py-1 rounded-md shadow-sm">@GetNodeName?.Invoke(Connection.FromNodeId)</span>
                <span>-></span>
                <span class="text-xs font-bold text-slate-600 bg-white px-2 py-1 rounded-md shadow-sm">@GetNodeName?.Invoke(Connection.ToNodeId)</span>
            </div>

            <div>
                <label>عنوان انتقال</label>
                <input type="text" @bind="Connection.Name" @bind:event="oninput" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl" />
                <ValidationMessage For="@(() => Connection.Name)" class="text-red-500 text-xs mt-1" />
            </div>

            <div class="flex items-center gap-4 pt-1">
                <label class="flex items-center gap-2 cursor-pointer">
                    <InputCheckbox @bind-Value="Connection.IsActive" class="w-4 h-4 text-blue-600 rounded border-slate-300" />
                    <span class="text-sm font-medium text-slate-700">فعال</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <InputCheckbox @bind-Value="Connection.IsAutomatic" class="w-4 h-4 text-blue-600 rounded border-slate-300" />
                    <span class="text-sm font-medium text-slate-700">انتقال خودکار</span>
                </label>
            </div>

            <!-- ورودی تاریخ اصلاح شده برای شمسی -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">تاریخ فعال‌سازی</label>
                <CustomPersianDatePicker @bind-Value="ActivateAtString" Placeholder="1403/05/12 14:30" ShowTimePicker="true" />
            </div>

            <div class="pt-2">
                <label class="block text-sm font-medium text-slate-700 mb-2">نقش‌های مجاز</label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var role in AvailableRoles)
                    {
                        bool hasRole = Connection.AllowedRoleIds.Contains(role.Id);
                        <button @key="role.Id" type="button" @onclick="() => OnRoleToggle.InvokeAsync(role.Id)" class="px-3 py-1.5 rounded-lg text-xs font-medium border @(hasRole ? "bg-indigo-50 border-indigo-200" : "bg-white")">
                            @role.Name
                        </button>
                    }
                </div>
            </div>

            <div class="pt-4 border-t border-slate-200">
                <div class="flex items-center justify-between mb-3">
                    <label class="block text-sm font-medium text-slate-700">فیلدهای سفارشی</label>
                    <button type="button" @onclick="AddCustomField" class="text-xs bg-blue-50 text-blue-600 px-2 py-1.5 rounded-lg hover:bg-blue-100 transition-colors font-medium">
                        + افزودن فیلد
                    </button>
                </div>

                <div class="space-y-3">
                    @if (Connection.CustomFields.Any())
                    {
                        @foreach (var field in Connection.CustomFields.OrderBy(f => f.SortOrder))
                        {
                            <div @key="field" class="p-3 bg-white border rounded-xl shadow-sm cursor-move transition-all duration-200 @(field == _draggedField ? "opacity-30 border-dashed border-slate-400 scale-95 bg-slate-50" : "border-slate-200")"
                                 draggable="true"
                                 @ondragstart="() => HandleDragStart(field)"
                                 @ondragenter="() => HandleDragEnter(field)"
                                 @ondragend="HandleDragEnd"
                                 @ondragover:preventDefault="true">

                                <div class="flex items-start gap-2">

                                    <div class="flex-1 min-w-0 flex flex-col gap-2">
                                        <!-- عنوان فیلد و نوع فیلد -->
                                        <div>
                                            <input type="text" @bind="field.FieldName" @bind:event="oninput" placeholder="عنوان فیلد" class="w-full px-2 py-1.5 text-sm bg-slate-50 border border-slate-200 focus:bg-white rounded-lg outline-none focus:border-blue-500 pointer-events-auto" />
                                            <ValidationMessage For="@(() => field.FieldName)" class="text-red-500 text-[10px] mt-0.5" />
                                        </div>

                                        <div class="pointer-events-auto">
                                            <TicketHub.Web.Components.Shared.SlideSelect 
                                                TItem="FieldTypeDto" 
                                                TValue="int" 
                                                Items="AvailableFieldTypes" 
                                                TextSelector="@(t => t.Type)" 
                                                ValueSelector="@(t => t.Id)" 
                                                @bind-Value="field.FieldTypeId" 
                                                Placeholder="انتخاب نوع..." 
                                                AllowClear="true" 
                                                ClearText="انتخاب نوع..." />
                                            <ValidationMessage For="@(() => field.FieldTypeId)" class="text-red-500 text-[10px] mt-0.5" />
                                        </div>

                                        @{
                                            var typeName = AvailableFieldTypes.FirstOrDefault(t => t.Id == field.FieldTypeId)?.Type ?? "";
                                            var showOptions = typeName.Contains("Dropdown", StringComparison.OrdinalIgnoreCase);
                                            var showTextProps = typeName.Contains("Text", StringComparison.OrdinalIgnoreCase) || 
                                                                typeName.Contains("Number", StringComparison.OrdinalIgnoreCase) || 
                                                                typeName.Contains("TextArea", StringComparison.OrdinalIgnoreCase);
                                        }

                                        <!-- نمایش فیلد گزینه‌ها تنها برای DropDown یا MultipleDropDown -->
                                        <div class="grid transition-all duration-300 ease-in-out @(showOptions ? "grid-rows-[1fr] opacity-100 mt-2" : "grid-rows-[0fr] opacity-0 mt-0")">
                                            <div class="overflow-hidden">
                                                <input type="text" @bind="field.Options" @bind:event="oninput" placeholder="گزینه‌ها را با کاما (,) جدا کنید" class="w-full px-2 py-1.5 text-sm bg-slate-50 border border-slate-200 focus:bg-white rounded-lg outline-none focus:border-blue-500 pointer-events-auto" />
                                            </div>
                                        </div>

                                        <!-- متن جایگیر و مقدار پیش‌فرض -->
                                        <div class="grid transition-all duration-300 ease-in-out @(showTextProps ? "grid-rows-[1fr] opacity-100 mt-2" : "grid-rows-[0fr] opacity-0 mt-0")">
                                            <div class="overflow-hidden flex flex-col gap-2">
                                                <input type="text" @bind="field.Placeholder" @bind:event="oninput" placeholder="متن جایگیر (Placeholder)" class="w-full px-2 py-1.5 text-sm bg-slate-50 border border-slate-200 focus:bg-white rounded-lg outline-none focus:border-blue-500 pointer-events-auto" />
                                                <input type="text" @bind="field.DefaultValue" @bind:event="oninput" placeholder="مقدار پیش‌فرض" class="w-full px-2 py-1.5 text-sm bg-slate-50 border border-slate-200 focus:bg-white rounded-lg outline-none focus:border-blue-500 pointer-events-auto" />
                                            </div>
                                        </div>

                                        <!-- گزینه‌های فعال بودن و اجباری بودن -->
                                        <div class="flex items-center gap-4 mt-1">
                                            <label class="flex items-center gap-1.5 cursor-pointer w-fit pointer-events-auto">
                                                <span class="text-xs font-medium text-slate-700">اجباری</span>
                                                <InputCheckbox @bind-Value="field.IsRequired" class="w-4 h-4 text-blue-600 rounded border-slate-300" />
                                            </label>
                                            <label class="flex items-center gap-1.5 cursor-pointer w-fit pointer-events-auto">
                                                <span class="text-xs font-medium text-slate-700">فعال</span>
                                                <InputCheckbox @bind-Value="field.IsActive" class="w-4 h-4 text-blue-600 rounded border-slate-300" />
                                            </label>
                                        </div>
                                    </div>

                                    <!-- دکمه حذف و آیکون درگ -->
                                    <div class="flex flex-col gap-2 shrink-0 mt-0.5 border-r border-slate-100 pr-2">
                                        <button type="button" @onclick="() => RemoveCustomField(field)" class="w-6 h-6 flex items-center justify-center text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-md transition-colors pointer-events-auto" title="حذف">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                        </button>
                                        <div class="w-6 h-6 flex items-center justify-center text-slate-300 cursor-grab" title="جابجایی">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-200">
                <button type="button" @onclick="() => OnDelete.InvokeAsync(Connection)" class="w-full py-2.5 rounded-xl text-rose-600 bg-rose-50">حذف این مسیر</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public IEnumerable<FieldTypeDto> AvailableFieldTypes { get; set; } = new List<FieldTypeDto>();
    [Parameter] public CanvasConnection? Connection { get; set; }
    [Parameter] public IEnumerable<RoleDto> AvailableRoles { get; set; } = new List<RoleDto>();
    [Parameter] public Func<Guid, string>? GetNodeName { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnRoleToggle { get; set; }
    [Parameter] public EventCallback<CanvasConnection> OnDelete { get; set; }

    private string ActivateAtString
    {
        get
        {
            if (Connection == null || !Connection.ActivateAt.HasValue) return string.Empty;
            var dt = Connection.ActivateAt.Value;
            var pc = new System.Globalization.PersianCalendar();
            return $"{pc.GetYear(dt):0000}/{pc.GetMonth(dt):00}/{pc.GetDayOfMonth(dt):00} {pc.GetHour(dt):00}:{pc.GetMinute(dt):00}";
        }
        set
        {
            if (Connection == null) return;
            if (string.IsNullOrWhiteSpace(value))
            {
                Connection.ActivateAt = null;
                return;
            }
            try
            {
                var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                var dateParts = parts[0].Split('/');
                int year = int.Parse(dateParts[0]);
                int month = int.Parse(dateParts[1]);
                int day = int.Parse(dateParts[2]);
                
                int hour = 0, minute = 0;
                if (parts.Length > 1)
                {
                    var timeParts = parts[1].Split(':');
                    hour = int.Parse(timeParts[0]);
                    minute = int.Parse(timeParts[1]);
                }
                var pc = new System.Globalization.PersianCalendar();
                Connection.ActivateAt = pc.ToDateTime(year, month, day, hour, minute, 0, 0);
            }
            catch
            {
                Connection.ActivateAt = null;
            }
        }
    }

    private void AddCustomField()
    {
        if (Connection != null)
        {
            int nextSortOrder = Connection.CustomFields.Any() ? Connection.CustomFields.Max(f => f.SortOrder) + 1 : 0;
            Connection.CustomFields.Add(new CanvasTransitionField
            {
                Id = 0,
                SortOrder = nextSortOrder,
                IsActive = true
            });
        }
    }

    private void RemoveCustomField(CanvasTransitionField field)
    {
        Connection?.CustomFields.Remove(field);
    }

    private CanvasTransitionField? _draggedField;

    private void HandleDragStart(CanvasTransitionField field)
    {
        _draggedField = field;
    }

    private void HandleDragEnter(CanvasTransitionField targetField)
    {
        // اگر در حال درگ نیستیم یا روی خودش هستیم، کاری نکن
        if (_draggedField == null || Connection == null || _draggedField == targetField) return;

        var orderedFields = Connection.CustomFields.OrderBy(f => f.SortOrder).ToList();

        int draggedIndex = orderedFields.IndexOf(_draggedField);
        int targetIndex = orderedFields.IndexOf(targetField);

        // جابجایی فیلد در لحظه
        orderedFields.RemoveAt(draggedIndex);
        orderedFields.Insert(targetIndex, _draggedField);

        // به‌روزرسانی SortOrder برای اعمال تغییرات در رابط کاربری
        for (int i = 0; i < orderedFields.Count; i++)
        {
            orderedFields[i].SortOrder = i;
        }
    }

    private void HandleDragEnd()
    {
        // پایان درگ و بازگشت ظاهر فیلد به حالت عادی
        _draggedField = null;
    }
}