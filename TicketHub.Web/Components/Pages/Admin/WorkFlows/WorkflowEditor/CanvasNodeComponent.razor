<!-- CanvasNodeComponent.razor -->

<div draggable="false" class="absolute w-[150px] rounded-xl shadow-lg border-2 flex flex-col items-center justify-center p-3 select-none z-10 transition-shadow @(IsSelected ? "border-slate-800 shadow-xl ring-4 ring-slate-800/20 scale-105" : "border-black/10 hover:shadow-xl") @(IsConnecting ? "pointer-events-none" : "pointer-events-auto")"
     style="@($"left: {Node.X}px; top: {Node.Y}px; background-color: {Node.Status.ColorCode}; cursor: {CursorStyle};")"
     @onpointerdown="e => OnPointerDown.InvokeAsync((e, Node))"
     @onclick="e => OnClick.InvokeAsync((e, Node))">

    <NodePort PortName="Top" ClassName="-top-3 left-1/2 -translate-x-1/2" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Bottom" ClassName="-bottom-3 left-1/2 -translate-x-1/2" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Right" ClassName="top-1/2 -translate-y-1/2 -right-3" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Left" ClassName="top-1/2 -translate-y-1/2 -left-3" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />

    @if (IsSelected)
    {
        <div class="absolute -top-3 -right-3 flex gap-1.5 z-40 pointer-events-auto">
            @if (ShowInitialButton)
            {
                <button @onpointerdown="() => OnSetInitialNode.InvokeAsync(Node)" @onpointerdown:stopPropagation="true" class="w-6 h-6 rounded-full @(Node.IsInitial ? "bg-amber-500 text-white" : "bg-white border-2 border-amber-500 text-amber-500") hover:bg-amber-400 hover:text-white flex items-center justify-center shadow-md transition-transform hover:scale-110" title="ثبت به عنوان وضعیت اولیه">
                    <svg class="w-3.5 h-3.5" fill="@(Node.IsInitial ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                </button>
            }

            <button @onpointerdown="() => OnDelete.InvokeAsync(Node)" @onpointerdown:stopPropagation="true" class="w-6 h-6 rounded-full bg-rose-500 hover:bg-rose-600 text-white flex items-center justify-center shadow-md transition-transform hover:scale-110">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    }

    <div class="w-full flex-1 flex flex-col items-center justify-center mt-2 min-h-[30px]">
        <span class="font-bold text-sm text-center block w-full truncate px-2" style="color: @TextColor" title="@Node.Status.Name">@Node.Status.Name</span>
    </div>
</div>

@code {
    [Parameter] public CanvasNodeDto Node { get; set; } = null!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsConnecting { get; set; }
    [Parameter] public CanvasNodeDto? ConnectingFromNode { get; set; }
    [Parameter] public string CursorStyle { get; set; } = "grab";
    [Parameter] public string TextColor { get; set; } = "#1e293b";

    [Parameter] public bool ShowInitialButton { get; set; }
    [Parameter] public EventCallback<CanvasNodeDto> OnSetInitialNode { get; set; }

    [Parameter] public EventCallback<(Microsoft.AspNetCore.Components.Web.PointerEventArgs e, CanvasNodeDto node)> OnPointerDown { get; set; }
    [Parameter] public EventCallback<(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, CanvasNodeDto node)> OnClick { get; set; }
    [Parameter] public EventCallback<CanvasNodeDto> OnDelete { get; set; }
    
    // رویدادهای مربوط به پورت‌ها که به والد پاس داده می‌شوند
    [Parameter] public EventCallback<(Microsoft.AspNetCore.Components.Web.PointerEventArgs e, CanvasNodeDto node, string port)> OnPortPointerDown { get; set; }
    [Parameter] public EventCallback<(Microsoft.AspNetCore.Components.Web.PointerEventArgs e, CanvasNodeDto node, string port)> OnPortPointerUp { get; set; }
}