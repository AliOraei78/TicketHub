@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows.WorkflowEditor
@using TicketHub.Application.DTOs

@{
    var statusColor = string.IsNullOrWhiteSpace(Node.Status?.ColorCode) ? "#38bdf8" : Node.Status.ColorCode;
    var nodeGlow = IsSelected 
        ? $"0 0 25px rgba(56,189,248,0.6), inset 0 0 15px rgba(56,189,248,0.2)" 
        : $"0 10px 25px rgba(0,0,0,0.6), 0 0 15px {statusColor}33, inset 0 0 12px {statusColor}15";
}

<div draggable="false" 
     class="absolute w-[164px] h-[66px] rounded-2xl cyber-node-chassis border-2 flex items-center justify-center p-3 select-none z-10 transition-all duration-200 @(IsSelected ? "border-sky-400 cyber-node-selected scale-102" : "hover:border-slate-400") @(IsConnecting ? "pointer-events-none" : "pointer-events-auto")"
     style="@($"left: {Node.X}px; top: {Node.Y}px; background-color: rgba(7, 12, 26, 0.94); backdrop-filter: blur(12px); border-color: {(IsSelected ? "#38bdf8" : statusColor)}; box-shadow: {nodeGlow}; cursor: {CursorStyle};")"
     @onpointerdown="e => OnPointerDown.InvokeAsync((e, Node))"
     @onclick="e => OnClick.InvokeAsync((e, Node))">

    <!-- Connection Ports -->
    <NodePort PortName="Top" ClassName="-top-2.5 left-1/2 -translate-x-1/2" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Bottom" ClassName="-bottom-2.5 left-1/2 -translate-x-1/2" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Right" ClassName="top-1/2 -translate-y-1/2 -right-2.5" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Left" ClassName="top-1/2 -translate-y-1/2 -left-2.5" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />

    <!-- Floating Holographic Badges (Initial ⭐ / Final 🏁) on Bottom Edge -->
    @if (Node.IsInitial)
    {
        <div class="absolute -bottom-2.5 left-3 z-30 pointer-events-none">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-950/95 border border-amber-500/80 text-amber-300 text-[10px] font-black shadow-[0_0_10px_rgba(245,158,11,0.6)] backdrop-blur-md" title="وضعیت اولیه">
                ⭐ شروع
            </span>
        </div>
    }
    @if (Node.IsFinal)
    {
        <div class="absolute -bottom-2.5 right-3 z-30 pointer-events-none">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-950/95 border border-emerald-500/80 text-emerald-300 text-[10px] font-black shadow-[0_0_10px_rgba(16,185,129,0.6)] backdrop-blur-md" title="وضعیت نهایی">
                🏁 پایان
            </span>
        </div>
    }

    @if (IsSelected)
    {
        <!-- Action Buttons (Initial ⭐ & Final 🏁) on Top-Right -->
        @if (ShowInitialButton)
        {
            <div class="absolute -top-4 -right-3 flex gap-1.5 z-40 pointer-events-auto">
                <button @onpointerdown="() => OnSetInitialNode.InvokeAsync(Node)" 
                        @onpointerdown:stopPropagation="true" 
                        class="w-7 h-7 rounded-xl @(Node.IsInitial ? "bg-amber-500 text-white shadow-[0_0_12px_rgba(245,158,11,0.8)]" : "bg-[#070c1a] border border-amber-500/60 text-amber-400 hover:bg-amber-950/80") flex items-center justify-center transition-all hover:scale-120 focus-ring" 
                        title="ثبت به عنوان وضعیت اولیه (شروع)">
                    <svg class="w-3.5 h-3.5" fill="@(Node.IsInitial ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                </button>

                <button @onpointerdown="() => OnToggleFinalNode.InvokeAsync(Node)" 
                        @onpointerdown:stopPropagation="true" 
                        class="w-7 h-7 rounded-xl @(Node.IsFinal ? "bg-emerald-500 text-white shadow-[0_0_12px_rgba(16,185,129,0.8)]" : "bg-[#070c1a] border border-emerald-500/60 text-emerald-400 hover:bg-emerald-950/80") flex items-center justify-center transition-all hover:scale-120 focus-ring" 
                        title="ثبت به عنوان وضعیت نهایی (خاتمه یافته)">
                    <svg class="w-3.5 h-3.5" fill="@(Node.IsFinal ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
                    </svg>
                </button>
            </div>
        }

        <!-- Delete Button on Top-Left -->
        <div class="absolute -top-4 -left-3 z-40 pointer-events-auto">
            <button @onpointerdown="() => OnDelete.InvokeAsync(Node)" 
                    @onpointerdown:stopPropagation="true" 
                    class="w-7 h-7 rounded-xl bg-[#070c1a] border border-rose-500/70 hover:bg-rose-950/90 text-rose-400 flex items-center justify-center shadow-[0_0_12px_rgba(244,63,94,0.5)] transition-all hover:scale-120 focus-ring" 
                    title="حذف وضعیت">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    }

    <!-- Center Status Content -->
    <div class="w-full flex items-center justify-center gap-2 pointer-events-none px-1">
        <div class="w-3 h-3 rounded-full shadow-[0_0_10px_currentColor] shrink-0" style="background-color: @statusColor; color: @statusColor;"></div>
        <span class="font-black text-sm text-center truncate text-slate-100 drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] tracking-tight max-w-[115px]" title="@(Node.Status?.Name)">
            @(Node.Status?.Name)
        </span>
    </div>
</div>