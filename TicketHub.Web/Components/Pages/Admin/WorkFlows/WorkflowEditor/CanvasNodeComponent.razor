@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows.WorkflowEditor
@using TicketHub.Application.DTOs

<div draggable="false" class="absolute w-[150px] rounded-2xl shadow-lg border-2 flex flex-col items-center justify-center p-3 select-none z-10 transition-all @(IsSelected ? "border-slate-800 shadow-xl ring-4 ring-slate-800/20 scale-105" : "border-black/10 hover:shadow-xl") @(IsConnecting ? "pointer-events-none" : "pointer-events-auto")"
     style="@($"left: {Node.X}px; top: {Node.Y}px; background-color: {Node.Status.ColorCode}; cursor: {CursorStyle};")"
     @onpointerdown="e => OnPointerDown.InvokeAsync((e, Node))"
     @onclick="e => OnClick.InvokeAsync((e, Node))">

    <NodePort PortName="Top" ClassName="-top-3 left-1/2 -translate-x-1/2" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Bottom" ClassName="-bottom-3 left-1/2 -translate-x-1/2" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Right" ClassName="top-1/2 -translate-y-1/2 -right-3" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />
    <NodePort PortName="Left" ClassName="top-1/2 -translate-y-1/2 -left-3" Node="Node" IsConnecting="IsConnecting" ConnectingFromNode="ConnectingFromNode" OnPortPointerDown="OnPortPointerDown" OnPortPointerUp="OnPortPointerUp" />

    @if (IsSelected)
    {
        <!-- Action Buttons (Initial ⭐ & Final 🏁) on Top-Right -->
        @if (ShowInitialButton)
        {
            <div class="absolute -top-3 -right-3 flex gap-1.5 z-40 pointer-events-auto">
                <button @onpointerdown="() => OnSetInitialNode.InvokeAsync(Node)" @onpointerdown:stopPropagation="true" class="w-6 h-6 rounded-full @(Node.IsInitial ? "bg-amber-500 text-white" : "bg-white border-2 border-amber-500 text-amber-500") hover:bg-amber-400 hover:text-white flex items-center justify-center shadow-md transition-transform hover:scale-110 focus-ring" title="ثبت به عنوان وضعیت اولیه (شروع)">
                    <svg class="w-3.5 h-3.5" fill="@(Node.IsInitial ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                </button>

                <button @onpointerdown="() => OnToggleFinalNode.InvokeAsync(Node)" @onpointerdown:stopPropagation="true" class="w-6 h-6 rounded-full @(Node.IsFinal ? "bg-emerald-600 text-white" : "bg-white border-2 border-emerald-500 text-emerald-600") hover:bg-emerald-500 hover:text-white flex items-center justify-center shadow-md transition-transform hover:scale-110 focus-ring" title="ثبت به عنوان وضعیت نهایی (خاتمه یافته)">
                    <svg class="w-3.5 h-3.5" fill="@(Node.IsFinal ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
                    </svg>
                </button>
            </div>
        }

        <!-- Delete Button on Top-Left -->
        <div class="absolute -top-3 -left-3 z-40 pointer-events-auto">
            <button @onpointerdown="() => OnDelete.InvokeAsync(Node)" @onpointerdown:stopPropagation="true" class="w-6 h-6 rounded-full bg-rose-500 hover:bg-rose-600 text-white flex items-center justify-center shadow-md transition-transform hover:scale-110 focus-ring" title="حذف وضعیت">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    }

    <!-- Persistent Status Node Badges -->
    <div class="absolute top-1 left-1.5 flex items-center gap-1 pointer-events-none">
        @if (Node.IsInitial)
        {
            <span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded-md bg-amber-500 text-white text-[9px] font-black shadow-xs" title="وضعیت اولیه">
                <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                شروع
            </span>
        }
        @if (Node.IsFinal)
        {
            <span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded-md bg-emerald-600 text-white text-[9px] font-black shadow-xs" title="وضعیت نهایی">
                <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3 6a3 3 0 013-3h10a1 1 0 01.8 1.6L14.25 8l2.55 3.4A1 1 0 0116 13H6a1 1 0 00-1 1v3a1 1 0 11-2 0V6z" clip-rule="evenodd"/>
                </svg>
                پایان
            </span>
        }
    </div>

    <div class="w-full flex-1 flex flex-col items-center justify-center mt-2.5 min-h-[30px]">
        <span class="font-bold text-xs text-center block w-full truncate px-2" style="color: @TextColor" title="@Node.Status.Name">@Node.Status.Name</span>
    </div>
</div>