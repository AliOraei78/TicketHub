@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows.WorkflowEditor

<div class="h-[90px] bg-white border-b border-slate-200/80 px-6 py-3 z-20 shadow-2xs flex-shrink-0 flex items-center select-none">
    <div class="flex justify-between items-center max-w-5xl mx-auto w-full gap-4">
        <div class="flex flex-col gap-1 flex-1">
            <input type="text" value="@Name" @oninput="OnNameInput" placeholder="نام جریان کاری..." class="text-xl font-bold text-slate-800 outline-none bg-transparent border-b-2 border-transparent focus:border-indigo-500 transition-colors w-full pb-0.5 placeholder:text-slate-300 tracking-tight" />
            <input type="text" value="@Description" @oninput="OnDescriptionInput" placeholder="توضیحات جریان کاری (اختیاری)..." class="text-xs text-slate-500 outline-none bg-transparent border-b-2 border-transparent focus:border-indigo-500 transition-colors w-full pb-0.5 placeholder:text-slate-300 font-normal" />
        </div>
        <div class="flex gap-3 items-center">
            <label class="relative inline-flex items-center cursor-pointer bg-slate-50 border border-slate-200 px-3.5 py-2 rounded-2xl">
                <span class="text-xs font-bold text-slate-700 ml-3 whitespace-nowrap">جریان‌کار فعال:</span>
                <div class="relative flex items-center w-11 h-6">
                    <input type="checkbox" checked="@IsActive" @onchange="OnIsActiveChanged" class="sr-only peer">
                    <div class="absolute inset-0 bg-slate-300 rounded-full peer-checked:bg-indigo-600 transition-colors duration-300"></div>
                    <div class="absolute right-[2px] w-5 h-5 bg-white border border-slate-300 rounded-full transition-transform duration-300 peer-checked:-translate-x-[20px] peer-checked:border-white z-10 shadow-2xs"></div>
                </div>
            </label>

            <a href="/workflows" class="px-5 py-2.5 rounded-2xl text-slate-700 bg-slate-100 hover:bg-slate-200 text-xs font-bold transition-colors focus-ring">انصراف و بازگشت</a>
            <button type="button" @onclick="() => OnSave.InvokeAsync()" class="px-5 py-2.5 rounded-2xl text-white bg-indigo-600 bg-blue-600 hover:bg-indigo-700 text-xs font-bold transition-all shadow-lg shadow-indigo-500/20 focus-ring">ذخیره جریان کار</button>
        </div>
    </div>
</div>