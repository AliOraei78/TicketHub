@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows.WorkflowEditor

<div class="h-[84px] cyber-toolbar-glass px-6 py-2.5 z-20 flex-shrink-0 flex items-center select-none" dir="rtl">
    <div class="flex justify-between items-center w-full gap-4">
        <!-- Title & Description with Cyber styling -->
        <div class="flex flex-col gap-1.5 flex-1 max-w-xl">
            <div class="field-spark-wrap flex-1">
                <input type="text" 
                       value="@Name" 
                       @oninput="OnNameInput" 
                       placeholder="نام جریان کاری..." 
                       class="w-full text-base font-black text-slate-100 placeholder:text-slate-500 outline-none bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 rounded-xl px-3 py-1 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] transition-all tracking-tight focus-ring" />
            </div>
            <div class="field-spark-wrap w-full">
                <input type="text" 
                       value="@Description" 
                       @oninput="OnDescriptionInput" 
                       placeholder="توضیحات جریان کاری (اختیاری)..." 
                       class="w-full text-xs text-slate-200 placeholder:text-slate-500 outline-none bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] border border-white/[0.12] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 rounded-xl px-3 py-1 focus:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all focus-ring" />
            </div>
        </div>

        <!-- Telemetry Chips -->
        <div class="hidden lg:flex items-center gap-2.5">
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 shadow-inner">
                <span class="w-2 h-2 rounded-full bg-sky-400 shadow-[0_0_6px_rgba(56,189,248,0.8)]"></span>
                <span class="text-[11px] text-slate-400 font-medium">وضعیت‌ها:</span>
                <span class="text-xs font-mono font-black text-sky-300">@NodeCount</span>
            </div>
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 shadow-inner">
                <span class="w-2 h-2 rounded-full bg-indigo-400 shadow-[0_0_6px_rgba(99,102,241,0.8)]"></span>
                <span class="text-[11px] text-slate-400 font-medium">مسیرهای انتقال:</span>
                <span class="text-xs font-mono font-black text-indigo-300">@ConnectionCount</span>
            </div>
        </div>

        <!-- Actions & Active Switch -->
        <div class="flex gap-3 items-center">
            <label class="relative inline-flex items-center cursor-pointer bg-slate-900/80 border border-slate-800 px-3.5 py-1.5 rounded-xl hover:border-slate-700 transition-colors">
                <span class="text-xs font-bold text-slate-300 ml-3 whitespace-nowrap">جریان‌کار فعال:</span>
                <div class="relative flex items-center w-10 h-5">
                    <input type="checkbox" checked="@IsActive" @onchange="OnIsActiveChanged" class="sr-only peer">
                    <div class="absolute inset-0 bg-slate-800 rounded-full peer-checked:bg-emerald-500/80 border border-slate-700 peer-checked:border-emerald-400 transition-colors duration-300 shadow-inner"></div>
                    <div class="absolute right-[2px] w-4 h-4 bg-slate-400 rounded-full transition-transform duration-300 peer-checked:-translate-x-[18px] peer-checked:bg-white peer-checked:shadow-[0_0_8px_rgba(16,185,129,0.9)] z-10"></div>
                </div>
            </label>

            <a href="/workflows" class="btn-cyber-ghost px-4 py-2 text-xs font-bold transition-all focus-ring">
                <span>انصراف و بازگشت</span>
            </a>

            <button type="button" @onclick="() => OnSave.InvokeAsync()" class="btn-cyber-primary bg-blue-600 px-5 py-2 text-xs font-black transition-all flex items-center gap-1.5 focus-ring">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
                <span>ذخیره جریان کار</span>
            </button>
        </div>
    </div>
</div>