@page "/workflows/editor/{Id:int?}"
@layout TicketHub.Web.Components.Layout.EmptyLayout
@rendermode InteractiveServer
@using TicketHub.Web.Components.Shared
@using TicketHub.Application.DTOs

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="fixed top-6 left-1/2 transform -translate-x-1/2 z-50 min-w-[350px]">
        <AlertMessage Message="@errorMessage"
                      Type="AlertMessage.AlertType.Error"
                      IsDark="false"
                      OnClose="() => errorMessage = string.Empty" />
    </div>
}

<div class="flex h-full w-full">

    <DraggableSidebar TItem="StatusDto"
                      Title="وضعیت‌های سیستم"
                      Items="FilteredStatuses"
                      OnDragStart="OnStatusDragStart"
                      OnItemAdd="AddStatusToCanvas">
        <HeaderContent>
            <input type="text"
                   @bind="statusSearchTerm"
                   @bind:event="oninput"
                   placeholder="جستجو..."
                   class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5 focus:outline-none focus:border-blue-500 transition-colors" />
        </HeaderContent>
        <ItemTemplate Context="status">
            <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full shadow-sm" style="background-color: @status.ColorCode"></div>
                <span class="text-sm font-medium text-slate-700 truncate">@status.Name</span>
            </div>
        </ItemTemplate>
    </DraggableSidebar>

    <div class="flex-1 flex flex-col relative overflow-hidden">

        <WorkflowToolbar @bind-Name="workflowName"
                         @bind-Description="workflowDescription"
                         OnSave="SaveWorkflowAsync" />

        <WorkflowCanvas Nodes="canvasNodes"
                        Connections="connections"
                        SelectedNodes="selectedNodes"
                        SelectedConnections="selectedConnections"
                        IsBoxSelecting="isBoxSelecting"
                        BoxStartX="boxStartX"
                        BoxStartY="boxStartY"
                        BoxEndX="boxEndX"
                        BoxEndY="boxEndY"
                        IsConnecting="isConnecting"
                        ConnectingFromNode="connectingFromNode"
                        ActiveSourcePort="@activeSourcePort"
                        MouseX="mouseX"
                        MouseY="mouseY"
                        IsDragging="isDragging"
                        DraggedNode="draggedNode"
                        OnKeyDown="HandleKeyDown"
                        OnPointerDown="CanvasPointerDown"
                        OnPointerMove="CanvasMouseMove"
                        OnPointerUp="CanvasMouseUp"
                        OnDrop="CanvasOnDrop"
                        OnNodeMouseDown="args => NodeMouseDown(args.e, args.node)"
                        OnSelectNode="args => SelectNode(args.e, args.node)"
                        OnSelectConnection="args => SelectConnection(args.e, args.conn)"
                        OnPortPointerDown="args => OnPortPointerDown(args.e, args.node, args.port)"
                        OnPortPointerUp="args => OnPortPointerUp(args.e, args.node, args.port)"
                        OnDeleteItem="DeleteSelectedItems"
                        GetTextColor="GetTextColor"
                        GetBezierPath="GetBezierPath"
                        GetBezierCenter="GetBezierCenter"
                        GetPortCoordinates="GetPortCoordinates" />

        <TransitionSidebar Connection="selectedConnections.FirstOrDefault()"
                           AvailableRoles="AvailableRoles"
                           AvailableFieldTypes="availableFieldTypes"
                           GetNodeName="GetNodeName"
                           OnClose="() => selectedConnections.Clear()"
                           OnRoleToggle="ToggleRole"
                           OnDelete="DeleteConnection" />
    </div>
</div>