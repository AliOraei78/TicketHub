@page "/workflows/editor/{Id:int?}"
@layout TicketHub.Web.Components.Layout.EmptyLayout
@rendermode InteractiveServer
@using TicketHub.Core.Entities
@using TicketHub.Core.Common
@using TicketHub.Web.Components.Shared
@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="fixed top-6 left-1/2 transform -translate-x-1/2 z-50 bg-white border-b-4 border-rose-500 px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-4 min-w-[350px] animate-fade-in-down transition-all">
        <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <div class="flex-1">
            <h3 class="text-sm font-bold text-slate-800">خطا در عملیات</h3>
            <p class="text-xs text-slate-500 mt-0.5">@errorMessage</p>
        </div>
        <button @onclick="() => errorMessage = string.Empty" class="w-8 h-8 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
    </div>
}

<div class="flex h-full w-full">

    <StatusSidebar Statuses="availableStatuses"
                   OnDragStart="OnStatusDragStart"
                   OnStatusAdd="AddStatusToCanvas" />

    <div class="flex-1 flex flex-col relative overflow-hidden">

        <WorkflowToolbar @bind-Name="workflowName"
                         @bind-Description="workflowDescription"
                         OnSave="SaveWorkflowAsync" />

        <div class="flex-1 relative bg-slate-50 overflow-hidden canvas-pattern outline-none"
             tabindex="0"
             @onkeydown="HandleKeyDown"
             @onpointerdown="CanvasPointerDown"
             @onpointermove="CanvasMouseMove"
             @onpointerup="CanvasMouseUp"
             @onpointerleave="CanvasMouseUp"
             @ondragenter="() => { }"
             @ondragenter:preventDefault="true"
             @ondragover="() => { }"
             @ondragover:preventDefault="true"
             @ondrop="CanvasOnDrop">

            @if (isBoxSelecting)
            {
                <div class="absolute border border-blue-500 bg-blue-500/20 z-50 pointer-events-none"
                     style="left: @(Math.Min(boxStartX, boxEndX))px; top: @(Math.Min(boxStartY, boxEndY))px; width: @(Math.Abs(boxEndX - boxStartX))px; height: @(Math.Abs(boxEndY - boxStartY))px;">
                </div>
            }

            <svg class="absolute inset-0 w-full h-full pointer-events-none z-0">
                <defs>
                    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="#94a3b8" /></marker>
                    <marker id="arrowhead-active" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="#3b82f6" /></marker>
                </defs>

                @foreach (var conn in connections)
                {
                    var fromNode = canvasNodes.FirstOrDefault(n => n.Id == conn.FromNodeId);
                    var toNode = canvasNodes.FirstOrDefault(n => n.Id == conn.ToNodeId);
                    if (fromNode != null && toNode != null)
                    {
                        bool isSelected = selectedConnections.Contains(conn);
                        string strokeColor = isSelected ? "#3b82f6" : "#cbd5e1";
                        string marker = isSelected ? "url(#arrowhead-active)" : "url(#arrowhead)";

                        var sameNodeConnections = connections.Where(c => (c.FromNodeId == fromNode.Id && c.ToNodeId == toNode.Id) || (c.FromNodeId == toNode.Id && c.ToNodeId == fromNode.Id)).ToList();
                        int index = sameNodeConnections.IndexOf(conn);

                        var p1 = GetPortCoordinates(fromNode, conn.SourcePort);
                        var p2 = GetPortCoordinates(toNode, conn.TargetPort);

                        <g @key="conn.Id" @onclick:stopPropagation="true">
                            <path d="@GetBezierPath(p1.X, p1.Y, p2.X, p2.Y, index)"
                                  stroke="transparent" stroke-width="15" fill="none" class="pointer-events-auto cursor-pointer"
                                  @onpointerdown="e => SelectConnection(e, conn)"
                                  @onpointerdown:stopPropagation="true" />

                            <path d="@GetBezierPath(p1.X, p1.Y, p2.X, p2.Y, index)"
                                  stroke="@strokeColor" stroke-width="2.5" fill="none" marker-end="@marker"
                                  class="transition-colors duration-200" stroke-dasharray="@(conn.IsAutomatic ? "5,5" : "none")" />
                        </g>
                    }
                }

                @if (isConnecting && connectingFromNode != null)
                {
                    var p1 = GetPortCoordinates(connectingFromNode, activeSourcePort);
                    <path d="@GetBezierPath(p1.X, p1.Y, mouseX, mouseY)" stroke="#3b82f6" stroke-width="2.5" fill="none" stroke-dasharray="4,4" class="opacity-60" />
                }
            </svg>

            @foreach (var conn in connections)
            {
                var fromNode = canvasNodes.FirstOrDefault(n => n.Id == conn.FromNodeId);
                var toNode = canvasNodes.FirstOrDefault(n => n.Id == conn.ToNodeId);
                if (fromNode != null && toNode != null)
                {
                    @if (selectedConnections.Contains(conn))
                    {
                        var sameNodeConnections = connections.Where(c => (c.FromNodeId == fromNode.Id && c.ToNodeId == toNode.Id) || (c.FromNodeId == toNode.Id && c.ToNodeId == fromNode.Id)).ToList();
                        int index = sameNodeConnections.IndexOf(conn);

                        var p1 = GetPortCoordinates(fromNode, conn.SourcePort);
                        var p2 = GetPortCoordinates(toNode, conn.TargetPort);

                        var center = GetBezierCenter(p1.X, p1.Y, p2.X, p2.Y, index);

                        <button @key="@($"del-conn-{conn.Id}")" @onpointerdown="() => DeleteSelectedItems(conn)" @onpointerdown:stopPropagation="true" class="absolute w-6 h-6 rounded-full bg-rose-500 hover:bg-rose-600 text-white flex items-center justify-center shadow-md transition-transform hover:scale-110 z-40 pointer-events-auto" style="@($"left: {center.X - 12}px; top: {center.Y - 12}px;")" title="حذف مسیر">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                        </button>
                    }
                }
            }

            @foreach (var node in canvasNodes)
            {
                <CanvasNodeComponent @key="node.Id"
                                     Node="node"
                                     IsSelected="selectedNodes.Contains(node)"
                                     IsConnecting="isConnecting"
                                     ConnectingFromNode="connectingFromNode"
                                     CursorStyle="@(isDragging && draggedNode == node ? "grabbing" : "grab")"
                                     TextColor="@GetTextColor(node.Status.ColorCode)"
                                     OnPointerDown="args => NodeMouseDown(args.e, args.node)"
                                     OnClick="args => SelectNode(args.e, args.node)"
                                     OnDelete="n => DeleteSelectedItems(n)"
                                     OnPortPointerDown="args => OnPortPointerDown(args.e, args.node, args.port)"
                                     OnPortPointerUp="args => OnPortPointerUp(args.e, args.node, args.port)" />
            }
        </div>

        <TransitionSidebar Connection="selectedConnections.FirstOrDefault()"
                           AvailableRoles="AvailableRoles"
                           GetNodeName="GetNodeName"
                           OnClose="() => selectedConnections.Clear()"
                           OnRoleToggle="ToggleRole"
                           OnDelete="DeleteConnection" />
    </div>
</div>