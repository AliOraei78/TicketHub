@page "/workflows/editor/{Id:int?}"
@layout TicketHub.Web.Components.Layout.EmptyLayout
@rendermode InteractiveServer
@using TicketHub.Core.Entities
@using TicketHub.Core.Common
@using TicketHub.Web.Components.Shared
@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows

<div class="flex h-full w-full">

    <StatusSidebar Statuses="availableStatuses" 
                   OnDragStart="OnStatusDragStart" 
                   OnStatusAdd="AddStatusToCanvas" />

    <div class="flex-1 flex flex-col relative overflow-hidden">

        <WorkflowToolbar @bind-Name="workflowName" 
                         @bind-Description="workflowDescription" 
                         OnSave="SaveWorkflowAsync" />

        <div class="flex-1 relative bg-slate-50 overflow-hidden canvas-pattern outline-none"
             tabindex="0"
             @onkeydown="HandleKeyDown"
             @onpointerdown="CanvasPointerDown"
             @onpointermove="CanvasMouseMove"
             @onpointerup="CanvasMouseUp"
             @onpointerleave="CanvasMouseUp"
             @ondragenter="() => { }"
             @ondragenter:preventDefault="true"
             @ondragover="() => { }"
             @ondragover:preventDefault="true"
             @ondrop="CanvasOnDrop">

            @if (isBoxSelecting)
            {
                <div class="absolute border border-blue-500 bg-blue-500/20 z-50 pointer-events-none"
                     style="left: @(Math.Min(boxStartX, boxEndX))px; top: @(Math.Min(boxStartY, boxEndY))px; width: @(Math.Abs(boxEndX - boxStartX))px; height: @(Math.Abs(boxEndY - boxStartY))px;">
                </div>
            }

            <svg class="absolute inset-0 w-full h-full pointer-events-none z-0">
                <defs>
                    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="#94a3b8" /></marker>
                    <marker id="arrowhead-active" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="#3b82f6" /></marker>
                </defs>

                @foreach (var conn in connections)
                {
                    // منطق رسم خطوط SVG (کمی پیچیده است، فعلاً اینجا می‌ماند تا زمانی که یک SVG Generator کامپوننت بسازید)
                    // ... (همان کدهای قبلی <g> و <path> برای رسم خط)
                }
                @if (isConnecting && connectingFromNode != null)
                {
                    var p1 = GetPortCoordinates(connectingFromNode, activeSourcePort);
                    <path d="@GetBezierPath(p1.X, p1.Y, mouseX, mouseY)" stroke="#3b82f6" stroke-width="2.5" fill="none" stroke-dasharray="4,4" class="opacity-60" />
                }
            </svg>

            @foreach (var conn in connections)
            {
                // دکمه حذف مسیرها (کدهای قبلی)
            }

            @foreach (var node in canvasNodes)
            {
                <CanvasNodeComponent @key="node.Id"
                                     Node="node"
                                     IsSelected="selectedNodes.Contains(node)"
                                     IsConnecting="isConnecting"
                                     ConnectingFromNode="connectingFromNode"
                                     CursorStyle="@(isDragging && draggedNode == node ? "grabbing" : "grab")"
                                     TextColor="@GetTextColor(node.Status.ColorCode)"
                                     OnPointerDown="args => NodeMouseDown(args.e, args.node)"
                                     OnClick="args => SelectNode(args.e, args.node)"
                                     OnDelete="DeleteSelectedItems"
                                     OnPortPointerDown="args => OnPortPointerDown(args.e, args.node, args.port)"
                                     OnPortPointerUp="args => OnPortPointerUp(args.e, args.node, args.port)" />
            }
        </div>

        <TransitionSidebar Connection="selectedConnections.FirstOrDefault()"
                           AvailableRoles="AvailableRoles"
                           GetNodeName="GetNodeName"
                           OnClose="() => selectedConnections.Clear()"
                           OnRoleToggle="ToggleRole"
                           OnDelete="DeleteConnection" />
    </div>
</div>