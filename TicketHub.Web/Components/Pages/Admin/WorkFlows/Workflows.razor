@page "/workflows"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using TicketHub.Application.DTOs
@using TicketHub.Application.Enums
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Web.Components.Shared

<PageTitle>مدیریت جریان‌های کاری | سامانه تیکتینگ</PageTitle>

<div class="w-full flex flex-col gap-3 flex-1 select-none" dir="rtl">
    <!-- Centered Cyber Operations Master Banner -->
    <div class="relative overflow-hidden rounded-xl bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 p-3 sm:p-3.5 shadow-[0_0_25px_rgba(8,13,26,0.85)] flex flex-col gap-2.5">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-cyan-500/20 via-indigo-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Section: Centered Title, Centered Subtitle & Centered Create CTA -->
        <div class="relative z-10 flex flex-col items-center justify-center text-center gap-2.5">
            <div class="space-y-1.5 flex flex-col items-center">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white drop-shadow-[0_2px_15px_rgba(255,255,255,0.35)] leading-tight flex items-center justify-center gap-2.5 flex-wrap text-center">
                    <span class="bg-gradient-to-r from-cyan-300 via-indigo-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_18px_rgba(56,189,248,0.7)]">مدیریت جریان‌های کاری</span>
                </h1>
                <p class="text-slate-200 text-sm sm:text-base font-semibold tracking-wide flex items-center justify-center gap-2 flex-wrap text-center">
                    <span>⚡ طراحی هوشمند جریان کاری</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>پایش مسیرها</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>مدیریت انتقال وضعیت‌ها</span>
                </p>
            </div>

            <SecuredView ResourceKey="/workflows" MinimumType="PermissionType.SystemSection">
                <div class="flex items-center justify-center">
                    <button @onclick="OpenCreateWorkflow"
                            class="btn-cyber-primary bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white text-sm sm:text-base py-2 px-6 focus-ring flex items-center gap-2.5 shadow-[0_0_18px_rgba(56,189,248,0.35)] cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 animate-pulse text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>ایجاد جریان کاری جدید</span>
                    </button>
                </div>
            </SecuredView>
        </div>

        <!-- Bottom Row: 5 Holographic Telemetry Cards -->
        <div class="relative z-10 pt-2 border-t border-white/[0.08] grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
            <!-- 1. Total Workflows (Cyan / Water) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(56, 189, 248, 0.5); --seg-glow: rgba(56, 189, 248, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-cyan-300/90 font-bold truncate">کل جریان‌ها</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-cyan-400/60 uppercase">⚡ همه</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(56,189,248,0.7)] px-1">
                    @TotalWorkflowsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 2. Total Statuses / Nodes (Purple / Void) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(168, 85, 247, 0.5); --seg-glow: rgba(168, 85, 247, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-purple-500/15 border border-purple-400/30 flex items-center justify-center text-purple-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-purple-300/90 font-bold truncate">کل گام‌ها</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-purple-400/60 uppercase">🟣 وضعیت‌ها</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(168,85,247,0.7)] px-1">
                    @TotalStatusesCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 3. Total Transitions (Amber / Lightning) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(245, 158, 11, 0.5); --seg-glow: rgba(245, 158, 11, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-amber-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-amber-300/90 font-bold truncate">کل انتقال‌ها</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-amber-400/60 uppercase">⚡ مسیرها</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(245,158,11,0.7)] px-1">
                    @TotalTransitionsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 4. Assigned Projects (Emerald / Nature) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(16, 185, 129, 0.5); --seg-glow: rgba(16, 185, 129, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-emerald-300/90 font-bold truncate">پروژه‌های متصل</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-400/60 uppercase">🟢 پروژه‌ها</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(16,185,129,0.7)] px-1">
                    @AssignedProjectsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 5. Active Workflows (Sky / Flow) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(14, 165, 233, 0.5); --seg-glow: rgba(14, 165, 233, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-sky-500/15 border border-sky-400/30 flex items-center justify-center text-sky-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-sky-300/90 font-bold truncate">جریان‌های فعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-sky-400/60 uppercase">✨ پایدار</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(14,165,233,0.7)] px-1">
                    @ActiveWorkflowsCount.ToPersianNumbers()
                </span>
            </div>
        </div>
    </div>

    <!-- Cyberpunk Filter & Search Command Bar -->
    <div class="relative z-30 bg-[#070c1a]/90 backdrop-blur-xl p-2.5 px-4 rounded-2xl shadow-lg border border-cyan-500/25 flex flex-wrap lg:flex-nowrap gap-3 items-center justify-between select-none">
        <!-- Controls Group: Search & Dropdowns -->
        <div class="flex flex-wrap lg:flex-nowrap items-center gap-3 w-full lg:w-auto flex-1">
            <!-- Search Box -->
            <div class="w-full sm:w-64">
                <SearchBox SearchTerm="@WfState.Value.SearchTerm"
                           OnSearchChanged="OnSearchTermChanged"
                           Placeholder="جستجوی جریان کاری..." />
            </div>

            <!-- Project Filter Dropdown -->
            <div class="w-full sm:w-52">
                <MultiSelectDropdown TItem="ProjectDto" TValue="int"
                                     Placeholder="پروژه..."
                                     Items="WfState.Value.AvailableProjects.ToList()"
                                     SelectedValues="WfState.Value.SelectedFilterProjectIds"
                                     SelectedValuesChanged="FilterProjectsChanged"
                                     ValueSelector="p => p.Id"
                                     DisplaySelector="p => p.Name"
                                     ShowSelectedTags="false" />
            </div>
        </div>

        <!-- PageSize Selector -->
        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-400">تعداد در صفحه:</span>
            <div class="w-20">
                <SlideSelect TItem="int" TValue="int"
                             Items="WfState.Value.MyCustomOptions"
                             Value="WfState.Value.PageSize"
                             ValueChanged="OnPageSizeChanged"
                             ValueSelector="x => x"
                             TextSelector="x => x.ToString()"
                             AllowClear="false" />
            </div>
        </div>
    </div>

    <!-- Bulk Action Toolbar -->
    @if (selectedWorkflowIds.Any())
    {
        <div class="w-full flex justify-end animate-[fadeIn_0.2s_ease-out]">
            <BulkActionToolbar SelectedCount="selectedWorkflowIds.Count"
                               OnCancel="ClearSelection"
                               OnDelete="OpenBulkDeleteModal"
                               ResourceKey="/workflows" />
        </div>
    }

    <!-- Cards Grid -->
    <WorkflowCardGrid Workflows="WfState.Value.Workflows.ToList()"
                      IsLoading="WfState.Value.IsLoading"
                      @bind-SelectedIds="selectedWorkflowIds"
                      DeletingIds="deletingWorkflowIds"
                      OnEdit="OpenEditWorkflow"
                      OnDelete="DeleteWorkflow" />

    <!-- Pagination -->
    <div class="mt-2">
        <Pagination CurrentPage="WfState.Value.CurrentPage"
                    PageSize="WfState.Value.PageSize"
                    ItemName="جریان کار"
                    TotalItems="WfState.Value.TotalWorkflows"
                    OnNext="NextPage"
                    OnPrevious="PreviousPage" />
    </div>
</div>

<!-- Confirm Delete Modal -->
<ConfirmDeleteModal IsOpen="isDeleteModalOpen"
                    Description="@deleteModalDescription"
                    OnConfirm="ConfirmDeleteAsync"
                    OnCancel="CancelDelete" />