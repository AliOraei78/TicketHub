@page "/workflows"
@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows
@rendermode InteractiveServer

@using TicketHub.Core.Entities
@using TicketHub.Web.Components.Shared
@using TicketHub.Web.Components.Pages.Admin.WorkFlows
@using TicketHub.Application.Interfaces

<PageTitle>مدیریت جریان‌های کاری | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-8 flex flex-col gap-6 min-h-screen" dir="rtl">
    <PageHeader Title="جریان‌های کاری"
                Description="طراحی و مدیریت مسیرهای جریان کار به شکل نوین."
                ButtonText="ایجاد جریان کاری جدید"
                ButtonThemeClass="bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white shadow-lg shadow-indigo-500/30 border-0"
                OnActionClick="OpenCreateWorkflow">
        <Icon>
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
                </svg>
            </div>
        </Icon>
    </PageHeader>

        <!-- در فایل Workflows.razor قسمت مربوط به ListFilterToolbar را با این کد جایگزین کنید -->
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between mb-2">
        <div class="w-full md:w-[400px]">
            <SearchBox SearchTerm="@searchTerm"
                         OnSearchChanged="OnSearchTermChanged"
                         Placeholder="جستجوی جریان کاری..." />
        </div>

        <div class="w-full md:w-auto min-h-[40px] flex items-center transition-all duration-300">
            @if (selectedWorkflowIds.Any())
            {
                <BulkActionToolbar SelectedCount="selectedWorkflowIds.Count"
                                   OnCancel="ClearSelection"
                                   OnDelete="OpenBulkDeleteModal" />
            }
        </div>
    </div>

    <div class="overflow-x-auto pb-4">
        <div class="min-w-[1000px]">
            <WorkflowCardGrid Workflows="workflows"
                              IsLoading="isLoading"
                              @bind-SelectedIds="selectedWorkflowIds"
                              DeletingIds="deletingWorkflowIds"
                              OnEdit="OpenEditWorkflow"
                              OnDelete="DeleteWorkflow" />
        </div>
    </div>

    <div class="bg-white rounded-3xl p-4 border border-gray-100 shadow-sm mt-2">
        <Pagination CurrentPage="currentPage"
                    PageSize="pageSize"
                    ItemName="جریان کار"
                    TotalItems="totalWorkflows"
                    OnNext="NextPage"
                    OnPrevious="PreviousPage" />
    </div>
</div>