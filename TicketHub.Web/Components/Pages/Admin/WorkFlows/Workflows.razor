@page "/workflows"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@rendermode InteractiveServer

<PageTitle>مدیریت جریان‌های کاری | سامانه تیکتینگ</PageTitle>

<EntityManagerTemplate TItem="WorkflowDto">
    <HeaderTemplate>
        <PageHeader Title="جریان‌های کاری"
                    Description="طراحی و مدیریت مسیرهای جریان کار به شکل نوین."
                    ButtonText="ایجاد جریان کاری جدید"
                    ButtonThemeClass="bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white shadow-lg shadow-indigo-500/30 border-0"
                    OnActionClick="OpenCreateWorkflow"
                    ResourceKey="/workflows">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                </svg>
            </Icon>
        </PageHeader>
    </HeaderTemplate>

    <ToolbarTemplate>
        <ListFilterToolbar SearchTerm="@WfState.Value.SearchTerm"
                           SearchTermChanged="OnSearchTermChanged"
                           PageSize="@WfState.Value.PageSize"
                           PageSizeChanged="OnPageSizeChanged"
                           SearchPlaceholder="جستجوی جریان کاری..."
                           ItemName="جریان کار"
                           PageSizeOptions="WfState.Value.MyCustomOptions">

            <MultiSelectDropdown TItem="ProjectDto" TValue="int"
                                 Placeholder="پروژه..."
                                 Items="WfState.Value.AvailableProjects.ToList()"
                                 SelectedValues="WfState.Value.SelectedFilterProjectIds"
                                 SelectedValuesChanged="FilterProjectsChanged"
                                 ValueSelector="p => p.Id"
                                 DisplaySelector="p => p.Name" />
        </ListFilterToolbar>

        @if (selectedWorkflowIds.Any())
        {
            <div class="w-full flex justify-end animate-[fadeIn_0.2s_ease-out]">
                <BulkActionToolbar SelectedCount="selectedWorkflowIds.Count"
                                   OnCancel="ClearSelection"
                                   OnDelete="OpenBulkDeleteModal"
                                   ResourceKey="/workflows" />
            </div>
        }
    </ToolbarTemplate>

    <ListTemplate>
        <WorkflowCardGrid Workflows="WfState.Value.Workflows.ToList()"
                          IsLoading="WfState.Value.IsLoading"
                          @bind-SelectedIds="selectedWorkflowIds"
                          DeletingIds="deletingWorkflowIds"
                          OnEdit="OpenEditWorkflow"
                          OnDelete="DeleteWorkflow" />
    </ListTemplate>

    <PaginationTemplate>
        <Pagination CurrentPage="WfState.Value.CurrentPage"
                    PageSize="WfState.Value.PageSize"
                    ItemName="جریان کار"
                    TotalItems="WfState.Value.TotalWorkflows"
                    OnNext="NextPage"
                    OnPrevious="PreviousPage" />
    </PaginationTemplate>

    <ModalTemplate>
        <ConfirmDeleteModal IsOpen="isDeleteModalOpen"
                            Description="@deleteModalDescription"
                            OnConfirm="ConfirmDeleteAsync"
                            OnCancel="CancelDelete" />
    </ModalTemplate>
</EntityManagerTemplate>