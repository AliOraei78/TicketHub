// مسیر پیشنهادی: TicketHub.Web/Components/Pages/Admin/Settings/Workflows.razor
@page "/workflows"
@namespace TicketHub.Web.Components.Pages.Admin.Settings
@rendermode InteractiveServer
@using TicketHub.Core.Entities
@using TicketHub.Web.Components.Shared
@using TicketHub.Web.Components.Pages.Admin.WorkFlows

<PageTitle>مدیریت جریان‌های کاری | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-6 flex flex-col gap-5 bg-gray-50/50 min-h-screen rounded-3xl" dir="rtl">
    
    <PageHeader Title="جریان‌های کاری (Workflows)" 
                Description="مدیریت مسیرهای گردش کار، وضعیت‌ها و انتقال‌ها." 
                ButtonText="ایجاد جریان کاری جدید" 
                ButtonThemeClass="bg-blue-600 hover:bg-blue-700 shadow-blue-500/20" 
                OnActionClick="OpenCreateWorkflow"> <!-- فعلا فقط متد خالی فراخوانی می‌شود -->
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
        </Icon>
    </PageHeader>

    @* چیدمان متفاوت: قرار دادن ابزارها و جدول در یک پنل یکپارچه *@
    <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100 flex flex-col gap-4">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 border-b border-gray-100 pb-4">
            <div class="w-full md:w-1/2">
                <ListFilterToolbar @bind-SearchTerm="searchTerm"
                                   @bind-PageSize="pageSize"
                                   SearchPlaceholder="جستجوی نام گردش کار..."
                                   ItemName="گردش کار" />
            </div>
            <div class="w-full md:w-auto">
                <BulkActionToolbar SelectedCount="selectedWorkflowIds.Count"
                                   OnCancel="ClearSelection"
                                   OnDelete="OpenBulkDeleteModal" />
            </div>
        </div>

        <WorkflowTable Workflows="workflows" 
                       IsLoading="isLoading"
                       @bind-SelectedIds="selectedWorkflowIds"
                       DeletingIds="deletingWorkflowIds"
                       CurrentPage="currentPage"
                       PageSize="pageSize" />

        <div class="pt-2">
            <Pagination CurrentPage="currentPage" 
                        PageSize="pageSize" 
                        ItemName="گردش کار" 
                        TotalItems="totalWorkflows" 
                        OnNext="NextPage" 
                        OnPrevious="PreviousPage" />
        </div>
    </div>
</div>

@code {
    private List<Workflow> workflows = new();
    private HashSet<int> selectedWorkflowIds = new();
    private HashSet<int> deletingWorkflowIds = new();
    
    private string searchTerm = string.Empty;
    private int pageSize = 10;
    private int currentPage = 1;
    private int totalWorkflows = 0;
    private bool isLoading = false;

    // متدهای مربوط به مدیریت استیت ویو
    private void OpenCreateWorkflow() { /* پیاده‌سازی در آینده */ }
    private void ClearSelection() => selectedWorkflowIds.Clear();
    private void OpenBulkDeleteModal() { /* پیاده‌سازی مدال حذف گروهی */ }
    private void NextPage() => currentPage++;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
}