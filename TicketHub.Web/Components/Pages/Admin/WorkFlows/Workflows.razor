@page "/workflows"
@namespace TicketHub.Web.Components.Pages.Admin.WorkFlows
@rendermode InteractiveServer

@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared
@using TicketHub.Web.Components.Pages.Admin.WorkFlows

<PageTitle>مدیریت جریان‌های کاری | سامانه تیکتینگ</PageTitle>

<EntityManagerTemplate TItem="WorkflowDto">
    <HeaderTemplate>
        <PageHeader Title="جریان‌های کاری"
                    Description="طراحی و مدیریت مسیرهای جریان کار به شکل نوین."
                    ButtonText="ایجاد جریان کاری جدید"
                    ButtonThemeClass="bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white shadow-lg shadow-indigo-500/30 border-0"
                    OnActionClick="OpenCreateWorkflow">
            <Icon>
                <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
                    </svg>
                </div>
            </Icon>
        </PageHeader>
    </HeaderTemplate>

    <ToolbarTemplate>
        <ListFilterToolbar SearchTerm="@Facade.State.SearchTerm"
                           SearchTermChanged="OnSearchTermChanged"
                           PageSize="@Facade.State.PageSize"
                           PageSizeChanged="OnPageSizeChanged"
                           SearchPlaceholder="جستجوی جریان کاری..."
                           ItemName="جریان کار"
                           PageSizeOptions="Facade.State.MyCustomOptions">

            <MultiSelectDropdown TItem="ProjectDto" TValue="int"
                                 Placeholder="پروژه..."
                                 Items="Facade.State.AvailableProjects"
                                 SelectedValues="Facade.State.SelectedFilterProjectIds"
                                 SelectedValuesChanged="FilterProjectsChanged"
                                 ValueSelector="p => p.Id"
                                 DisplaySelector="p => p.Name" />
        </ListFilterToolbar>

        @if (Facade.State.SelectedWorkflowIds.Any())
        {
            <div class="w-full flex justify-end animate-[fadeIn_0.2s_ease-out]">
                <BulkActionToolbar SelectedCount="Facade.State.SelectedWorkflowIds.Count"
                                   OnCancel="ClearSelection"
                                   OnDelete="OpenBulkDeleteModal" />
            </div>
        }
    </ToolbarTemplate>

    <ListTemplate>
        <WorkflowCardGrid Workflows="Facade.State.Workflows"
                          IsLoading="Facade.State.IsLoading"
                          @bind-SelectedIds="Facade.State.SelectedWorkflowIds"
                          DeletingIds="Facade.State.DeletingWorkflowIds"
                          OnEdit="OpenEditWorkflow"
                          OnDelete="DeleteWorkflow" />
    </ListTemplate>

    <PaginationTemplate>
        <Pagination CurrentPage="Facade.State.CurrentPage"
                    PageSize="Facade.State.PageSize"
                    ItemName="جریان کار"
                    TotalItems="Facade.State.TotalWorkflows"
                    OnNext="NextPage"
                    OnPrevious="PreviousPage" />
    </PaginationTemplate>

    <ModalTemplate>
        <ConfirmDeleteModal IsOpen="Facade.State.IsDeleteModalOpen"
                            Description="@Facade.State.DeleteModalDescription"
                            OnConfirm="ConfirmDeleteAsync"
                            OnCancel="CancelDelete" />
    </ModalTemplate>
</EntityManagerTemplate>