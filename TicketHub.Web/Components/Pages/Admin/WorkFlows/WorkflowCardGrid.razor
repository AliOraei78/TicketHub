@using TicketHub.Core.Entities
@using TicketHub.Web.Components.Shared

@if (IsLoading)
{
    <LoadingSpinner />
}
else if (!Workflows.Any())
{
    <EmptyStateTable Value="جریان کاری" />
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        @foreach (var workflow in Workflows)
        {
            bool isSelected = SelectedIds.Contains(workflow.Id);
            bool isDeleting = DeletingIds.Contains(workflow.Id);

            <div class="@($"group relative bg-white rounded-3xl p-5 border shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col gap-4 overflow-hidden {(isSelected ? "border-indigo-400 ring-2 ring-indigo-50" : "border-gray-100 hover:border-indigo-200")} {(isDeleting ? "opacity-50 scale-95" : "")}")">

                <!-- Hover Blob Effect -->
                <div class="absolute -top-12 -left-12 w-32 h-32 bg-gradient-to-br from-indigo-100 to-purple-100 rounded-full blur-3xl opacity-0 group-hover:opacity-60 transition-opacity duration-500 pointer-events-none"></div>

                <!-- Header & Selection -->
                <div class="flex justify-between items-start z-10">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white flex items-center justify-center shadow-md shadow-indigo-200">
                            <span class="font-black text-xl">@workflow.Name.FirstOrDefault()</span>
                        </div>
                        <div>
                            <h3 class="font-bold text-gray-800 text-base truncate max-w-[120px]" title="@workflow.Name">@workflow.Name</h3>
                            <span class="text-[10px] text-gray-400 font-medium">ایجاد: @workflow.CreatedAt.ToString("yyyy/MM/dd")</span>
                        </div>
                    </div>

                    <label class="cursor-pointer relative z-20">
                        <input type="checkbox" class="peer sr-only" checked="@isSelected" @onchange="@(e => ToggleSelection(workflow.Id, e.Value))" />
                        <div class="w-6 h-6 rounded-lg border-2 border-gray-300 peer-checked:bg-indigo-600 peer-checked:border-indigo-600 transition-all flex items-center justify-center">
                            <svg class="w-4 h-4 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                    </label>
                </div>

                <!-- Description -->
                <p class="text-sm text-gray-500 line-clamp-2 min-h-[2.5rem] z-10 leading-relaxed">
                    @(string.IsNullOrEmpty(workflow.Description) ? "توضیحاتی برای این گردش کار ثبت نشده است." : workflow.Description)
                </p>

                <!-- Stats Badges -->
                <div class="flex gap-2 z-10 mt-auto pt-2">
                    <div class="flex-1 bg-gray-50/80 rounded-xl p-2.5 flex items-center justify-center gap-2 border border-gray-100 group-hover:bg-white transition-colors">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></span>
                        <span class="text-xs font-bold text-gray-600">@workflow.Projects?.Count <span class="font-normal text-gray-400">پروژه</span></span>
                    </div>
                    <div class="flex-1 bg-gray-50/80 rounded-xl p-2.5 flex items-center justify-center gap-2 border border-gray-100 group-hover:bg-white transition-colors">
                        <span class="w-2 h-2 rounded-full bg-purple-500 shadow-[0_0_8px_rgba(168,85,247,0.5)]"></span>
                        <span class="text-xs font-bold text-gray-600">@workflow.WorkflowStatuses?.Count <span class="font-normal text-gray-400">وضعیت</span></span>
                    </div>
                </div>

                <!-- Actions Footer -->
                <div class="pt-3 mt-1 border-t border-gray-50 flex justify-between items-center z-10">
                    <button type="button" @onclick="() => OnEdit.InvokeAsync(workflow)" class="flex items-center gap-1.5 text-sm font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50/50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                        ویرایش مسیر
                    </button>

                    <button type="button" @onclick="() => OnDelete.InvokeAsync(workflow)" class="p-2 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 transition-colors" title="حذف گردش کار">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<Workflow> Workflows { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public EventCallback<Workflow> OnEdit { get; set; }
    [Parameter] public EventCallback<Workflow> OnDelete { get; set; }

    [Parameter] public HashSet<int> SelectedIds { get; set; } = new();
    [Parameter] public EventCallback<HashSet<int>> SelectedIdsChanged { get; set; }

    [Parameter] public HashSet<int> DeletingIds { get; set; } = new();

    private async Task ToggleSelection(int id, object? value)
    {
        bool isChecked = (bool)(value ?? false);
        if (isChecked) SelectedIds.Add(id);
        else SelectedIds.Remove(id);

        await SelectedIdsChanged.InvokeAsync(SelectedIds);
    }
}