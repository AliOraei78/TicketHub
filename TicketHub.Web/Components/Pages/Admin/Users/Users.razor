@page "/users"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@rendermode InteractiveServer

<PageTitle>مدیریت کاربران | سامانه تیکتینگ</PageTitle>

<div class="w-full flex flex-col gap-3 flex-1" dir="rtl">
    <!-- Centered Cyber Operations Master Banner -->
    <div class="relative overflow-hidden rounded-xl bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 p-3 sm:p-3.5 shadow-[0_0_25px_rgba(8,13,26,0.85)] flex flex-col gap-2.5">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-cyan-500/20 via-indigo-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Section: Centered Title, Centered Subtitle & Centered Create CTA -->
        <div class="relative z-10 flex flex-col items-center justify-center text-center gap-2.5">
            <div class="space-y-1.5 flex flex-col items-center">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white drop-shadow-[0_2px_15px_rgba(255,255,255,0.35)] leading-tight flex items-center justify-center gap-2.5 flex-wrap text-center">
                    <span class="bg-gradient-to-r from-cyan-300 via-indigo-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_18px_rgba(56,189,248,0.7)]">مدیریت کاربران</span>
                </h1>
                <p class="text-slate-200 text-sm sm:text-base font-semibold tracking-wide flex items-center justify-center gap-2 flex-wrap text-center">
                    <span>⚡ پایش کاربران سیستم</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>تخصیص نقش‌ها</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>کنترل دسترسی</span>
                </p>
            </div>

            <SecuredView ResourceKey="/users" MinimumType="PermissionType.SystemSection">
                <div class="flex items-center justify-center">
                    <button @onclick="OpenCreateModal"
                            class="btn-cyber-primary text-sm sm:text-base py-2 px-6 focus-ring flex items-center gap-2.5 shadow-[0_0_18px_rgba(56,189,248,0.35)] cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 animate-pulse text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>افزودن کاربر جدید</span>
                    </button>
                </div>
            </SecuredView>
        </div>

        <!-- Bottom Row: 5 Holographic Telemetry Cards -->
        <div class="relative z-10 pt-2 border-t border-white/[0.08] grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
            <!-- 1. Total Users (Cyan / Water) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(56, 189, 248, 0.5); --seg-glow: rgba(56, 189, 248, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-cyan-300/90 font-bold truncate">کل کاربران</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-cyan-400/60 uppercase">👥 همه</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(56,189,248,0.7)] px-1">
                    @UsrState.Value.TotalUsers.ToPersianNumbers()
                </span>
            </div>

            <!-- 2. Active Users (Emerald / Nature) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(16, 185, 129, 0.5); --seg-glow: rgba(16, 185, 129, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-emerald-300/90 font-bold truncate">کاربران فعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-400/60 uppercase">🟢 فعال</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(16,185,129,0.7)] px-1">
                    @ActiveUsersCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 3. Inactive Users (Rose / Fire) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(244, 63, 94, 0.5); --seg-glow: rgba(244, 63, 94, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-rose-500/15 border border-rose-400/30 flex items-center justify-center text-rose-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-rose-300/90 font-bold truncate">غیرفعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-rose-400/60 uppercase">🔴 آفلاین</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(244,63,94,0.7)] px-1">
                    @InactiveUsersCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 4. Admins (Purple / Void) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(168, 85, 247, 0.5); --seg-glow: rgba(168, 85, 247, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-purple-500/15 border border-purple-400/30 flex items-center justify-center text-purple-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-purple-300/90 font-bold truncate">مدیران</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-purple-400/60 uppercase">👑 ادمین</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(168,85,247,0.7)] px-1">
                    @AdminUsersCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 5. Users with Roles (Amber / Lightning) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(245, 158, 11, 0.5); --seg-glow: rgba(245, 158, 11, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-amber-500/15 border border-amber-400/30 flex items-center justify-center text-amber-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-amber-300/90 font-bold truncate">دارای نقش</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-amber-400/60 uppercase">⚡ اعضا</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(245,158,11,0.7)] px-1">
                    @AssignedRolesUsersCount.ToPersianNumbers()
                </span>
            </div>
        </div>
    </div>

    <!-- Cyberpunk Filter & Search Command Bar -->
    <div class="relative z-30 bg-[#070c1a]/90 backdrop-blur-xl p-2.5 px-4 rounded-2xl shadow-lg border border-cyan-500/25 flex flex-wrap lg:flex-nowrap gap-3 items-center justify-between select-none">
        <!-- Controls Group: Search & Dropdowns -->
        <div class="flex flex-wrap lg:flex-nowrap items-center gap-3 w-full lg:w-auto flex-1">
            <!-- Search Box -->
            <div class="w-full sm:w-48 md:w-64">
                <SearchBox Placeholder="جستجوی نام یا ایمیل..."
                           SearchTerm="@UsrState.Value.SearchTerm"
                           OnSearchChanged="SearchTermChanged" />
            </div>

            <!-- Role Filter -->
            <div class="w-full sm:w-40 md:w-44">
                <MultiSelectDropdown TItem="RoleDto" TValue="int"
                                     Placeholder="فیلتر نقش..."
                                     Items="UsrState.Value.AvailableRoles.ToList()"
                                     SelectedValues="UsrState.Value.SelectedFilterRoleIds"
                                     SelectedValuesChanged="FilterRolesChanged"
                                     ValueSelector="r => r.Id"
                                     DisplaySelector="r => r.Name" />
            </div>

            <!-- Project Filter -->
            <div class="w-full sm:w-40 md:w-44">
                <MultiSelectDropdown TItem="ProjectDto" TValue="int"
                                     Placeholder="فیلتر پروژه..."
                                     Items="UsrState.Value.AvailableProjects.ToList()"
                                     SelectedValues="UsrState.Value.SelectedFilterProjectIds"
                                     SelectedValuesChanged="FilterProjectsChanged"
                                     ValueSelector="p => p.Id"
                                     DisplaySelector="p => p.Name" />
            </div>
        </div>

        <!-- 3-State Cyberpunk Status Filter Switcher -->
        <div class="flex items-center gap-1 p-1 bg-[#050811]/90 rounded-2xl border border-white/[0.12] h-[46px] w-full sm:w-auto shrink-0 select-none">
            <button type="button" 
                    @onclick="@(() => FilterByStatus(null))"
                    class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(UsrState.Value.SelectedFilterStatus == null ? "bg-cyan-500/20 text-cyan-300 border border-cyan-400/50 shadow-[0_0_10px_rgba(56,189,248,0.25)]" : "text-slate-400 hover:text-slate-200")">
                همه
            </button>
            <button type="button" 
                    @onclick="@(() => FilterByStatus(true))"
                    class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(UsrState.Value.SelectedFilterStatus == true ? "bg-emerald-500/20 text-emerald-300 border border-emerald-400/50 shadow-[0_0_10px_rgba(16,185,129,0.25)]" : "text-slate-400 hover:text-slate-200")">
                فعال
            </button>
            <button type="button" 
                    @onclick="@(() => FilterByStatus(false))"
                    class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(UsrState.Value.SelectedFilterStatus == false ? "bg-rose-500/20 text-rose-300 border border-rose-400/50 shadow-[0_0_10px_rgba(244,63,94,0.25)]" : "text-slate-400 hover:text-slate-200")">
                غیرفعال
            </button>
        </div>
    </div>

    <BulkActionToolbar SelectedCount="selectedUserIds.Count"
                       OnCancel="ClearSelection"
                       OnDelete="OpenBulkDeleteModal"
                       OnDeactivate="BulkDeactivateUsers"
                       OnActivate="BulkActivateUsers"
                       ResourceKey="/users" />

    <UserTable Users="UsrState.Value.Users.ToList()"
               IsLoading="UsrState.Value.IsLoading"
               OnEdit="OpenEditModal"
               OnDelete="OpenDeleteModal"
               @bind-SelectedIds="selectedUserIds"
               DeletingIds="deletingUserIds"
               CurrentPage="UsrState.Value.CurrentPage"
               PageSize="UsrState.Value.PageSize" />

    <Pagination CurrentPage="UsrState.Value.CurrentPage" PageSize="UsrState.Value.PageSize" ItemName="کاربر" TotalItems="UsrState.Value.TotalUsers" OnNext="NextPage" OnPrevious="PreviousPage" />
</div>

<UserFormModal IsOpen="isUserModalOpen"
               Model="userModel"
               PasswordInput="@passwordInput"
               AvailableRoles="UsrState.Value.AvailableRoles.ToList()"
               SelectedRoles="selectedRoles"
               OnSubmit="HandleSaveUser"
               OnCancel="CloseUserModal" />

<ConfirmDeleteModal IsOpen="showDeleteModal"
                    Description="@($"آیا از حذف کاربر {(isBulkDelete ? "های انتخاب شده" : userToDelete?.Name)} مطمئن هستید؟")"
                    OnConfirm="ConfirmDeleteUser"
                    OnCancel="CloseDeleteModal" />