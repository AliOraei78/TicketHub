@page "/users"
@rendermode InteractiveServer
@using TicketHub.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using UserEntity = TicketHub.Core.Entities.User
@using TicketHub.Core.Entities
@using TicketHub.Web.Components.Shared
@using BCrypt.Net
@inject AppDbContext DbContext

<PageTitle>مدیریت کاربران | سامانه تیکتینگ</PageTitle>

<!-- پدینگ p-4 به p-3 و gap-5 به gap-3 کاهش یافت -->
<div class="container mx-auto p-3 md:p-4 flex flex-col gap-3" dir="rtl">
    <PageHeader Title="مدیریت کاربران" Description="مشاهده لیست کاربران سیستم و دسترسی‌ها." ButtonText="افزودن کاربر جدید" ButtonThemeClass="bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/20" OnActionClick="OpenCreateModal" />

    <!-- Always visible search bar -->
    <div class="min-h-[56px] mb-2">
        <ListFilterToolbar @bind-SearchTerm="searchTerm"
                           @bind-PageSize="pageSize"
                           SearchPlaceholder="جستجوی نام یا ایمیل..."
                           ItemName="کاربر" />
    </div>

    <!-- Floating bulk action toolbar at the bottom -->
    @if (selectedUserIds.Any())
    {
        <div class="fixed bottom-6 left-1/2 z-50 bg-white border border-rose-200 rounded-2xl p-2 pl-4 flex items-center gap-6 shadow-[0_10px_40px_-10px_rgba(225,29,72,0.3)] animate-[slideUpPopup_0.4s_cubic-bezier(0.16,1,0.3,1)_forwards]" dir="rtl">
            <div class="flex items-center gap-2 pr-2">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-rose-100 text-rose-700 text-xs font-bold">@selectedUserIds.Count</span>
                <span class="text-rose-800 font-bold text-sm">مورد انتخاب شده</span>
            </div>

            <div class="flex items-center gap-2">
                <button @onclick="() => selectedUserIds.Clear()" class="px-4 py-1.5 bg-gray-50 text-gray-600 hover:bg-gray-100 rounded-xl text-sm font-bold smooth-transition">
                    لغو
                </button>
                <button @onclick="OpenBulkDeleteModal" class="px-4 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl shadow-md text-sm font-bold smooth-transition flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    حذف
                </button>
            </div>
        </div>
    }
    <!-- جدول -->
    <UserTable Users="users" IsLoading="isLoading"
               OnEdit="OpenEditModal"
               OnDelete="OpenDeleteModal"
               @bind-SelectedIds="selectedUserIds"
               DeletingIds="deletingUserIds"
               CurrentPage="currentPage"
               PageSize="pageSize" />

    <!-- صفحه‌بندی -->
    <Pagination CurrentPage="currentPage" PageSize="pageSize" ItemName="کاربر" TotalItems="totalUsers" OnNext="NextPage" OnPrevious="PreviousPage" />
</div>

<UserFormModal IsOpen="isUserModalOpen" Model="userModel" PasswordInput="@passwordInput" AvailableRoles="availableRoles" AvailableProjects="availableProjects" SelectedRoles="selectedRoles" SelectedProjectIds="selectedProjectIds" OnSubmit="HandleSaveUser" OnCancel="CloseUserModal" />

<ConfirmDeleteModal IsOpen="showDeleteModal" Description="@($"آیا از حذف کاربر {userToDelete?.Name} مطمئن هستید؟")" ErrorMessage="@deleteErrorMessage" OnConfirm="ConfirmDeleteUser" OnCancel="CloseDeleteModal" />

@code {
    private List<UserEntity> users = new();
    private bool isLoading = true;

    private List<Role> availableRoles = new();
    private List<Project> availableProjects = new();

    private bool isUserModalOpen = false;
    private UserEntity userModel = new();
    private string passwordInput = string.Empty;
    private List<string> selectedRoles = new();
    private List<int> selectedProjectIds = new();

    private bool showDeleteModal = false;
    private UserEntity? userToDelete;
    private string? deleteErrorMessage;

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; currentPage = 1; _ = LoadUsers(); }
    }

    private int _pageSize = 10;
    private int pageSize
    {
        get => _pageSize;
        set { _pageSize = value; currentPage = 1; _ = LoadUsers(); }
    }

    private int currentPage = 1;
    private int totalUsers = 0;

    private HashSet<int> selectedUserIds = new();
    private HashSet<int> deletingUserIds = new();
    private bool isBulkDelete = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableData();
        await LoadUsers();
    }

    private async Task LoadAvailableData()
    {
        availableRoles = await DbContext.Roles.ToListAsync();
        availableProjects = await DbContext.Projects.ToListAsync();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        var query = DbContext.Users.Include(u => u.UserRoles).ThenInclude(ur => ur.Role).AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
            query = query.Where(u => u.Name.Contains(searchTerm) || u.Email.Contains(searchTerm));

        totalUsers = await query.CountAsync();

        int maxPage = totalUsers == 0 ? 1 : (int)Math.Ceiling(totalUsers / (double)pageSize);
        if (currentPage > maxPage)
        {
            currentPage = maxPage;
        }

        users = await query.Skip((currentPage - 1) * pageSize).Take(pageSize).ToListAsync();
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenCreateModal()
    {
        userModel = new UserEntity();
        passwordInput = string.Empty;
        selectedRoles.Clear();
        selectedProjectIds.Clear();
        isUserModalOpen = true;
    }

    private async Task OpenEditModal(UserEntity user)
    {
        userModel = new UserEntity
        {
            Id = user.Id,
            Name = user.Name,
            Email = user.Email,
            PhoneNumber = user.PhoneNumber,
            CreatedAt = user.CreatedAt,
            IsConfirmed = user.IsConfirmed
        };
        passwordInput = string.Empty;
        selectedRoles = user.UserRoles.Select(ur => ur.Role?.Name ?? "").Where(n => !string.IsNullOrEmpty(n)).ToList();
        selectedProjectIds = await DbContext.UserProjects.Where(up => up.UserId == user.Id).Select(up => up.ProjectId).ToListAsync();
        isUserModalOpen = true;
    }

    private void CloseUserModal() => isUserModalOpen = false;

    private async Task HandleSaveUser(UserFormSubmissionResult payload)
    {
        userModel = payload.User;
        passwordInput = payload.Password;
        selectedRoles = payload.SelectedRoles;
        selectedProjectIds = payload.SelectedProjectIds;

        if (userModel.Id == 0)
        {
            if (string.IsNullOrWhiteSpace(passwordInput)) return;
            userModel.Password = BCrypt.HashPassword(passwordInput);
            userModel.CreatedAt = DateTime.UtcNow;
            DbContext.Users.Add(userModel);
            await DbContext.SaveChangesAsync();
            AssignRolesAndProjects(userModel.Id);
        }
        else
        {
            var userInDb = await DbContext.Users.Include(u => u.UserRoles).FirstOrDefaultAsync(u => u.Id == userModel.Id);
            if (userInDb == null) return;
            userInDb.Name = userModel.Name; userInDb.Email = userModel.Email;
            userInDb.PhoneNumber = userModel.PhoneNumber; userInDb.IsConfirmed = userModel.IsConfirmed;
            if (!string.IsNullOrWhiteSpace(passwordInput)) userInDb.Password = BCrypt.HashPassword(passwordInput);

            var currentRoles = await DbContext.UserRoles.Where(ur => ur.UserId == userInDb.Id).ToListAsync();
            DbContext.UserRoles.RemoveRange(currentRoles);
            var currentProjects = await DbContext.UserProjects.Where(up => up.UserId == userInDb.Id).ToListAsync();
            DbContext.UserProjects.RemoveRange(currentProjects);

            AssignRolesAndProjects(userInDb.Id);
        }

        await DbContext.SaveChangesAsync();
        CloseUserModal();
        await LoadUsers();
    }

    private void AssignRolesAndProjects(int targetUserId)
    {
        foreach (var roleName in selectedRoles.Distinct())
        {
            var role = availableRoles.FirstOrDefault(r => r.Name == roleName);
            if (role != null) DbContext.UserRoles.Add(new UserRole { UserId = targetUserId, RoleId = role.Id });
        }
        foreach (var projId in selectedProjectIds.Distinct())
        {
            DbContext.UserProjects.Add(new UserProject { UserId = targetUserId, ProjectId = projId });
        }
    }

    private async Task ConfirmDeleteUser()
    {
        showDeleteModal = false; // بلافاصله مودال را می‌بندیم تا انیمیشن اجرا شود

        try
        {
            if (isBulkDelete)
            {
                // فعال کردن انیمیشن خروج برای همه انتخاب شده‌ها
                deletingUserIds = new HashSet<int>(selectedUserIds);
                StateHasChanged();
                await Task.Delay(400); // صبر برای اتمام انیمیشن CSS

                var usersToDelete = await DbContext.Users.Where(u => selectedUserIds.Contains(u.Id)).ToListAsync();
                DbContext.Users.RemoveRange(usersToDelete);
            }
            else if (userToDelete != null)
            {
                // فعال کردن انیمیشن خروج برای یک رکورد
                deletingUserIds.Add(userToDelete.Id);
                StateHasChanged();
                await Task.Delay(400); // صبر برای اتمام انیمیشن CSS

                DbContext.Users.Remove(userToDelete);
            }

            await DbContext.SaveChangesAsync();
            selectedUserIds.Clear();
            deletingUserIds.Clear();
            await LoadUsers();
        }
        catch (Exception)
        {
            deleteErrorMessage = "امکان حذف کاربر(ان) وجود ندارد!";
            deletingUserIds.Clear();
            showDeleteModal = true;
            _ = Task.Delay(4000).ContinueWith(_ => { deleteErrorMessage = null; InvokeAsync(StateHasChanged); });
        }
    }
    private async Task NextPage()
    {
        if (currentPage < Math.Ceiling(totalUsers / (double)pageSize)) { currentPage++; await LoadUsers(); }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1) { currentPage--; await LoadUsers(); }
    }

    private void OpenDeleteModal(UserEntity user)
    {
        userToDelete = user;
        isBulkDelete = false;
        deleteErrorMessage = null;
        showDeleteModal = true;
    }

    private void OpenBulkDeleteModal()
    {
        isBulkDelete = true;
        deleteErrorMessage = null;
        showDeleteModal = true;
    }

    private void CloseDeleteModal() { showDeleteModal = false; userToDelete = null; isBulkDelete = false; }
}