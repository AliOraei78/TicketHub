@page "/users"
@namespace TicketHub.Web.Components.Pages.Admin.Settings
@rendermode InteractiveServer
@using TicketHub.Web.Components.Pages.Admin.Users
@using TicketHub.Web.Components.Shared
@using TicketHub.Core.Entities

<PageTitle>مدیریت کاربران | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-8 flex flex-col gap-3 flex-1" dir="rtl">
    <PageHeader Title="مدیریت کاربران" Description="مشاهده لیست کاربران سیستم و دسترسی‌ها." ButtonText="افزودن کاربر جدید" ButtonThemeClass="bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/20" OnActionClick="OpenCreateModal">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
        </Icon>
    </PageHeader>

    <div class="min-h-[56px] mb-2">
        <ListFilterToolbar @bind-SearchTerm="searchTerm"
                           @bind-PageSize="pageSize"
                           SearchPlaceholder="جستجوی نام یا ایمیل..."
                           ItemName="کاربر">

            <MultiSelectDropdown TItem="Role" TValue="int"
                                 Placeholder="نقش..."
                                 Items="availableRoles"
                                 SelectedValues="selectedFilterRoleIds"
                                 SelectedValuesChanged="FilterRolesChanged"
                                 ValueSelector="r => r.Id"
                                 DisplaySelector="r => r.Name" />

            <MultiSelectDropdown TItem="Project" TValue="int"
                                 Placeholder="پروژه..."
                                 Items="availableProjects"
                                 SelectedValues="selectedFilterProjectIds"
                                 SelectedValuesChanged="FilterProjectsChanged"
                                 ValueSelector="p => p.Id"
                                 DisplaySelector="p => p.Name" />

            <MultiSelectDropdown TItem="StatusOption" TValue="bool"
                                 Placeholder="وضعیت..."
                                 Items="statusOptions"
                                 SelectedValues="selectedFilterStatuses"
                                 SelectedValuesChanged="FilterStatusesChanged"
                                 ValueSelector="s => s.Value"
                                 DisplaySelector="s => s.Name" />
        </ListFilterToolbar>
    </div>

    <BulkActionToolbar SelectedCount="selectedUserIds.Count"
                       OnCancel="ClearSelection"
                       OnDelete="OpenBulkDeleteModal"
                       OnDeactivate="BulkDeactivateUsers"
                       OnActivate="BulkActivateUsers" />

    <UserTable Users="users" IsLoading="isLoading"
               OnEdit="OpenEditModal"
               OnDelete="OpenDeleteModal"
               @bind-SelectedIds="selectedUserIds"
               DeletingIds="deletingUserIds"
               CurrentPage="currentPage"
               PageSize="pageSize" />

    <Pagination CurrentPage="currentPage" PageSize="pageSize" ItemName="کاربر" TotalItems="totalUsers" OnNext="NextPage" OnPrevious="PreviousPage" />
</div>

<UserFormModal IsOpen="isUserModalOpen" Model="userModel" PasswordInput="@passwordInput" AvailableRoles="availableRoles" AvailableProjects="availableProjects" SelectedRoles="selectedRoles" SelectedProjectIds="selectedProjectIds" OnSubmit="HandleSaveUser" OnCancel="CloseUserModal" ErrorMessage="@formErrorMessage" />
<ConfirmDeleteModal IsOpen="showDeleteModal" Description="@($"آیا از حذف کاربر {userToDelete?.Name} مطمئن هستید؟")" ErrorMessage="@deleteErrorMessage" OnConfirm="ConfirmDeleteUser" OnCancel="CloseDeleteModal" />