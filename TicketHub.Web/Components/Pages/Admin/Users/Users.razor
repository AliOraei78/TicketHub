@page "/users"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@rendermode InteractiveServer

<PageTitle>مدیریت کاربران | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-8 flex flex-col gap-3 flex-1" dir="rtl">
    <PageHeader Title="مدیریت کاربران" Description="مشاهده لیست کاربران سیستم و دسترسی‌ها." ButtonText="افزودن کاربر جدید" ButtonThemeClass="bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/20" OnActionClick="OpenCreateModal">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
        </Icon>
    </PageHeader>

    <div class="min-h-[56px] mb-2">
        <ListFilterToolbar SearchTerm="@UsrState.Value.SearchTerm"
                           SearchTermChanged="SearchTermChanged"
                           PageSize="@UsrState.Value.PageSize"
                           PageSizeChanged="PageSizeChanged"
                           SearchPlaceholder="جستجوی نام یا ایمیل..."
                           ItemName="کاربر">

            <MultiSelectDropdown TItem="RoleDto" TValue="int"
                                 Placeholder="نقش..."
                                 Items="UsrState.Value.AvailableRoles.ToList()"
                                 SelectedValues="UsrState.Value.SelectedFilterRoleIds"
                                 SelectedValuesChanged="FilterRolesChanged"
                                 ValueSelector="r => r.Id"
                                 DisplaySelector="r => r.Name" />

            <MultiSelectDropdown TItem="ProjectDto" TValue="int"
                                 Placeholder="پروژه..."
                                 Items="UsrState.Value.AvailableProjects.ToList()"
                                 SelectedValues="UsrState.Value.SelectedFilterProjectIds"
                                 SelectedValuesChanged="FilterProjectsChanged"
                                 ValueSelector="p => p.Id"
                                 DisplaySelector="p => p.Name" />

            <div class="w-full sm:w-48">
                <GenericStatusFilter TValue="bool?"
                                     Options="@(new bool?[] { null, true, false })"
                                     SelectedValue="UsrState.Value.SelectedFilterStatus"
                                     OnValueChanged="FilterByStatus"
                                     BackgroundClassSelector="@(val => val == null ? "translate-x-0 bg-gray-900" : val == true ? "-translate-x-full bg-emerald-600" : "-translate-x-[200%] bg-gray-400")"
                                     ItemClassSelector="@((item, selected) => item == selected ? "text-white" : item == null ? "text-gray-600 hover:text-gray-900" : item == true ? "text-emerald-600 hover:text-emerald-700" : "text-gray-500 hover:text-gray-700")">
                    <ItemTemplate Context="status">
                        @(status == null ? "همه" : status == true ? "فعال" : "غیرفعال")
                    </ItemTemplate>
                </GenericStatusFilter>
            </div>
        </ListFilterToolbar>
    </div>

    <BulkActionToolbar SelectedCount="selectedUserIds.Count"
                       OnCancel="ClearSelection"
                       OnDelete="OpenBulkDeleteModal"
                       OnDeactivate="BulkDeactivateUsers"
                       OnActivate="BulkActivateUsers" />

    <UserTable Users="UsrState.Value.Users.ToList()"
               IsLoading="UsrState.Value.IsLoading"
               OnEdit="OpenEditModal"
               OnDelete="OpenDeleteModal"
               @bind-SelectedIds="selectedUserIds"
               DeletingIds="deletingUserIds"
               CurrentPage="UsrState.Value.CurrentPage"
               PageSize="UsrState.Value.PageSize" />

    <Pagination CurrentPage="UsrState.Value.CurrentPage" PageSize="UsrState.Value.PageSize" ItemName="کاربر" TotalItems="UsrState.Value.TotalUsers" OnNext="NextPage" OnPrevious="PreviousPage" />
</div>

<UserFormModal IsOpen="isUserModalOpen"
               Model="userModel"
               PasswordInput="@passwordInput"
               AvailableRoles="UsrState.Value.AvailableRoles.ToList()"
               SelectedRoles="selectedRoles"
               OnSubmit="HandleSaveUser"
               OnCancel="CloseUserModal"
               ErrorMessage="@UsrState.Value.FormErrorMessage" />

<ConfirmDeleteModal IsOpen="showDeleteModal"
                    Description="@($"آیا از حذف کاربر {(isBulkDelete ? "های انتخاب شده" : userToDelete?.Name)} مطمئن هستید؟")"
                    ErrorMessage="@UsrState.Value.DeleteErrorMessage"
                    OnConfirm="ConfirmDeleteUser"
                    OnCancel="CloseDeleteModal" />