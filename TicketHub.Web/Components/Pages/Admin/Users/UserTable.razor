@namespace TicketHub.Web.Components.Pages.Admin.Users
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<DataGrid TItem="UserDto" TKey="int"
          Items="Users"
          IsLoading="IsLoading"
          KeySelector="u => u.Id"
          RowClassSelector="@(u => DeletingIds.Contains(u.Id) ? "row-exit" : "row-enter")"
          CurrentPage="CurrentPage"
          PageSize="PageSize"
          SelectedKeys="SelectedIds"
          SelectedKeysChanged="OnSelectionChanged"
          EmptyStateValue="کاربری"
          ShowSelection="CanManage">

    <HeaderTemplate>
        <th class="px-6 py-2.5 text-xs font-bold text-slate-700 w-[20%]">نام کاربر</th>
        <th class="px-6 py-2.5 text-xs font-bold text-slate-700 w-[20%]">ایمیل</th>
        <th class="px-6 py-2.5 text-xs font-bold text-slate-700 w-[15%]">نقش‌ها</th>
        <th class="px-6 py-2.5 text-xs font-bold text-slate-700 w-[15%]">پروژه‌ها</th>
        <th class="px-6 py-2.5 text-xs font-bold text-slate-700 w-[15%]">وضعیت</th>
        <th class="px-6 py-2.5 text-xs font-bold text-slate-700 text-center w-[10%]">عملیات</th>
    </HeaderTemplate>

    <RowTemplate Context="user">
        <td class="px-6 py-2.5 w-[20%]">
            <div class="flex items-center gap-3">
                <TextAvatar Text="@user.Name" />
                <span class="font-bold text-xs text-slate-800 truncate block max-w-[150px]" title="@user.Name">@user.Name</span>
            </div>
        </td>
        <td class="px-6 py-2.5 text-xs text-slate-500 font-medium w-[20%] truncate max-w-[150px]" dir="ltr" title="@user.Email">@user.Email</td>
        <td class="px-6 py-2.5 w-[15%]">
            <div class="flex flex-wrap gap-1">
                @foreach (var userRole in user.UserRoles)
                {
                    <Badge Variant="BadgeVariant.Primary">
                        <span class="block truncate max-w-[100px]" title="@userRole.Role?.Name">@userRole.Role?.Name</span>
                    </Badge>
                }
                @if (!user.UserRoles.Any())
                {
                    <span class="text-slate-400 text-xs font-normal">بدون نقش</span>
                }
            </div>
        </td>
        <td class="px-6 py-2.5 w-[15%]">
            <div class="flex flex-wrap gap-1">
                @{
                    var userProjects = user.UserRoles
                        .Where(ur => ur.Role?.RoleProjects != null)
                        .SelectMany(ur => ur.Role.RoleProjects)
                        .Select(rp => rp.Project)
                        .Where(p => p != null)
                        .DistinctBy(p => p.Id)
                        .ToList();
                }
                @foreach (var project in userProjects)
                {
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/60 truncate max-w-[120px] align-middle" title="@project.Name">
                        @project.Name
                    </span>
                }
                @if (!userProjects.Any())
                {
                    <span class="text-slate-400 text-xs font-normal">بدون پروژه</span>
                }
            </div>
        </td>
        <td class="px-6 py-2.5 w-[15%]">
            @if (user.IsActive)
            {
                <span class="inline-flex items-center gap-1.5 text-emerald-700 text-xs font-bold">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-xs"></span>
                    فعال
                </span>
            }
            else
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded-lg bg-slate-100 text-slate-600 text-xs font-medium">
                    غیرفعال
                </span>
            }
        </td>
        <td class="px-6 py-2.5 text-center w-[10%]">
            <ActionButtons OnEdit="() => OnEdit.InvokeAsync(user)" OnDelete="() => OnDelete.InvokeAsync(user)" ResourceKey="@ResourceKey" />
        </td>
    </RowTemplate>

</DataGrid>