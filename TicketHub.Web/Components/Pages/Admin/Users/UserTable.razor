@namespace TicketHub.Web.Components.Pages.Admin.Users
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<DataGrid TItem="UserDto" TKey="int"
          Items="Users"
          IsLoading="IsLoading"
          KeySelector="u => u.Id"
          RowClassSelector="@(u => DeletingIds.Contains(u.Id) ? "row-exit" : "row-enter")"
          CurrentPage="CurrentPage"
          PageSize="PageSize"
          SelectedKeys="SelectedIds"
          SelectedKeysChanged="OnSelectionChanged"
          EmptyStateValue="کاربری"
          ShowSelection="CanManage"
          IsCyberpunk="true">

    <HeaderTemplate>
        <th class="px-6 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] w-[20%]">نام کاربر</th>
        <th class="px-6 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] w-[20%]">ایمیل</th>
        <th class="px-6 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] w-[15%]">نقش‌ها</th>
        <th class="px-6 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] w-[15%]">پروژه‌ها</th>
        <th class="px-6 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] w-[15%]">وضعیت</th>
        <th class="px-6 py-3 text-xs font-bold text-cyan-400 uppercase tracking-widest drop-shadow-[0_0_5px_rgba(56,189,248,0.5)] text-center w-[10%]">عملیات</th>
    </HeaderTemplate>

    <RowTemplate Context="user">
        <td class="px-6 py-3 w-[20%]">
            <div class="flex items-center gap-3">
                <TextAvatar Text="@user.Name" />
                <span class="font-bold text-[13px] text-slate-200 truncate block max-w-[150px] group-hover/row:text-cyan-300 transition-colors" title="@user.Name">@user.Name</span>
            </div>
        </td>
        <td class="px-6 py-3 text-xs text-slate-400 font-medium w-[20%] truncate max-w-[150px] group-hover/row:text-cyan-400/80 transition-colors" dir="ltr" title="@user.Email">@user.Email</td>
        <td class="px-6 py-3 w-[15%]">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var userRole in user.UserRoles)
                {
                    <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/30 truncate max-w-[100px] shadow-[0_0_8px_rgba(99,102,241,0.2)]" title="@userRole.Role?.Name">@userRole.Role?.Name</span>
                }
                @if (!user.UserRoles.Any())
                {
                    <span class="text-slate-500/60 text-xs font-mono">بدون نقش</span>
                }
            </div>
        </td>
        <td class="px-6 py-3 w-[15%]">
            <div class="flex flex-wrap gap-1.5">
                @{
                    var userProjects = user.UserRoles
                        .Where(ur => ur.Role?.RoleProjects != null)
                        .SelectMany(ur => ur.Role.RoleProjects)
                        .Select(rp => rp.Project)
                        .Where(p => p != null)
                        .DistinctBy(p => p.Id)
                        .ToList();
                }
                @foreach (var project in userProjects)
                {
                    <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 truncate max-w-[120px] align-middle shadow-[0_0_8px_rgba(56,189,248,0.2)]" title="@project.Name">
                        @project.Name
                    </span>
                }
                @if (!userProjects.Any())
                {
                    <span class="text-slate-500/60 text-xs font-mono">بدون پروژه</span>
                }
            </div>
        </td>
        <td class="px-6 py-3 w-[15%]">
            @if (user.IsActive)
            {
                <span class="inline-flex items-center gap-1.5 text-emerald-400 text-xs font-bold drop-shadow-[0_0_5px_rgba(16,185,129,0.5)]">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] animate-pulse"></span>
                    فعال
                </span>
            }
            else
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-slate-800/80 border border-slate-700 text-slate-500 text-xs font-mono">
                    غیرفعال
                </span>
            }
        </td>
        <td class="px-6 py-3 text-center w-[10%] opacity-70 group-hover/row:opacity-100 transition-opacity">
            <ActionButtons OnEdit="() => OnEdit.InvokeAsync(user)" OnDelete="() => OnDelete.InvokeAsync(user)" ResourceKey="@ResourceKey" />
        </td>
    </RowTemplate>

</DataGrid>