@using TicketHub.Core.Entities
@using TicketHub.Web.Components.Shared

<ModalDialog IsOpen="IsOpen" Title="@(Model.Id == 0 ? "ایجاد کاربر جدید" : "ویرایش اطلاعات کاربر")" OnClose="OnCancel" MaxWidthClass="max-w-2xl">
    <EditForm Model="@Model" OnValidSubmit="HandleSubmit" class="flex flex-col max-h-[85vh]">
        <div class="p-8 space-y-8 overflow-y-auto flex-1">

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="p-4 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-2xl text-sm font-medium">
                    @ErrorMessage
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <CustomInput Label="نام کاربر" @bind-Value="Model.Name" IsRequired="true" />
                <CustomInput Label="ایمیل" Type="email" @bind-Value="Model.Email" Dir="ltr" IsRequired="true" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <CustomInput Label="شماره تلفن" Type="tel" @bind-Value="Model.PhoneNumber" Dir="ltr" />
                <CustomInput Label="@(Model.Id == 0 ? "رمز عبور" : "رمز عبور جدید (اختیاری)")"
                             Type="password"
                             @bind-Value="PasswordInput"
                             Placeholder="@(Model.Id == 0 ? "رمز عبور را وارد کنید" : "خالی بگذارید اگر تغییری نمی‌خواهید")"
                             IsRequired="@(Model.Id == 0)"
                             Dir="ltr" />
            </div>

            <CustomCheckbox Label="ایمیل تایید شده است؟" @bind-Value="Model.IsConfirmed" />
            <MultiSelectDropdown TItem="Role" TValue="string"
                                 Label="نقش‌ها"
                                 Placeholder="جستجو و انتخاب نقش..."
                                 Items="AvailableRoles"
                                 @bind-SelectedValues="SelectedRoles"
                                 ValueSelector="r => r.Name"
                                 DisplaySelector="r => r.Name"
                                 BadgeBgClass="bg-indigo-100"
                                 BadgeTextClass="text-indigo-700"
                                 BadgeButtonClass="text-indigo-500 hover:text-indigo-900" />

            <MultiSelectDropdown TItem="Project" TValue="int"
                                 Label="پروژه‌ها"
                                 Placeholder="جستجو و انتخاب پروژه..."
                                 Items="AvailableProjects"
                                 @bind-SelectedValues="SelectedProjectIds"
                                 ValueSelector="p => p.Id"
                                 DisplaySelector="p => p.Name"
                                 BadgeBgClass="bg-emerald-100"
                                 BadgeTextClass="text-emerald-700"
                                 BadgeButtonClass="text-emerald-500 hover:text-emerald-900" />
        </div>
        <div class="px-8 py-6 border-t bg-gray-50 flex gap-3">
            <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3.5 rounded-2xl smooth-transition">@(Model.Id == 0 ? "ثبت کاربر" : "ذخیره تغییرات")</button>
            <button type="button" @onclick="OnCancel" class="flex-1 border border-gray-300 hover:bg-gray-100 font-medium py-3.5 rounded-2xl smooth-transition">انصراف</button>
        </div>
    </EditForm>
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public User Model { get; set; } = new();
    [Parameter] public string PasswordInput { get; set; } = string.Empty;
    [Parameter] public List<Role> AvailableRoles { get; set; } = new();
    [Parameter] public List<Project> AvailableProjects { get; set; } = new();
    [Parameter] public List<string> SelectedRoles { get; set; } = new();
    [Parameter] public List<int> SelectedProjectIds { get; set; } = new();
    [Parameter] public EventCallback<UserFormSubmissionResult> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(new UserFormSubmissionResult
        {
            User = Model,
            Password = PasswordInput,
            SelectedRoles = SelectedRoles,
            SelectedProjectIds = SelectedProjectIds
        });
    }
}