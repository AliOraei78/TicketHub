<ModalDialog IsOpen="IsOpen" Title="@(FormModel.User.Id == 0 ? "ایجاد کاربر جدید" : "ویرایش اطلاعات کاربر")" OnClose="OnCancel" MaxWidthClass="max-w-2xl">
    <EditForm EditContext="editContext" OnSubmit="HandleSubmit" class="flex flex-col max-h-[85vh]">
        <FluentValidationValidator />

        <div class="p-8 space-y-8 overflow-y-auto flex-1">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <CustomInput Label="نام کاربر" @bind-Value="FormModel.User.Name" />
                    <ValidationMessage For="@(() => FormModel.User.Name)" class="text-red-500 text-xs mt-1" />
                </div>
                <div>
                    <CustomInput Label="ایمیل" Type="email" @bind-Value="FormModel.User.Email" Dir="ltr" />
                    <ValidationMessage For="@(() => FormModel.User.Email)" class="text-red-500 text-xs mt-1" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <CustomInput Label="شماره تلفن" Type="tel" @bind-Value="FormModel.User.PhoneNumber" Dir="ltr" />
                    <ValidationMessage For="@(() => FormModel.User.PhoneNumber)" class="text-red-500 text-xs mt-1" />
                </div>
                <div>
                    <CustomInput Label="@(FormModel.User.Id == 0 ? "رمز عبور" : "رمز عبور جدید (اختیاری)")"
                                 Type="password"
                                 @bind-Value="FormModel.Password"
                                 Placeholder="@(FormModel.User.Id == 0 ? "رمز عبور را وارد کنید" : "خالی بگذارید اگر تغییری نمی‌خواهید")"
                                 Dir="ltr" />
                    <ValidationMessage For="@(() => FormModel.Password)" class="text-red-500 text-xs mt-1" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <CustomCheckbox Label="ایمیل تایید شده است؟" @bind-Value="FormModel.User.IsConfirmed" />
                <CustomCheckbox Label="کاربر فعال است؟" @bind-Value="FormModel.User.IsActive" />
            </div>

            <MultiSelectDropdown TItem="RoleDto" TValue="string"
                                 Label="نقش‌ها"
                                 Placeholder="جستجو و انتخاب نقش..."
                                 Items="AvailableRoles"
                                 @bind-SelectedValues="FormModel.SelectedRoles"
                                 ValueSelector="r => r.Name"
                                 DisplaySelector="r => r.Name"
                                 BadgeBgClass="bg-indigo-100"
                                 BadgeTextClass="text-indigo-700"
                                 BadgeButtonClass="text-indigo-500 hover:text-indigo-900" />
        </div>
        <div class="px-8 py-6 border-t bg-gray-50 flex gap-3">
            <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3.5 rounded-2xl smooth-transition">@(FormModel.User.Id == 0 ? "ثبت کاربر" : "ذخیره تغییرات")</button>
            <button type="button" @onclick="OnCancel" class="flex-1 border border-gray-300 hover:bg-gray-100 font-medium py-3.5 rounded-2xl smooth-transition">انصراف</button>
        </div>
    </EditForm>
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public UserDto Model { get; set; } = new();
    [Parameter] public string PasswordInput { get; set; } = string.Empty;
    [Parameter] public List<RoleDto> AvailableRoles { get; set; } = new();
    [Parameter] public List<string> SelectedRoles { get; set; } = new();
    [Parameter] public EventCallback<UserFormSubmissionResult> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private UserFormSubmissionResult FormModel = new();

    private EditContext editContext = default!;

    protected override void OnInitialized()
    {
        editContext = new EditContext(FormModel);
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && FormModel.User != Model)
        {
            FormModel.User = Model;
            FormModel.Password = PasswordInput;
            FormModel.SelectedRoles = SelectedRoles;

            // ساخت کانتکست جدید برای اطمینان از ردیابی صحیح فیلدهای خالی
            editContext = new EditContext(FormModel);
        }
    }

    private async Task HandleSubmit()
    {
        // فراخوانی دستی اعتبارسنجی برای تریگر شدن خطاها روی فرم
        if (editContext.Validate())
        {
            await OnSubmit.InvokeAsync(FormModel);
        }
    }
}