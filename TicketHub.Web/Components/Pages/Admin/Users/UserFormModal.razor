@namespace TicketHub.Web.Components.Pages.Admin.Users
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<ModalDialog IsOpen="IsOpen" Title="@(FormModel.User.Id == 0 ? "ایجاد کاربر جدید" : "ویرایش اطلاعات کاربر")" OnClose="OnCancel" MaxWidthClass="max-w-2xl">
    <EditForm EditContext="EditContext" OnSubmit="HandleSubmit" class="flex flex-col max-h-[85vh] select-none" novalidate>
        <FluentValidationValidator />

        <div class="p-8 space-y-8 overflow-y-auto flex-1 custom-scrollbar">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <CustomInput Label="نام کاربر" @bind-Value="FormModel.User.Name" />
                    <ValidationMessage For="@(() => FormModel.User.Name)" class="text-rose-500 text-red-500 text-xs mt-1" />
                </div>
                <div>
                    <CustomInput Label="ایمیل" Type="email" @bind-Value="FormModel.User.Email" Dir="ltr" />
                    <ValidationMessage For="@(() => FormModel.User.Email)" class="text-rose-500 text-red-500 text-xs mt-1" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <CustomInput Label="شماره تلفن" Type="tel" @bind-Value="FormModel.User.PhoneNumber" Dir="ltr" />
                    <ValidationMessage For="@(() => FormModel.User.PhoneNumber)" class="text-rose-500 text-red-500 text-xs mt-1" />
                </div>
                <div>
                    <CustomInput Label="@(FormModel.User.Id == 0 ? "رمز عبور" : "رمز عبور جدید (اختیاری)")"
                                 Type="password"
                                 @bind-Value="FormModel.Password"
                                 Placeholder="@(FormModel.User.Id == 0 ? "رمز عبور را وارد کنید" : "خالی بگذارید اگر تغییری نمی‌خواهید")"
                                 Dir="ltr" />
                    <ValidationMessage For="@(() => FormModel.Password)" class="text-rose-500 text-red-500 text-xs mt-1" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <CustomCheckbox Label="ایمیل تایید شده است؟" @bind-Value="FormModel.User.IsConfirmed" />
                <CustomCheckbox Label="کاربر فعال است؟" @bind-Value="FormModel.User.IsActive" />
            </div>

            <MultiSelectDropdown TItem="RoleDto" TValue="string"
                                 Label="نقش‌ها"
                                 Placeholder="جستجو و انتخاب نقش..."
                                 Items="AvailableRoles"
                                 @bind-SelectedValues="FormModel.SelectedRoles"
                                 ValueSelector="r => r.Name"
                                 DisplaySelector="r => r.Name"
                                 BadgeBgClass="bg-indigo-100"
                                 BadgeTextClass="text-indigo-700"
                                 BadgeButtonClass="text-indigo-500 hover:text-indigo-900" />
        </div>
        <div class="px-8 py-6 border-t border-slate-100 bg-slate-50 flex gap-3 rounded-b-3xl">
            <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm py-3.5 rounded-2xl shadow-lg shadow-indigo-500/20 transition-all focus-ring">@(FormModel.User.Id == 0 ? "ثبت کاربر" : "ذخیره تغییرات")</button>
            <button type="button" @onclick="OnCancel" class="flex-1 border border-slate-200 hover:bg-slate-100 font-bold text-sm text-slate-700 py-3.5 rounded-2xl transition-colors focus-ring">انصراف</button>
        </div>
    </EditForm>
</ModalDialog>