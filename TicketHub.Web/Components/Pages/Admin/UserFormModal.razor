@using TicketHub.Core.Entities
@using TicketHub.Web.Components.Shared

<ModalDialog IsOpen="IsOpen" Title="@(Model.Id == 0 ? "ایجاد کاربر جدید" : "ویرایش اطلاعات کاربر")" OnClose="OnCancel" MaxWidthClass="max-w-2xl">
    <EditForm Model="@Model" OnValidSubmit="HandleSubmit" class="flex flex-col max-h-[85vh]">
        <div class="p-8 space-y-8 overflow-y-auto flex-1">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">نام کاربر</label>
                    <InputText @bind-Value="Model.Name" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">ایمیل</label>
                    <InputText type="email" @bind-Value="Model.Email" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" dir="ltr" required />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">شماره تلفن</label>
                    <InputText type="tel" @bind-Value="Model.PhoneNumber" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" dir="ltr" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(Model.Id == 0 ? "رمز عبور" : "رمز عبور جدید (اختیاری)")</label>
                    <input type="password" @bind="PasswordInput" placeholder="@(Model.Id == 0 ? "رمز عبور را وارد کنید" : "خالی بگذارید اگر تغییری نمی‌خواهید")" required="@(Model.Id == 0)" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" dir="ltr" />
                </div>
            </div>

            <div class="mt-4 flex items-center gap-3">
                <InputCheckbox id="userIsConfirmed" @bind-Value="Model.IsConfirmed" class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" />
                <label for="userIsConfirmed" class="text-sm font-medium text-gray-700">نیاز به تایید ایمیل</label>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">نقش‌ها</label>
                <div class="relative">
                    <input type="text" @bind="roleSearch" @bind:event="oninput" @onfocus="() => showRoleDropdown = true" placeholder="جستجو و انتخاب نقش..." class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" />
                    @if (showRoleDropdown)
                    {
                        <div class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-2xl shadow-lg max-h-60 overflow-auto py-1">
                            @foreach (var role in AvailableRoles.Where(r => string.IsNullOrEmpty(roleSearch) || r.Name.Contains(roleSearch, StringComparison.OrdinalIgnoreCase)))
                            {
                                <div @onclick="() => ToggleRole(role.Name)" class="px-4 py-3 hover:bg-gray-100 cursor-pointer flex items-center gap-3">
                                    <input type="checkbox" checked="@SelectedRoles.Contains(role.Name)" class="w-4 h-4" />
                                    <span>@role.Name</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="flex flex-wrap gap-2 mt-3">
                    @foreach (var role in SelectedRoles)
                    {
                        <span class="bg-indigo-100 text-indigo-700 px-3 py-1 rounded-xl text-sm flex items-center">@role <button type="button" @onclick="() => RemoveRole(role)" class="ml-2 text-indigo-500">×</button></span>
                    }
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">پروژه‌ها</label>
                <div class="relative">
                    <input type="text" @bind="projectSearch" @bind:event="oninput" @onfocus="() => showProjectDropdown = true" placeholder="جستجو و انتخاب پروژه..." class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" />
                    @if (showProjectDropdown)
                    {
                        <div class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-2xl shadow-lg max-h-60 overflow-auto py-1">
                            @foreach (var proj in AvailableProjects.Where(p => string.IsNullOrEmpty(projectSearch) || p.Name.Contains(projectSearch, StringComparison.OrdinalIgnoreCase)))
                            {
                                <div @onclick="() => ToggleProject(proj.Id)" class="px-4 py-3 hover:bg-gray-100 cursor-pointer flex items-center gap-3">
                                    <input type="checkbox" checked="@SelectedProjectIds.Contains(proj.Id)" class="w-4 h-4" />
                                    <span>@proj.Name</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="flex flex-wrap gap-2 mt-3">
                    @foreach (var projId in SelectedProjectIds)
                    {
                        var proj = AvailableProjects.FirstOrDefault(p => p.Id == projId);
                        if (proj != null)
                        {
                            <span class="bg-emerald-100 text-emerald-700 px-3 py-1 rounded-xl text-sm flex items-center">@proj.Name <button type="button" @onclick="() => RemoveProject(projId)" class="ml-2 text-emerald-500">×</button></span>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="px-8 py-6 border-t bg-gray-50 flex gap-3">
            <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3.5 rounded-2xl smooth-transition">@(Model.Id == 0 ? "ثبت کاربر" : "ذخیره تغییرات")</button>
            <button type="button" @onclick="OnCancel" class="flex-1 border border-gray-300 hover:bg-gray-100 font-medium py-3.5 rounded-2xl smooth-transition">انصراف</button>
        </div>
    </EditForm>
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public User Model { get; set; } = new();
    [Parameter] public string PasswordInput { get; set; } = string.Empty;
    [Parameter] public List<Role> AvailableRoles { get; set; } = new();
    [Parameter] public List<Project> AvailableProjects { get; set; } = new();
    [Parameter] public List<string> SelectedRoles { get; set; } = new();
    [Parameter] public List<int> SelectedProjectIds { get; set; } = new();
    [Parameter] public EventCallback<UserFormSubmissionResult> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string roleSearch = string.Empty;
    private string projectSearch = string.Empty;
    private bool showRoleDropdown = false;
    private bool showProjectDropdown = false;

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(new UserFormSubmissionResult
        {
            User = Model,
            Password = PasswordInput,
            SelectedRoles = SelectedRoles,
            SelectedProjectIds = SelectedProjectIds
        });
    }

    private void ToggleRole(string roleName)
    {
        if (SelectedRoles.Contains(roleName)) SelectedRoles.Remove(roleName);
        else SelectedRoles.Add(roleName);
    }
    private void RemoveRole(string roleName) => SelectedRoles.Remove(roleName);

    private void ToggleProject(int projectId)
    {
        if (SelectedProjectIds.Contains(projectId)) SelectedProjectIds.Remove(projectId);
        else SelectedProjectIds.Add(projectId);
    }
    private void RemoveProject(int projectId) => SelectedProjectIds.Remove(projectId);
}