@page "/system-health"
@page "/admin/health"
@using Microsoft.Extensions.Diagnostics.HealthChecks
@using TicketHub.Web.HealthChecks
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>وضعیت سلامت سیستم | TicketHub</PageTitle>

<div class="p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-slate-900/60 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 shadow-lg">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-tr @GetOverallStatusBgGradient() flex items-center justify-center shadow-lg shadow-cyan-500/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
                    وضعیت و سلامت زیرساخت (Health Checks)
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @GetOverallStatusBadgeClass()">
                        <span class="w-2 h-2 rounded-full @GetOverallStatusDotClass() me-1.5 animate-pulse"></span>
                        @GetOverallStatusText()
                    </span>
                </h1>
                <p class="text-xs sm:text-sm text-slate-400 mt-0.5">
                    مانیتورینگ آنلاین وضعیت اتصال به پایگاه داده، ردیس، صف‌های کاری و سرویس‌های سیستمی
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <a href="/health" target="_blank" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all border border-slate-700/60 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                خروجی JSON
            </a>

            <a href="/hangfire" target="_blank" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all border border-slate-700/60 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                داشبورد Hangfire
            </a>

            <button @onclick="RefreshHealthAsync" disabled="@_isLoading" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-medium bg-cyan-600 hover:bg-cyan-500 text-white transition-all shadow-md shadow-cyan-600/20 disabled:opacity-50">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 @(_isLoading ? "animate-spin" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                بررسی مجدد
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Latency Card -->
        <div class="bg-slate-900/60 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 relative overflow-hidden group">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-400">کل زمان بررسی سلامت</span>
                <div class="p-2 rounded-lg bg-cyan-500/10 text-cyan-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-bold text-white">@(_totalDurationMs.ToString("F1"))</span>
                <span class="text-xs text-slate-400">میلی‌ثانیه</span>
            </div>
            <div class="mt-2 text-xs text-slate-500">
                آخرین بررسی: @_lastCheckedTime
            </div>
        </div>

        <!-- Memory Card -->
        <div class="bg-slate-900/60 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 relative overflow-hidden group">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-400">حافظه مصرفی فرآیند</span>
                <div class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                    </svg>
                </div>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-bold text-white">@_processMemoryMb</span>
                <span class="text-xs text-slate-400">مگابایت</span>
            </div>
            <div class="mt-2 text-xs text-slate-500">
                GC Allocated: @_gcAllocatedMb MB
            </div>
        </div>

        <!-- Services Status Card -->
        <div class="bg-slate-900/60 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 relative overflow-hidden group">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-400">سرویس‌های متصل</span>
                <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-bold text-emerald-400">@_healthyServicesCount</span>
                <span class="text-xs text-slate-400">از @_totalServicesCount سرویس</span>
            </div>
            <div class="mt-2 text-xs text-slate-500">
                وضعیت: @(_healthyServicesCount == _totalServicesCount ? "تمام سرویس‌ها نرمال" : "نیازمند بررسی")
            </div>
        </div>

        <!-- Uptime Card -->
        <div class="bg-slate-900/60 backdrop-blur-md border border-slate-800/80 rounded-2xl p-5 relative overflow-hidden group">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-400">مدت زمان فعالیت سرور</span>
                <div class="p-2 rounded-lg bg-purple-500/10 text-purple-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                </div>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-bold text-white">@_appUptime</span>
            </div>
            <div class="mt-2 text-xs text-slate-500">
                دات‌نت @Environment.Version
            </div>
        </div>
    </div>

    <!-- Health Check Service Items -->
    <div class="space-y-4">
        <h2 class="text-lg font-semibold text-white flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            گزارش تفصیلی وضعیت سرویس‌ها
        </h2>

        @if (_isLoading && _entries.Count == 0)
        {
            <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-12 text-center text-slate-400">
                <div class="animate-spin w-8 h-8 border-2 border-cyan-500 border-t-transparent rounded-full mx-auto mb-3"></div>
                در حال بررسی وضعیت سلامت زیرساخت...
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                @foreach (var entry in _entries)
                {
                    <div class="bg-slate-900/60 backdrop-blur-md border @GetServiceCardBorder(entry.Status) rounded-2xl p-5 shadow-lg flex flex-col justify-between transition-all hover:scale-[1.01]">
                        <div>
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl @GetServiceIconBg(entry.Status) flex items-center justify-center flex-shrink-0">
                                        @GetServiceIcon(entry.Name)
                                    </div>
                                    <div>
                                        <h3 class="font-semibold text-white text-sm sm:text-base">@entry.Name</h3>
                                        <div class="flex items-center gap-1.5 mt-0.5">
                                            @foreach (var tag in entry.Tags)
                                            {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-800 text-slate-400 border border-slate-700/50">#@tag</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @GetStatusBadge(entry.Status)">
                                    <span class="w-1.5 h-1.5 rounded-full @GetStatusDot(entry.Status) me-1.5"></span>
                                    @GetStatusPersianText(entry.Status)
                                </span>
                            </div>

                            <p class="text-xs sm:text-sm text-slate-300 mt-4 leading-relaxed bg-slate-950/40 p-3 rounded-xl border border-slate-800/50">
                                @(string.IsNullOrEmpty(entry.Description) ? "سرویس فعال است." : entry.Description)
                            </p>

                            @if (entry.Data != null && entry.Data.Count > 0)
                            {
                                <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
                                    @foreach (var kvp in entry.Data)
                                    {
                                        <div class="bg-slate-800/40 rounded-lg p-2 border border-slate-700/30">
                                            <span class="text-slate-400 block text-[11px]">@kvp.Key</span>
                                            <span class="font-medium text-slate-200 truncate block mt-0.5">@kvp.Value</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
                            <span>پاسخگویی:</span>
                            <span class="font-mono text-cyan-400 font-semibold">@entry.DurationMs.ToString("F1") ms</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
