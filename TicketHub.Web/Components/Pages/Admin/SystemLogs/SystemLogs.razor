@page "/system-logs"
@namespace TicketHub.Web.Components.Pages.Admin.SystemLogs
@using TicketHub.Web.Components.Shared

<PageTitle>ترمینال لاگ‌های سیستم | سامانه تیکت‌هاب</PageTitle>

<!-- Matrix Digital Rain Background Canvas -->
<canvas id="matrix-rain-canvas" class="fixed inset-0 pointer-events-none opacity-25 z-0" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; pointer-events: none;"></canvas>

<div class="w-full space-y-6 relative pb-16 select-none z-10 font-mono overflow-x-hidden" dir="rtl">
    <!-- Centered Cyber Operations Master Banner (Matching Tickets Page Layout) -->
    <div class="relative overflow-hidden rounded-2xl bg-[#020804]/95 backdrop-blur-2xl border border-emerald-500/35 p-4 sm:p-5 shadow-[0_0_25px_rgba(0,0,0,0.85)] flex flex-col gap-3">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-emerald-500/20 via-teal-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Section: Centered Title, Centered Subtitle & Centered Action CTA -->
        <div class="relative z-10 flex flex-col items-center justify-center text-center gap-2.5">
            @if (isLive)
            {
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 text-emerald-300 bg-emerald-950/90 px-2.5 py-0.5 rounded-full text-[10px] font-bold border border-emerald-500/60 shadow-[0_0_10px_rgba(16,185,129,0.5)]">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 matrix-radar-pulse"></span>
                        <span>جریان زنده فعال</span>
                    </span>
                </div>
            }

            <div class="space-y-1.5 flex flex-col items-center">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white drop-shadow-[0_2px_15px_rgba(0,0,0,0.5)] leading-tight flex items-center justify-center gap-2 flex-wrap text-center font-sans">
                    <span>ترمینال</span>
                    <span class="text-emerald-400 drop-shadow-[0_0_15px_rgba(16,185,129,0.7)]">مانیتورینگ</span>
                    <span>و رخدادهای</span>
                    <span class="text-emerald-400 drop-shadow-[0_0_15px_rgba(16,185,129,0.7)]">سیستم</span>
                </h1>
                <p class="text-slate-300 text-xs sm:text-sm font-medium tracking-wide flex items-center justify-center gap-2 flex-wrap text-center font-sans">
                    <span>⚡ پایش زنده رویدادها</span>
                    <span class="text-emerald-400/60">•</span>
                    <span>🔍 تریسینگ هوشمند خطاهای سرور</span>
                    <span class="text-emerald-400/60">•</span>
                    <span>📊 آنالیز متادیتا با هسته ماتریکس</span>
                </p>
            </div>

            <div class="flex items-center justify-center pt-1">
                <button type="button" @onclick="() => LoadLogsAsync(false)"
                        class="btn-matrix-primary text-xs sm:text-sm py-2 px-6 focus-ring flex items-center gap-2 shadow-[0_0_18px_rgba(16,185,129,0.35)] cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span>بروزرسانی داده‌ها</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Level Filter Chips -->
    <div class="flex flex-wrap items-center gap-2 pt-1 font-sans">
        <span class="text-xs font-bold text-slate-400 ml-1">فیلتر سریع:</span>
        <button type="button" @onclick='() => SetQuickFilter("")'
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all focus-ring cursor-pointer @(string.IsNullOrEmpty(selectedLevel) ? "bg-emerald-950/90 text-emerald-300 border border-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.3)]" : "bg-[#020804]/80 text-slate-400 border border-emerald-950 hover:border-emerald-700/60 hover:text-emerald-300")">
            همه لاگ‌ها (@allFilteredLogs.Count)
        </button>
        <button type="button" @onclick='() => SetQuickFilter("Error")'
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all focus-ring cursor-pointer @(selectedLevel == "Error" ? "bg-rose-950/90 text-rose-300 border border-rose-500 shadow-[0_0_12px_rgba(244,63,94,0.4)]" : "bg-[#020804]/80 text-rose-400/80 border border-rose-950 hover:border-rose-700/60 hover:text-rose-300")">
            ⚠️ فقط خطاها (Error)
        </button>
        <button type="button" @onclick='() => SetQuickFilter("Warning")'
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all focus-ring cursor-pointer @(selectedLevel == "Warning" ? "bg-amber-950/90 text-amber-300 border border-amber-500 shadow-[0_0_12px_rgba(245,158,11,0.4)]" : "bg-[#020804]/80 text-amber-400/80 border border-amber-950 hover:border-amber-700/60 hover:text-amber-300")">
            ⚡ هشدارها (Warning)
        </button>
        <button type="button" @onclick='() => SetQuickFilter("Information")'
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all focus-ring cursor-pointer @(selectedLevel == "Information" ? "bg-emerald-950/90 text-emerald-300 border border-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.4)]" : "bg-[#020804]/80 text-emerald-400/80 border border-emerald-950 hover:border-emerald-700/60 hover:text-emerald-300")">
            ℹ️ اطلاعات (Info)
        </button>
        <button type="button" @onclick='() => SetQuickFilter("Debug")'
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all focus-ring cursor-pointer @(selectedLevel == "Debug" ? "bg-cyan-950/90 text-cyan-300 border border-cyan-500 shadow-[0_0_12px_rgba(6,182,212,0.4)]" : "bg-[#020804]/80 text-cyan-400/80 border border-cyan-950 hover:border-cyan-700/60 hover:text-cyan-300")">
            ⚙️ دیباگ (Debug)
        </button>
    </div>

    <!-- Filter Bar -->
    <div class="matrix-terminal-card p-5 rounded-3xl space-y-4 font-sans">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
            
            <!-- جستجو -->
            <div class="lg:col-span-3">
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">جستجو در متن، خطا یا کاربر</label>
                <div class="field-spark-wrap w-full">
                    <div class="relative">
                        <input type="text" @bind="searchTerm" @bind:event="oninput" @bind:after="ApplyFilters"
                               placeholder="جستجوی پیام، خطا، منبع، مسیر..."
                               class="w-full h-[42px] pr-9 pl-3 text-xs bg-[#010603] border border-emerald-500/30 rounded-2xl text-slate-100 placeholder:text-slate-600 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-500/20 focus:shadow-[0_0_15px_rgba(16,185,129,0.25)] outline-none transition-all focus-ring font-mono" />
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500/60 absolute right-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>
            </div>

            <!-- سطح لاگ -->
            <div class="lg:col-span-2">
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">سطح لاگ</label>
                <select @bind="selectedLevel" @bind:after="ApplyFilters"
                        class="w-full h-[42px] px-3 text-xs bg-[#010603] border border-emerald-500/30 rounded-2xl text-slate-100 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-500/20 focus:shadow-[0_0_15px_rgba(16,185,129,0.25)] outline-none transition-all font-mono font-bold focus-ring">
                    <option value="" class="bg-slate-950 text-slate-200">همه سطح‌ها</option>
                    <option value="Information" class="bg-slate-950 text-emerald-400">Information</option>
                    <option value="Warning" class="bg-slate-950 text-amber-400">Warning</option>
                    <option value="Error" class="bg-slate-950 text-rose-400">Error</option>
                    <option value="Fatal" class="bg-slate-950 text-red-500 font-bold">Fatal</option>
                    <option value="Debug" class="bg-slate-950 text-cyan-400">Debug</option>
                    <option value="Verbose" class="bg-slate-950 text-slate-400">Verbose</option>
                </select>
            </div>

            <!-- از تاریخ -->
            <div class="lg:col-span-2">
                <CustomPersianDatePicker Label="از تاریخ"
                                         Value="@fromDateStr"
                                         ValueChanged="OnFromDateChanged"
                                         Placeholder="از تاریخ..." 
                                         ShowTimePicker="true" />
            </div>

            <!-- تا تاریخ -->
            <div class="lg:col-span-2">
                <CustomPersianDatePicker Label="تا تاریخ"
                                         Value="@toDateStr"
                                         ValueChanged="OnToDateChanged"
                                         Placeholder="تا تاریخ..." 
                                         ShowTimePicker="true" />
            </div>

            <!-- دکمه‌های کنترل -->
            <div class="lg:col-span-3 flex items-center gap-2">
                <button type="button" @onclick="ToggleLiveStream"
                        class="flex-1 h-[42px] px-3 rounded-2xl text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer focus-ring @(isLive ? "bg-emerald-950 text-emerald-300 border border-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.4)]" : "btn-matrix-ghost")">
                    <span class="w-2.5 h-2.5 rounded-full @(isLive ? "bg-emerald-400 matrix-radar-pulse" : "bg-slate-500")"></span>
                    <span>@(isLive ? "استریم زنده فعال" : "فعالسازی لایو")</span>
                </button>

                @if (HasActiveFilters)
                {
                    <button type="button" @onclick="ClearFilters"
                            title="پاکسازی تمام فیلترها"
                            class="h-[42px] px-3 rounded-2xl text-xs font-bold bg-rose-950/80 text-rose-300 border border-rose-500/50 hover:bg-rose-900 transition-all flex items-center gap-1 cursor-pointer focus-ring shadow-[0_0_10px_rgba(244,63,94,0.3)]">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        <span>پاکسازی</span>
                    </button>
                }
            </div>
        </div>

        @if (isDateRangeInvalid)
        {
            <div class="flex items-center gap-2 p-3 bg-rose-950/80 border border-rose-500/70 text-rose-200 text-xs rounded-2xl font-bold shadow-[0_0_15px_rgba(244,63,94,0.3)]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>@dateRangeErrorMessage</span>
            </div>
        }

        <!-- نوار وضعیت فیلترها و آمار -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-emerald-950/80 text-xs text-slate-400 font-mono">
            <div class="flex items-center gap-2">
                <span class="font-medium text-slate-400 font-sans">تعداد کل رکوردها:</span>
                <span class="font-bold text-emerald-400 bg-emerald-950/80 px-2.5 py-0.5 rounded-lg border border-emerald-500/40 shadow-[0_0_8px_rgba(16,185,129,0.3)]">@allFilteredLogs.Count</span>
                @if (isLive)
                {
                    <span class="inline-flex items-center gap-1.5 text-emerald-300 bg-emerald-950/80 px-2 py-0.5 rounded-lg font-bold text-[11px] border border-emerald-500/40">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                        <span>Auto-refresh: 3s</span>
                    </span>
                }
                @if (selectedLogs.Any())
                {
                    <span class="inline-flex items-center gap-1 text-emerald-300 bg-emerald-950/80 px-2 py-0.5 rounded-lg font-bold text-[11px] border border-emerald-500/50 shadow-[0_0_8px_rgba(16,185,129,0.3)] font-sans">
                        @selectedLogs.Count لاگ انتخاب شده
                    </span>
                }
            </div>

            @if (HasActiveFilters)
            {
                <div class="flex items-center gap-1.5 text-[11px] font-sans">
                    <span class="text-slate-500">فیلترهای فعال:</span>
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <span class="bg-emerald-950/80 text-emerald-300 border border-emerald-500/40 px-2 py-0.5 rounded-lg font-bold font-mono">متن: @searchTerm</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedLevel))
                    {
                        <span class="bg-emerald-950/80 text-emerald-300 border border-emerald-500/40 px-2 py-0.5 rounded-lg font-bold font-mono">سطح: @selectedLevel</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(fromDateStr))
                    {
                        <span class="bg-amber-950/80 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded-lg font-bold font-mono">از: @fromDateStr</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(toDateStr))
                    {
                        <span class="bg-amber-950/80 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded-lg font-bold font-mono">تا: @toDateStr</span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- جدول ماتریکسی نمایش لاگ‌ها -->
    <div class="matrix-terminal-card rounded-3xl overflow-hidden matrix-crt-scanline">
        @if (isLoading)
        {
            <div class="p-16 text-center text-emerald-400 text-sm flex flex-col items-center justify-center gap-3 font-medium">
                <div class="w-8 h-8 border-2 border-emerald-400 border-t-transparent rounded-full animate-spin shadow-[0_0_15px_rgba(16,185,129,0.8)]"></div>
                <span class="text-emerald-300 font-bold tracking-wider">در حال دریافت و پردازش لاگ‌ها...</span>
            </div>
        }
        else if (!PagedLogs.Any())
        {
            <div class="p-16 text-center text-slate-500 text-sm space-y-2 font-medium font-sans">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-emerald-500/40 drop-shadow-[0_0_8px_rgba(16,185,129,0.3)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <div class="text-xs text-slate-400 font-bold">هیچ لاگی با فیلترهای مشخص‌شده یافت نشد.</div>
            </div>
        }
        else
        {
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-right text-sm">
                    <thead class="bg-[#020804] border-b border-emerald-950 text-emerald-400 font-bold text-xs tracking-wider">
                        <tr>
                            <th class="p-3.5 pr-4 w-10 text-center">
                                <input type="checkbox"
                                       checked="@IsAllCurrentPageSelected"
                                       @onchange="ToggleSelectAllOnPage"
                                       title="انتخاب همه لاگ‌های این صفحه"
                                       class="matrix-checkbox" />
                            </th>
                            <th class="p-3.5 w-12 text-center text-slate-500">#</th>
                            <th class="p-3.5 whitespace-nowrap">TIMESTAMP</th>
                            <th class="p-3.5 whitespace-nowrap">LEVEL</th>
                            <th class="p-3.5 whitespace-nowrap font-sans">سرویس / منبع</th>
                            <th class="p-3.5 font-sans">پیام و جزئیات رخداد</th>
                            <th class="p-3.5 w-24 text-center font-sans">عملیات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-emerald-950/60 font-mono text-xs">
                        @for (int i = 0; i < PagedLogs.Count; i++)
                        {
                            var log = PagedLogs[i];
                            var rowId = (currentPage - 1) * pageSize + i;
                            var isExpanded = expandedRowIndexes.Contains(rowId);
                            var isSelected = selectedLogs.Contains(log);
                            var isCopied = recentlyCopiedRowId == rowId;

                            <tr class="hover:bg-emerald-950/30 transition-all duration-150 @(isSelected ? "bg-emerald-950/40" : (isExpanded ? "bg-[#010904]" : "bg-transparent"))">
                                <td class="p-3.5 pr-4 text-center">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="(e) => ToggleSelectLog(log, (bool)(e.Value ?? false))"
                                           class="matrix-checkbox" />
                                </td>
                                <td class="p-3.5 text-center text-slate-500 font-bold text-[11px]">
                                    @(rowId + 1)
                                </td>
                                <td class="p-3.5 whitespace-nowrap text-emerald-400/90 dir-ltr text-right font-medium">
                                    @GetPersianFormattedDate(log.Timestamp)
                                </td>
                                <td class="p-3.5 whitespace-nowrap">
                                    <span class="px-2.5 py-0.5 rounded-lg text-[11px] font-bold border @GetLevelBadgeClass(log.Level)">
                                        @log.Level
                                    </span>
                                </td>
                                <td class="p-3.5 text-slate-300 font-sans truncate max-w-[180px]" title="@log.SourceContext">
                                    @(log.SourceContext ?? "-")
                                </td>
                                <td class="p-3.5 text-slate-200 font-sans">
                                    <div class="break-words leading-relaxed select-text font-mono text-[12px] text-slate-200">
                                        @log.Message
                                    </div>

                                    @if (!string.IsNullOrEmpty(log.Exception))
                                    {
                                        <div class="mt-1 flex items-center gap-1.5">
                                            <span class="inline-flex items-center gap-1 text-rose-400 font-bold text-[10px] bg-rose-950/80 px-2 py-0.5 rounded border border-rose-500/50 shadow-[0_0_6px_rgba(244,63,94,0.4)]">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                                </svg>
                                                <span>EXCEPTION STACKTRACE</span>
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="p-3.5 text-center whitespace-nowrap">
                                    <div class="flex items-center justify-center gap-1">
                                        <button type="button" @onclick="() => CopySingleLog(log, rowId)"
                                                class="p-1.5 rounded-xl transition-all cursor-pointer focus-ring @(isCopied ? "bg-emerald-900/90 text-emerald-300 border border-emerald-400 shadow-[0_0_10px_rgba(16,185,129,0.5)]" : "text-slate-400 hover:text-emerald-400 hover:bg-emerald-950/60")"
                                                title="کپی لاگ در کلیپ‌بورد">
                                            @if (isCopied)
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 animate-scaleIn" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                </svg>
                                            }
                                        </button>

                                        <button type="button" @onclick="() => ToggleRowExpand(rowId)"
                                                class="p-1.5 text-slate-400 hover:text-emerald-400 hover:bg-emerald-950/60 rounded-xl transition-all cursor-pointer focus-ring"
                                                title="@(isExpanded ? "بستن جزئیات" : "مشاهده جزئیات کامل لاگ")">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200 @(isExpanded ? "rotate-180 text-emerald-400" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @if (isExpanded)
                            {
                                <tr>
                                    <td colspan="7" class="p-4 bg-[#010603] border-y border-emerald-500/40 shadow-inner">
                                        <div class="space-y-4 text-xs font-sans">
                                            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-emerald-950">
                                                <div class="flex items-center gap-2">
                                                    <span class="text-xs font-bold text-emerald-400">جزئیات رخداد</span>
                                                    <span class="px-2.5 py-0.5 rounded-lg text-[11px] font-mono font-bold border @GetLevelBadgeClass(log.Level)">@log.Level</span>
                                                </div>
                                                <div class="flex items-center gap-3">
                                                    <div class="text-emerald-300 font-mono text-[11px] dir-ltr font-medium bg-emerald-950/80 px-2 py-0.5 rounded border border-emerald-500/40">
                                                        @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")
                                                    </div>
                                                    <button type="button" @onclick="() => CopySingleLog(log, rowId)"
                                                            class="btn-matrix-ghost px-3 py-1 rounded-xl text-[11px] font-mono font-bold flex items-center gap-1.5 cursor-pointer focus-ring">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                        </svg>
                                                        <span>کپی اطلاعات لاگ</span>
                                                    </button>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrEmpty(log.TraceId) || !string.IsNullOrEmpty(log.SpanId) || !string.IsNullOrEmpty(log.CorrelationId))
                                            {
                                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 bg-[#020904] p-3 rounded-xl border border-emerald-500/30 text-[11px] font-mono dir-ltr text-left shadow-inner">
                                                    @if (!string.IsNullOrEmpty(log.CorrelationId))
                                                    {
                                                        <div>
                                                            <span class="text-slate-400 font-sans">CorrelationId:</span>
                                                            <span class="text-emerald-300 ml-1 font-bold">@log.CorrelationId</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(log.TraceId))
                                                    {
                                                        <div>
                                                            <span class="text-slate-400 font-sans">TraceId:</span>
                                                            <span class="text-cyan-300 ml-1 font-bold">@log.TraceId</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(log.SpanId))
                                                    {
                                                        <div>
                                                            <span class="text-slate-400 font-sans">SpanId:</span>
                                                            <span class="text-indigo-300 ml-1 font-bold">@log.SpanId</span>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (log.Properties != null && log.Properties.Any())
                                            {
                                                <div class="space-y-1.5 font-mono">
                                                    <div class="text-emerald-400 font-bold text-xs flex items-center gap-1.5">
                                                        <span>◆</span>
                                                        <span>مشخصات و متادیتا (Properties):</span>
                                                    </div>
                                                    <div class="flex flex-wrap gap-2 dir-ltr text-left font-mono text-[11px]">
                                                        @foreach (var kvp in log.Properties)
                                                        {
                                                            <div class="bg-[#020b05] border border-emerald-500/30 px-2.5 py-1 rounded-xl flex items-center gap-1.5 shadow-sm">
                                                                <span class="text-slate-400 font-sans">@kvp.Key:</span>
                                                                <span class="text-amber-300 font-bold">@kvp.Value</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(log.Exception))
                                            {
                                                <div class="space-y-1.5 pt-2 font-mono">
                                                    <div class="flex items-center justify-between">
                                                        <span class="text-rose-400 font-bold text-xs flex items-center gap-1.5">
                                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                                            </svg>
                                                            <span>استک تریس خطا (Exception Stack Trace):</span>
                                                        </span>
                                                        <button type="button" @onclick="() => CopyToClipboard(log.Exception)"
                                                                class="px-2.5 py-1 bg-rose-950/80 hover:bg-rose-900 text-rose-300 border border-rose-500/50 rounded-xl text-[11px] font-sans font-bold transition-all flex items-center gap-1 cursor-pointer focus-ring shadow-[0_0_8px_rgba(244,63,94,0.3)]">
                                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                            </svg>
                                                            <span>کپی خطا</span>
                                                        </button>
                                                    </div>
                                                    <pre class="p-4 bg-black/90 text-rose-300 rounded-2xl overflow-x-auto dir-ltr text-left text-[11px] font-mono border border-rose-500/40 select-all leading-relaxed whitespace-pre-wrap max-h-96 shadow-inner custom-scrollbar">@log.Exception</pre>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- بخش صفحه‌بندی ماتریکسی -->
            <div class="p-4 border-t border-emerald-950/80 bg-[#020804]/90 font-sans">
                <Pagination CurrentPage="currentPage"
                            PageSize="pageSize"
                            ItemName="لاگ"
                            TotalItems="allFilteredLogs.Count"
                            OnNext="() => { currentPage++; }"
                            OnPrevious="() => { currentPage--; }" />
            </div>
        }
    </div>

    <!-- Floating Bulk Actions Bar (Matrix Command Console) -->
    @if (selectedLogs.Any())
    {
        <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-6 py-3.5 rounded-2xl bg-[#010804]/95 text-white shadow-[0_20px_50px_rgba(0,0,0,0.95),0_0_20px_rgba(16,185,129,0.3)] backdrop-blur-2xl border border-emerald-500/60 text-xs font-medium animate-fadeIn">
            <div class="flex items-center gap-2 pl-3 border-l border-emerald-900">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 matrix-radar-pulse"></span>
                <span class="font-bold font-mono text-sm text-emerald-300">@selectedLogs.Count</span>
                <span class="font-sans">لاگ انتخاب شده</span>
            </div>

            <button type="button" @onclick="CopySelectedLogsAsText"
                    class="btn-matrix-primary px-3.5 py-2 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer focus-ring font-sans">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>کپی متنی (Text)</span>
            </button>

            <button type="button" @onclick="CopySelectedLogsAsJson"
                    class="btn-matrix-ghost px-3.5 py-2 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer font-bold focus-ring font-sans">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                <span>کپی JSON</span>
            </button>

            <button type="button" @onclick="DownloadSelectedLogs"
                    class="btn-matrix-ghost px-3.5 py-2 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer font-bold focus-ring font-sans">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>دانلود لاگ‌ها</span>
            </button>

            <button type="button" @onclick="ClearSelection"
                    class="p-2 text-slate-400 hover:text-rose-400 hover:bg-rose-950/40 rounded-xl transition-colors cursor-pointer focus-ring"
                    title="لغو انتخاب">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }
</div>