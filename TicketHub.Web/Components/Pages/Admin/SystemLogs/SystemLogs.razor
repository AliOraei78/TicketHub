@page "/system-logs"
@namespace TicketHub.Web.Components.Pages.Admin.SystemLogs
@using TicketHub.Web.Components.Shared
@rendermode InteractiveServer

<PageTitle>لاگ‌های زنده سیستم | سامانه تیکت‌هاب</PageTitle>

<div class="w-full space-y-6 relative pb-16 select-none" dir="rtl">
    <!-- Header -->
    <PageHeader Title="لاگ‌های سیستم"
                Description="مشاهده زنده، بررسی خطاهای رخ‌داده و ردیابی رویدادهای سیستمی با امکان فیلتر پیشرفته."
                ButtonText="بروزرسانی دستی"
                ButtonThemeClass="bg-gradient-to-r from-slate-700 to-slate-900 hover:from-slate-800 hover:to-black text-white shadow-lg border-0"
                OnActionClick="() => LoadLogsAsync(false)">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-600 drop-shadow-2xs" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </Icon>
    </PageHeader>

    <!-- Filter Bar -->
    <div class="bg-white p-5 rounded-3xl border border-slate-200/80 shadow-2xs space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
            
            <!-- جستجو -->
            <div class="lg:col-span-3">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">جستجو در متن یا خطا</label>
                <div class="relative">
                    <input type="text" @bind="searchTerm" @bind:event="oninput" @bind:after="ApplyFilters"
                           placeholder="جستجوی متن، خطا، منبع، مسیر یا کاربر..."
                           class="w-full h-[42px] pr-9 pl-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all shadow-2xs" />
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>

            <!-- سطح لاگ -->
            <div class="lg:col-span-2">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">سطح لاگ</label>
                <select @bind="selectedLevel" @bind:after="ApplyFilters"
                        class="w-full h-[42px] px-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all font-bold text-slate-700 shadow-2xs">
                    <option value="">همه سطح‌ها</option>
                    <option value="Information">Information</option>
                    <option value="Warning">Warning</option>
                    <option value="Error">Error</option>
                    <option value="Fatal">Fatal</option>
                    <option value="Debug">Debug</option>
                    <option value="Verbose">Verbose</option>
                </select>
            </div>

            <!-- از تاریخ -->
            <div class="lg:col-span-2">
                <CustomPersianDatePicker Label="از تاریخ"
                                         Value="@fromDateStr"
                                         ValueChanged="OnFromDateChanged"
                                         Placeholder="از تاریخ..." 
                                         ShowTimePicker="true" />
            </div>

            <!-- تا تاریخ -->
            <div class="lg:col-span-2">
                <CustomPersianDatePicker Label="تا تاریخ"
                                         Value="@toDateStr"
                                         ValueChanged="OnToDateChanged"
                                         Placeholder="تا تاریخ..." 
                                         ShowTimePicker="true" />
            </div>

            <!-- دکمه‌های کنترل -->
            <div class="lg:col-span-3 flex items-center gap-2">
                <button type="button" @onclick="ToggleLiveStream"
                        class="flex-1 h-[42px] px-3 rounded-2xl text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer focus-ring @(isLive ? "bg-emerald-500 text-white shadow-lg shadow-emerald-500/20 animate-pulse" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                    <span class="w-2.5 h-2.5 rounded-full @(isLive ? "bg-white" : "bg-slate-400")"></span>
                    @(isLive ? "پخش زنده فعال است" : "فعالسازی زنده")
                </button>

                @if (HasActiveFilters)
                {
                    <button type="button" @onclick="ClearFilters"
                            title="پاکسازی تمام فیلترها"
                            class="h-[42px] px-3 rounded-2xl text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200/60 hover:bg-rose-100 transition-colors flex items-center gap-1 cursor-pointer focus-ring">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        <span>پاکسازی</span>
                    </button>
                }
            </div>
        </div>

        @if (isDateRangeInvalid)
        {
            <div class="flex items-center gap-2 p-3 bg-rose-50 border border-rose-200/60 text-rose-700 text-xs rounded-2xl font-bold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>@dateRangeErrorMessage</span>
            </div>
        }

        <!-- نوار وضعیت فیلترها و تعداد -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 text-xs text-slate-500">
            <div class="flex items-center gap-2">
                <span class="font-medium">تعداد کل رکوردها:</span>
                <span class="font-bold font-mono text-slate-800 bg-slate-100 px-2.5 py-0.5 rounded-lg border border-slate-200">@allFilteredLogs.Count</span>
                @if (isLive)
                {
                    <span class="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg font-bold text-[11px] border border-emerald-200/60">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                        به‌روزرسانی خودکار هر ۳ ثانیه
                    </span>
                }
                @if (selectedLogs.Any())
                {
                    <span class="inline-flex items-center gap-1 text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-lg font-bold text-[11px] border border-indigo-200/60">
                        @selectedLogs.Count لاگ انتخاب شده
                    </span>
                }
            </div>

            @if (HasActiveFilters)
            {
                <div class="flex items-center gap-1.5 text-[11px]">
                    <span class="text-slate-400">فیلترهای فعال:</span>
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-lg font-bold">متن: @searchTerm</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedLevel))
                    {
                        <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded-lg font-bold">سطح: @selectedLevel</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(fromDateStr))
                    {
                        <span class="bg-amber-50 text-amber-700 px-2 py-0.5 rounded-lg font-bold">از: @fromDateStr</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(toDateStr))
                    {
                        <span class="bg-amber-50 text-amber-700 px-2 py-0.5 rounded-lg font-bold">تا: @toDateStr</span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- جدول نمایش لاگ‌ها -->
    <div class="bg-white border border-slate-200/80 rounded-3xl shadow-2xs overflow-hidden">
        @if (isLoading)
        {
            <div class="p-12 text-center text-slate-500 text-sm flex flex-col items-center justify-center gap-3 font-medium">
                <div class="w-7 h-7 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
                <span>در حال دریافت و پردازش لاگ‌های سیستم...</span>
            </div>
        }
        else if (!PagedLogs.Any())
        {
            <div class="p-12 text-center text-slate-400 text-sm space-y-2 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <div>هیچ لاگی با فیلترهای مشخص‌شده یافت نشد.</div>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-right text-sm">
                    <thead class="bg-slate-50/80 border-b border-slate-100 text-slate-700 font-bold text-xs">
                        <tr>
                            <th class="p-3.5 pr-4 w-10 text-center">
                                <input type="checkbox"
                                       checked="@IsAllCurrentPageSelected"
                                       @onchange="ToggleSelectAllOnPage"
                                       title="انتخاب همه لاگ‌های این صفحه"
                                       class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer" />
                            </th>
                            <th class="p-3.5 w-12 text-center">#</th>
                            <th class="p-3.5 whitespace-nowrap">زمان ثبت</th>
                            <th class="p-3.5 whitespace-nowrap">سطح</th>
                            <th class="p-3.5 whitespace-nowrap">سرویس/منبع</th>
                            <th class="p-3.5">پیام و جزئیات</th>
                            <th class="p-3.5 w-24 text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-mono text-xs">
                        @for (int i = 0; i < PagedLogs.Count; i++)
                        {
                            var log = PagedLogs[i];
                            var rowId = (currentPage - 1) * pageSize + i;
                            var isExpanded = expandedRowIndexes.Contains(rowId);
                            var isSelected = selectedLogs.Contains(log);
                            var isCopied = recentlyCopiedRowId == rowId;

                            <tr class="hover:bg-slate-50/70 transition-colors @(isSelected ? "bg-indigo-50/40" : (isExpanded ? "bg-slate-50/90" : ""))">
                                <td class="p-3.5 pr-4 text-center">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="(e) => ToggleSelectLog(log, (bool)(e.Value ?? false))"
                                           class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer" />
                                </td>
                                <td class="p-3.5 text-center text-slate-400 font-sans font-bold text-[11px]">
                                    @(rowId + 1)
                                </td>
                                <td class="p-3.5 whitespace-nowrap text-slate-500 dir-ltr text-right font-medium">
                                    @GetPersianFormattedDate(log.Timestamp)
                                </td>
                                <td class="p-3.5 whitespace-nowrap">
                                    <span class="px-2.5 py-1 rounded-xl text-[11px] font-sans font-bold border shadow-2xs @GetLevelBadgeClass(log.Level)">
                                        @log.Level
                                    </span>
                                </td>
                                <td class="p-3.5 text-slate-600 font-sans truncate max-w-[180px]" title="@log.SourceContext">
                                    @(log.SourceContext ?? "-")
                                </td>
                                <td class="p-3.5 text-slate-800 font-sans">
                                    <div class="break-words leading-relaxed select-text">
                                        @log.Message
                                    </div>

                                    @if (!string.IsNullOrEmpty(log.Exception))
                                    {
                                        <div class="mt-1.5 flex items-center gap-2">
                                            <span class="inline-flex items-center gap-1 text-rose-600 font-bold text-[11px]">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                                </svg>
                                                دارای استک تریس خطا
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="p-3.5 text-center whitespace-nowrap">
                                    <div class="flex items-center justify-center gap-1">
                                        <button type="button" @onclick="() => CopySingleLog(log, rowId)"
                                                class="p-1.5 rounded-xl transition-all cursor-pointer focus-ring @(isCopied ? "bg-emerald-100 text-emerald-700" : "text-slate-400 hover:text-emerald-600 hover:bg-emerald-50")"
                                                title="کپی متن کامل این لاگ و خطا در کلیپ‌بورد">
                                            @if (isCopied)
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-600 animate-scaleIn" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                </svg>
                                            }
                                        </button>

                                        <button type="button" @onclick="() => ToggleRowExpand(rowId)"
                                                class="p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl transition-colors cursor-pointer focus-ring"
                                                title="@(isExpanded ? "بستن جزئیات" : "مشاهده جزئیات کامل لاگ")">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200 @(isExpanded ? "rotate-180 text-indigo-600" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            @if (isExpanded)
                            {
                                <tr class="bg-slate-900/5">
                                    <td colspan="7" class="p-4 bg-slate-900 text-slate-100 rounded-2xl my-2 shadow-inner border border-slate-800">
                                        <div class="space-y-4 text-xs font-sans">
                                            <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-slate-800">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-bold text-sm text-white">جزئیات کامل رخداد</span>
                                                    <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-bold border @GetLevelBadgeClass(log.Level)">@log.Level</span>
                                                </div>
                                                <div class="flex items-center gap-3">
                                                    <div class="text-slate-400 font-mono text-[11px] dir-ltr font-medium">
                                                        @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")
                                                    </div>
                                                    <button type="button" @onclick="() => CopySingleLog(log, rowId)"
                                                            class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-[11px] font-sans font-bold transition-colors flex items-center gap-1 cursor-pointer focus-ring">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                        </svg>
                                                        <span>کپی اطلاعات لاگ</span>
                                                    </button>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrEmpty(log.TraceId) || !string.IsNullOrEmpty(log.SpanId) || !string.IsNullOrEmpty(log.CorrelationId))
                                            {
                                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 bg-slate-950/60 p-3 rounded-xl border border-slate-800 text-[11px] font-mono dir-ltr text-left">
                                                    @if (!string.IsNullOrEmpty(log.CorrelationId))
                                                    {
                                                        <div>
                                                            <span class="text-slate-400 font-sans">CorrelationId:</span>
                                                            <span class="text-emerald-400 ml-1 font-bold">@log.CorrelationId</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(log.TraceId))
                                                    {
                                                        <div>
                                                            <span class="text-slate-400 font-sans">TraceId:</span>
                                                            <span class="text-sky-400 ml-1 font-bold">@log.TraceId</span>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(log.SpanId))
                                                    {
                                                        <div>
                                                            <span class="text-slate-400 font-sans">SpanId:</span>
                                                            <span class="text-indigo-400 ml-1 font-bold">@log.SpanId</span>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (log.Properties != null && log.Properties.Any())
                                            {
                                                <div class="space-y-1.5">
                                                    <div class="text-slate-300 font-bold text-xs">متادیتا و مشخصات درخواست (Properties):</div>
                                                    <div class="flex flex-wrap gap-2 dir-ltr text-left font-mono text-[11px]">
                                                        @foreach (var kvp in log.Properties)
                                                        {
                                                            <div class="bg-slate-800/90 border border-slate-700 px-2.5 py-1 rounded-xl flex items-center gap-1.5">
                                                                <span class="text-slate-400 font-sans">@kvp.Key:</span>
                                                                <span class="text-amber-300 font-bold">@kvp.Value</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(log.Exception))
                                            {
                                                <div class="space-y-1.5 pt-2">
                                                    <div class="flex items-center justify-between">
                                                        <span class="text-rose-400 font-bold text-xs flex items-center gap-1">
                                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                                            </svg>
                                                            استک تریس و جزئیات خطا (Exception Stack Trace):
                                                        </span>
                                                        <button type="button" @onclick="() => CopyToClipboard(log.Exception)"
                                                                class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-[11px] font-sans font-bold transition-colors flex items-center gap-1 cursor-pointer focus-ring">
                                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                                            </svg>
                                                            <span>کپی خطا</span>
                                                        </button>
                                                    </div>
                                                    <pre class="p-3 bg-black/70 text-rose-300 rounded-2xl overflow-x-auto dir-ltr text-left text-[11px] font-mono border border-rose-900/40 select-all leading-relaxed whitespace-pre-wrap max-h-96">@log.Exception</pre>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- بخش صفحه‌بندی -->
            <div class="p-4 border-t border-slate-100 bg-slate-50/50">
                <Pagination CurrentPage="currentPage"
                            PageSize="pageSize"
                            ItemName="لاگ"
                            TotalItems="allFilteredLogs.Count"
                            OnNext="() => { currentPage++; }"
                            OnPrevious="() => { currentPage--; }" />
            </div>
        }
    </div>

    <!-- Floating Bulk Actions Bar -->
    @if (selectedLogs.Any())
    {
        <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-5 py-3 rounded-2xl bg-slate-900/95 text-white shadow-2xl backdrop-blur-xl border border-slate-700/80 text-xs font-medium animate-fadeIn">
            <div class="flex items-center gap-2 pl-3 border-l border-slate-700">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 animate-ping"></span>
                <span class="font-bold font-mono text-sm text-indigo-400">@selectedLogs.Count</span>
                <span>لاگ انتخاب شده</span>
            </div>

            <button type="button" @onclick="CopySelectedLogsAsText"
                    class="px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl transition-all flex items-center gap-1.5 shadow-md shadow-indigo-600/30 cursor-pointer font-bold focus-ring">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>کپی متنی (Text)</span>
            </button>

            <button type="button" @onclick="CopySelectedLogsAsJson"
                    class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer font-bold focus-ring">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                <span>کپی JSON</span>
            </button>

            <button type="button" @onclick="DownloadSelectedLogs"
                    class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer font-bold focus-ring">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>دانلود لاگ‌ها</span>
            </button>

            <button type="button" @onclick="ClearSelection"
                    class="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors cursor-pointer focus-ring"
                    title="لغو انتخاب">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }
</div>