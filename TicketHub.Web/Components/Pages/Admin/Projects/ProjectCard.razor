@namespace TicketHub.Web.Components.Pages.Admin.Projects
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Application.DTOs
@using TicketHub.Application.Enums
@using TicketHub.Core.Common

<div class="tactical-project-card bg-[#080d1a]/95 backdrop-blur-2xl rounded-2xl border border-cyan-500/30 p-5 shadow-[0_0_25px_rgba(8,13,26,0.85)] relative overflow-hidden group select-none flex flex-col justify-between h-full min-h-[220px]">
    
    <!-- 4 Tactical Target Brackets on Hover -->
    <div class="target-bracket target-bracket-tl"></div>
    <div class="target-bracket target-bracket-tr"></div>
    <div class="target-bracket target-bracket-bl"></div>
    <div class="target-bracket target-bracket-br"></div>

    <!-- Tactical Target-Lock Crosshair HUD Overlay -->
    <div class="target-crosshair-hud">
        <div class="relative flex flex-col items-center justify-center">
            <!-- Outer Pulsing Lock Ring -->
            <div class="w-32 h-32 rounded-full border border-dashed border-cyan-400/40 reticle-spin-slow flex items-center justify-center">
                <!-- Inner Rotating Ring -->
                <div class="w-24 h-24 rounded-full border border-cyan-400/30 reticle-spin-reverse flex items-center justify-center">
                    <div class="w-16 h-16 rounded-full border-2 border-cyan-400/60 reticle-pulse"></div>
                </div>
            </div>

            <!-- Precision Crosshair Lines -->
            <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-36 h-[1.5px] bg-gradient-to-r from-transparent via-cyan-400/60 to-transparent"></div>
                <div class="absolute h-36 w-[1.5px] bg-gradient-to-b from-transparent via-cyan-400/60 to-transparent"></div>
            </div>

            <!-- Central Laser Dot -->
            <div class="absolute w-2 h-2 rounded-full bg-cyan-300 shadow-[0_0_8px_#38bdf8] animate-ping"></div>
            <div class="absolute w-1.5 h-1.5 rounded-full bg-white"></div>

            <!-- HUD Tactical Readout Label -->
            <div class="absolute -bottom-8 px-2.5 py-0.5 rounded-md bg-cyan-950/90 border border-cyan-400/50 shadow-[0_0_12px_rgba(56,189,248,0.4)] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
                <span class="text-[10px] font-mono font-black text-cyan-300 tracking-wider">
                    TARGET_LOCK // PRJ-@Project.Id.ToString("D3")
                </span>
            </div>
        </div>
    </div>

    <!-- Ambient Card Atmosphere -->
    <div class="absolute -top-12 -left-12 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-cyan-500/20 transition-all"></div>
    <div class="absolute -bottom-12 -right-12 w-32 h-32 bg-purple-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-purple-500/20 transition-all"></div>

    <!-- Card Header: Icon, Name & Actions / Status -->
    <div class="relative z-10">
        <div class="flex items-start justify-between gap-3 mb-3">
            <!-- Project Avatar Icon & Info -->
            <div class="flex items-center gap-3 min-w-0">
                <div class="w-11 h-11 rounded-xl bg-cyan-950/60 border border-cyan-500/40 flex items-center justify-center text-cyan-300 group-hover:border-cyan-400 group-hover:shadow-[0_0_15px_rgba(56,189,248,0.35)] transition-all flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
                <div class="min-w-0">
                    <h3 class="text-base sm:text-lg font-black text-white group-hover:text-cyan-300 truncate transition-colors drop-shadow-[0_0_8px_rgba(255,255,255,0.2)]" title="@Project.Name">
                        @Project.Name
                    </h3>
                    <div class="flex items-center gap-1.5 mt-0.5">
                        <span class="text-[10px] font-mono text-cyan-400/80 uppercase">PRJ-@Project.Id.ToString("D3")</span>
                    </div>
                </div>
            </div>

            <!-- Top Right: Status Badge & Floating Action Buttons -->
            <div class="flex items-center gap-1.5 flex-shrink-0">
                <!-- Action Buttons on Hover -->
                <div class="opacity-0 group-hover:opacity-100 transition-all duration-200 flex items-center gap-1">
                    <SecuredView ResourceKey="/projects" MinimumType="PermissionType.SystemSection">
                        <button type="button" @onclick="OnEdit" class="w-8 h-8 rounded-lg bg-indigo-950/80 text-indigo-300 hover:text-white hover:bg-indigo-600/80 border border-indigo-500/40 flex items-center justify-center transition-all focus-ring cursor-pointer shadow-[0_0_10px_rgba(99,102,241,0.25)]" title="ویرایش پروژه">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 5.232z" /></svg>
                        </button>
                    </SecuredView>
                    <SecuredView ResourceKey="/projects" MinimumType="PermissionType.Full">
                        <button type="button" @onclick="OnDelete" class="w-8 h-8 rounded-lg bg-rose-950/80 text-rose-300 hover:text-white hover:bg-rose-600/80 border border-rose-500/40 flex items-center justify-center transition-all focus-ring cursor-pointer shadow-[0_0_10px_rgba(244,63,94,0.25)]" title="حذف پروژه">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                    </SecuredView>
                </div>

                <!-- Status Badge -->
                @if (Project.IsActive)
                {
                    <span class="inline-flex items-center gap-1.5 text-emerald-300 text-xs font-bold bg-emerald-950/80 px-2.5 py-1 rounded-xl border border-emerald-500/40 shadow-[0_0_10px_rgba(16,185,129,0.25)]">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] animate-pulse"></span>
                        فعال
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-slate-900/80 text-slate-400 text-xs font-medium border border-slate-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                        غیرفعال
                    </span>
                }
            </div>
        </div>

        <!-- Description -->
        <p class="text-slate-300/80 text-xs sm:text-sm line-clamp-2 leading-relaxed font-normal mb-4 min-h-[36px]">
            @(string.IsNullOrWhiteSpace(Project.Description) ? "بدون توضیحات ثبت‌شده برای این پروژه." : Project.Description)
        </p>
    </div>

    <!-- Card Bottom Matrix: Workflow & Roles Pill & Date -->
    <div class="relative z-10 pt-3 border-t border-white/[0.08] flex flex-col gap-2.5">
        <div class="flex items-center justify-between gap-2 flex-wrap">
            <!-- Workflow Badge -->
            @if (Project.Workflow != null)
            {
                <div class="flex items-center gap-1.5 text-xs font-semibold text-purple-300 bg-purple-950/60 px-2.5 py-1 rounded-xl border border-purple-500/30 shadow-[0_0_10px_rgba(168,85,247,0.15)] max-w-[180px] truncate" title="@Project.Workflow.Name">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                    </svg>
                    <span class="truncate">@Project.Workflow.Name</span>
                </div>
            }
            else
            {
                <span class="text-[11px] text-slate-500 italic">بدون جریان کاری</span>
            }

            <!-- Role Matrix Pill -->
            <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-indigo-950/50 border border-indigo-500/30 text-indigo-300 text-xs font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                <span>@(Project.RoleIds?.Count ?? 0) <span class="font-normal text-slate-400 text-[10px]">نقش</span></span>
            </div>
        </div>

        <!-- Persian Creation Date -->
        <div class="text-[11px] text-slate-400 font-mono flex items-center justify-between">
            <span class="flex items-center gap-1 text-slate-400 font-sans">
                <svg class="w-3.5 h-3.5 text-cyan-400/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                ایجاد:
            </span>
            <span class="text-cyan-300/90 font-semibold">
                @(Project.CreatedAt > DateTime.MinValue && Project.CreatedAt.Year >= 622 ? Project.CreatedAt.ToPersianDateString() : "ثبت سیستم")
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = default!;
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}