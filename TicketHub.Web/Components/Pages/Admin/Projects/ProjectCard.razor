@namespace TicketHub.Web.Components.Pages.Admin.Projects
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Application.DTOs
@using TicketHub.Application.Enums

<div class="bg-white p-6 rounded-3xl shadow-2xs border border-slate-200/80 hover:shadow-xl transition-all group relative select-none">

    <!-- Action Buttons -->
    <div class="absolute top-4 left-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-20">
        <SecuredView ResourceKey="/projects" MinimumType="PermissionType.SystemSection">
            <button type="button" @onclick="OnEdit" class="p-1.5 text-indigo-500 hover:bg-indigo-50 rounded-xl transition-colors focus-ring" title="ویرایش">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 5.232z" /></svg>
            </button>
        </SecuredView>
        <SecuredView ResourceKey="/projects" MinimumType="PermissionType.Full">
            <button type="button" @onclick="OnDelete" class="p-1.5 text-rose-500 hover:bg-rose-50 rounded-xl transition-colors focus-ring" title="حذف">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            </button>
        </SecuredView>
    </div>

    <!-- Status Badge -->
    <div class="absolute top-4 left-4 z-10 transition-opacity duration-200 group-hover:opacity-0">
        @if (Project.IsActive)
        {
            <span class="inline-flex items-center gap-1.5 text-emerald-700 text-xs font-bold bg-emerald-50/80 px-2.5 py-1 rounded-xl border border-emerald-100">
                <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-xs"></span>
                فعال
            </span>
        }
        else
        {
            <span class="inline-flex items-center px-2.5 py-1 rounded-xl bg-slate-100 text-slate-600 text-xs font-medium border border-slate-200">
                غیرفعال
            </span>
        }
    </div>

    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mb-4 group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-2xs">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
    </div>
    <h3 class="text-xl font-bold text-slate-800 mb-2 pl-16 truncate tracking-tight" title="@Project.Name">@Project.Name</h3>
    <p class="text-slate-500 text-xs mb-4 line-clamp-2 leading-relaxed font-normal">@Project.Description</p>

    <!-- Workflow Badge -->
    @if (Project.Workflow != null)
    {
        <div class="flex items-center gap-1.5 text-xs font-semibold text-indigo-600 mb-3 bg-indigo-50/50 w-fit max-w-full px-2.5 py-1 rounded-xl border border-indigo-100 overflow-hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
            </svg>
            <span class="truncate block" title="@Project.Workflow?.Name">@Project.Workflow?.Name</span>
        </div>
    }

    <div class="flex-1 bg-slate-50/80 rounded-xl p-2 flex items-center justify-center gap-1.5 border border-slate-100 group-hover:bg-white transition-colors w-fit mt-3">
        <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-xs"></span>
        <span class="text-[11px] font-bold text-slate-600 whitespace-nowrap">@(Project.RoleIds?.Count ?? 0) <span class="font-normal text-slate-400">نقش</span></span>
    </div>

    <div class="text-xs text-slate-400 border-t border-slate-100 pt-4 mt-3 font-normal">
        ایجاد شده در: @Project.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = default!;
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
}