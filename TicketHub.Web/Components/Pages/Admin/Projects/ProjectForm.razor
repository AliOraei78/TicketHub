@namespace TicketHub.Web.Components.Pages.Admin.Projects
@using Microsoft.AspNetCore.Components.Sections
@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

@if (IsOpen)
{
    <SectionContent SectionName="RootModal">
        <div class="modal-backdrop-quantum fixed inset-0 z-[99999] flex items-center justify-center p-4 sm:p-6 bg-black/80 backdrop-blur-xl modal-backdrop-animate select-none">
            <div class="absolute inset-0" @onclick="OnCancel"></div>

            <div class="modal-warp-container modal-hud-chassis relative z-[99999] w-full max-w-xl bg-[#090e1d]/98 rounded-3xl flex flex-col border border-cyan-500/40 my-auto select-none text-slate-200 shadow-[0_25px_60px_rgba(0,0,0,0.95),0_0_30px_rgba(56,189,248,0.15)]" dir="rtl">

                <!-- Header Section -->
                <div class="flex items-center justify-between px-6 py-4.5 border-b border-white/[0.08] bg-[#050811]/90 flex-shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 bg-cyan-950/80 border border-cyan-500/40 text-cyan-400 rounded-2xl shadow-[0_0_15px_rgba(56,189,248,0.2)]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                @if (Model.Id == 0)
                                {
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                }
                                else
                                {
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                }
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-lg sm:text-xl font-bold text-slate-100">@Title</h2>
                            <p class="text-xs text-slate-400 mt-0.5 font-normal">
                                @(Model.Id == 0 ? "ایجاد و تعریف پروژه جدید در سیستم" : "ویرایش مشخصات و جریان کاری پروژه")
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="esc-key-badge hidden sm:inline-flex">ESC</span>
                        <button type="button" @onclick="OnCancel" class="group p-2 text-slate-400 hover:text-cyan-300 hover:bg-slate-800/80 rounded-full transition-all focus-ring" title="بستن">
                            <svg class="w-6 h-6 group-hover:rotate-90 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>

                <EditForm Model="@Model" OnValidSubmit="OnSave" novalidate class="flex flex-col flex-1">
                    <FluentValidationValidator />

                    <div class="p-6 space-y-4">
                        <!-- Project Name -->
                        <div class="stagger-item-1 relative z-20">
                            <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-300 mb-1.5">
                                <span class="text-cyan-400 text-[9px]">◆</span>
                                <span>نام پروژه</span>
                            </label>
                            <div class="field-spark-wrap w-full">
                                <InputText @bind-Value="Model.Name"
                                           class="w-full h-[46px] px-4 border border-white/[0.12] rounded-2xl focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all shadow-2xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] text-slate-100 text-sm placeholder-slate-500"
                                           placeholder="نام پروژه را وارد کنید" />
                            </div>
                            <ValidationMessage For="@(() => Model.Name)" class="text-red-500 text-rose-400 text-xs mt-1" />
                        </div>

                        <!-- Description -->
                        <div class="stagger-item-2 relative z-10">
                            <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-300 mb-1.5">
                                <span class="text-cyan-400 text-[9px]">◆</span>
                                <span>توضیحات پروژه</span>
                            </label>
                            <div class="field-spark-wrap w-full">
                                <InputTextArea @bind-Value="Model.Description" rows="2"
                                               class="w-full px-4 py-2.5 border border-white/[0.12] rounded-2xl focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all shadow-2xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] text-slate-100 text-sm placeholder-slate-500 resize-none"
                                               placeholder="درباره این پروژه بنویسید..." />
                            </div>
                            <ValidationMessage For="@(() => Model.Description)" class="text-red-500 text-rose-400 text-xs mt-1" />
                        </div>

                        <!-- Workflow & Roles in 2 columns -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 stagger-item-3 relative z-30">
                            <div>
                                <SlideSelect TItem="WorkflowDto"
                                             TValue="int?"
                                             Label="جریان کاری"
                                             Placeholder="انتخاب جریان کاری..."
                                             Items="@Workflows"
                                             TextSelector="@(w => w.Name)"
                                             ValueSelector="@(w => w.Id)"
                                             @bind-Value="Model.WorkflowId"
                                             AllowClear="true"
                                             ClearText="بدون جریان کاری" />
                            </div>

                            <div>
                                <MultiSelectDropdown TItem="RoleDto"
                                                     TValue="int"
                                                     Label="نقش‌های پروژه"
                                                     Placeholder="انتخاب نقش‌ها..."
                                                     Items="@Roles"
                                                     DisplaySelector="r => r.Name"
                                                     ValueSelector="r => r.Id"
                                                     @bind-SelectedValues="Model.RoleIds" />
                            </div>
                        </div>

                        <!-- Active Checkbox -->
                        <div class="pt-1 stagger-item-4">
                            <CustomCheckbox Label="پروژه فعال است؟" @bind-Value="Model.IsActive" />
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="p-4 sm:px-6 sm:py-4 border-t border-white/[0.08] bg-[#050811]/90 flex justify-end gap-3 flex-shrink-0 rounded-b-3xl">
                        <button type="button" @onclick="OnCancel" class="btn-cyber-ghost focus-ring">انصراف</button>
                        <button type="submit" class="btn-cyber-primary focus-ring">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                @if (Model.Id == 0)
                                {
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                                }
                                else
                                {
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                }
                            </svg>
                            <span>@(Model.Id == 0 ? "ثبت پروژه" : "ذخیره تغییرات")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </SectionContent>
}