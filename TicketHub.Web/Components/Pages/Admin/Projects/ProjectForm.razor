@using TicketHub.Application.DTOs
@using TicketHub.Web.Components.Shared

<ModalDialog IsOpen="IsOpen"
             Title="@Title"
             OnClose="OnCancel"
             MaxWidthClass="max-w-md">

    <EditForm Model="@Model" OnValidSubmit="OnSave" class="flex flex-col max-h-[85vh]">
        <div class="p-8 space-y-6 overflow-y-auto flex-1">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">نام پروژه</label>
                <InputText @bind-Value="Model.Name" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500 text-sm smooth-transition" placeholder="نام پروژه را وارد کنید" required />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">توضیحات</label>
                <InputTextArea @bind-Value="Model.Description" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500 text-sm smooth-transition" placeholder="درباره این پروژه بنویسید..." />
            </div>

            <SlideSelect TItem="WorkflowDto"
                         TValue="int?"
                         Label="جریان کاری"
                         Placeholder="انتخاب جریان کاری..."
                         Items="Workflows"
                         TextSelector="w => w.Name"
                         ValueSelector="w => w.Id"
                         @bind-Value="Model.WorkflowId"
                         AllowClear="true"
                         ClearText="بدون جریان کاری" />

            <div class="flex items-center mt-4 gap-2">
                <label for="projectIsActive" class="block text-sm font-medium text-gray-700">پروژه فعال است؟</label>
                <InputCheckbox @bind-Value="Model.IsActive" class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" id="projectIsActive" />
            </div>
        </div>

        <div class="px-8 py-6 border-t bg-gray-50 flex gap-3">
            <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3.5 rounded-2xl smooth-transition shadow-lg shadow-indigo-500/10">
                @(Model.Id == 0 ? "ثبت پروژه" : "ذخیره تغییرات")
            </button>
            <button type="button" @onclick="OnCancel" class="flex-1 border border-gray-300 hover:bg-gray-100 font-medium py-3.5 rounded-2xl smooth-transition text-gray-700">انصراف</button>
        </div>
    </EditForm>
</ModalDialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ProjectDto Model { get; set; } = new();
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IEnumerable<WorkflowDto> Workflows { get; set; } = Array.Empty<WorkflowDto>();
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}