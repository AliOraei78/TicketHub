@page "/projects"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@rendermode InteractiveServer

<div class="w-full flex flex-col gap-3 flex-1" dir="rtl">
    <PageHeader Title="مدیریت پروژه‌ها"
                Description="پروژه‌های سیستم را برای تخصیص تیکت‌ها مدیریت کنید."
                ButtonText="ایجاد پروژه جدید"
                ButtonThemeClass="bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/20"
                OnActionClick="OpenCreateModal"
                ResourceKey="/projects">
        <Icon>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </Icon>
    </PageHeader>

    <div class="flex flex-col sm:flex-row gap-3 items-center mb-2">
        <div class="w-full sm:w-72">
            <SearchBox Placeholder="جست و جوی عنوان..." OnSearchChanged="HandleSearch" />
        </div>

        <div class="w-full sm:w-48">
            <GenericStatusFilter TValue="bool?"
                                 Options="new bool?[] { null, true, false }"
                                 SelectedValue="State.Value.SelectedFilterStatus"
                                 OnValueChanged="FilterByStatus"
                                 BackgroundClassSelector='val => val == null ? "translate-x-0 bg-gray-900" : val == true ? "-translate-x-full bg-emerald-600" : "-translate-x-[200%] bg-gray-400"'
                                 ItemClassSelector='(item, selected) => item == selected ? "text-white" : item == null ? "text-gray-600 hover:text-gray-900" : item == true ? "text-emerald-600 hover:text-emerald-700" : "text-gray-500 hover:text-gray-700"'>
                <ItemTemplate Context="status">
                    @(status == null ? "همه" : status == true ? "فعال" : "غیرفعال")
                </ItemTemplate>
            </GenericStatusFilter>
        </div>
    </div>

    <StatefulDataView Items="FilteredProjects" EmptyMessage="هیچ پروژه‌ای یافت نشد.">
        <ItemTemplate Context="project">
            @{
                bool isDeleting = project.Id == deletingProjectId;
            }
            <div @key="project.Id" class="@(isDeleting ? "fade-out-item" : "fade-in-item")">
                <ProjectCard Project="project"
                             OnEdit="() => OpenEditModal(project)"
                             OnDelete="() => OpenDeleteModal(project)" />
            </div>
        </ItemTemplate>
    </StatefulDataView>
</div>

<ProjectForm IsOpen="isFormModalOpen"
             Model="projectModel"
             Title="@(projectModel.Id == 0 ? "ایجاد پروژه جدید" : "ویرایش پروژه")"
             Workflows="State.Value.Workflows"
             Roles="State.Value.Roles"
             OnSave="HandleSaveProject"
             OnCancel="CloseFormModal" />

<ConfirmDeleteModal IsOpen="isDeleteModalOpen"
                    Description="@($"آیا از حذف پروژه {projectToDelete?.Name} مطمئن هستید؟")"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CloseDeleteModal" />