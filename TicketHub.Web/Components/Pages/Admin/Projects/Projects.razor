@page "/projects"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@namespace TicketHub.Web.Components.Pages.Admin.Projects
@using TicketHub.Core.Common
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Application.Enums

<PageTitle>مدیریت پروژه‌ها | سامانه تیکتینگ</PageTitle>

<div class="w-full flex flex-col gap-2.5 flex-1 select-none" dir="rtl">
    <!-- Centered Cyber Operations Master Banner -->
    <div class="relative overflow-hidden rounded-xl bg-[#080d1a]/95 backdrop-blur-2xl border border-cyan-500/35 p-3 sm:p-3.5 shadow-[0_0_25px_rgba(8,13,26,0.85)] flex flex-col gap-2.5">
        <!-- Ambient Laser Atmosphere -->
        <div class="absolute -top-24 left-1/3 w-96 h-48 bg-gradient-to-b from-cyan-500/20 via-indigo-500/15 to-transparent blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 right-10 w-48 h-48 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 left-10 w-48 h-48 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Section: Centered Title, Centered Subtitle & Centered Create CTA -->
        <div class="relative z-10 flex flex-col items-center justify-center text-center gap-2.5">
            <div class="space-y-1.5 flex flex-col items-center">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white drop-shadow-[0_2px_15px_rgba(255,255,255,0.35)] leading-tight flex items-center justify-center gap-2.5 flex-wrap text-center">
                    <span class="bg-gradient-to-r from-cyan-300 via-indigo-300 to-purple-400 bg-clip-text text-transparent drop-shadow-[0_0_18px_rgba(56,189,248,0.7)]">مدیریت پروژه‌ها</span>
                </h1>
                <p class="text-slate-200 text-sm sm:text-base font-semibold tracking-wide flex items-center justify-center gap-2 flex-wrap text-center">
                    <span>⚡ پایش پروژه‌های فعال</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>معماری جریان‌های کاری</span>
                    <span class="text-cyan-400/60">•</span>
                    <span>تخصیص ماتریس نقش‌ها</span>
                </p>
            </div>

            <SecuredView ResourceKey="/projects" MinimumType="PermissionType.SystemSection">
                <div class="flex items-center justify-center">
                    <button @onclick="OpenCreateModal"
                            class="btn-cyber-primary text-sm sm:text-base py-2 px-6 focus-ring flex items-center gap-2.5 shadow-[0_0_18px_rgba(56,189,248,0.35)] cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 animate-pulse text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>ایجاد پروژه جدید</span>
                    </button>
                </div>
            </SecuredView>
        </div>

        <!-- Bottom Row: 5 Holographic Telemetry Cards -->
        <div class="relative z-10 pt-2 border-t border-white/[0.08] grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
            <!-- 1. Total Projects (Cyan / Water) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(56, 189, 248, 0.5); --seg-glow: rgba(56, 189, 248, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center text-cyan-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-cyan-300/90 font-bold truncate">کل پروژه‌ها</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-cyan-400/60 uppercase">🌊 همه</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(56,189,248,0.7)] px-1">
                    @TotalProjectsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 2. Active Projects (Emerald / Nature) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(16, 185, 129, 0.5); --seg-glow: rgba(16, 185, 129, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/15 border border-emerald-400/30 flex items-center justify-center text-emerald-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-emerald-300/90 font-bold truncate">پروژه‌های فعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-emerald-400/60 uppercase">🌿 فعال</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(16,185,129,0.7)] px-1">
                    @ActiveProjectsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 3. Inactive Projects (Rose / Amber) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(244, 63, 94, 0.5); --seg-glow: rgba(244, 63, 94, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-rose-500/15 border border-rose-400/30 flex items-center justify-center text-rose-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-rose-300/90 font-bold truncate">غیرفعال</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-rose-400/60 uppercase">⚡ بایگانی</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(244,63,94,0.7)] px-1">
                    @InactiveProjectsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 4. Workflows (Purple / Void) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(168, 85, 247, 0.5); --seg-glow: rgba(168, 85, 247, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-purple-500/15 border border-purple-400/30 flex items-center justify-center text-purple-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-purple-300/90 font-bold truncate">جریان‌های کاری</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-purple-400/60 uppercase">🔮 متصل</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(168,85,247,0.7)] px-1">
                    @WorkflowsCount.ToPersianNumbers()
                </span>
            </div>

            <!-- 5. Total Roles (Indigo / Arcane) -->
            <div class="telemetry-pill-segment py-1.5 px-2.5 sm:px-3" style="--seg-border: rgba(99, 102, 241, 0.5); --seg-glow: rgba(99, 102, 241, 0.25);">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-indigo-500/15 border border-indigo-400/30 flex items-center justify-center text-indigo-300 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-xs sm:text-[13px] text-indigo-300/90 font-bold truncate">ماتریس نقش‌ها</span>
                        <span class="text-[9px] sm:text-[10px] font-bold text-indigo-400/60 uppercase">🛡️ دسترسی</span>
                    </div>
                </div>
                <span class="text-base sm:text-lg font-black text-white drop-shadow-[0_0_8px_rgba(99,102,241,0.7)] px-1">
                    @RolesCount.ToPersianNumbers()
                </span>
            </div>
        </div>
    </div>

    <!-- Cyberpunk Filter & Search Command Bar -->
    <div class="relative z-30 bg-[#070c1a]/90 backdrop-blur-xl p-2.5 px-4 rounded-2xl shadow-lg border border-cyan-500/25 flex flex-col sm:flex-row items-center justify-between gap-3 select-none">
        <!-- Search Box -->
        <div class="w-full sm:w-72 md:w-80 flex items-center h-[46px]">
            <SearchBox Placeholder="جست‌وجوی پروژه یا شناسه..." 
                       SearchTerm="@State.Value.SearchTerm" 
                       OnSearchChanged="HandleSearch" />
        </div>

        <!-- 3-State Cyberpunk Status Filter Switcher -->
        <div class="flex items-center gap-1 p-1 bg-[#050811]/90 rounded-2xl border border-white/[0.12] h-[46px] w-full sm:w-auto shrink-0 select-none">
            <button type="button" 
                    @onclick="@(() => FilterByStatus(null))"
                    class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(State.Value.SelectedFilterStatus == null ? "bg-cyan-500/20 text-cyan-300 border border-cyan-400/50 shadow-[0_0_10px_rgba(56,189,248,0.25)]" : "text-slate-400 hover:text-slate-200")">
                همه (@TotalProjectsCount)
            </button>
            <button type="button" 
                    @onclick="@(() => FilterByStatus(true))"
                    class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(State.Value.SelectedFilterStatus == true ? "bg-emerald-500/20 text-emerald-300 border border-emerald-400/50 shadow-[0_0_10px_rgba(16,185,129,0.25)]" : "text-slate-400 hover:text-slate-200")">
                فعال (@ActiveProjectsCount)
            </button>
            <button type="button" 
                    @onclick="@(() => FilterByStatus(false))"
                    class="flex-1 sm:flex-none px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer @(State.Value.SelectedFilterStatus == false ? "bg-rose-500/20 text-rose-300 border border-rose-400/50 shadow-[0_0_10px_rgba(244,63,94,0.25)]" : "text-slate-400 hover:text-slate-200")">
                غیرفعال (@InactiveProjectsCount)
            </button>
        </div>
    </div>

    <!-- Projects Grid View -->
    @if (State.Value.IsLoading)
    {
        <div class="p-16 rounded-2xl bg-[#080d1a]/80 backdrop-blur-2xl border border-cyan-500/25 text-center flex flex-col items-center justify-center gap-3">
            <div class="w-8 h-8 border-3 border-cyan-400 border-t-transparent rounded-full animate-spin"></div>
            <span class="text-sm font-mono text-cyan-300 font-bold">در حال بارگذاری اطلاعات پروژه‌ها...</span>
        </div>
    }
    else if (!FilteredProjects.Any())
    {
        <div class="p-16 rounded-2xl bg-[#080d1a]/80 backdrop-blur-2xl border border-cyan-500/25 text-center flex flex-col items-center justify-center gap-3">
            <div class="w-16 h-16 rounded-2xl bg-cyan-950/40 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shadow-[0_0_20px_rgba(56,189,248,0.15)]">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-slate-200">هیچ پروژه‌ای مطابق فیلترهای انتخابی یافت نشد.</h3>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
            @foreach (var project in FilteredProjects)
            {
                bool isDeleting = project.Id == deletingProjectId;
                <div @key="project.Id" class="@(isDeleting ? "fade-out-item" : "fade-in-item")">
                    <ProjectCard Project="project"
                                 OnEdit="() => OpenEditModal(project)"
                                 OnDelete="() => OpenDeleteModal(project)" />
                </div>
            }
        </div>
    }
</div>

<ProjectForm IsOpen="isFormModalOpen"
             Model="projectModel"
             Title="@(projectModel.Id == 0 ? "ایجاد پروژه جدید" : "ویرایش پروژه")"
             Workflows="State.Value.Workflows"
             Roles="State.Value.Roles"
             OnSave="HandleSaveProject"
             OnCancel="CloseFormModal" />

<ConfirmDeleteModal IsOpen="isDeleteModalOpen"
                    Description="@($"آیا از حذف پروژه {projectToDelete?.Name} مطمئن هستید؟")"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CloseDeleteModal" />