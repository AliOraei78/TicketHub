@page "/projects"
@using TicketHub.Core.Entities
@using TicketHub.Core.Interfaces
@using TicketHub.Web.Components.Shared
@rendermode InteractiveServer
@inject IRepository<Project> ProjectRepository
@inject IRepository<Workflow> WorkflowRepository

<div class="container mx-auto p-4 md:p-8 flex flex-col gap-3 flex-1" dir="rtl">
    <PageHeader Title="مدیریت پروژه‌ها"
                Description="پروژه‌های سیستم را برای تخصیص تیکت‌ها مدیریت کنید."
                ButtonText="ایجاد پروژه جدید"
                ButtonThemeClass="bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/20"
                OnActionClick="OpenCreateModal">
        <Icon>
            <!-- Project icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
        </Icon>
    </PageHeader>

    <div class="flex flex-col sm:flex-row gap-3 items-center mb-2">
        <!-- فیلتر وضعیت به صورت کشویی (Sliding Segmented Control) -->
        <div class="relative flex rounded-xl bg-gray-100 p-1 shrink-0 h-[46px] items-center">
            <!-- پس‌زمینه متحرک (Slider) -->
            <div class="absolute right-1 top-1 bottom-1 w-20 rounded-lg transition-all duration-300 ease-out shadow-sm
                @(selectedFilterStatus == null ? "translate-x-0 bg-gray-900" :
                    selectedFilterStatus == true ? "-translate-x-full bg-emerald-600" :
                    "-translate-x-[200%] bg-gray-400")">
            </div>

            <!-- دکمه‌ها -->
            <button type="button" @onclick="() => FilterByStatus(null)" class="relative z-10 w-20 py-1.5 text-sm font-medium transition-colors duration-300 @(selectedFilterStatus == null ? "text-white" : "text-gray-600 hover:text-gray-900")">
                همه
            </button>
            <button type="button" @onclick="() => FilterByStatus(true)" class="relative z-10 w-20 py-1.5 text-sm font-medium transition-colors duration-300 @(selectedFilterStatus == true ? "text-white" : "text-emerald-600 hover:text-emerald-700")">
                فعال
            </button>
            <button type="button" @onclick="() => FilterByStatus(false)" class="relative z-10 w-20 py-1.5 text-sm font-medium transition-colors duration-300 @(selectedFilterStatus == false ? "text-white" : "text-gray-500 hover:text-gray-700")">
                غیرفعال
            </button>
        </div>

        <div class="w-full sm:w-72">
            <SearchBox Placeholder="جست و جوی عنوان..." OnSearchChanged="HandleSearch" />
        </div>
    </div>

    @if (projects == null)
    {
        <LoadingSpinner />
    }
    else if (!projects.Any())
    {
        <EmptyState Message="هیچ پروژه‌ای یافت نشد." />
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var project in FilteredProjects)
            {
                // بررسی اینکه آیا این پروژه در حال حذف شدن است یا خیر
                bool isDeleting = project.Id == deletingProjectId;

                <div @key="project.Id" class="@(isDeleting ? "fade-out-item" : "fade-in-item")">
                    <ProjectCard Project="project"
                                 OnEdit="() => OpenEditModal(project)"
                                 OnDelete="() => OpenDeleteModal(project)" />
                </div>
            }
        </div>
    }
</div>
<!-- Unified Create/Edit Modal with UI matching -->
<ModalDialog IsOpen="isFormModalOpen"
             Title="@(projectModel.Id == 0 ? "ایجاد پروژه جدید" : "ویرایش پروژه")"
             OnClose="CloseFormModal"
             MaxWidthClass="max-w-md">

    <EditForm Model="@projectModel" OnValidSubmit="HandleSaveProject" class="flex flex-col max-h-[85vh]">
        <div class="p-8 space-y-6 overflow-y-auto flex-1">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">نام پروژه</label>
                <InputText @bind-Value="projectModel.Name" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500 text-sm smooth-transition" placeholder="نام پروژه را وارد کنید" required />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">توضیحات</label>
                <InputTextArea @bind-Value="projectModel.Description" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500 text-sm smooth-transition" placeholder="درباره این پروژه بنویسید..." />
            </div>

            <!-- فیلد جریان کاری با انیمیشن اسلاید -->

            <SlideSelect TItem="Workflow"
                         TValue="int?"
                         Label="جریان کاری"
                         Placeholder="انتخاب جریان کاری..."
                         Items="workflows"
                         TextSelector="w => w.Name"
                         ValueSelector="w => w.Id"
                         @bind-Value="projectModel.WorkflowId"
                         AllowClear="true"
                         ClearText="بدون جریان کاری" />

            <div class="flex items-center mt-4 gap-2">
                <label for="projectIsActive" class="block text-sm font-medium text-gray-700">پروژه فعال است؟</label>
                <InputCheckbox @bind-Value="projectModel.IsActive" class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" id="projectIsActive" />
            </div>
        </div>

        <div class="px-8 py-6 border-t bg-gray-50 flex gap-3">
            <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3.5 rounded-2xl smooth-transition shadow-lg shadow-indigo-500/10">
                @(projectModel.Id == 0 ? "ثبت پروژه" : "ذخیره تغییرات")
            </button>
            <button type="button" @onclick="CloseFormModal" class="flex-1 border border-gray-300 hover:bg-gray-100 font-medium py-3.5 rounded-2xl smooth-transition text-gray-700">انصراف</button>
        </div>
    </EditForm>
</ModalDialog>

<!-- Use the shared delete modal component -->
<ConfirmDeleteModal IsOpen="isDeleteModalOpen"
                    Description="@($"آیا از حذف پروژه {projectToDelete?.Name} مطمئن هستید؟")"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CloseDeleteModal" />

@code {
    private IEnumerable<Project> projects = new List<Project>();

    // متغیرهای جدید
    private IEnumerable<Workflow> workflows = new List<Workflow>();

    // Model for Create/Edit
    private Project projectModel = new Project();
    private bool isFormModalOpen = false;

    private int? deletingProjectId;

    // Model for Delete
    private Project? projectToDelete;
    private bool isDeleteModalOpen = false;

    // Search & Filter properties
    private string searchTerm = string.Empty;
    private bool? selectedFilterStatus = null;

    // Computed property to filter projects based on search term and status
    private IEnumerable<Project> FilteredProjects =>
        projects
        .Where(p => string.IsNullOrWhiteSpace(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(p => selectedFilterStatus == null || p.IsActive == selectedFilterStatus);

    private void FilterByStatus(bool? status)
    {
        selectedFilterStatus = status;
    }

    private void HandleSearch(string term)
    {
        searchTerm = term;
    }

    // اضافه کردن بارگذاری جریان‌های کاری در متد OnInitializedAsync
    protected override async Task OnInitializedAsync()
    {
        workflows = await WorkflowRepository.GetAllAsync(); // دریافت لیست
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        projects = await ProjectRepository.GetAllAsync();
    }

    // آپدیت متد OpenCreateModal
    private void OpenCreateModal()
    {
        projectModel = new Project();
        isFormModalOpen = true;
    }

    // اضافه کردن WorkflowId در OpenEditModal
    private void OpenEditModal(Project project)
    {
        projectModel = new Project
        {
            Id = project.Id,
            Name = project.Name,
            Description = project.Description,
            CreatedAt = project.CreatedAt,
            IsActive = project.IsActive,
            WorkflowId = project.WorkflowId // اضافه شد
        };
        isFormModalOpen = true;
    }

    private void CloseFormModal()
    {
        isFormModalOpen = false;
    }

    private async Task HandleSaveProject()
    {
        if (projectModel.Id == 0)
        {
            projectModel.CreatedAt = DateTime.UtcNow;
            await ProjectRepository.AddAsync(projectModel);
        }
        else
        {
            var trackedProject = projects.FirstOrDefault(p => p.Id == projectModel.Id);

            if (trackedProject != null)
            {
                trackedProject.Name = projectModel.Name;
                trackedProject.Description = projectModel.Description;
                trackedProject.IsActive = projectModel.IsActive;
                trackedProject.WorkflowId = projectModel.WorkflowId; // اضافه شد

                await ProjectRepository.UpdateAsync(trackedProject);
            }
        }

        await LoadProjects();
        isFormModalOpen = false;
    }
    // --- Delete Methods ---
    private void OpenDeleteModal(Project project)
    {
        projectToDelete = project;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        projectToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (projectToDelete != null)
        {
            // 1. ذخیره آیدی پروژه برای جلوگیری از null شدن آن پس از بستن مودال
            var idToDelete = projectToDelete.Id;

            // 2. تنظیم آیدی برای اعمال کلاس fade-out-item
            deletingProjectId = idToDelete;

            // 3. بستن مودال تایید حذف
            CloseDeleteModal();

            // 4. اجبار بلیزور به بروزرسانی رابط کاربری برای شروع انیمیشن
            StateHasChanged();

            // 5. صبر کردن به مدت 400 میلی‌ثانیه (معادل زمان انیمیشن در CSS)
            await Task.Delay(400);

            // 6. حذف واقعی پروژه و بارگذاری مجدد اطلاعات
            await ProjectRepository.DeleteAsync(idToDelete);
            await LoadProjects();

            // 7. ریست کردن متغیر
            deletingProjectId = null;
        }
        else
        {
            CloseDeleteModal();
        }
    }
}