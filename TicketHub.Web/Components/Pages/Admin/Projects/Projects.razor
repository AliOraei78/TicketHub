@page "/projects"
@using TicketHub.Web.Components.Shared
@rendermode InteractiveServer

<div class="container mx-auto p-4 md:p-8 flex flex-col gap-3 flex-1" dir="rtl">
    <PageHeader Title="مدیریت پروژه‌ها"
                Description="پروژه‌های سیستم را برای تخصیص تیکت‌ها مدیریت کنید."
                ButtonText="ایجاد پروژه جدید"
                ButtonThemeClass="bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/20"
                OnActionClick="OpenCreateModal">
        <Icon>
            <!-- Project icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
        </Icon>
    </PageHeader>

    <div class="flex flex-col sm:flex-row gap-3 items-center mb-2">
        <!-- فیلتر وضعیت به صورت کشویی (Sliding Segmented Control) -->
        <div class="relative flex rounded-xl bg-gray-100 p-1 shrink-0 h-[46px] items-center">
            <!-- پس‌زمینه متحرک (Slider) -->
            <div class="absolute right-1 top-1 bottom-1 w-20 rounded-lg transition-all duration-300 ease-out shadow-sm
                @(ProjectFacade.State.SelectedFilterStatus == null ? "translate-x-0 bg-gray-900" :
                      ProjectFacade.State.SelectedFilterStatus == true ? "-translate-x-full bg-emerald-600" :
                     "-translate-x-[200%] bg-gray-400")">
            </div>

            <!-- دکمه‌ها -->
            <button type="button" @onclick="() => FilterByStatus(null)" class="relative z-10 w-20 py-1.5 text-sm font-medium transition-colors duration-300 @(ProjectFacade.State.SelectedFilterStatus == null ? "text-white" : "text-gray-600 hover:text-gray-900")">
                همه
            </button>
            <button type="button" @onclick="() => FilterByStatus(true)" class="relative z-10 w-20 py-1.5 text-sm font-medium transition-colors duration-300 @(ProjectFacade.State.SelectedFilterStatus == true ? "text-white" : "text-emerald-600 hover:text-emerald-700")">
                فعال
            </button>
            <button type="button" @onclick="() => FilterByStatus(false)" class="relative z-10 w-20 py-1.5 text-sm font-medium transition-colors duration-300 @(ProjectFacade.State.SelectedFilterStatus == false ? "text-white" : "text-gray-500 hover:text-gray-700")">
                غیرفعال
            </button>
        </div>

        <div class="w-full sm:w-72">
            <SearchBox Placeholder="جست و جوی عنوان..." OnSearchChanged="HandleSearch" />
        </div>
    </div>

    <StatefulDataView Items="ProjectFacade.State.FilteredProjects" EmptyMessage="هیچ پروژه‌ای یافت نشد.">
        <ItemTemplate Context="project">
            @{
                bool isDeleting = project.Id == deletingProjectId;
            }
            <div @key="project.Id" class="@(isDeleting ? "fade-out-item" : "fade-in-item")">
                <ProjectCard Project="project"
                             OnEdit="() => OpenEditModal(project)"
                             OnDelete="() => OpenDeleteModal(project)" />
            </div>
        </ItemTemplate>
    </StatefulDataView>
</div>

<!-- Unified Create/Edit Modal extracted to Dumb Component -->
<ProjectForm IsOpen="isFormModalOpen"
             Model="projectModel"
             Title="@(projectModel.Id == 0 ? "ایجاد پروژه جدید" : "ویرایش پروژه")"
             Workflows="ProjectFacade.State.Workflows"
             Roles="ProjectFacade.State.Roles"
             OnSave="HandleSaveProject"
             OnCancel="CloseFormModal" />

<!-- Use the shared delete modal component -->
<ConfirmDeleteModal IsOpen="isDeleteModalOpen"
                    Description="@($"آیا از حذف پروژه {projectToDelete?.Name} مطمئن هستید؟")"
                    OnConfirm="ConfirmDelete"
                    OnCancel="CloseDeleteModal" />
