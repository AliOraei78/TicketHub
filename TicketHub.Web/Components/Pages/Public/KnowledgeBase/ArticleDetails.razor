@page "/kb/{Slug}"
@page "/faq/{Slug}"
@layout TicketHub.Web.Components.Layout.PublicLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IKnowledgeBaseService KbService
@inject NavigationManager Navigation

@if (Article != null)
{
    <PageTitle>@Article.Title | پایگاه دانش تیکت‌هاب</PageTitle>

    <HeadContent>
        <meta name="description" content="@Article.Summary" />
        <meta name="keywords" content="@string.Join(", ", Article.Tags)" />
        <link rel="canonical" href="@($"/kb/{Article.Slug}")" />

        <!-- Open Graph Article -->
        <meta property="og:type" content="article" />
        <meta property="og:title" content="@Article.Title" />
        <meta property="og:description" content="@Article.Summary" />
        <meta property="article:published_time" content="@Article.LastUpdatedIso" />
        <meta property="article:section" content="@Article.CategoryTitle" />

        <!-- Schema.org Article & BreadcrumbList JSON-LD -->
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "TechArticle",
            "headline": "@Article.Title",
            "description": "@Article.Summary",
            "datePublished": "@Article.LastUpdatedIso",
            "dateModified": "@Article.LastUpdatedIso",
            "inLanguage": "fa",
            "author": {
                "@@type": "Organization",
                "name": "TicketHub Support Team"
            },
            "publisher": {
                "@@type": "Organization",
                "name": "TicketHub",
                "logo": {
                    "@@type": "ImageObject",
                    "url": "https://tickethub.local/images/brand/tickethub-icon.png"
                }
            }
        }
        </script>
    </HeadContent>

    <div class="max-w-4xl mx-auto px-4 sm:px-8 py-8 sm:py-12 space-y-8 select-none">
        
        <!-- Breadcrumb Navigation -->
        <nav class="flex items-center gap-2 text-xs text-slate-400 flex-wrap" aria-label="Breadcrumb">
            <a href="/kb" class="hover:text-cyan-300 transition-colors">پایگاه دانش</a>
            <span>/</span>
            <span class="text-slate-400">@Article.CategoryTitle</span>
            <span>/</span>
            <span class="text-cyan-300 font-bold truncate max-w-xs">@Article.Title</span>
        </nav>

        <!-- Article Header & Meta Bar -->
        <article class="space-y-6">
            <div class="space-y-3 pb-6 border-b border-white/[0.08]">
                <div class="flex items-center gap-3 flex-wrap">
                    <span class="px-3 py-1 rounded-full text-xs font-bold border @Article.CategoryColorClass">
                        @Article.CategoryTitle
                    </span>
                    <span class="text-xs text-slate-400 flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>@Article.ReadTimeMinutes دقیقه زمان مطالعه</span>
                    </span>
                    <span class="text-xs text-slate-400 flex items-center gap-1 font-mono">
                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        <span>بروزرسانی: @Article.LastUpdatedPersian</span>
                    </span>
                </div>

                <h1 class="text-xl sm:text-3xl font-black text-white leading-tight">
                    @Article.Title
                </h1>

                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal bg-white/[0.02] p-4 rounded-2xl border border-white/[0.06]">
                    @Article.Summary
                </p>
            </div>

            <!-- Main Rich Body Content -->
            <div class="p-6 sm:p-8 rounded-3xl bg-[#070b16]/90 border border-white/[0.08] shadow-xl text-slate-200">
                @((MarkupString)Article.ContentHtml)
            </div>

            <!-- Tags -->
            @if (Article.Tags.Any())
            {
                <div class="flex items-center gap-2 flex-wrap pt-2">
                    <span class="text-xs font-bold text-slate-400">برچسب‌ها:</span>
                    @foreach (var tag in Article.Tags)
                    {
                        <span class="px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/10 text-xs text-slate-300 font-mono">
                            #@tag
                        </span>
                    }
                </div>
            }

            <!-- Helpfulness Feedback Widget -->
            <div class="p-6 rounded-2xl bg-[#070c1a] border border-cyan-500/30 text-center space-y-4 shadow-lg">
                <h3 class="text-sm sm:text-base font-bold text-white">آیا این مقاله برای شما مفید بود؟</h3>
                
                @if (!hasSubmittedFeedback)
                {
                    <div class="flex items-center justify-center gap-3">
                        <button type="button"
                                @onclick="() => SubmitFeedback(true)"
                                class="px-4 py-2 rounded-xl bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-xs font-bold hover:bg-emerald-900 transition-all flex items-center gap-2 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg>
                            <span>بله (@Article.HelpfulCount)</span>
                        </button>

                        <button type="button"
                                @onclick="() => SubmitFeedback(false)"
                                class="px-4 py-2 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-300 text-xs font-bold hover:bg-rose-900 transition-all flex items-center gap-2 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5" /></svg>
                            <span>خیر (@Article.NotHelpfulCount)</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="p-3 rounded-xl bg-cyan-950/60 border border-cyan-500/40 text-cyan-300 text-xs font-bold animate-[fadeIn_0.2s_ease-out]">
                        ✓ از ثبت بازخورد ارزشمند شما سپاسگزاریم!
                    </div>
                }
            </div>

            <!-- Related Articles -->
            @if (RelatedArticles != null && RelatedArticles.Any())
            {
                <div class="space-y-4 pt-6 border-t border-white/[0.08]">
                    <h3 class="text-base font-bold text-white">مقالات مرتبط در همین دسته‌بندی</h3>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        @foreach (var rel in RelatedArticles)
                        {
                            <a href="/kb/@rel.Slug"
                               class="p-4 rounded-2xl bg-[#070b16]/80 border border-white/[0.06] hover:border-cyan-500/40 transition-all group block">
                                <h4 class="text-xs font-bold text-slate-200 group-hover:text-cyan-300 transition-colors line-clamp-2">
                                    @rel.Title
                                </h4>
                                <span class="text-[10px] text-slate-500 font-mono mt-2 block">@rel.ReadTimeMinutes دقیقه مطالعه</span>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Back to Hub Button -->
            <div class="pt-4 flex items-center justify-between">
                <a href="/kb" class="btn-cyber-ghost text-xs px-4 py-2 font-bold inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    <span>بازگشت به پایگاه دانش</span>
                </a>

                <a href="/login" class="btn-cyber-primary text-xs px-4 py-2 font-bold">
                    <span>ثبت تیکت به پشتیبانی</span>
                </a>
            </div>
        </article>
    </div>
}
else if (isLoading)
{
    <div class="min-h-[50vh] flex items-center justify-center">
        <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-cyan-400"></div>
    </div>
}
else
{
    <div class="max-w-md mx-auto px-4 py-16 text-center space-y-4">
        <div class="w-16 h-16 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 flex items-center justify-center mx-auto">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        </div>
        <h2 class="text-lg font-black text-white">مقاله مورد نظر یافت نشد</h2>
        <p class="text-xs text-slate-400">ممکن است آدرس مقاله تغییر کرده باشد یا حذف شده باشد.</p>
        <a href="/kb" class="btn-cyber-primary text-xs px-4 py-2 font-bold inline-block mt-2">
            مشاهده سایر مقالات پایگاه دانش
        </a>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private KbArticleDto? Article;
    private List<KbArticleDto>? RelatedArticles;
    private bool isLoading = true;
    private bool hasSubmittedFeedback = false;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        hasSubmittedFeedback = false;
        Article = await KbService.GetArticleBySlugAsync(Slug);
        
        if (Article != null)
        {
            RelatedArticles = await KbService.GetRelatedArticlesAsync(Article.Slug, Article.CategorySlug);
        }
        
        isLoading = false;
    }

    private async Task SubmitFeedback(bool isHelpful)
    {
        if (Article != null && !hasSubmittedFeedback)
        {
            await KbService.SubmitFeedbackAsync(Article.Slug, isHelpful);
            if (isHelpful) Article.HelpfulCount++;
            else Article.NotHelpfulCount++;
            hasSubmittedFeedback = true;
        }
    }
}
