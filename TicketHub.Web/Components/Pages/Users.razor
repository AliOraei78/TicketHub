@page "/users"
@rendermode InteractiveServer
@using TicketHub.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using UserEntity = TicketHub.Core.Entities.User
@using TicketHub.Core.Entities
@inject AppDbContext DbContext

<PageTitle>مدیریت کاربران | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-8" dir="rtl">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">مدیریت کاربران</h1>
            <p class="text-sm text-gray-500 mt-1">مشاهده لیست کاربران سیستم و دسترسی‌ها.</p>
        </div>
    </div>

    @if (users == null)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-right">
                    <thead class="bg-gray-50/50 border-b border-gray-100">
                        <tr>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-600">نام کاربر</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-600">ایمیل</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-600">نقش</th>
                            <th class="px-6 py-4 text-sm font-semibold text-gray-600 text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var user in users)
                        {
                            <tr class="hover:bg-gray-50/50 smooth-transition group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center font-bold shadow-sm">
                                            @(string.IsNullOrEmpty(user.Name) ? "U" : user.Name.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="font-medium text-gray-800">@user.Name</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-500" dir="ltr">@user.Email</td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-xs font-semibold border border-blue-100">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <button @onclick="() => OpenEditModal(user)"
                                            class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-700 text-sm font-medium px-4 py-2 rounded-xl hover:bg-indigo-50">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 5.232z" />
                                        </svg>
                                        ویرایش
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!users.Any())
            {
                <div class="text-center py-10 text-sm text-gray-500">هیچ کاربری در سیستم ثبت نشده است.</div>
            }
        </div>
    }
</div>

<!-- Edit Modal -->
@if (showEditModal && editingUser != null)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl shadow-xl max-w-2xl w-full max-h-[92vh] overflow-hidden">
            <div class="px-8 py-6 border-b flex items-center justify-between">
                <h2 class="text-2xl font-bold text-gray-800">ویرایش اطلاعات کاربر</h2>
                <button @onclick="CloseEditModal" class="text-3xl text-gray-400 hover:text-gray-600">×</button>
            </div>

            <div class="p-8 space-y-8 overflow-y-auto" style="max-height: calc(92vh - 180px);">
                <!-- Basic Info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">نام کاربر</label>
                        <input type="text" @bind="editingUser.Name" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">ایمیل</label>
                        <input type="email" @bind="editingUser.Email" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" dir="ltr" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">شماره تلفن</label>
                        <input type="tel" @bind="editingUser.PhoneNumber" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" dir="ltr" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">رمز عبور جدید (اختیاری)</label>
                        <input type="password" @bind="newPassword" placeholder="خالی بگذارید اگر تغییری نمی‌خواهید"
                               class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" />
                    </div>
                </div>

                <!-- Roles Multi-Select -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">نقش‌ها</label>
                    <div class="relative">
                        <input type="text" @bind="roleSearch" @onfocus="() => showRoleDropdown = true" placeholder="جستجو و انتخاب نقش..."
                               class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" />
                        @if (showRoleDropdown)
                        {
                            <div class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-2xl shadow-lg max-h-60 overflow-auto py-1">
                                @foreach (var role in availableRoles.Where(r => string.IsNullOrEmpty(roleSearch) || r.Name.Contains(roleSearch, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <div @onclick="() => ToggleRole(role.Name)" class="px-4 py-3 hover:bg-gray-100 cursor-pointer flex items-center gap-3">
                                        <input type="checkbox" checked="@SelectedRoles.Contains(role.Name)" class="w-4 h-4" />
                                        <span>@role.Name</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="flex flex-wrap gap-2 mt-3">
                        @foreach (var role in SelectedRoles)
                        {
                            <span class="bg-indigo-100 text-indigo-700 px-3 py-1 rounded-xl text-sm flex items-center">
                                @role <button @onclick="() => RemoveRole(role)" class="ml-2 text-indigo-500">×</button>
                            </span>
                        }
                    </div>
                </div>

                <!-- Projects Multi-Select -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">پروژه‌ها</label>
                    <div class="relative">
                        <input type="text" @bind="projectSearch" @onfocus="() => showProjectDropdown = true" placeholder="جستجو و انتخاب پروژه..."
                               class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-indigo-500" />
                        @if (showProjectDropdown)
                        {
                            <div class="absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-2xl shadow-lg max-h-60 overflow-auto py-1">
                                @foreach (var proj in availableProjects.Where(p => string.IsNullOrEmpty(projectSearch) || p.Name.Contains(projectSearch, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <div @onclick="() => ToggleProject(proj.Id)" class="px-4 py-3 hover:bg-gray-100 cursor-pointer flex items-center gap-3">
                                        <input type="checkbox" checked="@SelectedProjectIds.Contains(proj.Id)" class="w-4 h-4" />
                                        <span>@proj.Name</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="flex flex-wrap gap-2 mt-3">
                        @foreach (var projId in SelectedProjectIds)
                        {
                            var proj = availableProjects.FirstOrDefault(p => p.Id == projId);
                            if (proj != null)
                            {
                                <span class="bg-emerald-100 text-emerald-700 px-3 py-1 rounded-xl text-sm flex items-center">
                                    @proj.Name <button @onclick="() => RemoveProject(projId)" class="ml-2 text-emerald-500">×</button>
                                </span>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="px-8 py-6 border-t bg-gray-50 flex gap-3 rounded-b-3xl">
                <button @onclick="SaveUserChanges" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3.5 rounded-2xl">ذخیره تغییرات</button>
                <button @onclick="CloseEditModal" class="flex-1 border border-gray-300 hover:bg-gray-100 font-medium py-3.5 rounded-2xl">انصراف</button>
            </div>
        </div>
    </div>
}

@code {
    private List<UserEntity>? users;
    private UserEntity? editingUser;
    private bool showEditModal = false;
    private string newPassword = string.Empty;

    private List<Role> availableRoles = new();
    private List<Project> availableProjects = new();

    private List<string> SelectedRoles { get; set; } = new();
    private List<int> SelectedProjectIds { get; set; } = new();

    private string roleSearch = string.Empty;
    private string projectSearch = string.Empty;
    private bool showRoleDropdown = false;
    private bool showProjectDropdown = false;

    protected override async Task OnInitializedAsync()
    {
        users = await DbContext.Users.ToListAsync();
        await LoadAvailableData();
    }

    private async Task LoadAvailableData()
    {
        availableRoles = await DbContext.Roles.ToListAsync();
        availableProjects = await DbContext.Projects.ToListAsync();
    }

    private async Task OpenEditModal(UserEntity user)
    {
        editingUser = new UserEntity
        {
            Id = user.Id,
            Name = user.Name,
            Email = user.Email,
            PhoneNumber = user.PhoneNumber,
            CreatedAt = user.CreatedAt
        };

        newPassword = string.Empty;
        roleSearch = string.Empty;
        projectSearch = string.Empty;
        showRoleDropdown = false;
        showProjectDropdown = false;

        SelectedRoles = string.IsNullOrEmpty(user.Role) ? new() : new List<string> { user.Role };

        SelectedProjectIds = await DbContext.UserProjects
            .Where(up => up.UserId == user.Id)
            .Select(up => up.ProjectId)
            .ToListAsync();

        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        showRoleDropdown = false;
        showProjectDropdown = false;
        editingUser = null;
    }

    private void ToggleRole(string roleName)
    {
        if (SelectedRoles.Contains(roleName))
            SelectedRoles.Remove(roleName);
        else
            SelectedRoles.Add(roleName);
    }

    private void RemoveRole(string roleName) => SelectedRoles.Remove(roleName);

    private void ToggleProject(int projectId)
    {
        if (SelectedProjectIds.Contains(projectId))
            SelectedProjectIds.Remove(projectId);
        else
            SelectedProjectIds.Add(projectId);
    }

    private void RemoveProject(int projectId) => SelectedProjectIds.Remove(projectId);

    private async Task SaveUserChanges()
    {
        if (editingUser == null) return;

        var userInDb = await DbContext.Users.FindAsync(editingUser.Id);
        if (userInDb == null) return;

        // Update basic info
        userInDb.Name = editingUser.Name;
        userInDb.Email = editingUser.Email;
        userInDb.PhoneNumber = editingUser.PhoneNumber;

        if (!string.IsNullOrWhiteSpace(newPassword))
            userInDb.Password = newPassword; // TODO: Hash in real app

        // Update Role (first one or joined)
        userInDb.Role = SelectedRoles.Any() ? string.Join(",", SelectedRoles) : "User";

        // Update UserProjects (Many-to-Many)
        var currentProjects = await DbContext.UserProjects.Where(up => up.UserId == userInDb.Id).ToListAsync();
        DbContext.UserProjects.RemoveRange(currentProjects);

        foreach (var projId in SelectedProjectIds)
        {
            DbContext.UserProjects.Add(new UserProject
            {
                UserId = userInDb.Id,
                ProjectId = projId
            });
        }

        await DbContext.SaveChangesAsync();

        // Refresh list
        users = await DbContext.Users.ToListAsync();
        CloseEditModal();
    }
}