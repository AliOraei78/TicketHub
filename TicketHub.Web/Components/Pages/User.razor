@page "/user"
@rendermode InteractiveServer
@using TicketHub.Core.Entities
@using TicketSystem.Application.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using TicketHub.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using UserEntity = TicketHub.Core.Entities.User
@inject ITicketService TicketService
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>پروفایل کاربری | سامانه تیکتینگ</PageTitle>

<div class="container mx-auto p-4 md:p-8" dir="rtl">
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">پروفایل کاربری</h1>
        <p class="text-sm text-gray-500 mt-1">مشاهده اطلاعات و مدیریت نقش حساب کاربری.</p>
    </div>

    @if (currentUser == null)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
        </div>
    }
    else
    {
        <!-- User Info Card -->
        <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100 mb-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative">

            @if (isEditingRole)
            {
                <div class="absolute inset-0 bg-white/90 backdrop-blur-sm z-10 rounded-3xl flex items-center justify-center border border-indigo-200">
                    <div class="flex items-center gap-3 p-4">
                        <span class="text-sm font-medium">انتخاب نقش جدید:</span>
                        <select @bind="selectedRole" class="block w-48 px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                            <option value="">-- انتخاب کنید --</option>
                            @foreach (var role in availableRoles)
                            {
                                <option value="@role.Name">@role.Name</option>
                            }
                        </select>
                        <button @onclick="SaveRole" class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-sm font-medium hover:bg-indigo-700 smooth-transition">ذخیره</button>
                        <button @onclick="() => isEditingRole = false" class="px-4 py-2 bg-gray-100 text-gray-600 rounded-xl text-sm font-medium hover:bg-gray-200 smooth-transition">انصراف</button>
                    </div>
                </div>
            }

            <div class="flex items-center gap-5">
                <div class="w-16 h-16 bg-indigo-600 text-white rounded-2xl flex items-center justify-center text-2xl font-black shadow-lg shadow-indigo-500/20">
                    @(currentUser.Name.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800">@currentUser.Name</h2>
                    <p class="text-sm text-gray-400 mt-0.5">@currentUser.Email</p>
                </div>
            </div>

            <div class="flex flex-wrap gap-3 w-full md:w-auto">
                <div class="bg-gray-50 px-4 py-2.5 rounded-xl border border-gray-100 text-center flex-1 md:flex-initial relative group">
                    <span class="block text-xs text-gray-400 font-medium">نقش کاربری</span>                

                    <!-- Edit Role Button -->
                    <button @onclick="() => isEditingRole = true" class="absolute -top-2 -right-2 bg-white border border-gray-200 p-1.5 rounded-full text-gray-400 hover:text-indigo-600 hover:border-indigo-200 shadow-sm smooth-transition opacity-0 group-hover:opacity-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- User's Tickets Section -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-6 border-b border-gray-50 bg-gray-50/50 flex justify-between items-center">
                <h3 class="font-bold text-gray-800 text-lg">تیکت‌های ارسالی من</h3>
                <span class="text-xs bg-indigo-50 text-indigo-600 font-semibold px-3 py-1 rounded-full">
                    تعداد: @userTickets.Count()
                </span>
            </div>

            <div class="p-6">
                @if (!userTickets.Any())
                {
                    <div class="text-center py-12 text-gray-400 text-sm">
                        شما تاکنون هیچ تیکتی ثبت نکرده‌اید.
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 gap-4">
                        @foreach (var ticket in userTickets)
                        {
                            <div @onclick="() => NavigateToDetails(ticket.Id)" class="p-5 bg-white rounded-2xl border border-gray-100 hover:shadow-md hover:border-indigo-100 cursor-pointer smooth-transition flex flex-col md:flex-row justify-between md:items-center gap-4 group">
                                <div class="flex items-start gap-4">
                                    <div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl group-hover:scale-105 smooth-transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" /></svg>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-gray-800 text-base group-hover:text-indigo-600 smooth-transition">@ticket.Title</h4>
                                        <p class="text-sm text-gray-500 mt-1 line-clamp-1">@ticket.Description</p>
                                        <div class="flex items-center gap-3 mt-2 text-xs text-gray-400">
                                            <span>پروژه: @(ticket.Project?.Name ?? "عمومی")</span>
                                            <span>•</span>
                                            <span>@ticket.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2 justify-end">
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold @GetPriorityClass(ticket.Priority)">
                                        @ticket.Priority
                                    </span>
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold @GetStatusClass(ticket.Status)">
                                        @(ticket.Status == "Open" ? "باز" : "بسته شده")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Using UserEntity alias to avoid conflict with TicketHub.Web.Components.Pages.User
    private UserEntity? currentUser;
    private IEnumerable<Ticket> userTickets = new List<Ticket>();

    // Role management state
    private List<Role> availableRoles = new();
    private bool isEditingRole = false;
    private string selectedRole = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;
        var userClaims = authState.User;

        var userIdString = userClaims.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (int.TryParse(userIdString, out var currentUserId))
        {
            // Fetch real user from DB
            currentUser = await DbContext.Users.FirstOrDefaultAsync(u => u.Id == currentUserId);

            if (currentUser != null)
            {
                var allTickets = await TicketService.GetAllTicketsAsync();
                userTickets = allTickets.Where(t => t.UserId == currentUserId).OrderByDescending(t => t.CreatedAt);
            }
        }

        // Fetch available roles for dropdown
        availableRoles = await DbContext.Roles.ToListAsync();
    }

    private async Task SaveRole()
    {
        if (currentUser != null && !string.IsNullOrEmpty(selectedRole))
        {
            // Update user role in DB         
            DbContext.Users.Update(currentUser);
            await DbContext.SaveChangesAsync();

            isEditingRole = false;
        }
    }

    private void NavigateToDetails(int id)
    {
        Navigation.NavigateTo($"/tickets/{id}");
    }

    private string GetPriorityClass(string priority) => priority switch
    {
        "Low" => "bg-blue-50 text-blue-600",
        "Medium" => "bg-amber-50 text-amber-600",
        "High" => "bg-orange-50 text-orange-600",
        "Critical" => "bg-rose-50 text-rose-600",
        _ => "bg-gray-50 text-gray-600"
    };

    private string GetStatusClass(string status) => status switch
    {
        "Open" => "bg-emerald-100 text-emerald-800",
        "Closed" => "bg-gray-100 text-gray-600",
        _ => "bg-gray-100 text-gray-600"
    };
}