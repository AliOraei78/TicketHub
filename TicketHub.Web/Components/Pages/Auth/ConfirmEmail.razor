@page "/confirm-email"
@using TicketHub.Web.Components.Pages.Auth.Shared
@using TicketHub.Application.Models
@layout TicketHub.Web.Components.Layout.AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<AuthBackground ShowHeader="false">
    <VerificationUI TModel="VerifyViewModel"
                    Model="verifyModel"
                    FormName="verifyForm"
                    IsSuccess="isSuccess"
                    IsProcessing="isProcessing"
                    ErrorMessage="@errorMessage"
                    SuccessMessage="@successMessage"
                    SubmitButtonText="تایید حساب کاربری"
                    OnValidSubmit="VerifyCode">
        <SuccessTemplate>
            <div class="text-center">
                <div class="text-emerald-400 mb-4 bg-emerald-400/10 w-20 h-20 rounded-full flex items-center justify-center mx-auto">
                    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">حساب کاربری تایید شد</h3>
                <p class="text-slate-400 mb-6 leading-relaxed">
                    ایمیل شما با موفقیت تایید شد.<br />
                    تا <span class="font-bold text-blue-400 text-lg">@redirectCountdown ثانیه</span> دیگر به صفحه ورود منتقل می‌شوید...
                </p>
                <a href="/login" class="inline-flex justify-center items-center py-3 px-6 rounded-2xl text-sm font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 transition-all shadow-lg w-full">
                    بازگشت به صفحه ورود
                </a>
            </div>
        </SuccessTemplate>
        <HeaderTemplate>
            <div class="text-center">
                <h3 class="text-2xl font-bold text-white mb-2">تایید ایمیل</h3>
                <p class="text-slate-400 mb-6">کد ۶ رقمی ارسال شده به <strong>@Email</strong> را وارد کنید.</p>
            </div>
        </HeaderTemplate>
        <FormFields>
            <CustomAuthInput @bind-Value="verifyModel.Code"
                             Placeholder="------"
                             Dir="ltr"
                             ValidationFor="() => verifyModel.Code" />
        </FormFields>
        <TimerSection>
            @if (_remainingSeconds > 0)
            {
                <p class="text-sm text-slate-400">
                    زمان باقی‌مانده تا انقضای کد: <span class="text-blue-400 font-mono font-bold">@TimeSpan.FromSeconds(_remainingSeconds).ToString(@"mm\:ss")</span>
                </p>
            }
            else
            {
                <p class="text-sm text-rose-400 mb-2">کد منقضی شده است.</p>
                <button type="button" @onclick="ResendCode" disabled="@isProcessing" class="text-sm text-blue-400 hover:text-blue-300 font-bold transition-colors">
                    ارسال مجدد کد تایید
                </button>
            }
        </TimerSection>
    </VerificationUI>
</AuthBackground>