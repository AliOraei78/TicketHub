@page "/register"
@layout TicketHub.Web.Components.Layout.AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>ثبت‌نام در سامانه | تیکت‌هاب</PageTitle>

<HeadContent>
    <meta name="description" content="ثبت‌نام و عضویت در سامانه هوشمند مدیریت تیکت و پشتیبانی TicketHub. ایجاد حساب کاربری برای پیگیری سریع درخواست‌ها." />
    <meta property="og:title" content="ثبت‌نام در سامانه | تیکت‌هاب" />
    <meta property="og:description" content="ثبت‌نام در پلتفرم جامع تیکتینگ و گردش‌کار سازمانی TicketHub." />
    <link rel="canonical" href="/register" />
</HeadContent>

<AuthBackground Title="ایجاد حساب کاربری"
                Subtitle="اطلاعات خود را جهت ثبت‌نام و فعال‌سازی حساب کاربری وارد نمایید."
                ShowcaseTitle="به جامعه هوشمند تیکت‌هاب بپیوندید"
                ShowcaseSubtitle="زیرساخت قدرتمند تیکتینگ و گردش کار هوشمند متناسب با استانداردهای نوین سازمان‌ها">

    @if (showSuccessMessage)
    {
        <div class="mb-4">
            <AlertMessage Message="ثبت‌نام با موفقیت انجام شد. کد تایید به آدرس ایمیل شما ارسال گردید." Type="AlertMessage.AlertType.Success" />
        </div>
    }

    <GenericAuthForm TModel="RegisterViewModel"
                     Model="registerModel"
                     OnValidSubmit="HandleRegister"
                     FormName="registerForm"
                     ErrorMessage="@errorMessage"
                     IsLoading="isLoading"
                     LoadingText="در حال ساخت حساب..."
                     SubmitButtonText="تکمیل ثبت‌نام و دریافت کد تایید">

        <!-- سطر اول: نام و نام خانوادگی + شماره تماس -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <CustomAuthInput @bind-Value="registerModel.Name"
                             Label="نام و نام خانوادگی"
                             Placeholder="مثال: علی محمدی"
                             ValidationFor="() => registerModel.Name">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </Icon>
            </CustomAuthInput>

            <CustomAuthInput @bind-Value="registerModel.PhoneNumber"
                             Label="شماره همراه"
                             Type="tel"
                             Placeholder="09123456789"
                             Dir="ltr"
                             ValidationFor="() => registerModel.PhoneNumber">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                </Icon>
            </CustomAuthInput>
        </div>

        <!-- سطر دوم: آدرس ایمیل -->
        <CustomAuthInput @bind-Value="registerModel.Email"
                         Label="آدرس ایمیل سازمانی"
                         Type="email"
                         Placeholder="name@company.com"
                         Dir="ltr"
                         ValidationFor="() => registerModel.Email">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                </svg>
            </Icon>
        </CustomAuthInput>

        <!-- سطر سوم: رمز عبور و تکرار رمز عبور -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <CustomAuthInput @bind-Value="registerModel.Password"
                             Label="رمز عبور"
                             Type="password"
                             Placeholder="••••••••"
                             Dir="ltr"
                             ValidationFor="() => registerModel.Password">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </Icon>
            </CustomAuthInput>

            <CustomAuthInput @bind-Value="registerModel.ConfirmPassword"
                             Label="تکرار رمز عبور"
                             Type="password"
                             Placeholder="••••••••"
                             Dir="ltr"
                             ValidationFor="() => registerModel.ConfirmPassword">
                <Icon>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </Icon>
            </CustomAuthInput>
        </div>

        <!-- نوار تحلیل زنده قدرت رمز عبور -->
        <PasswordStrengthMeter Password="@registerModel.Password" />

        <!-- کپچای هوشمند -->
        <CaptchaView />

    </GenericAuthForm>

    <!-- فوتر هدایت به لاگین -->
    <div class="mt-6 pt-5 border-t border-white/[0.08] text-center">
        <p class="text-xs text-slate-400">
            قبلاً در سامانه عضو شده‌اید؟
            <a href="/login" class="font-bold text-cyan-400 hover:text-cyan-300 transition-colors inline-flex items-center gap-1 mr-1">
                <span>ورود به حساب</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </a>
        </p>
    </div>
</AuthBackground>