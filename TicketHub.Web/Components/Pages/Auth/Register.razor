@page "/register"
@layout TicketHub.Web.Components.Layout.AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using TicketHub.Web.Components.Pages.Auth.Shared
@using TicketHub.Application.Models
@using TicketHub.Web.Components.Shared

<AuthBackground Title="ایجاد حساب کاربری" Subtitle="به خانواده تیکت‌هاب بپیوندید">

    @* پیام موفقیت چون در فرم جنریک نیست، اینجا اضافه می‌شود *@
    @if (showSuccessMessage)
    {
        <AlertMessage Message="ثبت‌نام با موفقیت انجام شد. لینک تایید به ایمیل شما ارسال گردید." Type="AlertMessage.AlertType.Success" />
    }

    <GenericAuthForm TModel="RegisterViewModel"
                     Model="registerModel"
                     OnValidSubmit="HandleRegister"
                     FormName="registerForm"
                     ErrorMessage="@errorMessage"
                     IsLoading="isLoading"
                     LoadingText="در حال ثبت‌نام..."
                     SubmitButtonText="ثبت‌نام در سامانه">

        <CustomAuthInput @bind-Value="registerModel.Name" Label="نام و نام خانوادگی" Placeholder="مثال: علی محمدی" ValidationFor="() => registerModel.Name" />
        <CustomAuthInput @bind-Value="registerModel.Email" Label="آدرس ایمیل" Type="text" Placeholder="name@company.com" Dir="ltr" ValidationFor="() => registerModel.Email" />
        <CustomAuthInput @bind-Value="registerModel.PhoneNumber" Label="شماره تماس" Type="tel" Placeholder="09123456789" Dir="ltr" ValidationFor="() => registerModel.PhoneNumber" />
        <CustomAuthInput @bind-Value="registerModel.Password" Label="رمز عبور" Type="password" Placeholder="••••••••" Dir="ltr" ValidationFor="() => registerModel.Password" />
        <CustomAuthInput @bind-Value="registerModel.ConfirmPassword" Label="تکرار رمز عبور" Type="password" Placeholder="••••••••" Dir="ltr" ValidationFor="() => registerModel.ConfirmPassword" />

    </GenericAuthForm>

    <div class="mt-6 text-center">
        <p class="text-sm text-slate-400">
            قبلاً ثبت‌نام کرده‌اید؟
            <a href="/login" class="font-bold text-blue-400 hover:text-blue-300 transition-colors">وارد شوید</a>
        </p>
    </div>
</AuthBackground>