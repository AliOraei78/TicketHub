@page "/register"
@layout TicketHub.Web.Components.Layout.AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using TicketHub.Core.Entities
@using TicketHub.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using TicketHub.Web.Components.Shared
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject TicketHub.Core.Interfaces.IEmailService EmailService

<div class="relative min-h-screen flex items-center justify-center bg-slate-900 overflow-hidden py-12">

    <!-- Background Blobs -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-indigo-600/30 rounded-full mix-blend-screen filter blur-[100px] animate-pulse"></div>
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-blue-600/30 rounded-full mix-blend-screen filter blur-[100px] animate-pulse" style="animation-delay: 2s;"></div>

    <div class="relative z-10 w-full max-w-md px-6">

        <div class="text-center mb-8">
            <h2 class="text-3xl font-black text-white tracking-tight">ایجاد حساب کاربری</h2>
            <p class="mt-2 text-sm text-slate-400 font-medium">به خانواده تیکت‌هاب بپیوندید</p>
        </div>

        <div class="bg-slate-900/60 backdrop-blur-xl border border-slate-700/50 rounded-3xl p-8 shadow-2xl">
            <EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="registerForm" method="post">
                <DataAnnotationsValidator />

                <AlertMessage Message="@errorMessage" Type="AlertMessage.AlertType.Error" />
                <AlertMessage Message="@(showSuccessMessage ? "ثبت‌نام با موفقیت انجام شد. لینک تایید به ایمیل شما ارسال گردید." : null)" Type="AlertMessage.AlertType.Success" />

                <div class="space-y-5">
                    <!-- Name Input -->
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1.5">نام و نام خانوادگی</label>
                        <InputText @bind-Value="registerModel.Name" class="w-full px-4 py-3 bg-slate-950/50 border border-slate-700/50 rounded-2xl text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm" placeholder="مثال: علی محمدی" />
                        <ValidationMessage For="@(() => registerModel.Name)" class="text-rose-400 text-xs mt-1" />
                    </div>

                    <!-- Email Input -->
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1.5">آدرس ایمیل</label>
                        <InputText @bind-Value="registerModel.Email" type="email" class="w-full px-4 py-3 bg-slate-950/50 border border-slate-700/50 rounded-2xl text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm" placeholder="name@company.com" dir="ltr" />
                        <ValidationMessage For="@(() => registerModel.Email)" class="text-rose-400 text-xs mt-1" />
                    </div>

                    <!-- Phone Input -->
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1.5">شماره تماس</label>
                        <InputText @bind-Value="registerModel.PhoneNumber" type="tel" class="w-full px-4 py-3 bg-slate-950/50 border border-slate-700/50 rounded-2xl text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm" placeholder="09123456789" dir="ltr" />
                        <ValidationMessage For="@(() => registerModel.PhoneNumber)" class="text-rose-400 text-xs mt-1" />
                    </div>

                    <!-- Password Input -->
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-1.5">رمز عبور</label>
                        <InputText @bind-Value="registerModel.Password" type="password" class="w-full px-4 py-3 bg-slate-950/50 border border-slate-700/50 rounded-2xl text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm" placeholder="••••••••" dir="ltr" />
                        <ValidationMessage For="@(() => registerModel.Password)" class="text-rose-400 text-xs mt-1" />
                    </div>

                    <div class="pt-2">
                        <button type="submit" class="w-full flex justify-center items-center gap-2 py-3 px-4 rounded-2xl text-sm font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 focus:outline-none focus:ring-4 focus:ring-blue-500/30 transition-all shadow-lg shadow-blue-500/25">
                            ثبت‌نام در سامانه
                        </button>
                    </div>
                </div>
            </EditForm>

            <div class="mt-6 text-center">
                <p class="text-sm text-slate-400">
                    قبلاً ثبت‌نام کرده‌اید؟
                    <a href="/login" class="font-bold text-blue-400 hover:text-blue-300 transition-colors">وارد شوید</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterViewModel registerModel { get; set; } = new();

    private string? errorMessage;
    private bool showSuccessMessage = false;

    // در متد HandleRegister داخل register.razor
    private async Task HandleRegister()
    {
        try
        {
            if (await DbContext.Users.AnyAsync(u => u.Email == registerModel.Email))
            {
                errorMessage = "این ایمیل قبلاً ثبت شده است.";
                return;
            }

            string hashedPassword = BCrypt.Net.BCrypt.HashPassword(registerModel.Password);

            // تولید کد ۶ رقمی تصادفی
            string rawCode = new Random().Next(100000, 999999).ToString();
            string hashedCode = BCrypt.Net.BCrypt.HashPassword(rawCode);

            var newUser = new User
            {
                Name = registerModel.Name,
                Email = registerModel.Email,
                PhoneNumber = registerModel.PhoneNumber,
                Password = hashedPassword,
                CreatedAt = DateTime.UtcNow,
                IsConfirmed = false,
                ConfirmationToken = hashedCode,
                // تنظیم انقضا از همان ابتدا روی 2 دقیقه
                TokenExpiration = DateTime.UtcNow.AddMinutes(2)
            };

            DbContext.Users.Add(newUser);
            await DbContext.SaveChangesAsync();

            var defaultRole = await DbContext.Roles.FirstOrDefaultAsync(r => r.Name == "User");
            if (defaultRole != null)
            {
                DbContext.UserRoles.Add(new UserRole { UserId = newUser.Id, RoleId = defaultRole.Id });
                await DbContext.SaveChangesAsync();
            }

            string emailBody = $@"
            <div style='font-family: Tahoma, Arial, sans-serif; direction: rtl; text-align: right;'>
                <h2>خوش آمدید، {newUser.Name}!</h2>
                <p>کد تایید حساب کاربری شما:</p>
                <h1 style='letter-spacing: 5px; color: #2563eb;'>{rawCode}</h1>
                <p style='margin-top: 20px; font-size: 12px; color: #666;'>این کد تا ۲ دقیقه معتبر است.</p>
            </div>";

            await EmailService.SendEmailAsync(newUser.Email, "کد تایید حساب کاربری در تیکت‌هاب", emailBody);

            Navigation.NavigateTo($"/confirm-email?email={newUser.Email}");
        }
        catch (NavigationException)
        {
            // این خطا نیست! مکانیزم Blazor برای ریدایرکت است و باید رها شود
            throw;
        }
        catch (Exception)
        {
            errorMessage = "خطایی در پردازش اطلاعات رخ داد.";
        }
    }
    public class RegisterViewModel
    {
        [Required(ErrorMessage = "وارد کردن نام الزامی است.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "وارد کردن ایمیل الزامی است.")]
        [EmailAddress(ErrorMessage = "فرمت ایمیل نامعتبر است.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "وارد کردن شماره تماس الزامی است.")]
        [RegularExpression(@"^09\d{9}$", ErrorMessage = "شماره تماس باید ۱۱ رقم باشد و با 09 شروع شود.")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "وارد کردن رمز عبور الزامی است.")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$",
            ErrorMessage = "رمز عبور باید حداقل ۸ کاراکتر شامل حروف بزرگ و کوچک انگلیسی، عدد و کاراکتر ویژه (مانند !@#$) باشد.")]
        public string Password { get; set; } = "";
    }
}