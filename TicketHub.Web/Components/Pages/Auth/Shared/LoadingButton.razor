<button type="@Type"
        disabled="@Disabled"
        class="@CssClass"
        onclick="showLoadingState(this, '@LoadingText')">
    @ChildContent
</button>

<script>
    function showLoadingState(btn, text) {
        setTimeout(() => {
            const form = btn.closest('form');
            if (!form || form.checkValidity()) {
                btn.style.pointerEvents = 'none';
                btn.classList.add('opacity-75');

                // حذف سه نقطه از انتهای متن
                const cleanText = text.replace(/\.+$/, '').trim();

                // جابجایی متن و انیمیشن + کوچکتر کردن سایز (w-1 h-1)
                btn.innerHTML = `
                    <span>${cleanText}</span>
                    <div class="flex items-center gap-1 mr-2" dir="ltr">
                        <span class="w-1 h-1 bg-white rounded-full loading-dot" style="animation-delay: 0s;"></span>
                        <span class="w-1 h-1 bg-white rounded-full loading-dot" style="animation-delay: 0.2s;"></span>
                        <span class="w-1 h-1 bg-white rounded-full loading-dot" style="animation-delay: 0.4s;"></span>
                    </div>
                `;
            }
        }, 10);
    }
</script>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "submit";
    [Parameter] public string LoadingText { get; set; } = "در حال پردازش...";
    [Parameter] public string CssClass { get; set; } = "w-full flex justify-center items-center gap-2.5 py-3.5 px-4 rounded-2xl text-sm font-bold text-white bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-400 hover:via-blue-500 hover:to-indigo-500 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 transition-all shadow-[0_0_20px_rgba(56,189,248,0.35)] hover:shadow-[0_0_30px_rgba(56,189,248,0.6)] hover:scale-[1.01] active:scale-[0.99] disabled:opacity-75 disabled:cursor-not-allowed cursor-pointer";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}