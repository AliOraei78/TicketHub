@namespace TicketHub.Web.Components.Pages.Auth.Shared

<div x-data="{
        pass: '@(Password ?? "")',
        get len() { return this.pass.length >= 8; },
        get mixed() { return /[a-z]/.test(this.pass) && /[A-Z]/.test(this.pass); },
        get num() { return /[0-9]/.test(this.pass); },
        get spec() { return /[^a-zA-Z0-9]/.test(this.pass); },
        get score() {
            if (!this.pass) return 0;
            let s = 0;
            if (this.len) s++;
            if (this.mixed) s++;
            if (this.num) s++;
            if (this.spec) s++;
            return s;
        },
        get label() {
            if (!this.pass) return '';
            return ['خیلی ضعیف', 'ضعیف', 'متوسط', 'خوب', 'بسیار قوی و امن 🛡️'][this.score] || '';
        },
        get textColor() {
            if (this.score <= 1) return 'text-rose-400';
            if (this.score === 2) return 'text-amber-400';
            if (this.score === 3) return 'text-cyan-400';
            return 'text-emerald-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)]';
        },
        get barColor() {
            if (this.score <= 1) return 'bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.6)]';
            if (this.score === 2) return 'bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]';
            if (this.score === 3) return 'bg-cyan-400 shadow-[0_0_8px_rgba(56,189,248,0.6)]';
            return 'bg-emerald-400 shadow-[0_0_10px_rgba(16,185,129,0.8)]';
        }
    }"
    x-init="
        const form = $el.closest('form');
        const passInput = form ? form.querySelector('input[type=password]') : document.querySelector('input[type=password]');
        if (passInput) {
            pass = passInput.value || pass;
            passInput.addEventListener('input', (e) => { pass = e.target.value; });
        }
    "
    class="mt-2 space-y-2 select-none"
    x-show="pass.length > 0"
    style="@(string.IsNullOrEmpty(Password) ? "display: none;" : null)">

    <!-- Top Score Bar & Status Text -->
    <div class="flex items-center justify-between text-xs">
        <span class="text-slate-400 font-medium">امنیت رمز عبور:</span>
        <span class="font-bold font-mono text-xs" :class="textColor" x-text="label"></span>
    </div>

    <!-- 4-Segment Progress Bar -->
    <div class="grid grid-cols-4 gap-1.5 h-1.5 w-full bg-slate-900 rounded-full overflow-hidden p-0.5 border border-white/[0.08]">
        <div class="h-full rounded-full transition-all duration-300" :class="score >= 1 ? barColor : 'bg-transparent'"></div>
        <div class="h-full rounded-full transition-all duration-300" :class="score >= 2 ? barColor : 'bg-transparent'"></div>
        <div class="h-full rounded-full transition-all duration-300" :class="score >= 3 ? barColor : 'bg-transparent'"></div>
        <div class="h-full rounded-full transition-all duration-300" :class="score >= 4 ? barColor : 'bg-transparent'"></div>
    </div>

    <!-- Dynamic Security Criteria Checklist -->
    <div class="grid grid-cols-2 gap-1.5 pt-1 text-[11px]">
        <div class="flex items-center gap-1.5" :class="len ? 'text-emerald-400 font-medium' : 'text-slate-500'">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" x-show="len" />
                <circle cx="12" cy="12" r="9" stroke-width="2" x-show="!len" />
            </svg>
            <span>حداقل ۸ کاراکتر</span>
        </div>

        <div class="flex items-center gap-1.5" :class="mixed ? 'text-emerald-400 font-medium' : 'text-slate-500'">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" x-show="mixed" />
                <circle cx="12" cy="12" r="9" stroke-width="2" x-show="!mixed" />
            </svg>
            <span>حروف کوچک و بزرگ</span>
        </div>

        <div class="flex items-center gap-1.5" :class="num ? 'text-emerald-400 font-medium' : 'text-slate-500'">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" x-show="num" />
                <circle cx="12" cy="12" r="9" stroke-width="2" x-show="!num" />
            </svg>
            <span>شامل اعداد (0-9)</span>
        </div>

        <div class="flex items-center gap-1.5" :class="spec ? 'text-emerald-400 font-medium' : 'text-slate-500'">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" x-show="spec" />
                <circle cx="12" cy="12" r="9" stroke-width="2" x-show="!spec" />
            </svg>
            <span>نماد خاص (!@@#$%^&*)</span>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Password { get; set; }
}
