@namespace TicketHub.Web.Components.Pages.Auth.Shared
@using System.Linq.Expressions

<div class="space-y-1.5">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-xs font-bold text-slate-300">@Label</label>
    }
    <div class="field-spark-wrap relative rounded-2xl">
        <InputText Value="@Value"
                   ValueChanged="ValueChanged"
                   ValueExpression="ValueExpression"
                   type="@Type"
                   disabled="@Disabled"
                   id="@Id"
                   class="@($"w-full {(HasIcon ? "pr-11" : "pr-4")} {(IsPasswordField ? "pl-11" : "pl-4")} py-3 bg-[#030714]/80 border border-slate-700/60 hover:border-cyan-500/40 focus:border-cyan-400 rounded-2xl text-slate-100 placeholder-slate-500 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500/30 focus:shadow-[0_0_15px_rgba(56,189,248,0.25)] backdrop-blur-md")"
                   placeholder="@Placeholder"
                   dir="@Dir" />

        @if (Icon != null)
        {
            <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
                @Icon
            </div>
        }

        @if (IsPasswordField)
        {
            <button type="button"
                    tabindex="-1"
                    title="تغییر وضعیت نمایش رمز عبور"
                    onclick="const wrap = this.closest('.field-spark-wrap'); const input = wrap.querySelector('input'); const isPass = input.type === 'password'; input.type = isPass ? 'text' : 'password'; this.querySelector('.eye-open').classList.toggle('hidden', isPass); this.querySelector('.eye-closed').classList.toggle('hidden', !isPass);"
                    class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 hover:text-cyan-300 transition-colors cursor-pointer focus:outline-none z-10">
                <svg class="eye-open h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg class="eye-closed h-4.5 w-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
            </button>
        }
    </div>

    @if (ValidationFor != null && !HideInlineError)
    {
        <ValidationMessage For="ValidationFor" class="text-xs text-rose-400 mt-1" />
    }
    @if (!string.IsNullOrEmpty(HelperText))
    {
        <p class="text-[10px] text-slate-400 mt-1">@HelperText</p>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string Dir { get; set; } = "rtl";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public Expression<Func<object?>>? ValidationFor { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }
    [Parameter] public bool HideInlineError { get; set; } = false;

    private bool IsPasswordField => Type == "password";
    private bool HasIcon => Icon != null;
}