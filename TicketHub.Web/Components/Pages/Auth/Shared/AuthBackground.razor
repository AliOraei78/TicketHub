@namespace TicketHub.Web.Components.Pages.Auth.Shared

<div class="auth-split-chassis min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8 select-none relative" dir="rtl">
    <!-- Background Tactical Grid & Laser Glows -->
    <div class="fixed inset-0 pointer-events-none z-0">
        <div class="absolute inset-0 cyber-command-grid opacity-35"></div>
        <div class="absolute top-0 right-1/4 w-[600px] h-[300px] bg-indigo-600/15 blur-[150px] rounded-full"></div>
        <div class="absolute bottom-0 left-1/3 w-[500px] h-[300px] bg-cyan-600/15 blur-[150px] rounded-full"></div>
    </div>

    <!-- Main Split-Screen Chassis Container -->
    <div class="relative z-10 w-full max-w-6xl auth-glass-card rounded-3xl p-4 sm:p-6 lg:p-8 my-auto overflow-hidden">
        
        <!-- Mobile Miniature Branding Header (Hidden on Desktop) -->
        <div class="lg:hidden text-center mb-6 pt-2">
            <div class="inline-flex items-center justify-center mb-3">
                <BrandLogo Size="sm" ShowText="true" Subtitle="ENTERPRISE PORTAL" ShowPing="true" />
            </div>
            @if (!string.IsNullOrEmpty(Title))
            {
                <h2 class="text-xl font-black text-white">@Title</h2>
            }
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="text-xs text-slate-400 mt-1">@Subtitle</p>
            }
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
            <!-- Left Column: Holographic Cyber Showcase (Visible on Desktop) -->
            <div class="lg:col-span-5 h-full">
                <AuthShowcasePanel BadgeText="@BadgeText" Title="@ShowcaseTitle" Subtitle="@ShowcaseSubtitle" />
            </div>

            <!-- Right Column: Interactive Glassmorphic Form Card -->
            <div class="lg:col-span-7 flex flex-col justify-center bg-[#040817]/90 backdrop-blur-2xl border border-white/[0.08] rounded-3xl p-6 sm:p-8 lg:p-10 shadow-2xl relative overflow-hidden">
                <!-- Laser Top Edge Sweep -->
                <div class="cyber-laser-sweep"></div>

                @if (ShowHeader)
                {
                    <div class="hidden lg:block mb-6 text-right">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-[10px] font-mono font-bold text-cyan-300 mb-2">
                            <span>[AUTH // ACCESS_PANEL]</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Title))
                        {
                            <h2 class="text-2xl font-black text-white tracking-tight">@Title</h2>
                        }
                        @if (!string.IsNullOrEmpty(Subtitle))
                        {
                            <p class="text-xs text-slate-400 mt-1 font-medium leading-relaxed">@Subtitle</p>
                        }
                    </div>
                }

                @ChildContent
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool ShowLogo { get; set; } = false;
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public string BadgeText { get; set; } = "SYSTEM_SECURITY // ONLINE";
    [Parameter] public string ShowcaseTitle { get; set; } = "سامانه مدیریت یکپارچه تیکت‌هاب";
    [Parameter] public string ShowcaseSubtitle { get; set; } = "دسترسی ایمن و پرسرعت به پنل هوشمند پشتیبانی و عملیات سازمان";
}