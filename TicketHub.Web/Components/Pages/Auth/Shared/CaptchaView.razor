<div class="flex flex-col gap-2 my-3">
    <label class="text-xs text-slate-300">کد امنیتی</label>

    <div class="flex items-center gap-2">
        <!-- باکس تصویر کپچا -->
        <div class="bg-slate-800 p-1 rounded-xl border border-slate-700 flex items-center justify-center min-w-[120px] h-[50px] overflow-hidden">
            <img id="dntCaptchaImg" src="" alt="کد امنیتی" class="w-full h-full object-cover cursor-pointer" onclick="loadDntCaptcha()" title="برای تغییر کپچا کلیک کنید" />
        </div>

        <!-- دکمه رفرش (دریافت مجدد تصویر بدون رفرش صفحه) -->
        <button type="button" onclick="loadDntCaptcha()" class="p-2.5 bg-slate-800 hover:bg-slate-700 rounded-xl border border-slate-700 text-slate-300 transition-colors" title="تغییر کد">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        </button>
    </div>

    <!-- فیلدهای مخفی برای انتقال توکن‌های رمزنگاری شده به سمت سرور -->
    <input type="hidden" id="DNTCaptchaText" name="DNTCaptchaText" />
    <input type="hidden" id="DNTCaptchaToken" name="DNTCaptchaToken" />

    <!-- فیلد ورودی کاربر -->
    <input type="text"
           id="CaptchaInputText"
           name="CaptchaInputText"
           class="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all text-left"
           placeholder="اعداد تصویر را وارد کنید"
           dir="ltr"
           autocomplete="off"
           required />
</div>