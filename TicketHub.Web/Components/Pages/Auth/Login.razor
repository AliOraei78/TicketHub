@page "/login"
@layout TicketHub.Web.Components.Layout.AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>ورود به سامانه | تیکت‌هاب</PageTitle>

<HeadContent>
    <meta name="description" content="ورود امن به سامانه جامع مدیریت تیکت و پشتیبانی TicketHub. دسترسی به پنل کارشناسان، مدیران و کاربران سازمانی." />
    <meta property="og:title" content="ورود به سامانه | تیکت‌هاب" />
    <meta property="og:description" content="ورود به درگاه امن پلتفرم مدیریت تیکت و گردش‌کارهای سازمانی تیکت‌هاب." />
    <link rel="canonical" href="/login" />
</HeadContent>

<AuthBackground Title="ورود به سامانه"
                Subtitle="اطلاعات کاربری خود را جهت احراز هویت و دسترسی به پنل وارد نمایید."
                ShowcaseTitle="سامانه مدیریت هوشمند تیکت‌هاب"
                ShowcaseSubtitle="پلتفرم یکپارچه عملیات پشتیبانی سازمانی، گردش کار اتوماتیک و امنیت چندلایه">

    @if (SsoOptions?.Value?.Enabled == true)
    {
        <div class="mb-5 space-y-3">
            <a href="/auth/sso-login"
               class="w-full py-2.5 px-4 rounded-xl font-medium text-xs flex items-center justify-between transition-all duration-300 bg-gradient-to-r from-cyan-950/60 via-slate-900/80 to-blue-950/60 hover:from-cyan-900/60 hover:via-slate-800/80 hover:to-blue-900/60 border border-cyan-500/30 hover:border-cyan-400/60 text-white shadow-lg shadow-cyan-950/30 group">
                <span class="flex items-center gap-2.5">
                    <span class="p-1.5 rounded-lg bg-cyan-500/10 text-cyan-400 group-hover:bg-cyan-500/20 group-hover:scale-105 transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </span>
                    <span class="font-semibold text-slate-100">@(SsoOptions.Value.DisplayName ?? "ورود یکپارچه سازمانی (SSO)")</span>
                </span>
                <span class="text-[10px] uppercase font-bold tracking-wider bg-cyan-500/20 text-cyan-300 px-2 py-0.5 rounded border border-cyan-400/30">
                    @(SsoOptions.Value.ProviderName ?? "SSO")
                </span>
            </a>

            <div class="relative flex items-center justify-center pt-1">
                <div class="border-t border-white/[0.08] w-full"></div>
                <span class="bg-[#0b1120] px-3 text-[11px] text-slate-400 absolute select-none">یا ورود با مشخصات کاربری</span>
            </div>
        </div>
    }

    <GenericAuthForm TModel="LoginViewModel"
                     Model="loginModel"
                     OnValidSubmit="HandleLogin"
                     FormName="loginForm"
                     ErrorMessage="@errorMessage"
                     IsLoading="isLoading"
                     LoadingText="در حال احراز هویت..."
                     SubmitButtonText="ورود امن به سامانه">

        <!-- فیلد ایمیل -->
        <CustomAuthInput @bind-Value="loginModel.Email"
                         Label="آدرس ایمیل سازمانی"
                         Type="email"
                         Placeholder="name@company.com"
                         Dir="ltr"
                         ValidationFor="() => loginModel.Email">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                </svg>
            </Icon>
        </CustomAuthInput>

        <!-- فیلد رمز عبور -->
        <CustomAuthInput @bind-Value="loginModel.Password"
                         Label="رمز عبور"
                         Type="password"
                         Placeholder="••••••••"
                         Dir="ltr"
                         ValidationFor="() => loginModel.Password">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </Icon>
        </CustomAuthInput>

        <!-- چک‌باکس مرا به خاطر بسپار -->
        <div class="flex items-center justify-between pt-1 select-none">
            <label class="inline-flex items-center gap-2 cursor-pointer group">
                <InputCheckbox @bind-Value="loginModel.RememberMe" id="rememberMeCheckbox" class="matrix-checkbox w-4.5 h-4.5" />
                <span class="text-xs text-slate-400 group-hover:text-slate-200 transition-colors">مرا به خاطر بسپار</span>
            </label>

            <span class="text-[11px] font-medium text-cyan-400/80 bg-cyan-950/40 px-2 py-0.5 rounded border border-cyan-500/20 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span>ارتباط امن SSL</span>
            </span>
        </div>

        <!-- کپچای هوشمند سایبری -->
        <CaptchaView />

    </GenericAuthForm>

    <!-- فوتر هدایت به ثبت نام و راهنما -->
    <div class="mt-6 pt-5 border-t border-white/[0.08] text-center space-y-3">
        <p class="text-xs text-slate-400">
            حساب کاربری فعال ندارید؟
            <a href="/register" class="font-bold text-cyan-400 hover:text-cyan-300 transition-colors inline-flex items-center gap-1 mr-1">
                <span>ثبت‌نام در سامانه</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </a>
        </p>

        <div class="pt-2 border-t border-white/[0.04] flex items-center justify-center gap-4 text-[11px] text-slate-500">
            <a href="/kb" class="hover:text-cyan-300 transition-colors flex items-center gap-1">
                <span>📖 پایگاه دانش و راهنما</span>
            </a>
            <span>•</span>
            <a href="/faq" class="hover:text-cyan-300 transition-colors flex items-center gap-1">
                <span>❓ سوالات متداول</span>
            </a>
        </div>
    </div>
</AuthBackground>