@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TicketHub.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using TicketHub.Web.Security
@inject NavigationManager Navigation
@inject AppDbContext DbContext
@inject CustomAuthStateProvider AuthProvider

<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8" dir="rtl">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
            ورود به حساب کاربری
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
            حساب کاربری ندارید؟ <a href="/register" class="font-medium text-blue-600 hover:text-blue-500">ثبت‌نام کنید</a>
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-gray-100">
            <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="loginForm">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 p-3 bg-red-50 text-red-600 rounded-xl text-sm font-medium">
                        @errorMessage
                    </div>
                }

                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">ایمیل</label>
                        <div class="mt-1">
                            <InputText @bind-Value="loginModel.Email" type="email" class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" />
                            <ValidationMessage For="@(() => loginModel.Email)" class="text-xs text-red-500 mt-1" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">رمز عبور</label>
                        <div class="mt-1">
                            <InputText @bind-Value="loginModel.Password" type="password" class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" />
                            <ValidationMessage For="@(() => loginModel.Password)" class="text-xs text-red-500 mt-1" />
                        </div>
                    </div>

                    <div>
                        <button type="submit" disabled="@isLoading" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 smooth-transition disabled:opacity-70">
                            @if (isLoading)
                            {
                                <span class="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></span>
                            }
                            else
                            {
                                <span>ورود</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginViewModel loginModel = new();
    private bool isLoading = false;
    private string? errorMessage;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // Find user in database
            var user = await DbContext.Users.FirstOrDefaultAsync(u => u.Email == loginModel.Email);

            if (user != null)
            {
                // Verify BCrypt password
                bool isValid = BCrypt.Net.BCrypt.Verify(loginModel.Password, user.Password);

                if (isValid)
                {
                    // Create session string: Id|Name|Role
                    var sessionData = $"{user.Id}|{user.Name}|{user.Role}";
                    await AuthProvider.UpdateAuthenticationState(sessionData);

                    Navigation.NavigateTo("/", true);
                    return;
                }
            }

            errorMessage = "ایمیل یا رمز عبور اشتباه است.";
        }
        catch (Exception)
        {
            errorMessage = "خطایی رخ داد. لطفاً مجدداً تلاش کنید.";
        }
        finally
        {
            isLoading = false;
        }
    }
    private class LoginViewModel
    {
        [Required(ErrorMessage = "ایمیل الزامی است")]
        [EmailAddress(ErrorMessage = "فرمت ایمیل معتبر نیست")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "رمز عبور الزامی است")]
        public string Password { get; set; } = string.Empty;
    }
}