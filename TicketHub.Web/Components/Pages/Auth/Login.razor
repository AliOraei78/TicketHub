@page "/login"
@using TicketHub.Web.Components.Pages.Auth.Shared
@using TicketHub.Application.Models
@layout TicketHub.Web.Components.Layout.AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<AuthBackground Title="سامانه تیکت‌هاب" Subtitle="به پنل مدیریت یکپارچه خوش آمدید" ShowLogo="true">
    
    <GenericAuthForm TModel="LoginViewModel"
                     Model="loginModel"
                     OnValidSubmit="HandleLogin"
                     FormName="loginForm"
                     ErrorMessage="@errorMessage"
                     IsLoading="isLoading"
                     LoadingText="در حال ورود..."
                     SubmitButtonText="ورود به سیستم">
                     
        <CustomAuthInput @bind-Value="loginModel.Email"
                         Label="آدرس ایمیل"
                         Type="email"
                         Placeholder="name@company.com"
                         Dir="ltr"
                         ValidationFor="() => loginModel.Email">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" /></svg>
            </Icon>
        </CustomAuthInput>

        <CustomAuthInput @bind-Value="loginModel.Password"
                         Label="رمز عبور"
                         Type="password"
                         Placeholder="••••••••"
                         Dir="ltr"
                         ValidationFor="() => loginModel.Password">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
            </Icon>
        </CustomAuthInput>

        <CaptchaView />

    </GenericAuthForm>

    <div class="mt-6 text-center">
        <p class="text-sm text-slate-400">
            حساب کاربری ندارید؟
            <a href="/register" class="font-bold text-blue-400 hover:text-blue-300 transition-colors">ثبت‌نام کنید</a>
        </p>
    </div>
</AuthBackground>