@namespace TicketHub.Web.Components.Shared

<div class="flex flex-col justify-center items-center py-16 gap-3 @Class">
    <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600 shadow-2xs"></div>
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <p class="text-sm font-medium text-slate-500 animate-pulse">@Text</p>
    }
</div>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
}