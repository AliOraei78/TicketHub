@namespace TicketHub.Web.Components.Shared
@using TicketHub.Application.Interfaces
@using TicketHub.Application.Enums

<div class="fixed top-5 left-1/2 -translate-x-1/2 z-[999999] flex flex-col gap-3.5 min-w-[320px] max-w-md select-none @Class" dir="rtl">
    @foreach (var toast in ToastService.Toasts)
    {
        <div @key="toast.Id" class="relative overflow-hidden p-4 rounded-2xl shadow-2xl backdrop-blur-xl border flex items-start gap-3.5 transition-all duration-300 animate-toast-slide-in @GetCssClass(toast.Type)">
            <!-- Icon Container -->
            <div class="p-2 rounded-xl border flex-shrink-0 mt-0.5 shadow-sm">
                @if (toast.Type == ToastType.Error)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                }
                else if (toast.Type == ToastType.Warning)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                }
                else if (toast.Type == ToastType.Success)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                }
            </div>

            <!-- Content Container -->
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[9px] font-black font-mono px-1.5 py-0.5 rounded-md toast-badge">
                        @GetBadgeText(toast.Type)
                    </span>
                    @if (!string.IsNullOrEmpty(toast.Title))
                    {
                        <h4 class="text-xs font-bold text-slate-100 truncate">@toast.Title</h4>
                    }
                </div>
                <p class="text-xs font-medium leading-relaxed text-slate-300 whitespace-pre-line">@toast.Message</p>
            </div>

            <!-- Close Button -->
            <button @onclick="() => ToastService.RemoveToast(toast.Id)" class="flex-shrink-0 p-1 text-slate-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors focus-ring cursor-pointer">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- Animated Laser Progress Bar -->
            <div class="toast-progress-bar absolute bottom-0 left-0 right-0 h-0.5"></div>
        </div>
    }
</div>