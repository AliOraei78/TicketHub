@namespace TicketHub.Web.Components.Shared

<div class="relative w-full @Class" dir="rtl">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">@Label</label>
    }
    <div class="relative">
        <input id="@InputId"
               data-jdp
               type="text"
               value="@Value"
               @onchange="HandleManualChange"
               class="w-full h-[46px] pl-4 pr-10 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-sm bg-slate-50 hover:bg-white focus:bg-white text-sm focus-ring text-slate-900"
               placeholder="@(!string.IsNullOrWhiteSpace(Placeholder) ? Placeholder : (ShowTimePicker ? "انتخاب تاریخ و زمان..." : "انتخاب تاریخ..."))"
               autocomplete="off" />

        <div class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </div>
    </div>
</div>