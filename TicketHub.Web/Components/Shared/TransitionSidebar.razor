@using TicketHub.Core.Entities
@using TicketHub.Core.Common

<div class="absolute left-4 top-20 h-[calc(100vh-6rem)] w-80 bg-white border border-slate-200 rounded-2xl z-40 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.15)] transition-all duration-300 flex flex-col overflow-hidden @(Connection != null ? "translate-x-0 opacity-100" : "-translate-x-full opacity-0 pointer-events-none")">

    @if (Connection != null)
    {
        <!-- هدر با دکمه بستن جدید -->
        <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/80 flex-shrink-0">
            <h2 class="font-bold text-sm text-slate-800">مدیریت انتقال وضعیت</h2>
            <button @onclick="OnClose" class="w-8 h-8 rounded-full bg-slate-200/50 hover:bg-rose-100 hover:text-rose-600 text-slate-500 flex items-center justify-center transition-colors shadow-sm" title="بستن">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto p-5 space-y-5 custom-scrollbar">
            <div class="flex items-center justify-between bg-slate-50 p-3 rounded-xl border border-slate-200">
                <span class="text-xs font-bold text-slate-600 bg-white px-2 py-1 rounded-md shadow-sm">@GetNodeName?.Invoke(Connection.FromNodeId)</span>
                <span>-></span>
                <span class="text-xs font-bold text-slate-600 bg-white px-2 py-1 rounded-md shadow-sm">@GetNodeName?.Invoke(Connection.ToNodeId)</span>
            </div>

            <div>
                <label>عنوان انتقال</label>
                <input type="text" @bind="Connection.Name" @bind:event="oninput" class="w-full px-3 py-2.5 bg-white border border-slate-300 rounded-xl" />
            </div>

            <div class="flex items-center gap-4 pt-1">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" @bind="Connection.IsActive" class="w-4 h-4 text-blue-600 rounded border-slate-300" />
                    <span class="text-sm font-medium text-slate-700">فعال</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" @bind="Connection.IsAutomatic" class="w-4 h-4 text-blue-600 rounded border-slate-300" />
                    <span class="text-sm font-medium text-slate-700">انتقال خودکار</span>
                </label>
            </div>

            <!-- ورودی تاریخ اصلاح شده برای شمسی -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">تاریخ فعال‌سازی</label>
                <!-- از یک پلاگین JS تقویم شمسی مانند MD.BootstrapPersianDateTimePicker استفاده کنید -->
                <input type="text" dir="ltr" placeholder="1403/05/12 14:30" @bind="Connection.ActivateAt" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 focus:bg-white rounded-xl text-sm transition-colors outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500" data-jdp />
            </div>

            <div class="pt-2">
                <label class="block text-sm font-medium text-slate-700 mb-2">نقش‌های مجاز</label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var role in AvailableRoles)
                    {
                        bool hasRole = Connection.AllowedRoleIds.Contains(role.Id);
                        <button @key="role.Id" type="button" @onclick="() => OnRoleToggle.InvokeAsync(role.Id)" class="px-3 py-1.5 rounded-lg text-xs font-medium border @(hasRole ? "bg-indigo-50 border-indigo-200" : "bg-white")">
                            @role.Name
                        </button>
                    }
                </div>
            </div>

            <div class="pt-4 border-t border-slate-200">
                <div class="flex items-center justify-between mb-3">
                    <label class="block text-sm font-medium text-slate-700">فیلدهای سفارشی</label>
                    <button type="button" @onclick="AddCustomField" class="text-xs bg-blue-50 text-blue-600 px-2 py-1.5 rounded-lg hover:bg-blue-100 transition-colors font-medium">
                        + افزودن فیلد
                    </button>
                </div>

                <div class="space-y-3">
                    @if (Connection.CustomFields.Any())
                    {
                        @foreach (var field in Connection.CustomFields)
                        {
                            <div class="p-3 bg-white border border-slate-200 rounded-xl space-y-2 relative shadow-sm">
                                <button type="button" @onclick="() => RemoveCustomField(field)" class="absolute left-2 top-2 w-6 h-6 flex items-center justify-center text-rose-400 hover:text-rose-600 hover:bg-rose-50 rounded-md transition-colors" title="حذف فیلد">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                </button>

                                <div class="pr-6">
                                    <input type="text" @bind="field.FieldName" @bind:event="oninput" placeholder="عنوان فیلد" class="w-full px-2 py-1.5 text-sm bg-slate-50 border border-slate-200 focus:bg-white rounded-lg outline-none focus:border-blue-500 mb-2" />
                                    <div class="flex gap-2 items-center">
                                        <select @bind="field.FieldTypeId" class="flex-1 px-2 py-1.5 text-sm bg-slate-50 border border-slate-200 rounded-lg outline-none focus:border-blue-500">
                                            <option value="0">انتخاب نوع...</option>
                                            @foreach (var type in AvailableFieldTypes)
                                            {
                                                <option value="@type.Id">@type.Type</option>
                                            }
                                        </select>
                                        <label class="flex items-center gap-1.5 cursor-pointer">
                                            <input type="checkbox" @bind="field.IsRequired" class="w-3.5 h-3.5 text-blue-600 rounded border-slate-300" />
                                            <span class="text-xs font-medium text-slate-600">اجباری</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-200">
                <button type="button" @onclick="() => OnDelete.InvokeAsync(Connection)" class="w-full py-2.5 rounded-xl text-rose-600 bg-rose-50">حذف این مسیر</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<FieldType> AvailableFieldTypes { get; set; } = new List<FieldType>();
    [Parameter] public CanvasConnection? Connection { get; set; }
    [Parameter] public IEnumerable<Role> AvailableRoles { get; set; } = new List<Role>();
    [Parameter] public Func<Guid, string>? GetNodeName { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnRoleToggle { get; set; }
    [Parameter] public EventCallback<CanvasConnection> OnDelete { get; set; }


    private void AddCustomField()
    {
        if (Connection != null)
        {
            Connection.CustomFields.Add(new CanvasTransitionField
            {
                Id = 0,
                SortOrder = Connection.CustomFields.Count,
                IsActive = true
            });
        }
    }

    private void RemoveCustomField(CanvasTransitionField field)
    {
        Connection?.CustomFields.Remove(field);
    }
}