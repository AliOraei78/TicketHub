@namespace TicketHub.Web.Components.Shared

<div class="relative z-30 bg-[#070c1a]/90 backdrop-blur-xl p-2.5 px-4 rounded-2xl shadow-lg border border-cyan-500/25 flex flex-wrap lg:flex-nowrap gap-3 items-start justify-between select-none @Class">
    <div class="relative w-full sm:w-48 md:w-64 flex-shrink-0 flex items-start h-[46px]">
        <div class="field-spark-wrap w-full h-[46px] flex items-center">
            <div class="relative w-full h-[46px] flex items-center">
                <input type="text"
                       value="@SearchTerm"
                       @oninput="OnSearchInputChanged"
                       placeholder="@SearchPlaceholder"
                       class="w-full h-[46px] pr-11 pl-4 rounded-2xl border border-white/[0.12] bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.2)] text-sm text-slate-100 placeholder-slate-500 transition-all shadow-2xs focus-ring leading-none" />
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
        </div>
    </div>

    @if (ChildContent != null)
    {
        <div class="flex flex-wrap lg:flex-nowrap gap-3 w-full lg:w-auto items-start flex-1 min-h-[46px]">
            @ChildContent
        </div>
    }

    <div class="flex w-full sm:w-40 md:w-44 justify-end flex-shrink-0 flex items-start h-[46px]">
        <div class="field-spark-wrap relative w-full h-[46px] flex items-center select-none @(isPageSizeOpen ? "z-[250]" : "z-10")">
            <button type="button"
                    @onclick="TogglePageSizeDropdown"
                    @onblur="ClosePageSizeDropdown"
                    class="w-full h-[46px] px-4 pl-10 text-center text-sm text-slate-200 border border-white/[0.12] rounded-2xl transition-all bg-[#050811]/90 hover:bg-[#050811] hover:border-cyan-500/50 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 shadow-2xs focus-ring font-medium leading-none flex items-center justify-between cursor-pointer">
                <span class="w-full text-center truncate">@PageSize @ItemName در صفحه</span>
                <svg class="w-4 h-4 text-slate-400 transition-transform duration-300 shrink-0 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none @(isPageSizeOpen ? "rotate-180 text-cyan-400" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </button>

            <div class="dropdown-menu-container absolute top-full left-0 z-[250] w-full mt-1.5 bg-[#090e1d]/98 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.9),0_0_20px_rgba(56,189,248,0.15)] border border-cyan-500/30 overflow-hidden transition-all duration-300 backdrop-blur-2xl @(isPageSizeOpen ? "opacity-100 max-h-60" : "opacity-0 max-h-0 border-transparent pointer-events-none")">
                <ul class="py-1 custom-scrollbar max-h-52 overflow-y-auto divide-y divide-white/[0.04]">
                    @foreach (var size in PageSizeOptions)
                    {
                        <li @onmousedown="() => SelectPageSize(size)"
                            class="px-4 py-2.5 text-xs text-center cursor-pointer transition-all font-medium hover:bg-cyan-950/60 hover:text-cyan-300 @(size == PageSize ? "text-cyan-400 font-bold bg-cyan-950/40" : "text-slate-200")">
                            @size @ItemName در صفحه
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "جستجو...";
    [Parameter] public string ItemName { get; set; } = "آیتم";
    [Parameter] public List<int> PageSizeOptions { get; set; } = new() { 10, 25, 50, 100 };
    [Parameter] public string Class { get; set; } = string.Empty;

    private bool isPageSizeOpen = false;

    protected async Task OnSearchInputChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await SearchTermChanged.InvokeAsync(value);
    }

    private void TogglePageSizeDropdown()
    {
        isPageSizeOpen = !isPageSizeOpen;
    }

    private async Task ClosePageSizeDropdown()
    {
        await Task.Delay(150);
        isPageSizeOpen = false;
        StateHasChanged();
    }

    private async Task SelectPageSize(int newSize)
    {
        isPageSizeOpen = false;
        if (PageSize != newSize)
        {
            PageSize = newSize;
            await PageSizeChanged.InvokeAsync(newSize);
        }
    }
}