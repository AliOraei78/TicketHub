@namespace TicketHub.Web.Components.Shared
@typeparam TItem

<div class="w-full flex flex-col gap-3 flex-1 @Class" dir="rtl">
    @if (HeaderTemplate is not null)
    {
        @HeaderTemplate
    }

    <div class="flex flex-col gap-3">
        @if (ToolbarTemplate is not null)
        {
            @ToolbarTemplate
        }

        <div class="w-full">
            @if (ListTemplate is not null)
            {
                @ListTemplate
            }
        </div>
    </div>

    @if (PaginationTemplate is not null)
    {
        <div class="bg-white rounded-3xl p-4 border border-slate-200/80 shadow-2xs">
            @PaginationTemplate
        </div>
    }

    @if (ModalTemplate is not null)
    {
        @ModalTemplate
    }
</div>