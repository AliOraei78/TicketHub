@typeparam TItem

<div class="container mx-auto p-4 md:p-8 flex flex-col gap-3 flex-1" dir="rtl">
    @if (HeaderTemplate is not null)
    {
        @HeaderTemplate
    }

    <div class="flex flex-col gap-3">
        @if (ToolbarTemplate is not null)
        {
            @ToolbarTemplate
        }

        <div class="w-full">
            @if (ListTemplate is not null)
            {
                @ListTemplate
            }
        </div>
    </div>

    @if (PaginationTemplate is not null)
    {
        <div class="bg-white rounded-3xl p-4 border border-gray-100 shadow-sm">
            @PaginationTemplate
        </div>
    }

    @if (ModalTemplate is not null)
    {
        @ModalTemplate
    }
</div>

@code {
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public RenderFragment? ToolbarTemplate { get; set; }
    [Parameter] public RenderFragment? ListTemplate { get; set; }
    [Parameter] public RenderFragment? PaginationTemplate { get; set; }
    [Parameter] public RenderFragment? ModalTemplate { get; set; }

    [Parameter] public IEnumerable<TItem>? Items { get; set; }
}