@implements IDisposable

@namespace TicketHub.Web.Components.Shared

<div class="relative w-full h-[46px] flex items-center @Class">
    <div class="field-spark-wrap w-full h-[46px] flex items-center">
        <div class="relative w-full h-[46px] flex items-center">
            <input type="text"
                   data-search-input="true"
                   class="w-full h-[46px] pr-11 pl-8 text-sm text-slate-100 placeholder-slate-500 border border-white/[0.12] rounded-2xl bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all shadow-2xs focus-ring leading-none @InputClass"
                   placeholder="@Placeholder"
                   value="@SearchTerm"
                   @oninput="OnInputChanged" />
            <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <button type="button" 
                        @onclick="ClearSearch"
                        class="absolute inset-y-0 left-3 flex items-center text-slate-400 hover:text-cyan-300 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            }
            else
            {
                <kbd class="hidden sm:inline-flex absolute left-3 top-1/2 -translate-y-1/2 px-1.5 py-0.2 text-[10px] font-mono text-slate-400 bg-slate-900 border border-slate-700/60 rounded select-none pointer-events-none" title="کلید میانبر جستجو: /"> / </kbd>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = "جستجو...";
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string InputClass { get; set; } = string.Empty;
    [Parameter] public int DebounceInterval { get; set; } = 250;

    private System.Threading.CancellationTokenSource? _debounceCts;

    protected async Task OnInputChanged(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        if (DebounceInterval <= 0)
        {
            await OnSearchChanged.InvokeAsync(SearchTerm);
            return;
        }

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new System.Threading.CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            await Task.Delay(DebounceInterval, token);
            if (!token.IsCancellationRequested)
            {
                await OnSearchChanged.InvokeAsync(SearchTerm);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task ClearSearch()
    {
        _debounceCts?.Cancel();
        SearchTerm = string.Empty;
        await OnSearchChanged.InvokeAsync(SearchTerm);
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}