@namespace TicketHub.Web.Components.Shared

<div class="relative w-full max-w-md @Class">
    <div class="absolute inset-y-0 right-0 flex items-center pr-3.5 pointer-events-none">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
    </div>
    <input type="text"
           class="block w-full h-[46px] px-3 pr-10 text-sm text-slate-900 border border-slate-200 rounded-2xl bg-slate-50 hover:bg-white focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-sm focus-ring"
           placeholder="@Placeholder"
           value="@SearchTerm"
           @oninput="OnInputChanged" />
</div>