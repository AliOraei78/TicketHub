@namespace TicketHub.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms

<div class="mb-2 @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">@Label</label>
    }

    <div class="relative border-2 border-dashed border-slate-300 rounded-2xl p-6 hover:bg-indigo-50/50 hover:border-indigo-400 transition-all text-center bg-white shadow-2xs group focus-within:ring-2 focus-within:ring-indigo-100">
        <InputFile OnChange="HandleSelection" multiple class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.doc,.docx,.ppt,.pptx,.txt,.json" />

        <div class="pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-8 w-8 text-slate-400 group-hover:text-indigo-600 transition-colors mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <span class="block text-sm font-medium text-slate-700">برای انتخاب فایل‌ها کلیک کنید یا آن‌ها را اینجا رها کنید</span>
            <span class="block text-xs mt-1 text-slate-400 font-mono" dir="ltr">PDF, JPG, PNG, Word, Excel, PowerPoint, TXT, JSON</span>
            <span class="block text-xs mt-1.5 font-bold text-indigo-600">حداکثر مجموع حجم: ۱۰ مگابایت</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mt-2 text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-100 px-3 py-2 rounded-xl">@ErrorMessage</div>
    }

    @if (SelectedFiles.Any())
    {
        <ul class="mt-3 space-y-2">
            @foreach (var file in SelectedFiles)
            {
                <li class="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200">
                    <span class="text-xs font-medium text-slate-700 truncate max-w-[70%]" dir="ltr">@file.Name</span>
                    <div class="flex items-center gap-3">
                        <span class="text-xs text-slate-400 font-mono">@(file.Size / 1024) KB</span>
                        <button type="button" @onclick="() => RemoveFile(file)" class="text-rose-500 hover:text-rose-700 font-bold text-base leading-none focus-ring">&times;</button>
                    </div>
                </li>
            }
        </ul>
    }
</div>