@using Microsoft.AspNetCore.Components.Forms

<div class="mb-2">
    <label class="block text-sm font-medium text-gray-700 mb-2">@Label</label>

    <div class="relative border-2 border-dashed border-gray-300 rounded-2xl p-6 hover:bg-indigo-50 transition-colors text-center bg-white">
        <!-- InputFile برای آپلود چندگانه -->
        <InputFile OnChange="HandleSelection" multiple class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.doc,.docx,.ppt,.pptx,.txt,.json" />

        <div class="pointer-events-none">
            <span class="block text-sm font-medium text-gray-700">برای انتخاب فایل‌ها کلیک کنید یا آن‌ها را اینجا رها کنید</span>
            <span class="block text-xs mt-2 text-gray-500" dir="ltr">PDF, JPG, PNG, Word, Excel, PowerPoint, TXT, JSON</span>
            <span class="block text-xs mt-2 font-bold text-indigo-600">حداکثر مجموع حجم: ۱۰ مگابایت</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mt-2 text-sm text-red-600 bg-red-50 px-3 py-2 rounded-xl">@errorMessage</div>
    }

    @if (SelectedFiles.Any())
    {
        <ul class="mt-3 space-y-2">
            @foreach (var file in SelectedFiles)
            {
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-xl border border-gray-200">
                    <span class="text-sm text-gray-700 truncate max-w-[70%]" dir="ltr">@file.Name</span>
                    <div class="flex items-center gap-3">
                        <span class="text-xs text-gray-500">@(file.Size / 1024) KB</span>
                        <button type="button" @onclick="() => RemoveFile(file)" class="text-red-500 hover:text-red-700 font-bold text-lg leading-none">&times;</button>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "پیوست‌ها";

    // لیست فایل‌های خام انتخاب شده که به فرم متصل می‌شود
    [Parameter] public List<IBrowserFile> SelectedFiles { get; set; } = new();
    [Parameter] public EventCallback<List<IBrowserFile>> SelectedFilesChanged { get; set; }

    private string errorMessage = string.Empty;
    private const long MaxTotalSizeBytes = 10 * 1024 * 1024; // 10 MB
    private readonly string[] AllowedExtensions = { ".pdf", ".jpg", ".jpeg", ".png", ".xlsx", ".xls", ".doc", ".docx", ".ppt", ".pptx", ".txt", ".json" };

    private async Task HandleSelection(InputFileChangeEventArgs e)
    {
        errorMessage = string.Empty;
        var files = e.GetMultipleFiles(maximumFileCount: 20);
        long currentTotalSize = SelectedFiles.Sum(f => f.Size);

        foreach (var file in files)
        {
            var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();

            if (!AllowedExtensions.Contains(extension))
            {
                errorMessage = $"فرمت فایل {file.Name} مجاز نیست.";
                continue;
            }

            if (currentTotalSize + file.Size > MaxTotalSizeBytes)
            {
                errorMessage = "حجم کل فایل‌های انتخابی نمی‌تواند بیشتر از ۱۰ مگابایت باشد.";
                break;
            }

            if (!SelectedFiles.Any(f => f.Name == file.Name && f.Size == file.Size))
            {
                SelectedFiles.Add(file);
                currentTotalSize += file.Size;
            }
        }

        await SelectedFilesChanged.InvokeAsync(SelectedFiles);
    }

    private async Task RemoveFile(IBrowserFile file)
    {
        SelectedFiles.Remove(file);
        await SelectedFilesChanged.InvokeAsync(SelectedFiles);
    }
}