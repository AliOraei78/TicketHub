@namespace TicketHub.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms

<div class="mb-2 @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-300 mb-1.5">
            <span class="text-cyan-400 text-[9px]">◆</span>
            <span>@Label</span>
        </label>
    }

    <div class="relative border-2 border-dashed border-cyan-500/30 rounded-2xl p-6 hover:bg-cyan-950/20 hover:border-cyan-400 transition-all text-center bg-[#050811]/90 shadow-2xs group focus-within:ring-2 focus-within:ring-cyan-500/20">
        <InputFile OnChange="HandleSelection" multiple class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.xls,.doc,.docx,.ppt,.pptx,.txt,.json" />

        <div class="pointer-events-none">
            <div class="mx-auto w-12 h-12 rounded-2xl bg-cyan-950/80 border border-cyan-500/30 flex items-center justify-center text-cyan-400 group-hover:scale-110 group-hover:text-cyan-300 transition-all mb-3 shadow-[0_0_15px_rgba(56,189,248,0.2)]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
            </div>
            <span class="block text-xs font-bold text-slate-200">برای انتخاب فایل‌ها کلیک کنید یا آن‌ها را اینجا رها کنید</span>
            <span class="block text-[11px] mt-1 text-slate-400 font-mono" dir="ltr">PDF, JPG, PNG, Word, Excel, PowerPoint, TXT, JSON</span>
            <span class="inline-block text-[10px] mt-2 font-mono font-bold text-cyan-400 bg-cyan-950/60 px-2.5 py-0.5 rounded-md border border-cyan-500/30">حداکثر مجموع حجم: ۱۰ مگابایت</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mt-2 text-xs font-semibold text-rose-400 bg-rose-950/40 border border-rose-500/30 px-3 py-2 rounded-xl">@ErrorMessage</div>
    }

    @if (SelectedFiles.Any())
    {
        <ul class="mt-3 space-y-2">
            @foreach (var file in SelectedFiles)
            {
                <li class="flex items-center justify-between p-3 bg-[#050811]/90 rounded-xl border border-white/[0.1] hover:border-cyan-500/30 transition-colors">
                    <div class="flex items-center gap-2 max-w-[70%]">
                        <span class="text-cyan-400 text-xs">📄</span>
                        <span class="text-xs font-medium text-slate-200 truncate" dir="ltr">@file.Name</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-[11px] text-slate-400 font-mono">@(file.Size / 1024) KB</span>
                        <button type="button" @onclick="() => RemoveFile(file)" class="text-rose-400 hover:text-rose-300 font-bold text-base leading-none focus-ring">&times;</button>
                    </div>
                </li>
            }
        </ul>
    }
</div>