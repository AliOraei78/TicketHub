@namespace TicketHub.Web.Components.Shared

<div class="w-8 h-8 text-xs sm:text-sm bg-gradient-to-br from-[#0e172a] to-[#070c1a] text-cyan-300 rounded-xl flex items-center justify-center font-black shadow-[0_0_12px_rgba(56,189,248,0.25)] shrink-0 border border-cyan-500/40 select-none ring-1 ring-cyan-400/20 transition-all @Class">
    @DisplayInitial
</div>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;

    private string DisplayInitial => string.IsNullOrWhiteSpace(Text) ? "U" : Text.Trim().Substring(0, 1).ToUpper();
}