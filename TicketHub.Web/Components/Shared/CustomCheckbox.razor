@namespace TicketHub.Web.Components.Shared

<div class="flex items-center gap-3 h-[46px] select-none @Class">
    <input type="checkbox"
           id="@Id"
           @bind="CurrentValue"
           disabled="@Disabled"
           class="w-5 h-5 text-indigo-600 border-slate-300 rounded-md focus:ring-indigo-500 shadow-sm cursor-pointer disabled:opacity-50 focus-ring transition-all" />
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@Id" class="text-sm font-medium text-slate-700 dark:text-slate-200 cursor-pointer select-none">
            @Label
        </label>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    protected bool CurrentValue
    {
        get => Value;
        set
        {
            if (Value != value)
            {
                Value = value;
                ValueChanged.InvokeAsync(value);
            }
        }
    }
}