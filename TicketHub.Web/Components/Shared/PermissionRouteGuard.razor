@using Microsoft.AspNetCore.Components.Authorization
@using TicketHub.Application.Interfaces
@inject IPermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@if (!_isChecking && !_hasAccess)
{
    <PageTitle>یافت نشد</PageTitle>
    <LayoutView Layout="typeof(TicketHub.Web.Components.Layout.MainLayout)">
        <NotFoundView Message="ممکن است آدرس را اشتباه وارد کرده باشید یا دسترسی لازم به این بخش را نداشته باشید." />
    </LayoutView>
}
else
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private bool _isChecking = false;
    private bool _hasAccess = true;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User?.Identity?.IsAuthenticated != true)
        {
            // اجازه دهید AuthorizeRouteView کاربر لاگین‌نشده را به صفحه ورود هدایت کند
            _hasAccess = true;
            _isChecking = false;
            return;
        }

        var relativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];

        if (relativePath == "/") relativePath = "";

        _hasAccess = await PermissionService.HasAccessAsync(authState.User, relativePath);
        _isChecking = false;
    }
}