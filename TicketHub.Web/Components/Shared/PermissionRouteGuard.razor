@using Microsoft.AspNetCore.Components.Authorization
@using TicketHub.Application.Interfaces
@inject IPermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@if (_isChecking)
{
    <LoadingSpinner />
}
else if (_hasAccess)
{
    @ChildContent
}
else
{
    <PageTitle>یافت نشد</PageTitle>
    <LayoutView Layout="typeof(TicketHub.Web.Components.Layout.MainLayout)">
        <NotFoundView Message="ممکن است آدرس را اشتباه وارد کرده باشید یا دسترسی لازم به این بخش را نداشته باشید." />
    </LayoutView>
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private bool _isChecking = true;
    private bool _hasAccess = false;

    protected override async Task OnParametersSetAsync()
    {
        _isChecking = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var relativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];

        if (relativePath == "/") relativePath = "";

        _hasAccess = await PermissionService.HasAccessAsync(authState.User, relativePath);
        _isChecking = false;
    }
}