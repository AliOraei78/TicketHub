@using Microsoft.AspNetCore.Components.Authorization
@using TicketHub.Application.Interfaces
@inject IPermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@if (_isChecking)
{
    @* می‌توانید یک لودر ساده اینجا بگذارید یا خالی رها کنید *@
}
else if (_hasAccess)
{
    @ChildContent
}
else
{
    <PageTitle>یافت نشد</PageTitle>
    <LayoutView Layout="typeof(TicketHub.Web.Components.Layout.MainLayout)">
        <p role="alert">صفحه مورد نظر پیدا نشد.</p>
    </LayoutView>
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private bool _isChecking = true;
    private bool _hasAccess = false;

    protected override async Task OnParametersSetAsync()
    {
        _isChecking = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        // استخراج مسیر فعلی و حذف کوئری استرینگ‌ها
        var relativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];

        // هماهنگی با دیتابیس (داشبورد)
        if (relativePath == "/") relativePath = "";

        _hasAccess = await PermissionService.HasAccessAsync(authState.User, relativePath);
        _isChecking = false;
    }
}