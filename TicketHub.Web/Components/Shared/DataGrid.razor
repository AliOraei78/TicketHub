@namespace TicketHub.Web.Components.Shared
@typeparam TItem
@typeparam TKey

@if (IsLoading || Items == null)
{
    <LoadingSpinner />
}
else
{
    <div class="@(IsCyberpunk ? $"bg-[#080d1a]/80 backdrop-blur-2xl rounded-2xl shadow-[0_0_20px_rgba(8,13,26,0.8)] border border-cyan-500/30 overflow-hidden {Class}" : $"bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden {Class}")">
        <div class="w-full overflow-x-auto custom-scrollbar">
            <table class="w-full min-w-[650px] text-right flex flex-col">
                <thead class="@(IsCyberpunk ? "bg-[#050811]/90 border-b border-cyan-500/30 table w-full table-fixed shadow-2xs select-none" : "bg-slate-50 border-b border-slate-200 table w-full table-fixed shadow-2xs select-none")">
                    <tr class="table w-full table-fixed">
                        @if (ShowSelection)
                        {
                            <th class="px-3 py-3 w-[5%] text-center">
                                @if (IsCyberpunk)
                                {
                                    <label class="cyber-checkbox-container inline-flex justify-center items-center cursor-pointer m-0">
                                        <div class="cyber-checkbox-box @(IsAllSelected ? "checked" : "")">
                                            <input type="checkbox" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10"
                                                   checked="@IsAllSelected" @onchange="ToggleAll" />
                                            <svg class="cyber-checkbox-icon @(IsAllSelected ? "scale-100 opacity-100" : "scale-50 opacity-0")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                            </svg>
                                        </div>
                                    </label>
                                }
                                else
                                {
                                    <input type="checkbox" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer focus-ring"
                                           checked="@IsAllSelected" @onchange="ToggleAll" />
                                }
                            </th>
                        }
                        @if (ShowRowIndex)
                        {
                            <th class="px-2 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider w-[5%] text-center">ردیف</th>
                        }
                        @HeaderTemplate
                    </tr>
                </thead>

                <tbody class="@(IsCyberpunk ? "divide-y divide-cyan-900/30 block overflow-y-auto h-[450px] w-full custom-scrollbar" : "divide-y divide-slate-100 block overflow-y-auto h-[450px] w-full custom-scrollbar")">
                    @if (!Items.Any())
                    {
                        <tr class="flex items-center justify-center h-full w-full py-12">
                            <td class="@(IsCyberpunk ? "text-center text-sm font-medium text-cyan-500/70" : "text-center text-sm font-medium text-slate-400")">
                                @EmptyStateValue در سیستم یافت نشد.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowIndex = (CurrentPage - 1) * PageSize + 1;
                        foreach (var item in Items)
                        {
                            var key = KeySelector(item);
                            <tr @key="key" class="@(IsCyberpunk ? $"table w-full table-fixed hover:bg-cyan-900/10 hover:shadow-[inset_0_0_15px_rgba(56,189,248,0.15)] transition-all group/row {RowClassSelector?.Invoke(item)}" : $"table w-full table-fixed hover:bg-slate-50/80 transition-colors group/row {RowClassSelector?.Invoke(item)}")">
                                @if (ShowSelection)
                                {
                                    <td class="px-3 py-3 w-[5%] text-center">
                                        @if (IsCyberpunk)
                                        {
                                            bool isSelected = SelectedKeys.Contains(key);
                                            <label class="cyber-checkbox-container inline-flex justify-center items-center cursor-pointer m-0">
                                                <div class="cyber-checkbox-box @(isSelected ? "checked" : "")">
                                                    <input type="checkbox" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10"
                                                           checked="@isSelected"
                                                           @onchange="@(e => ToggleSelection(key, e.Value))" />
                                                    <svg class="cyber-checkbox-icon @(isSelected ? "scale-100 opacity-100" : "scale-50 opacity-0")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                </div>
                                            </label>
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer focus-ring"
                                                   checked="@SelectedKeys.Contains(key)"
                                                   @onchange="@(e => ToggleSelection(key, e.Value))" />
                                        }
                                    </td>
                                }
                                @if (ShowRowIndex)
                                {
                                    <td class="px-2 py-3 w-[5%] text-center text-sm font-medium text-slate-500">
                                        @(rowIndex++)
                                    </td>
                                }
                                @RowTemplate(item)
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}