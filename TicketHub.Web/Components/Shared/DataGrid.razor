@namespace TicketHub.Web.Components.Shared
@typeparam TItem
@typeparam TKey

@if (IsLoading || Items == null)
{
    <LoadingSpinner />
}
else
{
    <div class="@(IsCyberpunk ? $"bg-[#080d1a]/80 backdrop-blur-2xl rounded-2xl shadow-[0_0_20px_rgba(8,13,26,0.8)] border border-cyan-500/30 overflow-hidden {Class}" : $"bg-white rounded-3xl shadow-sm border border-slate-200/80 overflow-hidden {Class}")">
        <div class="w-full overflow-auto max-h-[450px] custom-scrollbar">
            <table class="w-full @(string.IsNullOrWhiteSpace(TableMinWidth) ? "min-w-[560px] sm:min-w-full" : TableMinWidth) text-right border-collapse">
                <thead class="sticky top-0 z-10 @(IsCyberpunk ? "bg-[#050811] shadow-[0_2px_10px_rgba(0,0,0,0.5)] border-b border-cyan-500/30 select-none" : "bg-slate-50 border-b border-slate-200 select-none")">
                    <tr>
                        @if (ShowSelection)
                        {
                            <th class="px-2 py-3 w-[52px] min-w-[52px] max-w-[52px] text-center shrink-0">
                                @if (IsCyberpunk)
                                {
                                    <label class="cyber-checkbox-container inline-flex justify-center items-center cursor-pointer m-0">
                                        <div class="cyber-checkbox-box @(IsAllSelected ? "checked" : "")">
                                            <input type="checkbox" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10"
                                                   checked="@IsAllSelected" @onchange="ToggleAll" />
                                            <svg class="cyber-checkbox-icon @(IsAllSelected ? "scale-100 opacity-100" : "scale-50 opacity-0")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                            </svg>
                                        </div>
                                    </label>
                                }
                                else
                                {
                                    <input type="checkbox" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer focus-ring"
                                           checked="@IsAllSelected" @onchange="ToggleAll" />
                                }
                            </th>
                        }
                        @if (ShowRowIndex)
                        {
                            <th class="px-1 py-3 text-xs font-bold @(IsCyberpunk ? "text-cyan-400/80 drop-shadow-[0_0_5px_rgba(56,189,248,0.5)]" : "text-slate-600") uppercase tracking-wider w-[52px] min-w-[52px] max-w-[52px] text-center shrink-0">ردیف</th>
                        }
                        @HeaderTemplate
                    </tr>
                </thead>

                <tbody class="@(IsCyberpunk ? "divide-y divide-cyan-900/30" : "divide-y divide-slate-100")">
                    @if (!Items.Any())
                    {
                        <tr>
                            <td colspan="15" class="py-12 @(IsCyberpunk ? "text-center text-sm font-medium text-cyan-500/70" : "text-center text-sm font-medium text-slate-400")">
                                @EmptyStateValue در سیستم یافت نشد.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowIndex = (CurrentPage - 1) * PageSize + 1;
                        foreach (var item in Items)
                        {
                            var key = KeySelector(item);
                            <tr @key="key" class="@(IsCyberpunk ? $"hover:bg-cyan-900/10 hover:shadow-[inset_0_0_15px_rgba(56,189,248,0.15)] transition-all group/row {RowClassSelector?.Invoke(item)}" : $"hover:bg-slate-50/80 transition-colors group/row {RowClassSelector?.Invoke(item)}")">
                                @if (ShowSelection)
                                {
                                    <td class="px-2 py-3 w-[52px] min-w-[52px] max-w-[52px] text-center shrink-0">
                                        @if (IsCyberpunk)
                                        {
                                            bool isSelected = SelectedKeys.Contains(key);
                                            <label class="cyber-checkbox-container inline-flex justify-center items-center cursor-pointer m-0">
                                                <div class="cyber-checkbox-box @(isSelected ? "checked" : "")">
                                                    <input type="checkbox" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10"
                                                           checked="@isSelected"
                                                           @onchange="@(e => ToggleSelection(key, e.Value))" />
                                                    <svg class="cyber-checkbox-icon @(isSelected ? "scale-100 opacity-100" : "scale-50 opacity-0")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                </div>
                                            </label>
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer focus-ring"
                                                   checked="@SelectedKeys.Contains(key)"
                                                   @onchange="@(e => ToggleSelection(key, e.Value))" />
                                        }
                                    </td>
                                }
                                @if (ShowRowIndex)
                                {
                                    <td class="px-1 py-3 w-[52px] min-w-[52px] max-w-[52px] text-center text-xs sm:text-[13px] font-bold @(IsCyberpunk ? "text-cyan-300/80" : "text-slate-500") shrink-0">
                                        @(rowIndex++)
                                    </td>
                                }
                                @RowTemplate(item)
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}