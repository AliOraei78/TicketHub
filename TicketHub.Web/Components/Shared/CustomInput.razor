<div>
    <label class="block text-sm font-medium text-gray-700 mb-2">@Label</label>
    <input type="@Type"
           @bind="CurrentValue"
           @bind:event="oninput"
           placeholder="@Placeholder"
           dir="@Dir"
           class="w-full h-[46px] px-4 border border-gray-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-sm bg-gray-50 hover:bg-white focus:bg-white text-sm" />
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Dir { get; set; } = "rtl";

    private string CurrentValue
    {
        get => Value;
        set
        {
            if (Value != value)
            {
                Value = value;
                ValueChanged.InvokeAsync(value);
            }
        }
    }
}