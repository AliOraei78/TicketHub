@namespace TicketHub.Web.Components.Shared

<div class="w-full">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            @Label
        </label>
    }
    <input type="@Type"
           @bind="CurrentValue"
           @bind:event="oninput"
           placeholder="@Placeholder"
           dir="@Dir"
           disabled="@Disabled"
           class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-sm bg-slate-50 hover:bg-white focus:bg-white disabled:bg-slate-100 disabled:text-slate-400 text-sm text-slate-900 focus-ring @(string.IsNullOrWhiteSpace(ErrorText) ? "" : "border-rose-400 focus:border-rose-500 focus:ring-rose-100") @Class" />

    @if (!string.IsNullOrWhiteSpace(ErrorText))
    {
        <p class="text-xs text-rose-500 mt-1 font-medium">@ErrorText</p>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Dir { get; set; } = "rtl";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    protected string CurrentValue
    {
        get => Value;
        set
        {
            if (Value != value)
            {
                Value = value;
                ValueChanged.InvokeAsync(value);
            }
        }
    }
}