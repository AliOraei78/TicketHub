@namespace TicketHub.Web.Components.Shared
@typeparam TItem
@typeparam TValue

<div id="@ElementId" class="w-full flex flex-col justify-start">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-300 mb-1.5">
            <span class="text-cyan-400 text-[9px]">◆</span>
            <span>@Label</span>
        </label>
    }
    <div class="relative @(ShowDropdown ? "z-[200]" : "z-10") h-[46px] flex items-center" dir="rtl">
        <div class="field-spark-wrap w-full h-[46px] flex items-center">
            <div class="relative w-full h-[46px] flex items-center">
                <input type="text"
                       @bind="SearchTerm"
                       @bind:event="oninput"
                       @onclick="OpenDropdown"
                       placeholder="@Placeholder"
                       class="w-full h-[46px] pr-4.5 pl-11 border border-white/[0.12] rounded-2xl focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all shadow-2xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] text-sm text-slate-100 placeholder-slate-500 focus-ring" />
                <div class="absolute inset-y-0 left-5 flex items-center cursor-pointer z-10" @onclick="ToggleDropdown" @onclick:stopPropagation>
                    <svg class="w-4 h-4 text-slate-400 hover:text-cyan-400 transition-transform duration-300 @(ShowDropdown ? "rotate-180 text-cyan-400" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="dropdown-menu-container absolute top-full left-0 mt-1.5 z-[250] w-full bg-[#090e1d]/98 border border-cyan-500/30 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.9),0_0_20px_rgba(56,189,248,0.15)] overflow-hidden transition-all duration-300 backdrop-blur-2xl @(ShowDropdown ? "opacity-100 max-h-64" : "opacity-0 max-h-0 border-transparent pointer-events-none")">
            <div class="max-h-60 overflow-y-auto pt-1 pb-2 overscroll-contain custom-scrollbar">
                @if (!FilteredItems.Any())
                {
                    <div class="px-4 py-6 text-center flex flex-col items-center justify-center opacity-80">
                        <svg class="w-8 h-8 text-cyan-500/50 mb-2 drop-shadow-[0_0_5px_rgba(56,189,248,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                        </svg>
                        <span class="text-[10px] font-mono text-cyan-400 tracking-wider mb-1">[SYS // NO_MATCH]</span>
                        <span class="text-xs text-slate-400 font-medium">نتیجه‌ای یافت نشد</span>
                    </div>
                }
                else
                {
                    @if (FilteredItems.Count() > 2)
                    {
                        <div @onclick="ToggleSelectAll" class="px-3 py-2 mx-2 my-1 hover:bg-cyan-950/60 rounded-xl cursor-pointer flex items-center justify-between transition-colors border-b border-white/[0.08] mb-1 pb-2 select-none">
                            <span class="text-xs font-bold text-slate-200">انتخاب / لغو همه</span>
                            <div class="cyber-checkbox-box @(AreAllSelected ? "checked" : "")">
                                <svg class="cyber-checkbox-icon @(AreAllSelected ? "scale-100 opacity-100" : "scale-50 opacity-0")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                        </div>
                    }
                    @foreach (var item in FilteredItems)
                    {
                        var val = ValueSelector(item);
                        var display = DisplaySelector(item);
                        var isSelected = SelectedValues.Contains(val);
                        <div @onclick="() => ToggleSelection(val)" class="px-3 py-2 mx-2 my-1 hover:bg-cyan-950/60 hover:text-cyan-300 rounded-xl cursor-pointer flex items-center justify-between group transition-colors select-none">
                            <span class="text-xs font-medium text-slate-200 group-hover:text-cyan-300 truncate block max-w-[85%]" title="@display">@display</span>
                            <div class="cyber-checkbox-box @(isSelected ? "checked" : "")">
                                <svg class="cyber-checkbox-icon @(isSelected ? "scale-100 opacity-100" : "scale-50 opacity-0")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    @if (SelectedValues != null && SelectedValues.Any())
    {
        <div class="flex flex-wrap gap-1.5 mt-1.5">
            @foreach (var val in SelectedValues)
            {
                var item = Items.FirstOrDefault(i => EqualityComparer<TValue>.Default.Equals(ValueSelector(i), val));
                if (item != null)
                {
                    <span class="bg-cyan-950/80 text-cyan-300 border border-cyan-500/40 shadow-[0_0_8px_rgba(56,189,248,0.2)] px-2 py-0.5 rounded-lg text-[11px] font-semibold flex items-center gap-1.5 max-w-full">
                        <span class="truncate block max-w-[130px]" title="@DisplaySelector(item)">@DisplaySelector(item)</span>
                        <button type="button" @onclick="() => RemoveSelection(val)" class="text-rose-400 hover:text-rose-300 text-sm font-bold leading-none shrink-0 focus-ring">
                            &times;
                        </button>
                    </span>
                }
            }
        </div>
    }
</div>