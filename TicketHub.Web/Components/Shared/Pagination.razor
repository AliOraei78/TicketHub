@namespace TicketHub.Web.Components.Shared

<div class="flex flex-col sm:flex-row justify-between items-center bg-[#070c1a]/90 backdrop-blur-xl py-2.5 px-4 rounded-2xl shadow-lg border border-cyan-500/25 mt-2 gap-3 flex-shrink-0 select-none @Class">
    <div class="text-sm text-slate-300 flex items-center flex-wrap gap-2">
        <span>نمایش</span>
        <span class="font-bold font-mono text-cyan-300 bg-cyan-950/60 border border-cyan-500/30 px-2.5 py-0.5 rounded-lg text-xs">
            @(TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1)
        </span>
        <span>تا</span>
        <span class="font-bold font-mono text-cyan-300 bg-cyan-950/60 border border-cyan-500/30 px-2.5 py-0.5 rounded-lg text-xs">
            @Math.Min(CurrentPage * PageSize, TotalItems)
        </span>
        <span>از</span>
        <span class="font-bold font-mono text-indigo-300 bg-indigo-950/60 border border-indigo-500/40 px-2.5 py-0.5 rounded-lg text-xs">
            @TotalItems
        </span>
        <span>@ItemName</span>
    </div>

    <div class="flex items-center gap-2.5">
        <button @onclick="OnPrevious" disabled="@(CurrentPage == 1)"
                class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-900/90 border border-slate-700/80 rounded-xl text-xs font-semibold text-slate-200 hover:text-cyan-300 hover:border-cyan-500/50 hover:bg-cyan-950/50 disabled:opacity-30 disabled:pointer-events-none transition-all shadow-2xs focus-ring group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span>قبلی</span>
        </button>

        <div class="flex items-center justify-center min-w-[95px] px-3 py-1.5 bg-[#050811]/90 border border-white/[0.1] rounded-xl text-xs font-medium text-slate-200">
            صفحه <span class="text-cyan-400 font-bold font-mono mx-1 text-sm">@CurrentPage</span> از <span class="font-mono text-slate-300 mx-1">@TotalPages</span>
        </div>

        <button @onclick="OnNext" disabled="@(CurrentPage >= TotalPages)"
                class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-900/90 border border-slate-700/80 rounded-xl text-xs font-semibold text-slate-200 hover:text-cyan-300 hover:border-cyan-500/50 hover:bg-cyan-950/50 disabled:opacity-30 disabled:pointer-events-none transition-all shadow-2xs focus-ring group">
            <span>بعدی</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public string ItemName { get; set; } = "رکورد";
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    protected int TotalPages => TotalItems == 0 ? 1 : (int)Math.Ceiling(TotalItems / (double)PageSize);
}