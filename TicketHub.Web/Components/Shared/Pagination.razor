@namespace TicketHub.Web.Components.Shared

<div class="flex flex-col md:flex-row justify-between items-center bg-white p-3 rounded-2xl shadow-sm border border-slate-200/80 mt-2 gap-3 flex-shrink-0 select-none @Class">
    <div class="text-sm text-slate-500 flex items-center flex-wrap gap-1.5">
        <span>نمایش</span>
        <span class="font-bold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-lg">
            @(TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1)
        </span>
        <span>تا</span>
        <span class="font-bold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-lg">
            @Math.Min(CurrentPage * PageSize, TotalItems)
        </span>
        <span>از</span>
        <span class="font-bold text-indigo-600 bg-indigo-50 border border-indigo-100/60 px-2.5 py-1 rounded-lg">
            @TotalItems
        </span>
        <span>@ItemName</span>
    </div>

    <div class="flex items-center gap-2">
        <button @onclick="OnPrevious" disabled="@(CurrentPage == 1)"
                class="flex items-center gap-2 px-3 py-1.5 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 disabled:opacity-40 disabled:bg-slate-50 disabled:text-slate-400 disabled:cursor-not-allowed transition-all shadow-2xs focus-ring group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span>قبلی</span>
        </button>

        <div class="flex items-center justify-center min-w-[100px] px-3 py-1.5 bg-slate-50 border border-slate-200/80 rounded-xl text-sm font-medium text-slate-600">
            صفحه <span class="text-indigo-600 font-bold mx-1.5 text-base">@CurrentPage</span> از @TotalPages
        </div>

        <button @onclick="OnNext" disabled="@(CurrentPage >= TotalPages)"
                class="flex items-center gap-2 px-3 py-1.5 bg-white border border-slate-200 rounded-xl text-sm font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 disabled:opacity-40 disabled:bg-slate-50 disabled:text-slate-400 disabled:cursor-not-allowed transition-all shadow-2xs focus-ring group">
            <span>بعدی</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
    </div>
</div>