<div class="flex flex-col md:flex-row justify-between items-center bg-white p-4 rounded-2xl shadow-sm border border-gray-100 mt-6 gap-4">
    <!-- بخش اطلاعات (سمت راست) -->
    <div class="text-sm text-gray-500 flex items-center flex-wrap gap-1.5">
        <span>نمایش</span>
        <span class="font-bold text-gray-700 bg-gray-100/80 px-2.5 py-1 rounded-lg">
            @(TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1)
        </span>
        <span>تا</span>
        <span class="font-bold text-gray-700 bg-gray-100/80 px-2.5 py-1 rounded-lg">
            @Math.Min(CurrentPage * PageSize, TotalItems)
        </span>
        <span>از</span>
        <span class="font-bold text-indigo-600 bg-indigo-50 border border-indigo-100 px-2.5 py-1 rounded-lg">
            @TotalItems
        </span>
        <span>@ItemName</span>
    </div>

    <!-- بخش دکمه‌ها (سمت چپ) -->
    <div class="flex items-center gap-2">
        <!-- دکمه قبلی -->
        <button @onclick="OnPrevious" disabled="@(CurrentPage == 1)"
                class="flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-600 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 disabled:opacity-50 disabled:bg-gray-50 disabled:text-gray-400 disabled:cursor-not-allowed transition-all duration-300 shadow-sm disabled:shadow-none group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span>قبلی</span>
        </button>

        <!-- نشانگر صفحه -->
        <div class="flex items-center justify-center min-w-[100px] px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm font-medium text-gray-600">
            صفحه <span class="text-indigo-600 font-bold mx-1.5 text-base">@CurrentPage</span> از @TotalPages
        </div>

        <!-- دکمه بعدی -->
        <button @onclick="OnNext" disabled="@(CurrentPage >= TotalPages)"
                class="flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-600 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 disabled:opacity-50 disabled:bg-gray-50 disabled:text-gray-400 disabled:cursor-not-allowed transition-all duration-300 shadow-sm disabled:shadow-none group">
            <span>بعدی</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int TotalItems { get; set; }

    // کلمه پیش‌فرض "رکورد" است. می‌توانید از صفحه اصلی نام دلخواه را ارسال کنید.
    [Parameter] public string ItemName { get; set; } = "رکورد";

    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }

    private int TotalPages => TotalItems == 0 ? 1 : (int)Math.Ceiling(TotalItems / (double)PageSize);
}