@typeparam TItem
@typeparam TValue
@inject IJSRuntime JSRuntime

<div id="@elementId" class="relative @(isOpen ? "z-[60]" : "")" dir="rtl">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-gray-700 mb-2">@Label</label>
    }
    <div @onclick="Toggle" class="w-full h-[46px] px-4 border border-gray-200 rounded-2xl cursor-pointer flex justify-between items-center transition-all shadow-sm bg-gray-50 hover:bg-white hover:border-indigo-500 focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-100 focus-within:bg-white text-sm">
        <span class="text-sm truncate block max-w-[90%] @(EqualityComparer<TValue>.Default.Equals(Value, default) ? "text-gray-400" : "text-gray-900")" title="@GetSelectedText()">
            @GetSelectedText()
        </span>
        <svg class="w-4 h-4 text-gray-400 transition-transform duration-300 @(isOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
    </div>

    <div class="absolute top-full left-0 z-50 w-full mt-1 bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden transition-all duration-300 @(isOpen ? "opacity-100 max-h-60" : "opacity-0 max-h-0 border-transparent pointer-events-none")">
        @if (isOpen)
        {
            <div class="p-2 border-b border-gray-100">
                <input type="text" @bind="searchTerm" @bind:event="oninput" @onclick:stopPropagation class="w-full h-10 px-3 text-sm border border-gray-200 rounded-xl focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-gray-50 focus:bg-white transition-all outline-none" placeholder="جستجو..." />
            </div>
        }
        <ul class="overflow-y-auto max-h-48 pt-1 pb-3 overscroll-contain">
            @if (AllowClear)
            {
                <li @onclick="() => Select(default!)" class="px-4 py-2.5 text-sm text-gray-500 hover:bg-indigo-50 cursor-pointer transition-colors">@ClearText</li>
            }
            @if (FilteredItems != null && FilteredItems.Any())
            {
                @foreach (var item in FilteredItems)
                {
                    <!-- جایگزین تگ li داخل حلقه -->
                    <li @onclick="() => Select(ValueSelector(item))" class="px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 cursor-pointer transition-colors truncate block max-w-full" title="@TextSelector(item)">@TextSelector(item)</li>
                }
            }
            else if (FilteredItems != null && !FilteredItems.Any())
            {
                <li class="px-4 py-3 text-sm text-gray-400 text-center">نتیجه‌ای یافت نشد</li>
            }
        </ul>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "انتخاب کنید...";
    [Parameter] public IEnumerable<TItem> Items { get; set; } = default!;
    [Parameter] public Func<TItem, string> TextSelector { get; set; } = default!;
    [Parameter] public Func<TItem, TValue> ValueSelector { get; set; } = default!;

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public string ClearText { get; set; } = "بدون انتخاب";

    private bool isOpen;
    private string searchTerm = string.Empty;
    private string elementId = "slide-select-" + Guid.NewGuid().ToString("N");

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (Items == null) return Enumerable.Empty<TItem>();
            if (string.IsNullOrEmpty(searchTerm)) return Items;
            return Items.Where(i => TextSelector(i)?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true);
        }
    }

    private async Task Toggle() 
    {
        isOpen = !isOpen;
        if (!isOpen)
        {
            searchTerm = string.Empty;
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("initClickOutside", elementId, DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        isOpen = false;
        searchTerm = string.Empty;
        StateHasChanged();
    }

    private async Task Select(TValue val)
    {
        Value = val;
        isOpen = false;
        await ValueChanged.InvokeAsync(val);
    }

    private string GetSelectedText()
    {
        if (EqualityComparer<TValue>.Default.Equals(Value, default) || Items == null)
            return Placeholder;

        var selectedItem = Items.FirstOrDefault(x => EqualityComparer<TValue>.Default.Equals(ValueSelector(x), Value));
        return selectedItem != null ? TextSelector(selectedItem) : Placeholder;
    }
}