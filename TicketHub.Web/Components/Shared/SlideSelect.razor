@namespace TicketHub.Web.Components.Shared
@typeparam TItem
@typeparam TValue

<div id="@ElementId" class="relative @(IsOpen ? "z-[60]" : "")" dir="rtl">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">@Label</label>
    }
    <div @onclick="Toggle" class="w-full h-[46px] px-4 border border-slate-200 rounded-2xl cursor-pointer flex justify-between items-center transition-all shadow-sm bg-slate-50 hover:bg-white hover:border-indigo-500 focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-100 focus-within:bg-white text-sm select-none focus-ring">
        <span class="text-sm truncate block max-w-[90%] @(EqualityComparer<TValue>.Default.Equals(Value, default) ? "text-slate-400" : "text-slate-900 font-medium")" title="@GetSelectedText()">
            @GetSelectedText()
        </span>
        <svg class="w-4 h-4 text-slate-400 transition-transform duration-300 @(IsOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
    </div>

    <div class="dropdown-menu-container absolute top-full left-0 z-50 w-full mt-1 bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden transition-all duration-300 @(IsOpen ? "opacity-100 max-h-60" : "opacity-0 max-h-0 border-transparent pointer-events-none")">
        @if (IsOpen)
        {
            <div class="p-2 border-b border-slate-100">
                <input type="text" @bind="SearchTerm" @bind:event="oninput" @onclick:stopPropagation class="w-full h-10 px-3 text-sm border border-slate-200 rounded-xl focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-slate-50 focus:bg-white transition-all focus-ring" placeholder="جستجو..." />
            </div>
        }
        <ul class="overflow-y-auto max-h-48 pt-1 pb-3 overscroll-contain custom-scrollbar">
            @if (AllowClear)
            {
                <li @onclick="() => Select(default!)" class="px-4 py-2.5 text-sm text-slate-500 hover:bg-indigo-50 cursor-pointer transition-colors font-medium select-none">@ClearText</li>
            }
            @if (FilteredItems != null && FilteredItems.Any())
            {
                @foreach (var item in FilteredItems)
                {
                    <li @onclick="() => Select(ValueSelector(item))" class="px-4 py-2.5 text-sm text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 cursor-pointer transition-colors truncate block max-w-full font-medium select-none" title="@TextSelector(item)">@TextSelector(item)</li>
                }
            }
            else if (FilteredItems != null && !FilteredItems.Any())
            {
                <li class="px-4 py-3 text-sm text-slate-400 text-center">نتیجه‌ای یافت نشد</li>
            }
        </ul>
    </div>
</div>