@namespace TicketHub.Web.Components.Shared

<span class="@CssClass">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Default;
    [Parameter] public BadgeSize Size { get; set; } = BadgeSize.Sm;
    [Parameter] public string Class { get; set; } = string.Empty;

    private string CssClass => GetCssClasses();

    private string GetCssClasses()
    {
        var baseClasses = "inline-flex items-center justify-center font-semibold rounded-full border transition-colors select-none";

        var sizeClass = Size switch
        {
            BadgeSize.Xs => "px-2 py-0.5 text-[10px]",
            BadgeSize.Sm => "px-2.5 py-0.5 text-xs",
            BadgeSize.Md => "px-3 py-1 text-sm",
            _ => "px-2.5 py-0.5 text-xs"
        };

        var variantClass = Variant switch
        {
            BadgeVariant.Primary => "bg-indigo-50 text-indigo-700 border-indigo-200/60 hover:bg-indigo-100",
            BadgeVariant.Success => "bg-emerald-50 text-emerald-700 border-emerald-200/60 hover:bg-emerald-100",
            BadgeVariant.Warning => "bg-amber-50 text-amber-700 border-amber-200/60 hover:bg-amber-100",
            BadgeVariant.Danger => "bg-rose-50 text-rose-700 border-rose-200/60 hover:bg-rose-100",
            BadgeVariant.Info => "bg-sky-50 text-sky-700 border-sky-200/60 hover:bg-sky-100",
            BadgeVariant.Neutral => "bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200",
            _ => "bg-blue-50 text-blue-600 border-blue-100 hover:bg-blue-100"
        };

        return $"{baseClasses} {sizeClass} {variantClass} {Class}".Trim();
    }
}