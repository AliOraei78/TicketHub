@namespace TicketHub.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Sections
@using TicketHub.Application.DTOs
@using TicketHub.Core.Common
@using TicketHub.Core.Enums

@if (IsOpen && Notification != null)
{
    <SectionContent SectionName="RootModal">
        <style>
            main { overflow: hidden !important; }
            body { overflow: hidden !important; }
        </style>

        <div class="fixed inset-0 z-[99999] flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-xl modal-backdrop-animate select-none" 
             dir="rtl"
             @onclick="CloseModal">

            <!-- Cyberpunk Modal Chassis -->
            <div class="relative bg-[#070c1a]/98 backdrop-blur-2xl rounded-3xl shadow-[0_25px_60px_rgba(0,0,0,0.95),0_0_40px_rgba(56,189,248,0.2)] max-w-lg w-full overflow-hidden p-6 modal-content-animate border border-cyan-500/40 text-right @Class"
                 @onclick:stopPropagation>

                <!-- Ambient Glow Elements -->
                <div class="absolute -top-16 -right-16 w-36 h-36 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-16 -left-16 w-36 h-36 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>

                <!-- Chamfered HUD Corner Markers -->
                <div class="absolute -top-1 -right-1 w-4 h-4 border-t-2 border-r-2 @GetSeverityCornerClass(Notification.Severity)"></div>
                <div class="absolute -bottom-1 -left-1 w-4 h-4 border-b-2 border-l-2 @GetSeverityCornerClass(Notification.Severity)"></div>
                <div class="absolute -top-1 -left-1 w-4 h-4 border-t-2 border-l-2 @GetSeverityCornerClass(Notification.Severity)"></div>
                <div class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 @GetSeverityCornerClass(Notification.Severity)"></div>

                <!-- Header Section: Icon Halo + Protocol Badge + Title -->
                <div class="flex items-start justify-between gap-4 mb-4">
                    <div class="flex items-center gap-3.5 min-w-0">
                        <!-- Holographic Severity Halo Box -->
                        <div class="w-13 h-13 rounded-2xl flex items-center justify-center flex-shrink-0 @GetSeverityBoxClass(Notification.Severity)">
                            @GetSeverityIconLarge(Notification.Severity)
                        </div>

                        <div class="flex flex-col min-w-0">
                            <!-- Telemetry HUD Tag -->
                            <div class="flex items-center gap-2 mb-1 flex-wrap">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold @GetSeverityBadgeClass(Notification.Severity)">
                                    <span class="w-1.5 h-1.5 rounded-full bg-current animate-ping"></span>
                                    <span>@GetTypeName(Notification.Type)</span>
                                </span>

                                @if (Notification.IsRead)
                                {
                                    <span class="text-[10px] text-slate-400 font-medium flex items-center gap-1 bg-slate-900/80 px-2 py-0.5 rounded-full border border-white/[0.06]">
                                        <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                        خوانده شده
                                    </span>
                                }
                                else
                                {
                                    <span class="text-[10px] text-cyan-300 font-bold flex items-center gap-1 bg-cyan-950/80 px-2 py-0.5 rounded-full border border-cyan-500/30">
                                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_6px_#38bdf8]"></span>
                                        جدید
                                    </span>
                                }
                            </div>

                            <!-- Notification Title -->
                            <h3 class="text-base sm:text-lg font-black text-slate-100 truncate tracking-tight drop-shadow-[0_2px_8px_rgba(255,255,255,0.15)]">
                                @Notification.Title
                            </h3>
                        </div>
                    </div>

                    <!-- Close X Button -->
                    <button type="button" 
                            @onclick="CloseModal" 
                            class="text-slate-400 hover:text-cyan-300 p-1.5 rounded-xl hover:bg-slate-800/60 transition-all border border-transparent hover:border-cyan-500/30 focus-ring cursor-pointer flex-shrink-0"
                            title="بستن">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Timestamp Bar -->
                <div class="mb-4 px-3.5 py-1.5 bg-[#050811]/90 rounded-xl border border-white/[0.08] flex items-center justify-between text-xs text-slate-400">
                    <span class="flex items-center gap-1.5 font-medium">
                        <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>زمان ثبت اعلان:</span>
                    </span>
                    <span class="font-mono text-cyan-300 font-semibold">
                        @Notification.CreatedAt.ToPersianDateTimeString()
                    </span>
                </div>

                <!-- Body Message Chassis -->
                <div class="p-4 bg-[#050811]/90 rounded-2xl border border-white/[0.08] mb-5 shadow-inner">
                    <p class="text-sm leading-relaxed text-slate-200 font-normal whitespace-pre-wrap selection:bg-cyan-500/30">
                        @Notification.Message
                    </p>
                </div>

                <!-- Footer Action Buttons -->
                <div class="flex items-center justify-between gap-3 pt-2 border-t border-white/[0.08] flex-wrap">
                    <!-- Delete Button -->
                    <button type="button" 
                            @onclick="DeleteNotification" 
                            class="text-xs text-rose-400 hover:text-rose-300 hover:bg-rose-950/60 px-3 py-2 rounded-xl transition-all flex items-center gap-1.5 font-semibold border border-transparent hover:border-rose-500/40 focus-ring cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        <span>حذف این اعلان</span>
                    </button>

                    <!-- Right Group: Close & Navigate -->
                    <div class="flex items-center gap-2.5">
                        <button type="button" 
                                @onclick="CloseModal" 
                                class="btn-cyber-ghost px-4 py-2 text-xs font-bold cursor-pointer">
                            بستن
                        </button>

                        @if (!string.IsNullOrWhiteSpace(Notification.ActionUrl))
                        {
                            <button type="button" 
                                    @onclick="NavigateToAction" 
                                    class="btn-cyber-primary px-4 sm:px-5 py-2 text-xs sm:text-sm font-bold flex items-center gap-2 shadow-[0_0_15px_rgba(56,189,248,0.35)] cursor-pointer">
                                <span>مشاهده تیکت</span>
                                <svg class="w-4 h-4 rotate-180 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </SectionContent>
}
