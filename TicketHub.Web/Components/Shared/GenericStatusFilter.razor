@typeparam TValue

<div class="relative flex w-full rounded-xl bg-gray-100 p-1 shrink-0 h-[46px] items-center">
    <!-- کانتینر داخلی برای محاسبه دقیق عرض -->
    <div class="relative flex w-full h-full items-center">

        <!-- پس‌زمینه متحرک به صورت داینامیک بر اساس تعداد آپشن‌ها -->
        <div class="absolute right-0 top-0 bottom-0 rounded-lg transition-all duration-300 ease-out shadow-sm @BackgroundClassSelector(SelectedValue)"
             style="width: @(100.0 / Options.Count())%;"></div>

        @foreach (var item in Options)
        {
            <button type="button" @onclick="() => OnValueChanged.InvokeAsync(item)"
                    class="relative z-10 flex-1 h-full flex items-center justify-center text-sm font-medium transition-colors duration-300 @ItemClassSelector(item, SelectedValue)">
                @ItemTemplate(item)
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<TValue> Options { get; set; } = default!;
    [Parameter] public TValue SelectedValue { get; set; } = default!;
    [Parameter] public EventCallback<TValue> OnValueChanged { get; set; }

    [Parameter, EditorRequired] public RenderFragment<TValue> ItemTemplate { get; set; } = default!;
    [Parameter] public Func<TValue, string> BackgroundClassSelector { get; set; } = _ => "";
    [Parameter] public Func<TValue, TValue, string> ItemClassSelector { get; set; } = (_, __) => "";
}