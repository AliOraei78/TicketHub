@namespace TicketHub.Web.Components.Shared
@typeparam TValue

<div class="relative flex w-full rounded-2xl bg-slate-100 p-1 shrink-0 h-[46px] items-center border border-slate-200/60 select-none @Class">
    <div class="relative flex w-full h-full items-center">
        <div class="absolute right-0 top-0 bottom-0 rounded-xl transition-all duration-300 ease-out shadow-2xs @BackgroundClassSelector(SelectedValue)"
             style="width: @(Options.Any() ? 100.0 / Options.Count() : 100.0)%;"></div>

        @foreach (var item in Options)
        {
            <button type="button" @onclick="() => OnValueChanged.InvokeAsync(item)"
                    class="relative z-10 flex-1 h-full flex items-center justify-center text-xs font-semibold transition-colors duration-300 focus-ring @ItemClassSelector(item, SelectedValue)">
                @ItemTemplate(item)
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<TValue> Options { get; set; } = default!;
    [Parameter] public TValue SelectedValue { get; set; } = default!;
    [Parameter] public EventCallback<TValue> OnValueChanged { get; set; }

    [Parameter, EditorRequired] public RenderFragment<TValue> ItemTemplate { get; set; } = default!;
    [Parameter] public Func<TValue, string> BackgroundClassSelector { get; set; } = _ => "";
    [Parameter] public Func<TValue, TValue, string> ItemClassSelector { get; set; } = (_, __) => "";
    [Parameter] public string Class { get; set; } = string.Empty;
}