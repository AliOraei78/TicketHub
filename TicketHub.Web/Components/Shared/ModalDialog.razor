@namespace TicketHub.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Sections

@if (IsOpen)
{
    <SectionContent SectionName="RootModal">
        <style>
            main { overflow: hidden !important; }
            body { overflow: hidden !important; }
        </style>

        <div class="fixed inset-0 z-[99999] flex items-start justify-center p-4 pt-8 md:pt-12 bg-slate-950/70 backdrop-blur-md modal-backdrop-animate select-none"
             dir="rtl"
             @onclick="OnClose">

            <div class="relative w-full @MaxWidthClass max-h-[85vh] bg-white rounded-3xl shadow-2xl border border-slate-200/80 overflow-hidden flex flex-col modal-content-animate my-0 @Class"
                 @onclick:stopPropagation>

                <!-- Header -->
                <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/80 flex-shrink-0">
                    <h3 class="font-bold text-slate-800 dark:text-slate-100 text-lg">@Title</h3>
                    <button type="button" @onclick="OnClose" class="text-slate-400 hover:text-slate-600 transition-colors p-1.5 rounded-xl hover:bg-slate-200/60 focus-ring">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Body Content -->
                <div class="p-6 flex-1 overflow-y-auto custom-scrollbar">
                    @ChildContent
                </div>
            </div>
        </div>
    </SectionContent>
}