@namespace TicketHub.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using TicketHub.Application.DTOs
@using TicketHub.Application.Interfaces
@using TicketHub.Core.Common
@using TicketHub.Core.Enums

<div class="relative inline-block text-right select-none @Class">
    <!-- Bell Icon Trigger Button -->
    <button type="button" 
            @onclick="ToggleDropdown" 
            class="relative w-9 h-9 rounded-xl bg-[#050811]/90 text-slate-300 hover:text-cyan-300 hover:bg-slate-800/80 flex items-center justify-center transition-all cursor-pointer border border-cyan-500/30 shadow-[0_0_15px_rgba(56,189,248,0.15)] hover:shadow-[0_0_20px_rgba(56,189,248,0.35)] focus-ring"
            title="اعلانات">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 @(UnreadCount > 0 ? "text-cyan-300 animate-pulse" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>

        @if (UnreadCount > 0)
        {
            <span class="absolute -top-1 -right-1 flex h-4 min-w-[16px] px-1 items-center justify-center rounded-full bg-rose-500 bg-gradient-to-r from-rose-500 to-pink-500 text-[9px] font-black text-white shadow-[0_0_10px_rgba(244,63,94,0.8)] border border-white/20 animate-pulse">
                @(UnreadCount > 9 ? "9+" : UnreadCount.ToString())
            </span>
        }
    </button>

    <!-- Popover Dropdown -->
    @if (IsDropdownOpen)
    {
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>

        <div class="absolute left-0 mt-2.5 w-84 sm:w-96 bg-[#080d1a]/98 backdrop-blur-2xl rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.95),0_0_30px_rgba(56,189,248,0.2)] border border-cyan-500/35 z-50 overflow-hidden modal-content-animate text-right"
             @onclick:stopPropagation>
            
            <!-- Ambient Laser Glow -->
            <div class="absolute -top-12 -right-12 w-28 h-28 bg-cyan-500/15 rounded-full blur-2xl pointer-events-none"></div>
            <div class="absolute -bottom-12 -left-12 w-28 h-28 bg-purple-500/15 rounded-full blur-2xl pointer-events-none"></div>

            <!-- Dropdown Header -->
            <div class="relative z-10 p-3.5 border-b border-white/[0.08] flex items-center justify-between bg-[#050811]/90">
                <div class="flex items-center gap-2">
                    <span class="font-black text-sm bg-gradient-to-r from-cyan-300 via-indigo-200 to-purple-300 bg-clip-text text-transparent drop-shadow-[0_0_10px_rgba(56,189,248,0.5)]">
                        مرکز اعلانات
                    </span>
                    @if (UnreadCount > 0)
                    {
                        <span class="bg-cyan-950/90 text-cyan-300 border border-cyan-500/40 text-[10px] font-bold px-2 py-0.5 rounded-full shadow-[0_0_8px_rgba(56,189,248,0.25)]">
                            @UnreadCount جدید
                        </span>
                    }
                </div>

                @if (UnreadCount > 0)
                {
                    <button type="button" 
                            @onclick="MarkAllAsRead" 
                            class="text-[11px] text-cyan-400 hover:text-cyan-300 font-semibold hover:underline flex items-center gap-1 focus-ring rounded-md cursor-pointer transition-all">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <span>خوانده شدن همه</span>
                    </button>
                }
            </div>

            <!-- Filter Tabs -->
            <div class="relative z-10 flex border-b border-white/[0.08] text-xs font-semibold bg-[#050811]/70">
                <button type="button" 
                        @onclick="() => SetFilter(false)" 
                        class="flex-1 py-2.5 text-center transition-all cursor-pointer @(!FilterUnreadOnly ? "text-cyan-300 border-b-2 border-cyan-400 bg-cyan-950/30 font-bold shadow-[inset_0_-8px_12px_rgba(56,189,248,0.1)]" : "text-slate-400 hover:text-slate-200")">
                    همه (@Notifications.Count)
                </button>
                <button type="button" 
                        @onclick="() => SetFilter(true)" 
                        class="flex-1 py-2.5 text-center transition-all cursor-pointer @(FilterUnreadOnly ? "text-cyan-300 border-b-2 border-cyan-400 bg-cyan-950/30 font-bold shadow-[inset_0_-8px_12px_rgba(56,189,248,0.1)]" : "text-slate-400 hover:text-slate-200")">
                    خوانده‌نشده (@UnreadCount)
                </button>
            </div>

            <!-- Notification List -->
            <div class="relative z-10 max-h-80 overflow-y-auto custom-scrollbar divide-y divide-white/[0.05]">
                @if (IsLoading)
                {
                    <div class="p-8 text-center text-slate-400 text-xs flex flex-col items-center gap-2.5">
                        <div class="w-6 h-6 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin"></div>
                        <span class="text-cyan-300/80 font-mono">در حال همگام‌سازی اعلانات...</span>
                    </div>
                }
                else if (!FilteredNotifications.Any())
                {
                    <div class="p-8 text-center text-slate-400 text-xs flex flex-col items-center justify-center gap-2.5">
                        <div class="w-12 h-12 rounded-2xl bg-cyan-950/30 flex items-center justify-center text-cyan-400/60 border border-cyan-500/20 shadow-[0_0_15px_rgba(56,189,248,0.1)]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                        </div>
                        <span class="font-medium text-slate-300">هیچ اعلانی در این بخش وجود ندارد.</span>
                    </div>
                }
                else
                {
                    @foreach (var notif in FilteredNotifications)
                    {
                        <div @onclick="() => OpenNotificationDetails(notif)" 
                             class="notification-item p-3.5 hover:bg-slate-800/80 cursor-pointer transition-all relative flex items-start gap-3 border-r-2 group @(!notif.IsRead ? "bg-cyan-950/30 border-cyan-400 shadow-[inset_4px_0_12px_rgba(56,189,248,0.12)]" : "border-transparent hover:border-cyan-500/30")">
                            
                            <div class="w-8.5 h-8.5 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5 @GetSeverityIconContainerClass(notif.Severity)">
                                @GetSeverityIcon(notif.Severity)
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-1.5 mb-1">
                                    <h4 class="text-xs font-bold text-slate-200 group-hover:text-cyan-300 truncate @(!notif.IsRead ? "text-cyan-300" : "")">
                                        @notif.Title
                                    </h4>
                                    <span class="text-[10px] text-slate-400 group-hover:text-slate-300 flex-shrink-0 font-normal">
                                        @GetTimeAgo(notif.CreatedAt)
                                    </span>
                                </div>
                                <p class="text-[11px] text-slate-400 group-hover:text-slate-200 line-clamp-2 leading-relaxed font-normal">
                                    @notif.Message
                                </p>
                            </div>

                            @if (!notif.IsRead)
                            {
                                <span class="w-2 h-2 rounded-full bg-cyan-400 flex-shrink-0 mt-2 shadow-[0_0_8px_#38bdf8] animate-pulse"></span>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Dropdown Footer -->
            <div class="relative z-10 p-2 border-t border-white/[0.08] text-center bg-[#050811]/90">
                <button type="button" @onclick="CloseDropdown" class="text-[11px] text-slate-400 hover:text-cyan-300 font-medium focus-ring rounded-md px-3 py-1 cursor-pointer transition-colors">
                    بستن مرکز اعلانات
                </button>
            </div>
        </div>
    }
</div>

<!-- Details Modal -->
<NotificationDetailsModal IsOpen="@IsModalOpen" 
                          Notification="@SelectedNotification" 
                          OnClose="@CloseDetailsModal" 
                          OnDelete="@HandleDeleteNotification" />
