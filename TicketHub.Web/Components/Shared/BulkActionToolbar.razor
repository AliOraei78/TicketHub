@using Microsoft.AspNetCore.Components.Sections
@using TicketHub.Web.Components.Layout.Shared
@using TicketHub.Application.Enums

@if (SelectedCount > 0)
{
    @if (!string.IsNullOrWhiteSpace(ResourceKey))
    {
        <SecuredView ResourceKey="@ResourceKey" MinimumType="PermissionType.SystemSection">
            <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[999999] bg-[#070c1a]/95 border border-rose-500/60 rounded-2xl p-2.5 px-5 flex items-center gap-5 shadow-[0_20px_50px_rgba(0,0,0,0.95),0_0_35px_rgba(244,63,94,0.3)] backdrop-blur-2xl animate-toast-slide-in select-none" dir="rtl">
                <!-- Selected Counter Badge -->
                <div class="flex items-center gap-2 pr-1">
                    <span class="flex items-center justify-center min-w-[28px] h-7 px-2 rounded-xl bg-rose-950/90 text-rose-400 border border-rose-500/50 text-xs font-black font-mono shadow-[0_0_12px_rgba(244,63,94,0.3)]">
                        @SelectedCount
                    </span>
                    <div class="flex flex-col">
                        <span class="text-slate-100 font-bold text-xs">مورد انتخاب شده</span>
                    </div>
                </div>

                <div class="h-7 w-px bg-rose-500/30"></div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-2">
                    @if (OnActivate.HasDelegate)
                    {
                        <button @onclick="OnActivate" type="button" class="px-4 py-2 bg-emerald-950/90 hover:bg-emerald-900 text-emerald-300 border border-emerald-500/50 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-[0_0_15px_rgba(16,185,129,0.2)] cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                            <span>فعال‌سازی</span>
                        </button>
                    }

                    @if (OnDeactivate.HasDelegate)
                    {
                        <button @onclick="OnDeactivate" type="button" class="px-4 py-2 bg-amber-950/90 hover:bg-amber-900 text-amber-300 border border-amber-500/50 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-[0_0_15px_rgba(245,158,11,0.2)] cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                            <span>غیرفعال‌سازی</span>
                        </button>
                    }

                    <SecuredView ResourceKey="@ResourceKey" MinimumType="PermissionType.Full">
                        <button @onclick="OnDelete" type="button" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white border border-rose-400/60 rounded-xl text-xs font-bold transition-all flex items-center gap-2 shadow-[0_0_20px_rgba(244,63,94,0.5)] cursor-pointer">
                            <!-- Neon Cyber Skull Icon 💀 -->
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-rose-200 animate-pulse drop-shadow-[0_0_6px_rgba(244,63,94,0.9)]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2.5c-4.14 0-7.5 3.36-7.5 7.5 0 2.65 1.37 4.98 3.45 6.31V19a1.5 1.5 0 001.5 1.5h5.1a1.5 1.5 0 001.5-1.5v-2.69c2.08-1.33 3.45-3.66 3.45-6.31 0-4.14-3.36-7.5-7.5-7.5z" />
                                <circle cx="8.5" cy="10.5" r="1.6" fill="currentColor" />
                                <circle cx="15.5" cy="10.5" r="1.6" fill="currentColor" />
                                <path d="M12 13l-1.2 1.8h2.4L12 13z" fill="currentColor" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.5 17v3M12 17v3M14.5 17v3" />
                            </svg>
                            <span>حذف گروهی</span>
                        </button>
                    </SecuredView>

                    <button @onclick="OnCancel" type="button" class="btn-cyber-ghost px-4 py-2 text-xs font-bold cursor-pointer">
                        <span>لغو</span>
                    </button>
                </div>
            </div>
        </SecuredView>
    }
    else
    {
        <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[999999] bg-[#070c1a]/95 border border-rose-500/60 rounded-2xl p-2.5 px-5 flex items-center gap-5 shadow-[0_20px_50px_rgba(0,0,0,0.95),0_0_35px_rgba(244,63,94,0.3)] backdrop-blur-2xl animate-toast-slide-in select-none" dir="rtl">
            <!-- Selected Counter Badge -->
            <div class="flex items-center gap-2 pr-1">
                <span class="flex items-center justify-center min-w-[28px] h-7 px-2 rounded-xl bg-rose-950/90 text-rose-400 border border-rose-500/50 text-xs font-black font-mono shadow-[0_0_12px_rgba(244,63,94,0.3)]">
                    @SelectedCount
                </span>
                <div class="flex flex-col">
                    <span class="text-slate-100 font-bold text-xs">مورد انتخاب شده</span>
                </div>
            </div>

            <div class="h-7 w-px bg-rose-500/30"></div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2">
                @if (OnActivate.HasDelegate)
                {
                    <button @onclick="OnActivate" type="button" class="px-4 py-2 bg-emerald-950/90 hover:bg-emerald-900 text-emerald-300 border border-emerald-500/50 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-[0_0_15px_rgba(16,185,129,0.2)] cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                        <span>فعال‌سازی</span>
                    </button>
                }

                @if (OnDeactivate.HasDelegate)
                {
                    <button @onclick="OnDeactivate" type="button" class="px-4 py-2 bg-amber-950/90 hover:bg-amber-900 text-amber-300 border border-amber-500/50 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-[0_0_15px_rgba(245,158,11,0.2)] cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                        <span>غیرفعال‌سازی</span>
                    </button>
                }

                <button @onclick="OnDelete" type="button" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white border border-rose-400/60 rounded-xl text-xs font-bold transition-all flex items-center gap-2 shadow-[0_0_20px_rgba(244,63,94,0.5)] cursor-pointer">
                    <!-- Neon Cyber Skull Icon 💀 -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-rose-200 animate-pulse drop-shadow-[0_0_6px_rgba(244,63,94,0.9)]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2.5c-4.14 0-7.5 3.36-7.5 7.5 0 2.65 1.37 4.98 3.45 6.31V19a1.5 1.5 0 001.5 1.5h5.1a1.5 1.5 0 001.5-1.5v-2.69c2.08-1.33 3.45-3.66 3.45-6.31 0-4.14-3.36-7.5-7.5-7.5z" />
                        <circle cx="8.5" cy="10.5" r="1.6" fill="currentColor" />
                        <circle cx="15.5" cy="10.5" r="1.6" fill="currentColor" />
                        <path d="M12 13l-1.2 1.8h2.4L12 13z" fill="currentColor" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.5 17v3M12 17v3M14.5 17v3" />
                    </svg>
                    <span>حذف گروهی</span>
                </button>

                <button @onclick="OnCancel" type="button" class="btn-cyber-ghost px-4 py-2 text-xs font-bold cursor-pointer">
                    <span>لغو</span>
                </button>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int SelectedCount { get; set; }

    [Parameter]
    public EventCallback OnDeactivate { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    [Parameter]
    public EventCallback OnActivate { get; set; }

    [Parameter]
    public string? ResourceKey { get; set; }
}