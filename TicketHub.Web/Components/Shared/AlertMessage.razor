@if (!string.IsNullOrEmpty(Message))
{
    <div class="p-4 rounded-2xl text-sm font-medium flex items-center gap-3 mb-4 @CssClass">
        @if (Type == AlertType.Error)
        {
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        }
        else if (Type == AlertType.Success)
        {
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        }
        <span class="whitespace-pre-line">@Message</span>

        @if (OnClose.HasDelegate)
        {
            <button @onclick="OnClose" class="mr-auto opacity-70 hover:opacity-100 transition-opacity">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        }

    </div>
}

@code {
    public enum AlertType { Success, Error }

    [Parameter] public string? Message { get; set; }
    [Parameter] public AlertType Type { get; set; } = AlertType.Error;
    [Parameter] public bool IsDark { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }

    private string CssClass => (Type, IsDark) switch
    {
        (AlertType.Success, true) => "bg-emerald-500/10 border border-emerald-500/20 text-emerald-400",
        (AlertType.Success, false) => "bg-emerald-50 border border-emerald-200 text-emerald-700",
        (AlertType.Error, true) => "bg-rose-500/10 border border-rose-500/20 text-rose-400",
        (AlertType.Error, false) => "bg-rose-50 border border-rose-200 text-rose-700",
        _ => ""
    };
}