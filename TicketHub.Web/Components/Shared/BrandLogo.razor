@namespace TicketHub.Web.Components.Shared

<div class="@GetContainerClasses()" @attributes="AdditionalAttributes">
    <!-- Brand Icon Container -->
    <div class="@GetIconClasses()">
        <img src="images/brand/tickethub-icon.png"
             alt="TicketHub Brand Mark"
             class="w-full h-full object-cover rounded-xl transition-transform duration-300 group-hover:scale-105"
             loading="eager" />
        
        @if (ShowPing)
        {
            <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan-500 border border-black"></span>
            </span>
        }
    </div>

    <!-- Brand Typography (Optional) -->
    @if (ShowText)
    {
        <div class="flex flex-col justify-center select-none text-right">
            @if (IsLink)
            {
                <a href="" class="@GetTitleClasses()">@BrandTitle</a>
            }
            else
            {
                <span class="@GetTitleClasses()">@BrandTitle</span>
            }

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <span class="@GetSubtitleClasses()">@Subtitle</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Size { get; set; } = "md"; // "xs", "sm", "md", "lg", "xl"
    [Parameter] public bool ShowText { get; set; } = true;
    [Parameter] public bool ShowPing { get; set; } = false;
    [Parameter] public bool IsLink { get; set; } = true;
    [Parameter] public string BrandTitle { get; set; } = "TICKETHUB";
    [Parameter] public string? Subtitle { get; set; } = "سامانه هوشمند تیکتینگ";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string GetContainerClasses() =>
        $"inline-flex items-center gap-3 group {Class}".Trim();

    private string GetIconClasses()
    {
        var sizeClass = Size switch
        {
            "xs" => "w-6 h-6 rounded-lg",
            "sm" => "w-8 h-8 rounded-xl",
            "md" => "w-9 h-9 rounded-xl",
            "lg" => "w-11 h-11 rounded-2xl",
            "xl" => "w-16 h-16 rounded-2xl",
            _ => "w-9 h-9 rounded-xl"
        };

        return $"relative flex-shrink-0 {sizeClass} p-0.5 bg-[#080d1a] border border-cyan-500/30 shadow-[0_0_15px_rgba(56,189,248,0.3)] group-hover:border-cyan-400 group-hover:shadow-[0_0_20px_rgba(56,189,248,0.6)] transition-all duration-300 overflow-hidden";
    }

    private string GetTitleClasses()
    {
        var titleSize = Size switch
        {
            "xs" => "text-xs font-bold",
            "sm" => "text-sm font-black",
            "md" => "text-base font-black",
            "lg" => "text-lg font-black",
            "xl" => "text-2xl font-black",
            _ => "text-sm font-black"
        };

        return $"tracking-tight {titleSize} text-transparent bg-clip-text bg-gradient-to-r from-white via-cyan-200 to-indigo-300 font-mono whitespace-nowrap hover:opacity-85 transition-opacity";
    }

    private string GetSubtitleClasses()
    {
        var subSize = Size switch
        {
            "xs" => "text-[8px]",
            "sm" => "text-[9px]",
            "md" => "text-[10px]",
            "lg" => "text-[11px]",
            "xl" => "text-xs",
            _ => "text-[9px]"
        };

        return $"{subSize} font-mono text-cyan-400/80 tracking-widest uppercase";
    }
}
