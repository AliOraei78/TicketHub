@namespace TicketHub.Web.Components.Shared

<div class="w-full">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="flex justify-between items-center mb-1.5">
            <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-300">
                <span class="text-cyan-400 text-[9px]">◆</span>
                <span>@Label</span>
            </label>
            <span class="text-[10px] text-slate-500 font-medium">
                @(CurrentValue?.Length ?? 0) کاراکتر
            </span>
        </div>
    }
    <div class="field-spark-wrap w-full">
        <textarea @bind="CurrentValue"
                  @bind:event="oninput"
                  placeholder="@Placeholder"
                  dir="@Dir"
                  rows="@Rows"
                  disabled="@Disabled"
                  class="w-full px-4 py-3 border border-white/[0.12] rounded-2xl focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/20 focus:shadow-[0_0_15px_rgba(56,189,248,0.2)] transition-all shadow-2xs bg-[#050811]/90 hover:bg-[#050811] focus:bg-[#050811] disabled:bg-slate-900 disabled:text-slate-500 text-sm text-slate-100 placeholder-slate-500 focus-ring custom-scrollbar @(string.IsNullOrWhiteSpace(ErrorText) ? "" : "border-rose-500 focus:border-rose-400 focus:ring-rose-500/20") @Class"></textarea>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorText))
    {
        <p class="text-xs text-rose-400 mt-1 font-medium">@ErrorText</p>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Dir { get; set; } = "rtl";
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    protected string CurrentValue
    {
        get => Value;
        set
        {
            if (Value != value)
            {
                Value = value;
                ValueChanged.InvokeAsync(value);
            }
        }
    }
}