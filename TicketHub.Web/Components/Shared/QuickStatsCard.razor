@namespace TicketHub.Web.Components.Shared
@inject IJSRuntime JSRuntime

<div class="element-card gamer-card-3d @GetElementClass() p-3.5 sm:p-4 rounded-2xl flex items-center justify-between transition-all select-none relative overflow-hidden group cursor-pointer @Class">
    
    @if (IsLoading)
    {
        <!-- 0ms Instant Cyber Skeleton (Zero WebGL CPU/GPU Overhead) -->
        <div @key="@("skeleton")" class="relative z-10 w-full flex items-center justify-between">
            <div class="space-y-2.5 flex-1">
                <div class="h-3.5 bg-slate-700/50 rounded-md w-20 cyber-skeleton-box"></div>
                <div class="h-8 bg-cyan-500/20 rounded-lg w-16 cyber-skeleton-box"></div>
            </div>
            <div class="w-11 h-11 rounded-xl bg-slate-800/60 border border-white/10 cyber-skeleton-box flex-shrink-0 mr-2"></div>
        </div>
    }
    else
    {
        @* Live Procedural Canvas VFX Layer (Fire flames, Lightning arcs, Toxic bubbles/drips, Fluid waves, Volumetric Smoke) *@
        @if (!ElementType.Equals("none", StringComparison.OrdinalIgnoreCase))
        {
            <canvas @key="@($"canvas-{ElementType}")" class="element-vfx-canvas absolute inset-0 w-full h-full pointer-events-none z-0" data-element="@ElementType.ToLowerInvariant()"></canvas>
        }

        <div @key="@("content")" class="relative z-10 min-w-0 flex-1">
            <p class="text-sm sm:text-base font-extrabold @(ElementType == "none" ? "text-slate-500 group-hover:text-slate-800" : "text-slate-200 group-hover:text-white") transition-colors truncate tracking-wide">@Title</p>
            <h3 class="text-2xl sm:text-3xl font-black mt-1 tracking-tight @ValueColorClass flex items-baseline gap-1">
                <span class="gamer-counter" data-target="@Value" data-target-fa="@Value.ToPersianNumbers()"></span>
                @if (!string.IsNullOrEmpty(UnitText))
                {
                    <span class="text-xs font-medium text-slate-400">@UnitText</span>
                }
            </h3>
        </div>
        
        <div @key="@("icon")" class="relative z-10 p-2.5 rounded-xl border shadow-sm transition-all duration-300 group-hover:scale-110 @IconThemeClass @(ElementType == "lightning" ? "lightning-spark-icon" : "") flex-shrink-0 mr-2">
            @Icon
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string ValueColorClass { get; set; } = "text-slate-800";
    [Parameter] public string IconThemeClass { get; set; } = "bg-indigo-50 text-indigo-600 border-indigo-100/60";
    [Parameter] public RenderFragment Icon { get; set; } = default!;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string ElementType { get; set; } = "none";
    [Parameter] public string BadgeText { get; set; } = string.Empty;
    [Parameter] public string BadgeClass { get; set; } = "bg-slate-100 text-slate-600";
    [Parameter] public string UnitText { get; set; } = string.Empty;
    [Parameter] public bool IsLoading { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("refreshGamerHud");
        }
        catch
        {
            // Suppress JS interop exception during static prerender or circuit disconnection
        }
    }

    private string GetElementClass() => ElementType.ToLowerInvariant() switch
    {
        "water" => "element-water",
        "lightning" => "element-lightning",
        "toxic" => "element-toxic",
        "fire" => "element-fire",
        "smoke" => "element-smoke",
        "void" => "element-void",
        _ => "bg-white border border-slate-200/80 shadow-2xs hover:shadow-md"
    };
}