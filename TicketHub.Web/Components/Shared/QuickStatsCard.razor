@namespace TicketHub.Web.Components.Shared

<div class="bg-white p-6 rounded-3xl shadow-2xs border border-slate-200/80 flex items-center justify-between transition-all hover:shadow-md select-none @Class">
    <div>
        <p class="text-xs font-semibold text-slate-400">@Title</p>
        <h3 class="text-2xl font-bold mt-1 tracking-tight @ValueColorClass">@Value</h3>
    </div>
    <div class="p-3.5 rounded-2xl border border-slate-100/60 shadow-2xs @IconThemeClass">
        @Icon
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string ValueColorClass { get; set; } = "text-slate-800";
    [Parameter] public string IconThemeClass { get; set; } = "bg-indigo-50 text-indigo-600";
    [Parameter] public RenderFragment Icon { get; set; } = default!;
    [Parameter] public string Class { get; set; } = string.Empty;
}