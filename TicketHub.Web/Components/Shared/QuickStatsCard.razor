@namespace TicketHub.Web.Components.Shared

<div class="element-card gamer-card-3d @GetElementClass() p-3.5 sm:p-4 rounded-2xl flex items-center justify-between transition-all select-none relative overflow-hidden group cursor-pointer @Class">
    
    @* Live Procedural Canvas VFX Layer (Fire flames, Lightning arcs, Toxic bubbles/drips, Fluid waves, Volumetric Smoke) *@
    @if (!ElementType.Equals("none", StringComparison.OrdinalIgnoreCase))
    {
        <canvas class="element-vfx-canvas absolute inset-0 w-full h-full pointer-events-none z-0" data-element="@ElementType.ToLowerInvariant()"></canvas>
    }

    <div class="relative z-10 min-w-0 flex-1">
        <div class="flex items-center gap-1.5 flex-wrap">
            <p class="text-[11px] sm:text-xs font-bold @(ElementType == "none" ? "text-slate-500 group-hover:text-slate-800" : "text-slate-300 group-hover:text-white") transition-colors truncate">@Title</p>
            @if (!string.IsNullOrEmpty(BadgeText))
            {
                <span class="text-[9px] font-black px-1.5 py-0.2 rounded-md @BadgeClass">
                    @BadgeText
                </span>
            }
        </div>
        <h3 class="text-2xl sm:text-3xl font-black mt-1 tracking-tight @ValueColorClass flex items-baseline gap-1">
            <span class="gamer-counter" data-target="@Value">@Value</span>
            @if (!string.IsNullOrEmpty(UnitText))
            {
                <span class="text-xs font-medium text-slate-400">@UnitText</span>
            }
        </h3>
    </div>
    
    <div class="relative z-10 p-2.5 rounded-xl border shadow-sm transition-all duration-300 group-hover:scale-110 @IconThemeClass @(ElementType == "lightning" ? "lightning-spark-icon" : "") flex-shrink-0 mr-2">
        @Icon
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string ValueColorClass { get; set; } = "text-slate-800";
    [Parameter] public string IconThemeClass { get; set; } = "bg-indigo-50 text-indigo-600 border-indigo-100/60";
    [Parameter] public RenderFragment Icon { get; set; } = default!;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string ElementType { get; set; } = "none";
    [Parameter] public string BadgeText { get; set; } = string.Empty;
    [Parameter] public string BadgeClass { get; set; } = "bg-slate-100 text-slate-600";
    [Parameter] public string UnitText { get; set; } = string.Empty;

    private string _lastTitle = string.Empty;
    private string _lastValue = string.Empty;
    private string _lastElementType = string.Empty;
    private string _lastBadgeText = string.Empty;

    protected override bool ShouldRender()
    {
        bool changed = Title != _lastTitle || 
                       Value != _lastValue || 
                       ElementType != _lastElementType || 
                       BadgeText != _lastBadgeText;

        if (changed)
        {
            _lastTitle = Title;
            _lastValue = Value;
            _lastElementType = ElementType;
            _lastBadgeText = BadgeText;
        }

        return changed;
    }

    private string GetElementClass() => ElementType.ToLowerInvariant() switch
    {
        "water" => "element-water",
        "lightning" => "element-lightning",
        "toxic" => "element-toxic",
        "fire" => "element-fire",
        "smoke" => "element-smoke",
        "void" => "element-void",
        _ => "bg-white border border-slate-200/80 shadow-2xs hover:shadow-md"
    };
}