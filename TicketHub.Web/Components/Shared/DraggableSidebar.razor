@namespace TicketHub.Web.Components.Shared
@typeparam TItem

<div class="w-64 bg-white border-r border-slate-200/80 flex flex-col h-full z-10 shadow-sm select-none @Class">
    <div class="p-4 border-b border-slate-100 flex flex-col gap-3">
        <h2 class="text-sm font-bold text-slate-800 dark:text-slate-100">@Title</h2>
        @HeaderContent
    </div>

    <div class="flex-1 overflow-y-auto p-3 space-y-2 custom-scrollbar">
        @if (Items != null)
        {
            @foreach (var item in Items)
            {
                <div draggable="true"
                     @ondragstart="() => OnDragStart.InvokeAsync(item)"
                     class="group flex items-center justify-between p-3 bg-white border border-slate-200 rounded-2xl cursor-grab active:cursor-grabbing hover:border-indigo-400 hover:shadow-2xs transition-all">

                    <div class="flex-1 truncate">
                        @ItemTemplate(item)
                    </div>

                    @if (OnItemAdd.HasDelegate)
                    {
                        <button type="button"
                                @onclick="() => OnItemAdd.InvokeAsync(item)"
                                class="w-7 h-7 rounded-xl text-slate-400 hover:bg-indigo-50 hover:text-indigo-600 flex items-center justify-center transition-colors focus-ring">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        </button>
                    }
                </div>
            }
        }
    </div>
</div>