@namespace TicketHub.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using TicketHub.Application.DTOs
@using TicketHub.Application.Enums

<div class="@(string.IsNullOrWhiteSpace(Title) ? "mt-4" : "mt-8 pt-6 border-t border-slate-200/80") @Class">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-6">@Title</h3>
    }
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-6">
        @foreach (var field in Fields.OrderBy(f => f.SortOrder))
        {
            <div class="@GetGridClass(field)">
                @switch ((FieldTypeEnum)field.FieldTypeId)
                {
                    case FieldTypeEnum.Text:
                        <CustomInput Label="@field.Name" @bind-Value="field.Value" Type="text" Placeholder="@field.Placeholder" />
                        break;

                    case FieldTypeEnum.Number:
                        <CustomInput Label="@field.Name" @bind-Value="field.Value" Type="number" Placeholder="@field.Placeholder" />
                        break;

                    case FieldTypeEnum.Checkbox:
                        <CustomCheckbox Label="@field.Name" Value="@GetCheckboxValue(field)" ValueChanged="@(val => SetCheckboxValue(field, val))" />
                        break;

                    case FieldTypeEnum.ColorPicker:
                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">@field.Name</label>
                            <ColorPicker @bind-Value="field.Value" Placeholder="@field.Placeholder" />
                        </div>
                        break;

                    case FieldTypeEnum.TextArea:
                        <CustomTextArea Label="@field.Name" @bind-Value="field.Value" Placeholder="@field.Placeholder" />
                        break;

                    case FieldTypeEnum.Dropdown:
                        <SlideSelect TItem="string" TValue="string"
                                     Label="@field.Name"
                                     Items="GetOptions(field)"
                                     TextSelector="x => x"
                                     ValueSelector="x => x"
                                     @bind-Value="field.Value" />
                        break;

                    case FieldTypeEnum.MultipleDropdown:
                        <MultiSelectDropdown TItem="string" TValue="string"
                                             Label="@field.Name"
                                             Items="GetOptions(field)"
                                             DisplaySelector="x => x"
                                             ValueSelector="x => x"
                                             SelectedValues="GetMultipleValues(field)"
                                             SelectedValuesChanged="@(vals => SetMultipleValues(field, vals))" />
                        break;

                    case FieldTypeEnum.File:
                        <CustomFileUpload Label="@field.Name"
                                          SelectedFiles="GetInternalBrowserFiles(field)"
                                          SelectedFilesChanged="@(files => HandleFilesChanged(field, files))" />
                        break;

                    case FieldTypeEnum.Date:
                        <div>
                            <CustomPersianDatePicker Label="@field.Name" @bind-Value="field.Value" Placeholder="@field.Placeholder" />
                        </div>
                        break;

                    default:
                        <div class="text-sm text-slate-400">نوع فیلد پشتیبانی نمی‌شود</div>
                        break;
                }

                @if (ValidationErrors != null && ValidationErrors.TryGetValue(field.Name, out var errorMsg))
                {
                    <div class="text-rose-500 text-xs font-medium mt-1">@errorMsg</div>
                }
            </div>
        }
    </div>
</div>
