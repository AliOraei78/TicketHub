@namespace TicketHub.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using TicketHub.Application.DTOs
@using TicketHub.Application.Enums

<div class="@(string.IsNullOrWhiteSpace(Title) ? "mt-4" : "mt-8 pt-6 border-t border-white/[0.08]") @Class">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="flex items-center gap-2 mb-6">
            <span class="text-[10px] font-mono font-black px-2 py-0.5 rounded-md bg-cyan-950/80 text-cyan-400 border border-cyan-500/30">
                [SYS // CUSTOM_METRICS]
            </span>
            <h3 class="text-sm font-bold text-slate-100">@Title</h3>
        </div>
    }

    <div class="space-y-6">
        @* Section 1: Data & Input Fields (Text, Number, Date, Dropdown, MultipleDropdown) *@
        @if (DataFields.Any())
        {
            <div class="space-y-3">
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-[9px] font-mono font-black px-2 py-0.5 rounded-md bg-cyan-950/80 text-cyan-400 border border-cyan-500/30">
                        [SYS // DATA_FIELDS]
                    </span>
                    <span class="text-xs font-bold text-slate-300">اطلاعات و مقادیر پایه</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-4">
                    @foreach (var field in DataFields)
                    {
                        <div class="@GetGridClass(field) relative">
                            @switch ((FieldTypeEnum)field.FieldTypeId)
                            {
                                case FieldTypeEnum.Text:
                                    <CustomInput Label="@field.Name" @bind-Value="field.Value" Type="text" Placeholder="@field.Placeholder" />
                                    break;

                                case FieldTypeEnum.Number:
                                    <CustomInput Label="@field.Name" @bind-Value="field.Value" Type="number" Placeholder="@field.Placeholder" />
                                    break;

                                case FieldTypeEnum.Dropdown:
                                    <SlideSelect TItem="string" TValue="string"
                                                 Label="@field.Name"
                                                 Items="GetOptions(field)"
                                                 TextSelector="x => x"
                                                 ValueSelector="x => x"
                                                 @bind-Value="field.Value" />
                                    break;

                                case FieldTypeEnum.MultipleDropdown:
                                    <MultiSelectDropdown TItem="string" TValue="string"
                                                         Label="@field.Name"
                                                         Items="GetOptions(field)"
                                                         DisplaySelector="x => x"
                                                         ValueSelector="x => x"
                                                         SelectedValues="GetMultipleValues(field)"
                                                         SelectedValuesChanged="@(vals => SetMultipleValues(field, vals))" />
                                    break;

                                case FieldTypeEnum.Date:
                                    <div>
                                        <CustomPersianDatePicker Label="@field.Name" @bind-Value="field.Value" Placeholder="@field.Placeholder" />
                                    </div>
                                    break;

                                default:
                                    <div class="text-xs text-slate-500 font-mono">[UNKNOWN_FIELD_TYPE]</div>
                                    break;
                            }

                            @if (ValidationErrors != null && ValidationErrors.TryGetValue(field.Name, out var errorMsg))
                            {
                                <div class="text-rose-400 text-xs font-medium mt-1">@errorMsg</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Section 2: Rich Text & Text Areas (TextArea) *@
        @if (RichTextFields.Any())
        {
            <div class="space-y-3 @(DataFields.Any() ? "pt-5 border-t border-white/[0.08]" : "")">
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-[9px] font-mono font-black px-2 py-0.5 rounded-md bg-emerald-950/80 text-emerald-400 border border-emerald-500/30">
                        [SYS // RICH_TEXT]
                    </span>
                    <span class="text-xs font-bold text-slate-300">متون تفصیلی و توضیحات</span>
                </div>
                <div class="space-y-4">
                    @foreach (var field in RichTextFields)
                    {
                        <div class="relative w-full">
                            <CustomTextArea Label="@field.Name" @bind-Value="field.Value" Placeholder="@field.Placeholder" />
                            @if (ValidationErrors != null && ValidationErrors.TryGetValue(field.Name, out var errorMsg))
                            {
                                <div class="text-rose-400 text-xs font-medium mt-1">@errorMsg</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Section 3: Checkboxes (3 in a row) *@
        @if (CheckboxFields.Any())
        {
            <div class="space-y-3 @(DataFields.Any() || RichTextFields.Any() ? "pt-5 border-t border-white/[0.08]" : "")">
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-[9px] font-mono font-black px-2 py-0.5 rounded-md bg-indigo-950/80 text-indigo-400 border border-indigo-500/30">
                        [SYS // CHECKBOXES]
                    </span>
                    <span class="text-xs font-bold text-slate-300">گزینه‌ها و وضعیت‌ها</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
                    @foreach (var field in CheckboxFields)
                    {
                        <div class="relative flex flex-col justify-center">
                            <div class="p-3 px-3.5 rounded-2xl bg-[#050811]/90 border border-white/[0.12] hover:border-cyan-500/40 transition-all flex items-center min-h-[46px] shadow-2xs">
                                <CustomCheckbox Label="@field.Name" Value="@GetCheckboxValue(field)" ValueChanged="@(val => SetCheckboxValue(field, val))" BoxOnLeft="true" Class="w-full" />
                            </div>
                            @if (ValidationErrors != null && ValidationErrors.TryGetValue(field.Name, out var errorMsg))
                            {
                                <div class="text-rose-400 text-xs font-medium mt-1">@errorMsg</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Section 4: Color Picker (ColorPicker) *@
        @if (ColorPickerFields.Any())
        {
            <div class="space-y-3 @(DataFields.Any() || RichTextFields.Any() || CheckboxFields.Any() ? "pt-5 border-t border-white/[0.08]" : "")">
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-[9px] font-mono font-black px-2 py-0.5 rounded-md bg-purple-950/80 text-purple-400 border border-purple-500/30">
                        [SYS // COLOR_THEME]
                    </span>
                    <span class="text-xs font-bold text-slate-300">تنظیمات و پالت رنگ</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-4">
                    @foreach (var field in ColorPickerFields)
                    {
                        <div class="relative">
                            <div>
                                <label class="flex items-center gap-1.5 text-xs font-semibold text-slate-300 mb-1.5">
                                    <span class="text-cyan-400 text-[9px]">◆</span>
                                    <span>@field.Name</span>
                                </label>
                                <ColorPicker @bind-Value="field.Value" Placeholder="@field.Placeholder" />
                            </div>
                            @if (ValidationErrors != null && ValidationErrors.TryGetValue(field.Name, out var errorMsg))
                            {
                                <div class="text-rose-400 text-xs font-medium mt-1">@errorMsg</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Section 5: Attachments & Documents (File) *@
        @if (AttachmentFields.Any())
        {
            <div class="space-y-3 @(DataFields.Any() || RichTextFields.Any() || CheckboxFields.Any() || ColorPickerFields.Any() ? "pt-5 border-t border-white/[0.08]" : "")">
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-[9px] font-mono font-black px-2 py-0.5 rounded-md bg-amber-950/80 text-amber-400 border border-amber-500/30">
                        [SYS // ATTACHMENTS]
                    </span>
                    <span class="text-xs font-bold text-slate-300">فایل‌ها و مستندات پیوست</span>
                </div>
                <div class="space-y-4">
                    @foreach (var field in AttachmentFields)
                    {
                        <div class="relative w-full">
                            <CustomFileUpload Label="@field.Name"
                                              SelectedFiles="GetInternalBrowserFiles(field)"
                                              SelectedFilesChanged="@(files => HandleFilesChanged(field, files))" />
                            @if (ValidationErrors != null && ValidationErrors.TryGetValue(field.Name, out var errorMsg))
                            {
                                <div class="text-rose-400 text-xs font-medium mt-1">@errorMsg</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
