@namespace TicketHub.Web.Components.Shared
@typeparam TItem

@if (Items == null)
{
    <LoadingSpinner />
}
else if (!Items.Any())
{
    <EmptyState Message="@EmptyMessage" />
}
else
{
    <div class="@ContainerClass">
        @foreach (var item in Items)
        {
            @ItemTemplate(item)
        }
    </div>
}