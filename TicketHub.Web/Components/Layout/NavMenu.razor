@namespace TicketHub.Web.Components.Layout
@using TicketHub.Web.Components.Layout.Shared
@rendermode InteractiveServer

<aside class="h-full flex flex-col bg-[#070b16]/98 border-l border-white/[0.08] text-slate-300 select-none shadow-2xl relative">
    <!-- Protruding Border Toggle Handle (Desktop Only) -->
    <button type="button"
            @onclick="HandleToggleSidebar"
            title="@(IsCollapsed ? "باز کردن منو" : "بستن منو")"
            class="hidden md:flex absolute top-1/2 -left-3.5 -translate-y-1/2 w-7 h-7 rounded-full bg-[#080d1a] border border-cyan-500/40 text-cyan-300 hover:text-white hover:bg-cyan-950 hover:border-cyan-400 hover:scale-115 shadow-[0_0_15px_rgba(56,189,248,0.35)] hover:shadow-[0_0_25px_rgba(56,189,248,0.7)] items-center justify-center transition-all duration-300 z-50 cursor-pointer focus-ring">
        <svg xmlns="http://www.w3.org/2000/svg"
             class="w-4 h-4 transition-transform duration-300 @(IsCollapsed ? "rotate-180 text-cyan-400" : "text-cyan-300")"
             fill="none"
             viewBox="0 0 24 24"
             stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
    </button>

    <!-- Brand / Logo Section -->
    <div class="@($"h-16 flex items-center {(IsCollapsed ? "justify-center" : "justify-between px-5")} bg-[#050811]/90 border-b border-white/[0.08] transition-all duration-300")">
        <div class="flex items-center gap-3">
            <button type="button" @onclick="HandleToggleSidebar" class="w-8 h-8 rounded-xl bg-gradient-to-tr from-cyan-500 via-indigo-600 to-pink-500 flex-shrink-0 flex items-center justify-center shadow-[0_0_15px_rgba(56,189,248,0.4)] transition-all hover:scale-105 group relative cursor-pointer focus-ring">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white block group-hover:hidden" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2z" clip-rule="evenodd" />
                </svg>
                @if (IsCollapsed)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white hidden group-hover:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white hidden group-hover:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                }
            </button>

            @if (!IsCollapsed)
            {
                <div class="flex flex-col">
                    <a href="" class="tracking-tight text-sm font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-cyan-200 to-indigo-300 font-mono whitespace-nowrap hover:opacity-80 transition-opacity">TICKETHUB</a>
                    <span class="text-[9px] font-mono text-cyan-400/80 tracking-widest uppercase">COMMAND MATRIX</span>
                </div>
            }
        </div>

        @if (!IsCollapsed)
        {
            <button @onclick="CloseMobileMenu" class="md:hidden p-1.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        }
    </div>

    <!-- Navigation Links -->
    <nav class="@($"flex-1 p-3.5 space-y-1.5 {(IsCollapsed ? "overflow-visible" : "overflow-y-auto overflow-x-hidden custom-scrollbar")}")">

        @if (!IsCollapsed)
        {
            <div class="px-3 pt-1 pb-1 text-[10px] font-mono font-bold uppercase tracking-wider text-slate-500 select-none">
                TACTICAL // ناوبری اصلی
            </div>
        }

        <NavItem Href="" Title="داشبورد اصلی" ShortcutKey="1" Match="NavLinkMatch.All" IsCollapsed="IsCollapsed" OnClick="HandleSideBarClick">
            <IconContent>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
            </IconContent>
        </NavItem>

        <SecuredView ResourceKey="/tickets">
            <NavItem Href="tickets" Title="مدیریت تیکت‌ها" ShortcutKey="2" IsCollapsed="IsCollapsed" OnClick="HandleSideBarClick">
                <IconContent>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                    </svg>
                </IconContent>
            </NavItem>
        </SecuredView>

        <SecuredView ResourceKey="/projects">
            <NavItem Href="projects" Title="پروژه‌ها" ShortcutKey="3" IsCollapsed="IsCollapsed" OnClick="HandleSideBarClick">
                <IconContent>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </IconContent>
            </NavItem>
        </SecuredView>

        <SecuredView ResourceKey="/users">
            <NavItem Href="users" Title="مدیریت کاربران" ShortcutKey="4" IsCollapsed="IsCollapsed" OnClick="HandleSideBarClick">
                <IconContent>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </IconContent>
            </NavItem>
        </SecuredView>

        <SecuredView ResourceKey="/workflows">
            <NavItem Href="workflows" Title="مدیریت جریان‌های کاری" IsCollapsed="IsCollapsed" OnClick="HandleSideBarClick">
                <IconContent>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                    </svg>
                </IconContent>
            </NavItem>
        </SecuredView>

        <SecuredView ResourceKey="/system-logs">
            <NavItem Href="system-logs" Title="لاگ‌های سیستم" IsCollapsed="IsCollapsed" OnClick="HandleSideBarClick">
                <IconContent>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </IconContent>
            </NavItem>
        </SecuredView>

        <SecuredView ResourceKey="تنظیمات سیستم">
            <NavItem Title="تنظیمات سیستم" IsCollapsed="IsCollapsed" OnExpandRequested="OnExpandRequested">
                <IconContent>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </IconContent>
                <ChildContent>
                    <SecuredView ResourceKey="/settings/roles">
                        <NavLink class="cyber-sub-link group" href="settings/roles" @onclick="HandleSideBarClick">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
                            </svg>
                            <span class="whitespace-nowrap">مدیریت نقش‌ها</span>
                        </NavLink>
                    </SecuredView>

                    <SecuredView ResourceKey="/settings/statuses">
                        <NavLink class="cyber-sub-link group mt-1" href="settings/statuses" @onclick="HandleSideBarClick">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="whitespace-nowrap">مدیریت وضعیت‌ها</span>
                        </NavLink>
                    </SecuredView>

                    <SecuredView ResourceKey="/settings/categories">
                        <NavLink class="cyber-sub-link group mt-1" href="settings/categories" @onclick="HandleSideBarClick">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                            </svg>
                            <span class="whitespace-nowrap">مدیریت انواع تیکت</span>
                        </NavLink>
                    </SecuredView>

                    <SecuredView ResourceKey="/settings/priorities">
                        <NavLink class="cyber-sub-link group mt-1" href="settings/priorities" @onclick="HandleSideBarClick">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                            <span class="whitespace-nowrap">مدیریت اولویت‌ها</span>
                        </NavLink>
                    </SecuredView>

                    <SecuredView ResourceKey="/settings/ticket-fields">
                        <NavLink class="cyber-sub-link group mt-1" href="settings/ticket-fields" @onclick="HandleSideBarClick">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            <span class="whitespace-nowrap">مدیریت فیلدهای تیکت</span>
                        </NavLink>
                    </SecuredView>

                    <SecuredView ResourceKey="/settings/permissions">
                        <NavLink class="cyber-sub-link group mt-1" href="settings/permissions" @onclick="HandleSideBarClick">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            <span class="whitespace-nowrap">مدیریت دسترسی‌ها</span>
                        </NavLink>
                    </SecuredView>
                </ChildContent>
            </NavItem>
        </SecuredView>
    </nav>

    <!-- Sidebar Footer (Aura Selector, XP Bar, Profile & Logout) -->
    <div class="flex flex-col border-t border-white/[0.08] bg-[#050811]/90">
        @if (!IsCollapsed)
        {
            <!-- Elemental Aura Matrix Selector -->
            <div class="px-4 py-2 border-b border-white/[0.05] bg-[#04060c]/80 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                    <span class="text-[10px] font-mono font-bold text-slate-400 tracking-wider">AURA MATRIX</span>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="window.setCockpitAura('water')" data-aura-target="water" class="aura-btn w-4.5 h-4.5 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-400 cursor-pointer shadow-sm hover:opacity-100" title="تم آب و اقیانوس"></button>
                    <button type="button" onclick="window.setCockpitAura('fire')" data-aura-target="fire" class="aura-btn w-4.5 h-4.5 rounded-full bg-gradient-to-tr from-red-600 to-amber-400 cursor-pointer shadow-sm hover:opacity-100" title="تم آتش و حرارت"></button>
                    <button type="button" onclick="window.setCockpitAura('lightning')" data-aura-target="lightning" class="aura-btn w-4.5 h-4.5 rounded-full bg-gradient-to-tr from-amber-500 to-yellow-300 cursor-pointer shadow-sm hover:opacity-100" title="تم صاعقه و برق"></button>
                    <button type="button" onclick="window.setCockpitAura('toxic')" data-aura-target="toxic" class="aura-btn w-4.5 h-4.5 rounded-full bg-gradient-to-tr from-emerald-600 to-lime-400 cursor-pointer shadow-sm hover:opacity-100" title="تم اسید و سم"></button>
                </div>
            </div>
        }

        <a href="/profile" class="@($"relative flex items-center gap-3 {(IsCollapsed ? "justify-center p-3" : "p-3.5")} hover:bg-slate-800/60 transition-colors group")" @onclick="HandleSideBarClick">
            <div class="w-8 h-8 rounded-full bg-slate-800 flex-shrink-0 flex items-center justify-center text-xs font-bold text-cyan-400 border border-slate-700 group-hover:border-cyan-400 transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
            @if (!IsCollapsed)
            {
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-semibold text-slate-200 truncate">پروفایل من</p>
                    <p class="text-[10px] font-mono text-cyan-400/70 truncate group-hover:text-cyan-300">OP: ONLINE</p>
                </div>
            }
            @if (IsCollapsed)
            {
                <span class="absolute right-full mr-3 px-3 py-1.5 bg-[#090e1d] text-cyan-300 text-xs font-mono font-medium rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 whitespace-nowrap z-50 border border-cyan-500/30 pointer-events-none">پروفایل من</span>
            }
        </a>

        <form action="/logout" method="post" data-enhance="false" class="w-full border-t border-white/[0.05]">
            <AntiforgeryToken />
            <button type="submit" class="@($"relative w-full flex items-center justify-center gap-2 {(IsCollapsed ? "p-3.5" : "p-2.5")} text-xs font-medium text-rose-400 hover:bg-rose-500/10 hover:text-rose-300 transition-colors group focus-ring cursor-pointer")">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                @if (!IsCollapsed)
                {
                    <span class="whitespace-nowrap">خروج از سیستم</span>
                }
                @if (IsCollapsed)
                {
                    <span class="absolute right-full mr-3 px-3 py-1.5 bg-[#090e1d] text-rose-300 text-xs font-mono font-medium rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 whitespace-nowrap z-50 border border-rose-500/30 pointer-events-none">خروج</span>
                }
            </button>
        </form>
    </div>
</aside>