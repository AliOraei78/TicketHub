@namespace TicketHub.Web.Components.Layout
@inherits LayoutComponentBase
@using TicketHub.Web.Components.Shared
@using TicketHub.Web.Components.Layout.Shared
@using Microsoft.AspNetCore.Components.Authorization

<div class="min-h-screen flex flex-col bg-[#05070f] font-['Vazirmatn'] text-slate-200 selection:bg-cyan-500/20 selection:text-cyan-300 relative overflow-x-hidden" dir="rtl">
    
    <!-- Background Tactical Grid & Ambient Nebula -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
        <div class="absolute inset-0 cyber-command-grid opacity-20"></div>
        <div class="cyber-nebula-orb orb-1 opacity-40"></div>
        <div class="cyber-nebula-orb orb-2 opacity-30"></div>
    </div>

    <!-- Public Top Navigation Bar -->
    <header class="h-16 flex items-center justify-between px-4 sm:px-8 bg-[#070b16]/90 backdrop-blur-xl border-b border-white/[0.08] sticky top-0 z-40 shadow-lg">
        <div class="flex items-center gap-6">
            <BrandLogo Size="sm" ShowText="true" Subtitle="KNOWLEDGE BASE" />

            <nav class="hidden md:flex items-center gap-1 pr-4 border-r border-white/10 text-xs font-medium">
                <a href="/kb" class="px-3 py-1.5 rounded-xl text-slate-300 hover:text-cyan-300 hover:bg-white/[0.04] transition-all flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    <span>پایگاه دانش</span>
                </a>
                <a href="/kb#faq-section" onclick="window.scrollToElement('faq-section')" class="px-3 py-1.5 rounded-xl text-slate-300 hover:text-cyan-300 hover:bg-white/[0.04] transition-all flex items-center gap-1.5 cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>سوالات متداول</span>
                </a>
            </nav>
        </div>

        <!-- Right Actions: Login & Portal Links -->
        <div class="flex items-center gap-2.5">
            <AuthorizeView>
                <Authorized>
                    <a href="/" class="btn-cyber-primary text-xs px-3.5 py-1.5 font-bold inline-flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span>ورود به داشبورد</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" data-enhance="false" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-slate-200 hover:text-cyan-300 hover:bg-white/[0.05] transition-all border border-white/10 flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                        </svg>
                        <span>ورود به سامانه</span>
                    </a>
                    <a href="/register" data-enhance="false" class="btn-cyber-primary text-xs px-3.5 py-1.5 font-bold hidden sm:inline-flex">
                        <span>ثبت‌نام کاربر</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <!-- Main Body View -->
    <main class="flex-1 relative z-10">
        <CustomErrorBoundary @ref="errorBoundary">
            @Body
        </CustomErrorBoundary>
    </main>

    <!-- Obsidian Footer -->
    <footer class="mt-auto bg-[#04060d] border-t border-white/[0.08] py-8 px-4 sm:px-8 relative z-10 text-xs text-slate-400">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <BrandLogo Size="xs" ShowText="false" />
                <p>© ۱۴۰۴ سامانه هوشمند تیکت‌هاب (TicketHub) - تمامی حقوق محفوظ است.</p>
            </div>

            <div class="flex items-center gap-4 text-slate-400">
                <a href="/kb" class="hover:text-cyan-300 transition-colors">پایگاه دانش</a>
                <a href="/kb#faq-section" onclick="window.scrollToElement('faq-section')" class="hover:text-cyan-300 transition-colors cursor-pointer">سوالات متداول</a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/" class="hover:text-cyan-300 transition-colors">داشبورد مدیریت</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" data-enhance="false" class="hover:text-cyan-300 transition-colors">ورود به سامانه</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </footer>
</div>

@code {
    private CustomErrorBoundary? errorBoundary;

    protected override void OnParametersSet()
    {
        errorBoundary?.Recover();
    }
}
