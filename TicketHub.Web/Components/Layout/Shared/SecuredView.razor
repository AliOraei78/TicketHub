@using Microsoft.AspNetCore.Components.Authorization
@using TicketHub.Application.Interfaces
@using TicketHub.Application.Enums
@inject AuthenticationStateProvider AuthStateProvider
@inject IPermissionService PermissionService

@if (_hasAccess)
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public string ResourceKey { get; set; } = default!;
    [Parameter] public PermissionType MinimumType { get; set; } = PermissionType.Menu;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private bool _hasAccess;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _hasAccess = await PermissionService.HasAccessAsync(authState.User, ResourceKey, MinimumType);
    }
}