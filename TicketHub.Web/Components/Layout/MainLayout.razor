@inherits LayoutComponentBase

<style>
    /* Styling active NavLinks built-in inside Blazor using Tailwind equivalence */
    nav a.active {
        background-color: rgb(30 41 59 / 0.8) !important; /* bg-slate-800 */
        color: rgb(255 255 255) !important; /* text-white */
        border-right: 3px solid rgb(37 99 235); /* border-blue-600 indicator */
    }
    nav a.active svg {
        color: rgb(37 99 235) !important; /* active icon color */
    }
</style>

<div class="min-h-screen flex bg-slate-50 font-['Vazirmatn'] selection:bg-blue-500/10 selection:text-blue-600" dir="rtl">

    <!-- Desktop Sidebar (Sticky & Fixed width) -->
    <div class="hidden md:block w-64 h-screen sticky top-0 flex-shrink-0 z-20 shadow-xl shadow-slate-900/5">
        <NavMenu IsMobileMenuOpen="false" />
    </div>

    <!-- Mobile Sidebar Drawer Overlay (Backdrop) -->
    @if (isMobileMenuOpen)
    {
        <div @onclick="ToggleMobileMenu" class="md:hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 animate-[fadeIn_0.2s_ease-out]"></div>
    }

    <!-- Mobile Sidebar Menu Container -->
    <div class="md:hidden fixed inset-y-0 right-0 w-64 z-50 transform smooth-transition @(isMobileMenuOpen ? "translate-x-0 shadow-2xl" : "translate-x-full")">
        <NavMenu IsMobileMenuOpen="isMobileMenuOpen" CloseMobileMenu="ToggleMobileMenu" />
    </div>

    <!-- Main Content Shell -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto">
        <!-- Top Responsive Header Bar -->
        <header class="h-16 flex items-center justify-between px-4 md:px-8 bg-white border-b border-slate-100 flex-shrink-0 sticky top-0 z-10 shadow-sm shadow-slate-100/40">
            <div class="flex items-center gap-3">
                <!-- Mobile Toggle Hamburger Button -->
                <button @onclick="ToggleMobileMenu" class="md:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-800 smooth-transition border border-slate-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <div class="hidden sm:block text-xs font-semibold text-slate-400 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-100">
                    نسخه سامانه: ۱.۰.۰ (.NET 8)
                </div>
            </div>

            <!-- Profile / System Actions Quick Menu -->
            <div class="flex items-center gap-3">
                <span class="text-sm font-medium text-slate-600 hidden sm:inline">مدیریت تیکت‌ها</span>
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
            </div>
        </header>

        <!-- Page Dynamic Body Container -->
        <main class="flex-1 p-4 md:p-8">
            @Body
        </main>
    </div>
</div>

<!-- Native Blazor Error UI Toast (Replaced with elegant minimal look) -->
<div id="blazor-error-ui" class="fixed bottom-4 left-4 right-4 md:right-auto md:w-96 bg-rose-50 border border-rose-100 p-4 rounded-xl shadow-xl z-50 text-rose-800 text-xs font-medium flex items-center justify-between hidden">
    <span>خطایی در سیستم رخ داده است. لطفا صفحه را مجدداً بارگذاری کنید.</span>
    <div class="flex items-center gap-2">
        <a href="" class="reload bg-rose-600 text-white px-2.5 py-1 rounded-lg hover:bg-rose-700 smooth-transition">بارگذاری</a>
        <a class="dismiss cursor-pointer text-rose-400 hover:text-rose-600 text-base">×</a>
    </div>
</div>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }
}