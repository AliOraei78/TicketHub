@inherits LayoutComponentBase
@inject NavigationManager Navigation

<style>
    nav a.active {
        background-color: rgb(30 41 59 / 0.8) !important;
        color: rgb(255 255 255) !important;
        border-right: 3px solid rgb(37 99 235);
    }

        nav a.active svg {
            color: rgb(37 99 235) !important;
        }

    .sidebar-transition {
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>

<div class="min-h-screen flex bg-slate-50 font-['Vazirmatn'] selection:bg-blue-500/10 selection:text-blue-600" dir="rtl">

    <!-- Desktop Sidebar -->
    <div class="hidden md:block @(isSidebarCollapsed ? "w-20" : "w-64") h-screen sticky top-0 flex-shrink-0 z-20 shadow-xl shadow-slate-900/5 sidebar-transition">
        <NavMenu IsMobileMenuOpen="false" IsCollapsed="isSidebarCollapsed" OnExpandRequested="OpenSidebar" OnToggleSidebar="ToggleDesktopSidebar" />
    </div>

    <!-- Mobile Sidebar Drawer Overlay -->
    @if (isMobileMenuOpen)
    {
        <div @onclick="ToggleMobileMenu" class="md:hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 animate-[fadeIn_0.2s_ease-out]"></div>
    }

    <!-- Mobile Sidebar -->
    <div class="md:hidden fixed inset-y-0 right-0 w-64 z-50 transform smooth-transition @(isMobileMenuOpen ? "translate-x-0 shadow-2xl" : "translate-x-full")">
        <NavMenu IsMobileMenuOpen="isMobileMenuOpen" CloseMobileMenu="ToggleMobileMenu" IsCollapsed="false" />
    </div>

    <!-- Main Content Shell -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden">
        <!-- Top Responsive Header Bar -->
        <header class="h-16 flex items-center justify-between px-4 md:px-8 bg-white border-b border-slate-100 flex-shrink-0 sticky top-0 z-10 shadow-sm shadow-slate-100/40">
            <div class="flex items-center gap-3">
                <button @onclick="ToggleMobileMenu" class="md:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-800 smooth-transition border border-slate-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <div class="hidden sm:block text-xs font-semibold text-slate-400 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-100">
                    نسخه سامانه: ۱.۰.۰ (.NET 8)
                </div>
            </div>

            <!-- Profile / System Actions Quick Menu -->
            <div class="flex items-center gap-3 relative">
                <span class="text-sm font-medium text-slate-600 hidden sm:inline">حساب کاربری</span>
                <button @onclick="ToggleProfileMenu" class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center hover:bg-blue-100 smooth-transition cursor-pointer border border-blue-100 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </button>

                @if (isProfileMenuOpen)
                {
                    <div class="fixed inset-0 z-40" @onclick="ToggleProfileMenu"></div>

                    <div class="absolute top-12 left-0 w-48 bg-white border border-slate-100 rounded-xl shadow-xl z-50 py-1 animate-[fadeIn_0.1s_ease-out]">
                        <a href="/profile" class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-blue-600 smooth-transition" @onclick="ToggleProfileMenu">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            پروفایل من
                        </a>
                        <div class="h-px bg-slate-100 my-1"></div>
                        <form action="/logout" method="post" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="w-full flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50 smooth-transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                خروج از سیستم
                            </button>
                        </form>
                    </div>
                }
            </div>
        </header>

        <main class="flex-1 p-4 md:p-8 overflow-y-auto relative custom-scrollbar">
            <!-- اضافه کردن h-full برای اطمینان از کشیدگی درست محتوا -->
            <div @key="Navigation.Uri" class="page-transition-enter min-h-full flex flex-col">
                @Body
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="fixed bottom-4 left-4 right-4 md:right-auto md:w-96 bg-rose-50 border border-rose-100 p-4 rounded-xl shadow-xl z-50 text-rose-800 text-xs font-medium flex items-center justify-between hidden">
    <span>خطایی در سیستم رخ داده است. لطفا صفحه را مجدداً بارگذاری کنید.</span>
    <div class="flex items-center gap-2">
        <a href="" class="reload bg-rose-600 text-white px-2.5 py-1 rounded-lg hover:bg-rose-700 smooth-transition">بارگذاری</a>
        <a class="dismiss cursor-pointer text-rose-400 hover:text-rose-600 text-base">×</a>
    </div>
</div>

@code {
    private bool isMobileMenuOpen = false;
    private bool isProfileMenuOpen = false;
    private bool isSidebarCollapsed = false;

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;
    private void ToggleProfileMenu() => isProfileMenuOpen = !isProfileMenuOpen;
    private void ToggleDesktopSidebar() => isSidebarCollapsed = !isSidebarCollapsed;
    private void OpenSidebar() => isSidebarCollapsed = false;
}