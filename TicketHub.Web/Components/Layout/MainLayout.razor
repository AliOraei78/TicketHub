@namespace TicketHub.Web.Components.Layout
@using Microsoft.AspNetCore.Components.Sections
@inherits LayoutComponentBase

<div class="min-h-screen flex bg-[#05070f] font-['Vazirmatn'] text-slate-200 selection:bg-cyan-500/20 selection:text-cyan-300 relative overflow-hidden" dir="rtl" id="cyber-cockpit-root">
    
    <!-- Background Tactical Grid & Fluid Ambient Nebula Mesh -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" id="cyber-ambient-nebula-container">
        <div class="absolute inset-0 cyber-command-grid opacity-30"></div>
        <div class="cyber-nebula-orb orb-1"></div>
        <div class="cyber-nebula-orb orb-2"></div>
        <div class="cyber-nebula-orb orb-3"></div>
    </div>

    <!-- Global Matrix Rain Canvas -->
    <canvas id="global-matrix-rain-canvas" class="fixed inset-0 pointer-events-none z-0" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; pointer-events: none; opacity: 0.35; display: none;"></canvas>

    <ToastContainer />
    <SectionOutlet SectionName="RootModal" />

    <!-- Desktop Sidebar -->
    <div class="hidden md:block @(IsSidebarCollapsed ? "w-20" : "w-64") h-screen sticky top-0 flex-shrink-0 z-30 shadow-2xl transition-all duration-300 ease-in-out relative">
        <NavMenu IsMobileMenuOpen="false" IsCollapsed="IsSidebarCollapsed" OnExpandRequested="OpenSidebar" OnToggleSidebar="ToggleDesktopSidebar" />
    </div>

    <!-- Mobile Sidebar Drawer Overlay -->
    @if (IsMobileMenuOpen)
    {
        <div @onclick="ToggleMobileMenu" class="md:hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-40 animate-[fadeIn_0.2s_ease-out]"></div>
    }

    <!-- Mobile Sidebar -->
    <div class="md:hidden fixed inset-y-0 right-0 w-64 z-50 transform transition-transform duration-300 ease-out @(IsMobileMenuOpen ? "translate-x-0 shadow-2xl" : "translate-x-full")">
        <NavMenu IsMobileMenuOpen="IsMobileMenuOpen" CloseMobileMenu="ToggleMobileMenu" IsCollapsed="false" />
    </div>

    <!-- Main Content Shell -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden relative z-10">
        <!-- Top Cyber Command Bridge Header -->
        <header class="h-16 flex items-center justify-between px-4 md:px-8 bg-[#070b16]/90 backdrop-blur-xl border-b border-white/[0.08] flex-shrink-0 sticky top-0 z-20 shadow-lg relative">
            
            <!-- Bottom Laser Sweep Line -->
            <div class="cyber-laser-sweep"></div>

            <!-- Left / Center: Telemetry HUD & Status -->
            <div class="flex items-center gap-3">
                <button @onclick="ToggleMobileMenu" class="md:hidden p-2 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-cyan-300 transition-all border border-slate-700 focus-ring cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <!-- Live Server Online Status -->
                <div class="inline-flex items-center gap-2 bg-[#050811]/90 px-3 py-1.5 rounded-xl border border-emerald-500/30 text-emerald-300 shadow-[0_0_12px_rgba(16,185,129,0.15)] text-xs font-bold select-none hover:border-emerald-400/60 transition-all backdrop-blur-md">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    <span>سرور آنلاین // پچ ۱.۰</span>
                </div>

                <!-- Live Cyber Persian Calendar Badge -->
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#050811]/90 border border-cyan-500/30 text-cyan-300 shadow-[0_0_12px_rgba(56,189,248,0.15)] font-mono text-xs select-none hover:border-cyan-400/60 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="font-bold">@CurrentPersianDate</span>
                </div>

                <!-- Server Latency & FPS Telemetry -->
                <div dir="ltr" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#050811]/80 border border-white/[0.08] font-mono text-[11px] text-slate-400 select-none">
                    <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    <span>PING:</span>
                    <span id="hud-ping-val" class="text-cyan-300 font-bold">18ms</span>
                    <span class="text-slate-600">//</span>
                    <span class="text-indigo-300 font-semibold">60 FPS</span>
                </div>

                <!-- Core Engine Chip -->
                <div dir="ltr" class="hidden lg:inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-[#050811]/80 border border-white/[0.08] font-mono text-[10px] text-slate-400 select-none">
                    <span>ENGINE:</span>
                    <span class="text-slate-200 font-bold">.NET 10</span>
                </div>

                <!-- Stealth / Eco Performance Toggle -->
                <button id="hud-eco-mode-btn" type="button" onclick="window.toggleStealthMode()"
                        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-[#050811]/90 border border-amber-500/30 text-amber-300 shadow-[0_0_12px_rgba(245,158,11,0.15)] text-xs font-bold select-none hover:border-amber-400/60 hover:text-amber-200 transition-all cursor-pointer focus-ring"
                        title="تغییر حالت گرافیکی و عملکردی (کلید میانبر: E)">
                    <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    <span class="hidden md:inline">حالت کم‌مصرف</span>
                </button>

                <!-- Keyboard Shortcuts Cheat Sheet Button -->
                <button type="button" onclick="window.toggleShortcutsModal()"
                        class="hidden sm:inline-flex items-center gap-1 px-2 py-1.5 rounded-xl bg-[#050811]/80 border border-white/[0.1] text-slate-300 hover:text-cyan-300 hover:border-cyan-500/40 text-xs font-mono select-none transition-all cursor-pointer focus-ring"
                        title="راهنمای کلیدهای میانبر (کلید میانبر: ?)">
                    <span class="font-bold">⌨️</span>
                    <kbd class="px-1 py-0.2 bg-slate-900 border border-slate-700/60 rounded text-[10px] text-cyan-300 font-mono">?</kbd>
                </button>
            </div>

            <!-- Right Profile / Actions Quick Menu -->
            <div class="flex items-center gap-3 relative select-none">
                <NotificationBell />

                <!-- User Profile & Avatar -->
                <div class="flex items-center gap-3 cursor-pointer group" @onclick="ToggleProfileMenu">
                    <div class="hidden sm:flex flex-col items-start text-right" style="text-align: right; align-items: flex-start;">
                        <span class="text-xs font-bold text-slate-100 group-hover:text-cyan-300 transition-colors max-w-[130px] truncate text-right">@CurrentUserName</span>
                        <span class="text-[10px] font-bold @PrimaryRoleColorClass tracking-wider text-right">@PrimaryRoleName</span>
                    </div>

                    <!-- Glowing Conic Energy Ring Avatar -->
                    <div class="cyber-avatar-ring">
                        <button type="button" class="w-8.5 h-8.5 rounded-full bg-slate-900 text-cyan-400 flex items-center justify-center hover:scale-105 transition-transform cursor-pointer border border-slate-700 shadow-inner">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </button>
                    </div>
                </div>

                @if (IsProfileMenuOpen)
                {
                    <div class="fixed inset-0 z-40" @onclick="ToggleProfileMenu"></div>

                    <div class="absolute top-12 left-0 w-56 bg-[#090e1d]/98 backdrop-blur-2xl border border-cyan-500/30 rounded-2xl shadow-[0_15px_40px_rgba(0,0,0,0.8),0_0_20px_rgba(56,189,248,0.15)] z-50 py-2 animate-[fadeIn_0.15s_ease-out]">
                        <div class="px-4 py-2.5 border-b border-white/[0.08] mb-1">
                            <p class="text-xs font-bold text-white truncate">@CurrentUserName</p>
                            <p class="text-[10px] @PrimaryRoleColorClass font-bold mt-0.5">@PrimaryRoleName</p>
                            @if (!string.IsNullOrWhiteSpace(CurrentUserEmail))
                            {
                                <p class="text-[10px] text-slate-400 font-mono truncate mt-0.5">@CurrentUserEmail</p>
                            }
                        </div>

                        <a href="/profile" class="flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-300 hover:bg-slate-800/80 hover:text-cyan-300 transition-colors" @onclick="ToggleProfileMenu">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            پروفایل من
                        </a>

                        <div class="h-px bg-white/[0.08] my-1"></div>

                        <form action="/logout" method="post" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-rose-400 hover:bg-rose-500/10 transition-colors focus-ring cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                خروج از سیستم
                            </button>
                        </form>
                    </div>
                }
            </div>
        </header>

        <main class="flex-1 p-6 md:p-8 overflow-y-auto overflow-x-hidden relative custom-scrollbar">
            <div @key="Navigation.Uri" class="page-transition-enter min-h-full flex flex-col w-full max-w-full overflow-x-hidden">
                <CustomErrorBoundary @ref="ErrorBoundary">
                    @Body
                </CustomErrorBoundary>
            </div>
        </main>
    </div>

    <!-- Cyberpunk Keyboard Shortcuts Helper Modal (Press '?' or click '[؟]') -->
    <div id="cyber-shortcuts-modal" class="fixed inset-0 z-[99999] bg-[#030611]/85 backdrop-blur-xl hidden items-center justify-center p-4 animate-[fadeIn_0.15s_ease-out]">
        <div class="fixed inset-0" onclick="window.toggleShortcutsModal()"></div>
        <div class="relative z-10 w-full max-w-lg bg-[#070c1a]/98 border border-cyan-500/40 rounded-3xl shadow-[0_25px_60px_rgba(0,0,0,0.9),0_0_30px_rgba(56,189,248,0.2)] p-6 text-white overflow-hidden modal-hud-chassis select-none">
            <div class="cyber-scanline pointer-events-none opacity-40"></div>
            
            <div class="flex items-center justify-between border-b border-white/[0.08] pb-4 mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-cyan-500/15 border border-cyan-400/40 flex items-center justify-center text-cyan-300 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-white flex items-center gap-2">
                            <span>کلیدهای میانبر سایبری</span>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">COMMAND HOTKEYS</span>
                        </h3>
                        <p class="text-xs text-slate-400 mt-0.5">ناوبری و اجرای آنی دستورات با صفحه کلید</p>
                    </div>
                </div>
                <button type="button" onclick="window.toggleShortcutsModal()" class="p-2 rounded-xl text-slate-400 hover:text-cyan-300 hover:bg-slate-800/60 transition-all border border-slate-800 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Shortcuts Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div class="flex items-center justify-between p-3 rounded-2xl bg-[#050811]/90 border border-white/[0.06] hover:border-cyan-500/40 transition-colors">
                    <span class="text-xs font-semibold text-slate-200">جستجوی سریع</span>
                    <kbd class="px-2 py-1 bg-slate-900 border border-slate-700 text-cyan-300 text-xs font-mono rounded-lg shadow-sm font-bold">/</kbd>
                </div>
                <div class="flex items-center justify-between p-3 rounded-2xl bg-[#050811]/90 border border-white/[0.06] hover:border-cyan-500/40 transition-colors">
                    <span class="text-xs font-semibold text-slate-200">ثبت تیکت جدید</span>
                    <div class="flex items-center gap-1">
                        <kbd class="px-2 py-1 bg-slate-900 border border-slate-700 text-cyan-300 text-xs font-mono rounded-lg shadow-sm font-bold">C</kbd>
                        <span class="text-slate-500 text-xs">یا</span>
                        <kbd class="px-2 py-1 bg-slate-900 border border-slate-700 text-cyan-300 text-xs font-mono rounded-lg shadow-sm font-bold">N</kbd>
                    </div>
                </div>
                <div class="flex items-center justify-between p-3 rounded-2xl bg-[#050811]/90 border border-white/[0.06] hover:border-amber-500/40 transition-colors">
                    <span class="text-xs font-semibold text-slate-200">حالت کم‌مصرف / کامل</span>
                    <kbd class="px-2 py-1 bg-slate-900 border border-slate-700 text-amber-300 text-xs font-mono rounded-lg shadow-sm font-bold">E</kbd>
                </div>
                <div class="flex items-center justify-between p-3 rounded-2xl bg-[#050811]/90 border border-white/[0.06] hover:border-rose-500/40 transition-colors">
                    <span class="text-xs font-semibold text-slate-200">بستن پنجره‌ها / مودال</span>
                    <kbd class="px-2 py-1 bg-slate-900 border border-slate-700 text-rose-300 text-xs font-mono rounded-lg shadow-sm font-bold">ESC</kbd>
                </div>
                <div class="flex items-center justify-between p-3 rounded-2xl bg-[#050811]/90 border border-white/[0.06] hover:border-purple-500/40 transition-colors">
                    <span class="text-xs font-semibold text-slate-200">رفتن به داشبورد</span>
                    <kbd class="px-2 py-1 bg-slate-900 border border-slate-700 text-purple-300 text-xs font-mono rounded-lg shadow-sm font-bold">1</kbd>
                </div>
                <div class="flex items-center justify-between p-3 rounded-2xl bg-[#050811]/90 border border-white/[0.06] hover:border-purple-500/40 transition-colors">
                    <span class="text-xs font-semibold text-slate-200">مدیریت تیکت‌ها</span>
                    <kbd class="px-2 py-1 bg-slate-900 border border-slate-700 text-purple-300 text-xs font-mono rounded-lg shadow-sm font-bold">2</kbd>
                </div>
            </div>

            <div class="mt-5 pt-3 border-t border-white/[0.08] flex items-center justify-between text-[11px] text-slate-400 font-medium">
                <span>💡 برای باز کردن دوباره این راهنما در هر جا، کلید <kbd class="font-mono text-cyan-300 font-bold">?</kbd> را فشار دهید.</span>
                <span class="text-cyan-400 font-bold">TicketHub v1.0</span>
            </div>
        </div>
    </div>
</div>

<div id="blazor-error-ui" class="fixed bottom-4 left-4 right-4 md:right-auto md:w-96 bg-rose-950/90 border border-rose-500/50 p-4 rounded-2xl shadow-2xl z-50 text-rose-200 text-xs font-medium flex items-center justify-between hidden backdrop-blur-xl">
    <span>خطایی در سیستم رخ داده است. لطفا صفحه را مجدداً بارگذاری کنید.</span>
    <div class="flex items-center gap-2">
        <a href="" class="reload bg-rose-600 text-white px-2.5 py-1 rounded-lg hover:bg-rose-700 transition-colors">بارگذاری</a>
        <a class="dismiss cursor-pointer text-rose-400 hover:text-rose-600 text-base">×</a>
    </div>
</div>