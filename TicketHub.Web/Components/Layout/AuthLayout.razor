@inherits LayoutComponentBase

<!-- این صفحه هیچ منو و سایدباری ندارد و فقط محتوای فرم‌ها را رندر می‌کند -->
<div class="min-h-screen w-full font-['Vazirmatn'] selection:bg-blue-500/30 selection:text-white" dir="rtl">
    <CustomErrorBoundary @ref="errorBoundary">
        @Body
    </CustomErrorBoundary>
</div>

<div id="blazor-error-ui" class="hidden"></div>

@code {
    private CustomErrorBoundary? errorBoundary;

    protected override void OnParametersSet()
    {
        errorBoundary?.Recover();
    }
}